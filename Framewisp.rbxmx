	if hasFall and not screen:FindFirstChild("FramewispFall") then
	local fall = Instance.new("LocalScript")
	fall.Name = "FramewispFall"
	fall.Source = [==[
-- Framewisp: _fall — copies of the layer drift down behind the design.
-- The tagged layer is the TEMPLATE: it hides itself and its copies fall inside
-- the frame it lived in, each at its own size, tilt and fade. Attributes:
-- FallCount, FallTime (seconds top to bottom), FallAlpha, FallScale (smallest
-- copy, 1 = never smaller), FallTilt (degrees either way), FallSpread + FallGap
-- (keep copies apart, gap in copy widths). FallHostX/Y/W/H/R say
-- which box the copies rain inside, as fractions of the layer's own box; without
-- them the copies fill whatever the layer's parent is. The copies sit at the
-- template's own ZIndex, so the layer order in Figma decides what covers them.
-- Safe to delete: the layer comes back and nothing falls.
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function attr(el, key, def)
	local v = el:GetAttribute(key)
	if type(v) ~= "number" then v = el:GetAttribute("Figma" .. key) end
	return type(v) == "number" and v or def
end
local drops = {}
local roots, groups, hooks, watched = fwRoots(), {}, {}, {}
local stopped, queued = false, false
local function inside(el)
	for _, root in ipairs(roots) do if el == root or el:IsDescendantOf(root) then return true end end
	return false
end
local function release(el)
	local group = groups[el]
	if not group then return end
	groups[el] = nil
	for i = #drops, 1, -1 do
		local d = drops[i]
		if d.owner == group then table.remove(drops, i); d.art:Destroy() end
	end
	for _, item in ipairs(group.pool) do
		if item.el.Parent then item.el.Visible = item.visible end
	end
	if group.mine and group.stage.Parent then group.stage:Destroy() end
	el:SetAttribute("FW_Fall", nil)
end
local function applyVariant(d, index)
	local item = d.owner.pool[index]
	d.variant, d.w, d.h, d.aspect = index, item.el.Size.X, item.el.Size.Y, item.aspect
	if #d.owner.pool > 1 then
		d.art.Image = item.el.Image
		d.art.ImageColor3 = item.el.ImageColor3
		for _, f in ipairs(d.fades) do
			if f.c == d.art and f.p == "ImageTransparency" then f.b = item.el.ImageTransparency end
		end
	end
end
local FADE = 0.18 -- share of the trip spent arriving, and the same leaving
local myVer = "?"
do
	local ok, v = pcall(function() return script:GetAttribute("FWv") end)
	if ok and v then myVer = tostring(v) end
end
local function scatter(d, first)
	if not first and #d.owner.pool > 1 then
		applyVariant(d, d.owner.next)
		d.owner.next = d.owner.next % #d.owner.pool + 1
	end
	d.rot = (math.random() * 2 - 1) * d.tilt
	d.dir = math.random() < 0.5 and -1 or 1 -- each copy turns its own way
	d.scale = d.minS + math.random() * (d.maxS - d.minS)
	d.speed = 1 / (d.time * (0.75 + math.random() * 0.5)) -- no two fall in step
	d.t = first and math.random() or 0
	d.x = math.random()
	local need = d.sep0 * (d.wf or 0.2) -- asked gap, in stage widths, at this copy's last drawn width
	if need > 0 then
		local xs = {} -- middle of the widest hole, wandering only in its slack: random retries barely move a full frame
		for _, o in ipairs(drops) do
			if o ~= d and o.grp == d.grp then xs[#xs + 1] = o.x end
		end
		table.sort(xs)
		local from, to, size, prev = 0, 1, -1, 0
		for i = 1, #xs + 1 do
			local cur = xs[i] or 1
			if cur - prev > size then size, from, to = cur - prev, prev, cur end
			prev = cur
		end
		local slack = math.max(0, (size - need) / 2)
		d.x = (from + to) / 2 + (math.random() * 2 - 1) * slack
	end
end
local function wire(el, signature)
	if not el:IsA("GuiObject") then return end
	if not inside(el) or not el:GetAttribute("FigmaFall") or el:GetAttribute("FigmaFall") == 0 or el:GetAttribute("FW_Fall") then return end
	local host = el.Parent -- the copies fall in the group the template sits in
	if not host or not host:IsA("GuiObject") then return end
	el:SetAttribute("FW_Fall", true)
	local tpl, over = el, false -- a container rains its TOP child over its own content; a leaf rains itself
	do
		local best
		for _, c in ipairs(el:GetChildren()) do
			if c:IsA("GuiObject") and (not best or c.ZIndex >= best.ZIndex) then best = c end
		end
		if best then tpl, over = best, true end
	end
	local low = over and (el.ZIndex + 1) or el.ZIndex -- over the content, or the template's own slot
	local stage, mine = host, false
	if not host:GetAttribute("FigmaFallBox") then
		local in3D, n = false, host
		while n and n ~= gui do -- one CanvasGroup anywhere in a 3D card and the card refuses to tilt
			if n:GetAttribute("Figma3D") or n:GetAttribute("FigmaTilt") or n:GetAttribute("FigmaSwing") then in3D = true break end
			n = n.Parent
		end
		stage = Instance.new(in3D and "Frame" or "CanvasGroup") -- older blueprint has no imported box: use the parent
		if not in3D then stage.GroupTransparency = 0 end
		stage.Name = el.Name .. "_Fall"
		stage.BackgroundTransparency = 1
		stage.BorderSizePixel = 0
		stage.ClipsDescendants = true
		stage.ZIndex = low
		stage.AnchorPoint = Vector2.new(0.5, 0.5)
		stage.Position = UDim2.fromScale(0.5, 0.5)
		stage.Size = UDim2.fromScale(1, 1)
		stage:SetAttribute("FW_Owned", true)
		stage:SetAttribute("FW_FallStage", true)
		stage.Parent = host
		mine = true
	end
	local n = math.clamp(math.floor(attr(el, "FallCount", 12)), 1, 60)
	local time = math.max(0.3, attr(el, "FallTime", 6))
	local alpha = math.clamp(attr(el, "FallAlpha", 0.75), 0, 1)
	local minS = math.clamp(attr(el, "FallScale", 0.6), 0.15, 2)
	local maxS = math.clamp(attr(el, "FallScaleMax", 1), 0.15, 2)
	if maxS < minS then maxS = minS end -- a crossed pair means "exactly this size"
	local tilt = math.clamp(attr(el, "FallTilt", 40), 0, 180)
	local sep0 = attr(el, "FallSpread", 0) >= 1 and math.clamp(attr(el, "FallGap", 1), 0.2, 3) or 0
	local spin = attr(el, "FallSpin", 0) >= 1 and math.clamp(attr(el, "FallSpinSpeed", 90), 0, 3600) or 0 -- degrees per second; off by default
	if not stage:IsA("CanvasGroup") then
		tilt, spin = 0, 0 -- a plain Frame cannot clip a rotated copy; inside a 3D card the box was flattened so the CARD can tilt
	end
	local aspect = attr(el, "FallAspect", 0) -- the image's own w/h; 0 = keep the drawn box
	local pool = {{ el = tpl, aspect = aspect, visible = tpl.Visible }}
	if el:GetAttribute("FigmaFallVariant") == 1 then
		local variants = {}
		for _, child in ipairs(host:GetChildren()) do
			local index = child:GetAttribute("FigmaFallVariant")
			if child:IsA("ImageLabel") and type(index) == "number" and index >= 2 and index <= 4 then
				variants[#variants + 1] = { el = child, index = index, aspect = attr(child, "FallAspect", 0), visible = child.Visible }
			end
		end
		table.sort(variants, function(a, b) return a.index < b.index end)
		for _, item in ipairs(variants) do if #pool < 4 then pool[#pool + 1] = item end end
	end
	local group = { pool = pool, next = n % #pool + 1, stage = stage, mine = mine, signature = signature }
	groups[el] = group
	local strip = function(c, show)
		for k in pairs(c:GetAttributes()) do -- scenery: no tag may wake another runtime
			if k:sub(1, 5) == "Figma" or k:sub(1, 3) == "FW_" then c:SetAttribute(k, nil) end
		end
		c:SetAttribute("FW_Owned", true)
		c:SetAttribute("FW_FallDrop", true)
		if show ~= false then c.Visible = true end
	end
	local fadeTargets = function(root) -- every surface a copy can fade, at the template's own value
		local out = {}
		local add = function(c, prop)
			local ok, v = pcall(function() return c[prop] end)
			if ok and type(v) == "number" then out[#out + 1] = { c = c, p = prop, b = v } end
		end
		local scan = function(c)
			if c:IsA("GuiObject") then add(c, "BackgroundTransparency") end
			if c:IsA("ImageLabel") or c:IsA("ImageButton") then add(c, "ImageTransparency") end
			if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
				add(c, "TextTransparency")
				add(c, "TextStrokeTransparency")
			end
			if c:IsA("CanvasGroup") then add(c, "GroupTransparency") end
			if c:IsA("UIStroke") then add(c, "Transparency") end
		end
		scan(root)
		for _, c in ipairs(root:GetDescendants()) do scan(c) end
		return out
	end
	for i = 1, n do
		local item = pool[(i - 1) % #pool + 1]
		local art = item.el:Clone()
		strip(art)
		for _, child in ipairs(art:GetDescendants()) do
			if child:IsA("GuiObject") then strip(child, false) end
		end
		art.Name = el.Name .. "_Drop" .. i
		art.AnchorPoint = Vector2.new(0.5, 0.5)
		art.ZIndex = low
		if art:IsA("ImageLabel") or art:IsA("ImageButton") then
			local st = art.ScaleType
			if st == Enum.ScaleType.Crop or st == Enum.ScaleType.Fit then
				art.ScaleType = Enum.ScaleType.Stretch -- Crop zooms into a fragment; Fit keeps a baked stretch
			end
		end
		art.Parent = stage
		local d = { art = art, w = item.el.Size.X, h = item.el.Size.Y, time = time, minS = minS, tilt = tilt,
			alpha = alpha, fades = fadeTargets(art), warm = 0, aspect = aspect, maxS = maxS, owner = group,
			grp = stage, sep0 = sep0, spin = spin }
		applyVariant(d, (i - 1) % #pool + 1)
		scatter(d, true)
		d.t = (i - 1) / n -- spread the first pass out, or they all arrive together
		drops[#drops + 1] = d
	end
	for _, item in ipairs(pool) do item.el.Visible = false end
	local sp, sz = stage.AbsolutePosition, stage.AbsoluteSize
	local r = function(v) return math.floor(v + 0.5) end
	local lc = stage:FindFirstAncestorWhichIsA("LayerCollector")
	local zb, zGlobal = "?", false
	if lc then
		local ok, v = pcall(function() return lc.ZIndexBehavior end)
		if ok and v then
			zb = tostring(v.Name or v)
			zGlobal = v == Enum.ZIndexBehavior.Global
		end
	end
	if zGlobal then
		warn(("[Framewisp] _fall: %s.ZIndexBehavior is Global. A CanvasGroup does not flatten there, "
			.. "so the tilted copies will not be cut by the box. Set it to Sibling."):format(lc:GetFullName()))
	end
	local tex = "(not an image)"
	if tpl:IsA("ImageLabel") or tpl:IsA("ImageButton") then
		tex = tostring(tpl.Image)
		local src = tpl:GetAttribute("FW_ImageSource")
		if src and tostring(src) ~= tex then tex = tex .. " (source " .. tostring(src) .. ")" end
	end
	print(("[Framewisp] _fall v%s %q x%d z%d | box %s | aspect %.3f | %s | zindex %s | template %s | %s %d,%d %dx%d"):format(
		myVer, el.Name, n, stage.ZIndex,
		mine and "runtime (no box in blueprint — re-export)" or "import",
		attr(el, "FallAspect", 0),
		stage.ClassName == "CanvasGroup" and "canvas" or "PLAIN FRAME (a tilted copy is not clipped)",
		zb, tex, stage.Name, r(sp.X), r(sp.Y), r(sz.X), r(sz.Y)))
end
local queueRefresh
local rootHooks, references = {}, {}
local controls = { "Count", "Time", "Alpha", "Scale", "ScaleMax", "Tilt", "Spread", "Gap", "Spin", "SpinSpeed", "Aspect" }
local function unwatch(el)
	local record = watched[el]
	if not record then return end
	watched[el] = nil
	for _, hook in ipairs(record.hooks) do hook:Disconnect() end
end
local function watch(el)
	if not el:IsA("GuiObject") or el:GetAttribute("FW_FallDrop") or el:GetAttribute("FW_FallStage") then return end
	if not watched[el] then
		watched[el] = { level = 1, hooks = {} }
		for _, key in ipairs({ "FigmaFall", "FigmaFallVariant" }) do
			watched[el].hooks[#watched[el].hooks + 1] = el:GetAttributeChangedSignal(key):Connect(function() queueRefresh() end)
		end
	end
	if watched[el].level == 1 and (el:GetAttribute("FigmaFall") or el:GetAttribute("FigmaFallVariant")) then
		watched[el].level = 2
		for _, prop in ipairs({ "Size", "ZIndex", "Image", "ImageColor3", "ImageTransparency" }) do
			if prop ~= "Image" and prop ~= "ImageColor3" and prop ~= "ImageTransparency" or el:IsA("ImageLabel") or el:IsA("ImageButton") then
				watched[el].hooks[#watched[el].hooks + 1] = el:GetPropertyChangedSignal(prop):Connect(function() queueRefresh() end)
			end
		end
		for _, key in ipairs(controls) do
			for _, prefix in ipairs({ "Fall", "FigmaFall" }) do
				watched[el].hooks[#watched[el].hooks + 1] = el:GetAttributeChangedSignal(prefix .. key):Connect(function() queueRefresh() end)
			end
		end
	end
end
local function signature(el)
	local out = { tostring(el.Parent), tostring(el.Size), tostring(el.ZIndex), tostring(el:GetAttribute("FigmaFallVariant")) }
	for _, key in ipairs(controls) do out[#out + 1] = tostring(attr(el, "Fall" .. key, -999)) end
	local list = { el }
	if el.Parent and el:GetAttribute("FigmaFallVariant") == 1 then
		for _, child in ipairs(el.Parent:GetChildren()) do
			if child ~= el and child:GetAttribute("FigmaFallVariant") then list[#list + 1] = child end
		end
	end
	for _, item in ipairs(list) do
		watch(item)
		out[#out + 1] = tostring(item)
		out[#out + 1] = tostring(item.Size)
		out[#out + 1] = tostring(item:GetAttribute("FigmaFallVariant"))
		out[#out + 1] = tostring(attr(item, "FallAspect", 0))
		if item:IsA("ImageLabel") or item:IsA("ImageButton") then
			out[#out + 1] = item.Image
			out[#out + 1] = tostring(item.ImageColor3)
			out[#out + 1] = tostring(item.ImageTransparency)
		end
	end
	return table.concat(out, "|")
end
local function disconnect(list)
	for _, hook in ipairs(list) do hook:Disconnect() end
end
local function syncRoots()
	local refs, nextRoots, seen = {}, {}, {}
	for _, child in ipairs(gui:GetChildren()) do
		if child:IsA("ObjectValue") then
			refs[child] = true
			if not references[child] then
				references[child] = {
					child:GetPropertyChangedSignal("Value"):Connect(function() queueRefresh() end),
					child:GetPropertyChangedSignal("Name"):Connect(function() queueRefresh() end),
				}
			end
		end
	end
	for ref, list in pairs(references) do
		if not refs[ref] then disconnect(list); references[ref] = nil end
	end
	for _, root in ipairs(fwRoots()) do
		if not seen[root] then seen[root] = true; nextRoots[#nextRoots + 1] = root end
	end
	roots = nextRoots
	for root, list in pairs(rootHooks) do
		if not seen[root] then disconnect(list); rootHooks[root] = nil end
