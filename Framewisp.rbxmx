end
local function wire(el)
	if not el:IsA("GuiObject") or not inside(el) then return end
	if not watched[el] then
		local hooks = {}
		watched[el] = hooks
		hooks[#hooks + 1] = el:GetAttributeChangedSignal("FigmaStroke"):Connect(function()
			if tagged(el) then
				task.defer(function() -- _flow first restores the design regardless of signal subscription order
					if stopped or not watched[el] or not tagged(el) or not inside(el) then return end
