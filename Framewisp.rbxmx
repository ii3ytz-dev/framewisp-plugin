local function classIcon(imageLabel, className)
	local ok, ci = pcall(function()
		return StudioService:GetClassIcon(className)
	end)
	if ok and ci and ci.Image then
		imageLabel.Image = ci.Image
		imageLabel.ImageRectOffset = ci.ImageRectOffset
		imageLabel.ImageRectSize = ci.ImageRectSize
		imageLabel.Visible = true
	else
		imageLabel.Visible = false
	end
end

