	if hasShiny and not screen:FindFirstChild("FramewispShine") then
	local shine = Instance.new("LocalScript")
	shine.Name = "FramewispShine"
	shine.Source = [==[
-- Framewisp: _shiny and _glint — your drawn shines in motion.
-- _shiny: sweeps across its parent in an endless loop, starting where you
--         placed it; after the whole formation leaves the right edge it
--         re-enters from the left.
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end

-- ========================== tune the feel here ==========================
-- SPEED — _shiny travel speed, in parent-widths per second.
--   0.4 = slow, luxurious   ·   1.2 = default   ·   3 = fast flicker
-- COOLDOWN — pause between _shiny sweeps, in seconds.
--   0 = continuous conveyor   ·   2 = default glint   ·   6 = rare tease
-- GLINT_SPEED — _glint sweep speed on hover, in parent-widths per second.
--   1 = calm   ·   1.8 = default   ·   3 = snappy
-- ========================================================================
local SPEED = 1.2
local COOLDOWN = 2
local GLINT_SPEED = 1.8

local loops, glints = {}, {}
local function collect(attr, store)
	for _, d in ipairs(fwAll()) do
		if d:GetAttribute(attr) and d:IsA("GuiObject") and d.Parent and d.Parent:IsA("GuiObject") then
			local parent = d.Parent
			parent.ClipsDescendants = true
			d.Visible = true
			local g = store[parent]
			if not g then
				g = { parent = parent, items = {}, off = 0, rest = 0, active = false,
					measured = false, minLeft = -2, maxRight = 2, pad = 0 } -- parked out until measured
				store[parent] = g
				parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() g.measured = false end)
			end
			g.items[#g.items + 1] = { el = d, x0 = d.Position.X.Scale, ox = d.Position.X.Offset }
			g.speed = g.speed or d:GetAttribute("ShineSpeed") or d:GetAttribute("FigmaShineSpeed")
				or d:GetAttribute("GlintSpeed") or d:GetAttribute("FigmaGlintSpeed")
			g.cd = g.cd or d:GetAttribute("ShineCooldown") or d:GetAttribute("FigmaShineCooldown")
		end
	end
end
collect("FigmaShiny", loops)
collect("FigmaGlint", glints)

local function measure(g) -- a tilted streak spans w*cos + h*sin, well past Size.X.Scale
	local pw, ph = g.parent.AbsoluteSize.X, g.parent.AbsoluteSize.Y
	if pw <= 0 then return false end
	local minLeft, maxRight = math.huge, -math.huge
	for _, it in ipairs(g.items) do
		local d = it.el
		if d.Parent then
			local aw, ah = d.AbsoluteSize.X, d.AbsoluteSize.Y
			if aw <= 0 then aw = math.abs(d.Size.X.Scale) * pw + d.Size.X.Offset end
			if ah <= 0 then ah = math.abs(d.Size.Y.Scale) * ph + d.Size.Y.Offset end
			local r = math.rad(d.Rotation or 0)
			local st = d:FindFirstChildOfClass("UIStroke")
			local edge = (st and st.Enabled ~= false and st.Thickness or 0) -- a stroke paints outside the box
			local reach = (math.abs(aw * math.cos(r)) + math.abs(ah * math.sin(r))) / 2 + edge
			local centre = it.x0 + it.ox / pw + (0.5 - d.AnchorPoint.X) * (aw / pw)
			minLeft = math.min(minLeft, centre - reach / pw)
			maxRight = math.max(maxRight, centre + reach / pw)
		end
	end
	if maxRight == -math.huge then return false end
	g.minLeft, g.maxRight, g.pad, g.measured = minLeft, maxRight, 1 / pw, true -- pad: one pixel of daylight
	return true
end

local function place(g)
	for _, it in ipairs(g.items) do
		local el = it.el
		if el.Parent then
			el.Position = UDim2.new(it.x0 + g.off, it.ox, el.Position.Y.Scale, el.Position.Y.Offset)
		end
	end
end

local function park(g) -- the whole formation out on the left, tilt and stroke included
	if not g.measured then measure(g) end
	g.off = -(g.maxRight + g.pad)
end

local list = {}
for _, g in pairs(loops) do list[#list + 1] = g end
local glist = {}
for parent, g in pairs(glints) do
	park(g)
	place(g)
	glist[#glist + 1] = g
	parent.MouseEnter:Connect(function()
		if not g.active then
			park(g)
			g.active = true
		end
	end)
end
if #list == 0 and #glist == 0 then return end

RunService.Heartbeat:Connect(function(dt)
	for _, g in ipairs(list) do
		if not g.measured and measure(g) and g.rest > 0 then park(g); place(g) end -- a resize moves "outside"
		if g.rest > 0 then
			g.rest = g.rest - dt
		else
			g.off = g.off + (g.speed or SPEED) * dt
			if g.minLeft + g.off > 1 + g.pad then
				park(g)
				g.rest = g.cd or COOLDOWN
			end
			place(g)
		end
	end
	for _, g in ipairs(glist) do
		if not g.measured and measure(g) and not g.active then park(g); place(g) end
		if g.active then
			g.off = g.off + (g.speed or GLINT_SPEED) * dt
			if g.minLeft + g.off > 1 + g.pad then
				park(g)
				g.active = false
			end
			place(g)
		end
	end
end)
