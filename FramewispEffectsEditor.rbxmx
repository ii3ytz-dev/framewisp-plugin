local previewBases = setmetatable({}, { __mode = "k" })
local previewArtifacts = setmetatable({}, { __mode = "k" })
local previewClock = 0

local function capture(object: GuiObject)
    if previewBases[object] then return previewBases[object] end
    local scale = object:FindFirstChild("FramewispEditorScale")
    if not scale then scale = new("UIScale", { Name = "FramewispEditorScale" }, object) end
    local colorProperty = (object:IsA("ImageLabel") or object:IsA("ImageButton")) and "ImageColor3" or (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) and "TextColor3" or "BackgroundColor3"
    local transparencyProperty = (object:IsA("ImageLabel") or object:IsA("ImageButton")) and "ImageTransparency" or (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) and "TextTransparency" or "BackgroundTransparency"
    local target: any = object
    previewBases[object] = { Position = object.Position, Rotation = object.Rotation, Size = object.Size, Scale = (scale :: UIScale).Scale, ColorProperty = colorProperty, Color = target[colorProperty], TransparencyProperty = transparencyProperty, Transparency = target[transparencyProperty] }
    return previewBases[object]
end

local function restorePreviews()
    for object, base in pairs(previewBases) do
        if object.Parent then
            object.Position = base.Position; object.Rotation = base.Rotation; object.Size = base.Size
            local target: any = object
            target[base.ColorProperty] = base.Color; target[base.TransparencyProperty] = base.Transparency
            local scale = object:FindFirstChild("FramewispEditorScale")
            if scale and scale:IsA("UIScale") then scale.Scale = base.Scale; scale:Destroy() end
        end
    end
    for artifact in pairs(previewArtifacts) do if artifact.Parent then artifact:Destroy() end end
    previewBases = setmetatable({}, { __mode = "k" })
    previewArtifacts = setmetatable({}, { __mode = "k" })
end

local function numberAttr(object: Instance, key: string, fallback: number): number
    return tonumber(object:GetAttribute(pascal(key)) or object:GetAttribute(key)) or fallback
end

local function hexColor(value: any, fallback: Color3): Color3
    if typeof(value) == "Color3" then return value end
    if typeof(value) ~= "string" then return fallback end
    local hex = string.gsub(value, "#", "")
    if #hex ~= 6 then return fallback end
    local number = tonumber(hex, 16); if not number then return fallback end
    return Color3.fromRGB(math.floor(number / 65536) % 256, math.floor(number / 256) % 256, number % 256)
end

local function activeTags(object: Instance): {[string]: boolean}
    local output = {}
    for _, tag in ipairs(decodeTags(object)) do output[tag] = true end
    return output
end

RunService.Heartbeat:Connect(function(delta)
    if not widget.Enabled or not previewEnabled then return end
    previewClock += delta
    for _, object in ipairs(selectedGui()) do
        local tags = activeTags(object)
        local base = capture(object)
        local scale = object:FindFirstChild("FramewispEditorScale") :: UIScale
        object.Rotation = base.Rotation
        object.Position = base.Position
        local target: any = object
        target[base.ColorProperty] = base.Color
        target[base.TransparencyProperty] = base.Transparency
        if tags._spin or tags._rays then
            local speed = tags._rays and numberAttr(object, "raysSpeed", 25) or numberAttr(object, "spinSpeed", 120)
            object.Rotation = base.Rotation + previewClock * speed
        elseif tags._jelly then
            object.Rotation = base.Rotation + math.sin(previewClock * math.pi * 2 * numberAttr(object, "jellySpeed", 1.2)) * numberAttr(object, "jellyAmp", 3)
        elseif tags._wiggle then
            object.Rotation = base.Rotation + math.sin(previewClock * math.pi * 4) * numberAttr(object, "wiggleAngle", 12)
        elseif tags._turn then object.Rotation = base.Rotation + numberAttr(object, "turnAngle", -5)
        elseif tags._tilt then object.Rotation = base.Rotation + numberAttr(object, "tiltY", -14) * .12 + numberAttr(object, "tiltX", 6) * .06
        elseif tags._3d then object.Rotation = base.Rotation + math.sin(previewClock * 1.5) * numberAttr(object, "tiltMax", 8) end
        if tags._float then
            local distance, speed = numberAttr(object, "floatDist", 8), numberAttr(object, "floatSpeed", .6)
            local angle = math.rad(numberAttr(object, "floatAngle", 0)); local value = math.sin(previewClock * math.pi * 2 * speed) * distance / 2
            object.Position = base.Position + UDim2.fromOffset(math.sin(angle) * value, -math.cos(angle) * value)
        elseif tags._drift then
            local distance = (previewClock * numberAttr(object, "driftSpeed", 40)) % math.max(20, object.AbsoluteSize.X)
            local angle = math.rad(numberAttr(object, "driftAngle", 270)); object.Position = base.Position + UDim2.fromOffset(math.sin(angle) * distance, -math.cos(angle) * distance)
        elseif tags._shake then
            local amplitude = numberAttr(object, "shakeAmp", 6); object.Position = base.Position + UDim2.fromOffset(math.sin(previewClock * 35) * amplitude, math.cos(previewClock * 41) * amplitude)
        elseif tags._up then object.Position = base.Position - UDim2.fromOffset(0, numberAttr(object, "upDist", 6)) end
        if tags._pulse or tags._rays then
            local amplitude = (tags._rays and numberAttr(object, "raysPulse", 6) or numberAttr(object, "pulseAmp", 5)) / 100
            scale.Scale = base.Scale * (1 + math.max(0, math.sin(previewClock * math.pi * 2 * numberAttr(object, "pulseSpeed", 1))) * amplitude)
        elseif tags._jelly then
            local wave = math.sin(previewClock * math.pi * 2 * numberAttr(object, "jellySpeed", 1.2))
            scale.Scale = base.Scale * (1 + wave * .02)
        elseif tags._smooth then scale.Scale = base.Scale * numberAttr(object, "hoverScale", 1.08)
        elseif tags._button then scale.Scale = base.Scale * numberAttr(object, "pressScale", .985)
        elseif tags._select then scale.Scale = base.Scale * numberAttr(object, "selectPop", 1.06)
        else scale.Scale = base.Scale end
        if tags._color then target[base.ColorProperty] = hexColor(object:GetAttribute("ColorPick") or object:GetAttribute("colorPick"), base.Color) end
        if tags._blink then
            local visibleFor, hiddenFor = numberAttr(object, "blinkOn", 1.2), numberAttr(object, "blinkOff", .8)
            target[base.TransparencyProperty] = (previewClock % math.max(.1, visibleFor + hiddenFor)) > visibleFor and 1 or base.Transparency
        end
        if tags._glow then
            local glow = object:FindFirstChild("FramewispEditorGlow")
            if not glow then glow = new("UIStroke", { Name = "FramewispEditorGlow", Color = Color3.new(1, 1, 1) }, object); previewArtifacts[glow] = true end
            if glow:IsA("UIStroke") then glow.Thickness = 1 + (1 + math.sin(previewClock * math.pi * 2 * numberAttr(object, "glowSpeed", .8))) * numberAttr(object, "glowSize", 12) / 8 end
        end
        if tags._flow or tags._stroke then
            local gradient = object:FindFirstChild("FramewispEditorGradient")
            if not gradient then gradient = new("UIGradient", { Name = "FramewispEditorGradient" }, object); previewArtifacts[gradient] = true end
            if gradient:IsA("UIGradient") then
                if tags._stroke and numberAttr(object, "strokeMode", 0) == 0 or tags._flow and numberAttr(object, "flowMove", 0) == 1 then
                    gradient.Rotation = previewClock * (tags._stroke and numberAttr(object, "strokeRotate", 45) or numberAttr(object, "flowRotate", 180))
                else
                    local angle = math.rad(tags._stroke and numberAttr(object, "strokeDirection", 0) or numberAttr(object, "flowDirection", 0))
                    local speed = tags._stroke and numberAttr(object, "strokeSpeed", .35) or numberAttr(object, "flowSpeed", .5)
                    gradient.Offset = Vector2.new(math.cos(angle), math.sin(angle)) * ((previewClock * speed) % 2 - 1)
                end
            end
        end
    end
end)

local function setStatus(message: string, color: Color3?)
    status.Text = message; status.TextColor3 = color or COLORS.muted
end

local function effectState(tag: string): (number, number)
    local selected = selectedGui(); local active = 0
    for _, object in ipairs(selected) do if hasTag(object, tag) then active += 1 end end
    return active, #selected
end

local function otherEffectUsesKey(object: Instance, exceptTag: string, key: string): boolean
    for _, effect in ipairs(effects) do
        if effect.tag ~= exceptTag and hasTag(object, effect.tag) then
            for _, control in ipairs(effect.controls) do if control.key == key then return true end end
        end
    end
    return false
end

local function toggleEffect(effect)
    local selected = selectedGui(); if #selected == 0 then setStatus("Select a GUI object first.", COLORS.red); return end
    restorePreviews()
    ensureGlobalRuntime()
    local active = effectState(effect.tag); local enable = active < #selected
    ChangeHistoryService:SetWaypoint("Before Framewisp effect")
    for _, object in ipairs(selected) do
        setTag(object, effect.tag, enable)
        if enable then
            for _, control in ipairs(effect.controls) do
                local key = pascal(control.key)
                if object:GetAttribute(key) == nil and object:GetAttribute(control.key) == nil then object:SetAttribute(key, control.defaultValue) end
            end
        else
            for _, control in ipairs(effect.controls) do
                if not otherEffectUsesKey(object, effect.tag, control.key) then object:SetAttribute(pascal(control.key), nil); object:SetAttribute(control.key, nil) end
            end
        end
    end
    ChangeHistoryService:SetWaypoint((enable and "Add " or "Remove ") .. effect.tag)
    setStatus((enable and "Added " or "Removed ") .. effect.tag .. " on " .. #selected .. " object(s).", enable and COLORS.green or COLORS.muted)
    renderEffects()
end

local function applyValue(control, value)
    local selected = selectedGui(); if #selected == 0 then return end
    ChangeHistoryService:SetWaypoint("Before Framewisp setting")
    for _, object in ipairs(selected) do object:SetAttribute(pascal(control.key), value) end
    ChangeHistoryService:SetWaypoint("Set " .. control.label)
    setStatus(control.label .. " updated on " .. #selected .. " object(s).", COLORS.green)
end

local function valueFor(control)
    local selected = selectedGui(); if #selected == 0 then return control.defaultValue end
    local value = selected[1]:GetAttribute(pascal(control.key))
    if value == nil then value = selected[1]:GetAttribute(control.key) end
    return value == nil and control.defaultValue or value
end

local function previewOnce(effect)
    local selected = selectedGui(); if #selected == 0 then setStatus("Select a GUI object first.", COLORS.red); return end
    previewEnabled = true; previewButton.Text = "Preview: ON"
    for _, object in ipairs(selected) do
        local base = capture(object); local scale = object:FindFirstChild("FramewispEditorScale") :: UIScale
        if effect.tag == "_pop" or effect.tag == "_reveal" or effect.tag == "_swing" then
            scale.Scale = numberAttr(object, effect.tag == "_pop" and "popFrom" or effect.tag == "_reveal" and "revealFrom" or "swingFrom", .6)
            TweenService:Create(scale, TweenInfo.new(numberAttr(object, effect.tag == "_pop" and "popTime" or effect.tag == "_reveal" and "revealTime" or "swingTime", .5), Enum.EasingStyle.Back), { Scale = base.Scale }):Play()
        elseif effect.tag == "_drop" then
            object.Position = base.Position - UDim2.fromOffset(0, numberAttr(object, "dropHeight", 160))
            TweenService:Create(object, TweenInfo.new(numberAttr(object, "dropTime", .6), Enum.EasingStyle.Bounce), { Position = base.Position }):Play()
        elseif effect.tag == "_shake" then
            task.spawn(function() local started=time(); while object.Parent and time()-started<.5 do object.Position=base.Position+UDim2.fromOffset(math.random(-6,6),math.random(-6,6)); task.wait() end; if object.Parent then object.Position=base.Position end end)
        elseif effect.tag == "_wiggle" then
            task.spawn(function() local started=time(); while object.Parent and time()-started<.65 do local elapsed=time()-started;object.Rotation=base.Rotation+math.sin(elapsed*math.pi*8)*numberAttr(object,"wiggleAngle",12)*(1-elapsed/.65);task.wait() end;if object.Parent then object.Rotation=base.Rotation end end)
        else
            scale.Scale = base.Scale * 1.08
            TweenService:Create(scale, TweenInfo.new(.32, Enum.EasingStyle.Back), { Scale = base.Scale }):Play()
        end
    end
    setStatus("Previewed " .. effect.tag .. ".", COLORS.accent)
end

local function controlRow(parent: Instance, control)
    local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 31) }, parent) :: Frame
    new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(.57, -4, 1, 0), Font = Enum.Font.Gotham, Text = control.label, TextColor3 = COLORS.muted, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
    local kind = control.kind or "range"
    if kind == "toggle" then
        local value = valueFor(control) == true
        local button = new("TextButton", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.fromScale(1, .5), Size = UDim2.fromOffset(78, 25), BackgroundColor3 = value and COLORS.accentDark or COLORS.raised, BorderSizePixel = 0, Font = Enum.Font.GothamBold, Text = value and "ON" or "OFF", TextColor3 = value and COLORS.accent or COLORS.muted, TextSize = 10, AutoButtonColor = false }, row) :: TextButton
        corner(button, 6); button.Activated:Connect(function() applyValue(control, not value); renderEffects() end)
    elseif kind == "select" then
        local options = control.options or {}; local current = valueFor(control); local index = 1
        for candidate, option in ipairs(options) do if option.value == current then index = candidate end end
        local button = new("TextButton", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.fromScale(1, .5), Size = UDim2.fromOffset(128, 25), BackgroundColor3 = COLORS.raised, BorderSizePixel = 0, Font = Enum.Font.Gotham, Text = options[index] and options[index].label or tostring(current), TextColor3 = COLORS.text, TextSize = 10, AutoButtonColor = false }, row) :: TextButton
        corner(button, 6); button.Activated:Connect(function() index = index % math.max(1, #options) + 1; if options[index] then applyValue(control, options[index].value) end; renderEffects() end)
    else
        local box = new("TextBox", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.fromScale(1, .5), Size = UDim2.fromOffset(128, 25), BackgroundColor3 = COLORS.raised, BorderSizePixel = 0, ClearTextOnFocus = false, Font = Enum.Font.Code, Text = tostring(valueFor(control)), TextColor3 = COLORS.text, TextSize = 10 }, row) :: TextBox
        corner(box, 6)
        box.FocusLost:Connect(function()
            local value: any = box.Text
            if kind == "range" or kind == "angle" then
                value = tonumber(box.Text)
                if value == nil then box.Text = tostring(valueFor(control)); return end
                if control.min then value = math.max(control.min, value) end
                if control.max then value = math.min(control.max, value) end
            end
            applyValue(control, value); box.Text = tostring(value)
        end)
    end
end

renderEffects = function()
    if rendering then return end; rendering = true
    for _, child in ipairs(list:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
    local query = string.lower(search.Text); local category = categories[categoryIndex]; local order = 0
    for _, effect in ipairs(effects) do
        local pretty = string.gsub(string.sub(effect.tag, 2), "(%l)(%u)", "%1 %2")
        local matchesSearch = query == "" or string.find(string.lower(effect.tag .. " " .. pretty .. " " .. (effect.description or "")), query, 1, true) ~= nil
        local matchesCategory = category == "All" or categoryTags[category] and categoryTags[category][effect.tag]
        if matchesSearch and matchesCategory then
            order += 1
            local active, total = effectState(effect.tag); local expanded = expandedTag == effect.tag
            local height = expanded and (122 + #effect.controls * 31) or 48
            local card = new("Frame", { AutomaticSize = Enum.AutomaticSize.None, BackgroundColor3 = COLORS.card, BorderSizePixel = 0, Size = UDim2.new(1, -2, 0, height), LayoutOrder = order }, list) :: Frame
            corner(card, 8); stroke(card, active > 0 and COLORS.accent or COLORS.border, active > 0 and .1 or .3)
            local title = new("TextButton", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -126, 0, 40), Font = Enum.Font.GothamBold, Text = (expanded and "▾  " or "▸  ") .. effect.tag, TextColor3 = active > 0 and COLORS.accent or COLORS.text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false }, card) :: TextButton
            local stateText = total == 0 and "ADD" or active == total and "REMOVE" or active > 0 and "ADD ALL" or "ADD"
            local add = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(72, 28), BackgroundColor3 = active == total and total > 0 and Color3.fromRGB(78, 39, 52) or COLORS.accentDark, BorderSizePixel = 0, Font = Enum.Font.GothamBold, Text = stateText, TextColor3 = active == total and total > 0 and COLORS.red or COLORS.accent, TextSize = 9, AutoButtonColor = false }, card) :: TextButton
            corner(add, 6); add.Activated:Connect(function() toggleEffect(effect) end)
            title.Activated:Connect(function() expandedTag = expanded and nil or effect.tag; renderEffects() end)
            if expanded then
                local preview = new("TextButton", { Position = UDim2.fromOffset(10, 43), Size = UDim2.fromOffset(76, 24), BackgroundColor3 = COLORS.raised, BorderSizePixel = 0, Font = Enum.Font.GothamBold, Text = "PREVIEW", TextColor3 = COLORS.muted, TextSize = 9, AutoButtonColor = false }, card) :: TextButton
                corner(preview, 5); preview.Activated:Connect(function() previewOnce(effect) end)
                new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(96, 43), Size = UDim2.new(1, -106, 0, 43), Font = Enum.Font.Gotham, Text = effect.description or "", TextColor3 = COLORS.muted, TextSize = 10, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top }, card)
                local controls = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 92), Size = UDim2.new(1, -20, 0, #effect.controls * 31) }, card) :: Frame
                new("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder }, controls)
                for _, control in ipairs(effect.controls) do controlRow(controls, control) end
            end
        end
    end
    rendering = false
end

local function refreshSelection()
    restorePreviews()
    local selected = selectedGui()
    if #selected == 0 then selectedTitle.Text = "No UI selected"; selectedDetail.Text = "Choose one or more GUI objects in Explorer."
    elseif #selected == 1 then selectedTitle.Text = selected[1].Name; selectedDetail.Text = selected[1].ClassName .. " · " .. #decodeTags(selected[1]) .. " active Framewisp tag(s)"
    else selectedTitle.Text = tostring(#selected) .. " UI objects selected"; selectedDetail.Text = "Changes apply to every selected GUI object." end
    renderEffects()
end

toolbarButton.Click:Connect(function() widget.Enabled = not widget.Enabled end)
widget:GetPropertyChangedSignal("Enabled"):Connect(function() if widget.Enabled then ensureGlobalRuntime(); refreshSelection() else restorePreviews() end end)
Selection.SelectionChanged:Connect(refreshSelection)
search:GetPropertyChangedSignal("Text"):Connect(renderEffects)
categoryButton.Activated:Connect(function() categoryIndex = categoryIndex % #categories + 1; categoryButton.Text = categories[categoryIndex] .. " ▾"; renderEffects() end)
previewButton.Activated:Connect(function() previewEnabled = not previewEnabled; previewButton.Text = previewEnabled and "Preview: ON" or "Preview: OFF"; if not previewEnabled then restorePreviews() end end)

ensureGlobalRuntime()
refreshSelection()
]]></ProtectedString><string name="Name">FramewispEffectsEditor</string><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content></Properties></Item></roblox>