<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Script" referent="RBXB6939A8962E74E209DF8A8FC7E3E1766">
		<Properties>
			<ProtectedString name="Source"><![CDATA[--[[
	Framewisp — thin Studio importer (v2).
	Fetches a finished blueprint from the backend by import code and builds it
	VERBATIM. All conversion decisions (class, fonts, colours, layout) were made
	server-side; this plugin just constructs instances. Requires HttpService
	("Allow HTTP Requests" in Game Settings › Security).
]]

-- This file is a PLUGIN. Pasted into a game Script it would still run: the
-- self-heal pass would re-scale every imported GUI against a server with no
-- camera (viewport 1x1) and squash the layout, and the toolbar call would throw.
-- One line stops all of that.
if not plugin then
	warn("[Framewisp] This is the Framewisp plugin source. Install it as a Studio plugin (Plugins folder / Marketplace) — running it as a game script does nothing and can rescale imported UI. Ignoring.")
	return
end

local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local Selection = game:GetService("Selection")

local BACKEND_URL = "https://api.framewisp.com" -- prod; local dev: http://localhost:8790
local FW_BUILD = "4.5.1 · 2026-10-03 · no-studio-capture"
local TEXT_SIZE_FACTOR = 1.16 -- matches the old plugin exactly
-- Where each bundled font's baseline sits inside the line box Roblox draws, as a
-- fraction of that box: hhea.ascent / (ascent - descent), read straight from the
-- TTFs Studio ships (see scripts in the repo). Verified twice over: Montserrat
-- computes 0.7941 against the hand-measured 0.794 of the EQUIP case, and
-- PressStart2P's 0.8189 lands the pixel-font shop exactly (the hand-measured
-- 0.74 it replaces sat every label ~0.08 em low). A family not listed falls back
-- to the design font's own metric.
-- TextSize per design em for each bundled face: (hhea.ascent - hhea.descent) /
-- unitsPerEm, read from the TTFs Studio ships — TextSize is the height of that box.
-- A label that cannot be sized by its width (rich, wrapped, bound, rewritten) is
-- sized by its em through this: the flat 1.16 it replaces drew Titillium 31% and
-- Oswald 28% smaller than the design and Press Start 2P 37% smaller.
-- One face is NOT the file Figma draws with: Roblox's Press Start 2P advances
-- 572/1024 em per glyph, Google's (Figma's) a full em — 1.790x wider, the same
-- ratio in all 266 labels of 485 live imports (26.09.2026; every other face
-- matched within 1-2%). So its entry is 1.0244 x 1.790, not the bare hhea box.
