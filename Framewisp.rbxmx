	"FramewispUITools4",
	DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, false, 340, 620, 280, 360)
)
toolsWidget.Title = "Framewisp v4.5 — UI Tools"

local tbg = Instance.new("Frame")
tbg.Size = UDim2.fromScale(1, 1)
tbg.BackgroundColor3 = COL.bg
tbg.BorderSizePixel = 0
tbg.Parent = toolsWidget
tbg.ClipsDescendants = true

local tscroll = Instance.new("ScrollingFrame")
tscroll.Size = UDim2.fromScale(1, 1)
tscroll.BackgroundTransparency = 1
tscroll.BorderSizePixel = 0
tscroll.CanvasSize = UDim2.new()
tscroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
tscroll.ScrollingDirection = Enum.ScrollingDirection.Y
tscroll.ScrollBarThickness = 3
tscroll.ScrollBarImageColor3 = COL.stroke
tscroll.ZIndex = 2
tscroll.Parent = tbg

-- everything lives in `tcontent`, scaled by a UIScale that tracks the widget
-- width, so the whole panel compresses/grows with the dock size (like Kekui).
local DESIGN_W = 336
local tcontent = Instance.new("Frame")
tcontent.Name = "Content"
tcontent.AnchorPoint = Vector2.new(0.5, 0)
tcontent.Position = UDim2.fromScale(0.5, 0)
tcontent.Size = UDim2.new(0, DESIGN_W, 0, 0)
tcontent.AutomaticSize = Enum.AutomaticSize.Y
tcontent.BackgroundTransparency = 1
tcontent.Parent = tscroll

local uiScale = Instance.new("UIScale")
uiScale.Parent = tcontent
local function fitScale()
	local w = tscroll.AbsoluteSize.X
	if w < 1 then return end
	local s = math.clamp(w / DESIGN_W, 0.86, 1.15)
	uiScale.Scale = s
	-- logical width chosen so the SCALED content fills the dock EXACTLY at any
	-- size — never cut off, never off-centre (w/s * s == w)
	tcontent.Size = UDim2.new(0, w / s, 0, 0)
end
tscroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitScale)
task.defer(fitScale)

local tpad = Instance.new("UIPadding")
tpad.PaddingTop = UDim.new(0, 14)
tpad.PaddingBottom = UDim.new(0, 14)
tpad.PaddingLeft = UDim.new(0, 14)
tpad.PaddingRight = UDim.new(0, 14)
tpad.Parent = tcontent

local tvlist = Instance.new("UIListLayout")
