	do
		dropIfOurs(screen, "FramewispBurst", 2)
	end
	if hasBurst and not screen:FindFirstChild("FramewispBurst") then
	local burst = Instance.new("LocalScript")
	burst.Name = "FramewispBurst"
	-- _burst: the particles draw UNDER the button and OVER the card it sits on — a
	-- layer one ZIndex step below the button in the button's own parent. The
	-- conversion leaves that odd step free under every layer (restack), so the order
	-- holds in Sibling and Global mode alike. A parent that lays its children out
	-- would take the layer for one of its items, so the layer climbs to the first
	-- parent nothing lays out and sits under the whole row. Built lazily on the first
	-- press: by then the other runtimes have finished slotting buttons into wrappers.
	-- Every particle: out along its own ray with an ease-out, a quick pop in, then a
	-- fade that always ends fully transparent (and a shrink, when asked for).
	burst.Source = [==[
-- Framewisp: _burst — particles fly out of a button on every press.
-- Count, time in the air, reach, start transparency, size, spin and colour come
-- from the plugin; a Studio attribute without the Figma prefix wins (BurstCount,
-- BurstTime, BurstDist, BurstAlpha, BurstSize, BurstSizeMax, BurstShrink,
-- BurstSpin, BurstSpinSpeed, BurstColor). Fire one from your own code with
--   button:SetAttribute("Burst", (button:GetAttribute("Burst") or 0) + 1)
-- Safe to delete: the button keeps working, it only stops throwing particles.
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end

local MAX_LIVE = 240 -- every particle on screen at once, all buttons together
local live = {}
local spare = { dot = {}, img = {} }
local layers = {}
local conn = nil

local function num(el, manual, auto, def, lo, hi)
	local v = el:GetAttribute(manual)
	if type(v) ~= "number" then v = el:GetAttribute(auto) end
	if type(v) ~= "number" or v ~= v then v = def end
	if lo and v < lo then v = lo end
	if hi and v > hi then v = hi end
	return v
end

local function rgb(n)
	n = math.floor(n)
	return Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
end

local function laidOut(p)
	return p ~= nil and (p:FindFirstChildWhichIsA("UIGridLayout") ~= nil or p:FindFirstChildWhichIsA("UIListLayout") ~= nil
		or p:FindFirstChildWhichIsA("UITableLayout") ~= nil or p:FindFirstChildWhichIsA("UIPageLayout") ~= nil)
end

local function shown(el)
	local n = el
	while n and n:IsA("GuiObject") do
		if not n.Visible then return false end
		n = n.Parent
	end
	return true
end

local function anchorOf(el) -- the first ancestor whose parent does NOT lay its children out
	local a = el
	while a.Parent and a.Parent:IsA("GuiObject") and laidOut(a.Parent) do a = a.Parent end
	return a
end

local function layerFor(el)
	local anchor = anchorOf(el)
	local host = anchor.Parent
	if not host or laidOut(host) then return nil end
	local layer = layers[el]
	if not (layer and layer.Parent == host) then
		if layer then layer:Destroy() end
		layer = Instance.new("Frame")
		layer.Name = el.Name .. "_Burst"
		layer.BackgroundTransparency = 1
		layer.BorderSizePixel = 0
		layer.ClipsDescendants = false
		layer.Active = false
		layer.Selectable = false
		layer:SetAttribute("FW_Owned", true)
		layer:SetAttribute("FW_BurstLayer", true)
		layer.Parent = host
		layers[el] = layer
	end
	layer.ZIndex = anchor.ZIndex - 1 -- under the button, over the card: the odd step the import leaves free
	return layer
end

local function cover(layer, el) -- the layer takes the button's box, rotation included
	local host = layer.Parent
	if el.Parent == host then -- same parent: copy the geometry
		layer.AnchorPoint = el.AnchorPoint
		layer.Position = el.Position
		layer.Size = el.Size
		layer.Rotation = el.Rotation
		return true
	end
	local hp, hs = host.AbsolutePosition, host.AbsoluteSize -- in a laid-out row: measured on screen
	if host:IsA("ScrollingFrame") then
		local cs = host.AbsoluteCanvasSize
		if cs and cs.X > 0 and cs.Y > 0 then hp = hp - host.CanvasPosition; hs = cs end
	end
	if not hs or hs.X < 1 or hs.Y < 1 then return false end
	local ep, es = el.AbsolutePosition, el.AbsoluteSize
	layer.AnchorPoint = Vector2.new(0, 0)
	layer.Rotation = 0
	layer.Position = UDim2.fromScale((ep.X - hp.X) / hs.X, (ep.Y - hp.Y) / hs.Y)
	layer.Size = UDim2.fromScale(es.X / hs.X, es.Y / hs.Y)
	return true
end

local function template(el) -- the picture uploaded in the plugin; nil = circles
	for _, c in ipairs(el:GetChildren()) do
		if c:IsA("ImageLabel") and c:GetAttribute("FigmaBurstImg") and c.Image ~= "" then return c end
	end
	return nil
end

local function take(tpl)
	local kind = tpl and "img" or "dot"
	local p = table.remove(spare[kind])
	if not p then
		if tpl then
			p = Instance.new("ImageLabel")
			p.BackgroundTransparency = 1
			p.ScaleType = Enum.ScaleType.Fit
		else
			p = Instance.new("Frame")
			p.BorderSizePixel = 0
			local round = Instance.new("UICorner")
			round.CornerRadius = UDim.new(0.5, 0)
			round.Parent = p
		end
		p.Name = "BurstBit"
		p.AnchorPoint = Vector2.new(0.5, 0.5)
		p.Active = false
		p:SetAttribute("FW_Owned", true)
	end
	if tpl then
		p.Image = tpl.Image
		p.ImageRectOffset = tpl.ImageRectOffset
		p.ImageRectSize = tpl.ImageRectSize
	end
	return p, kind
end

local function give(b)
	b.p.Parent = nil
	local pool = spare[b.kind]
	if #pool < MAX_LIVE then pool[#pool + 1] = b.p else b.p:Destroy() end
end

local function paint(b)
	local p = math.min(1, math.max(0, b.t) / b.life)
	local e = 1 - (1 - p) ^ 3 -- out fast, lands soft
	local x = b.x0 + (b.x1 - b.x0) * e
	local y = b.y0 + (b.y1 - b.y0) * e
	local g = p < 0.12 and (0.35 + 0.65 * (p / 0.12)) or 1 -- pops in
	if b.shrink and p > 0.12 then g = math.max(0, 1 - ((p - 0.12) / 0.88) ^ 2) end
	local f = p <= 0.4 and 0 or ((p - 0.4) / 0.6) ^ 1.5 -- always fades out to nothing
	local tr = b.a0 + (1 - b.a0) * f
	if b.t < 0 then tr = 1 end -- still waiting for its turn
	local s = b.size * g
	b.p.Position = UDim2.fromScale(x / b.W, y / b.H)
	b.p.Size = UDim2.fromScale(s / b.W, s / b.H)
	b.p.Rotation = b.rot0 + b.spin * b.t
	if b.kind == "img" then b.p.ImageTransparency = tr else b.p.BackgroundTransparency = tr end
end

local function step(dt)
	for i = #live, 1, -1 do
		local b = live[i]
		b.t = b.t + dt
		if b.t >= b.life or not b.layer.Parent or b.p.Parent ~= b.layer then
			table.remove(live, i)
			give(b)
		else
			paint(b)
		end
	end
	if #live == 0 and conn then
		conn:Disconnect()
		conn = nil
	end
end

local function emit(el)
	if not shown(el) then return end
	local layer = layerFor(el)
	if not layer or not cover(layer, el) then return end
	local W, H = el.AbsoluteSize.X, el.AbsoluteSize.Y
	if W < 1 or H < 1 then return end
	local k = W / num(el, "FigmaBurstW", "FigmaBurstW", W, 1) -- screen px per design px
	local count = math.floor(num(el, "BurstCount", "FigmaBurstCount", 12, 1, 200) + 0.5)
	local life = num(el, "BurstTime", "FigmaBurstTime", 0.6, 0.05, 10)
	local reach = num(el, "BurstDist", "FigmaBurstDist", 0.6, 0, 10) * math.min(W, H)
	local a0 = num(el, "BurstAlpha", "FigmaBurstAlpha", 0, 0, 0.95)
	local sMin = num(el, "BurstSize", "FigmaBurstSize", 12, 1, 500)
	local sMax = math.max(sMin, num(el, "BurstSizeMax", "FigmaBurstSizeMax", 12, 1, 500))
	local shrink = num(el, "BurstShrink", "FigmaBurstShrink", 1, 0, 1) >= 0.5
	local spin = 0
	if num(el, "BurstSpin", "FigmaBurstSpin", 0, 0, 1) >= 0.5 then
		spin = num(el, "BurstSpinSpeed", "FigmaBurstSpinSpeed", 360, 0, 3600)
	end
	local colour = rgb(num(el, "BurstColor", "FigmaBurstColor", 16777215, 0, 16777215))
	local scatter = num(el, "BurstRandom", "FigmaBurstRandom", 0, 0, 1) >= 0.5 -- random points on the edge
	local tpl = template(el)
	local phase = math.random() * math.pi * 2
	for i = 1, count do
		if #live >= MAX_LIVE then break end
		local x0, y0, x1, y1, wait = 0, 0, 0, 0, 0
		if scatter then
			local per = 2 * (W + H)
			local r = math.random() * per
			local ex, ey, nx, ny
			if r < W then ex, ey, nx, ny = r, 0, 0, -1
			elseif r < W + H then ex, ey, nx, ny = W, r - W, 1, 0
			elseif r < 2 * W + H then ex, ey, nx, ny = W - (r - W - H), H, 0, 1
			else ex, ey, nx, ny = 0, H - (r - 2 * W - H), -1, 0 end
			local tilt = (math.random() - 0.5) * 1.4 -- up to ±40° off the edge's normal
			local sdx = nx * math.cos(tilt) - ny * math.sin(tilt)
			local sdy = nx * math.sin(tilt) + ny * math.cos(tilt)
			local inset = 0.06 * math.min(W, H)
			local len = inset + reach * (0.7 + math.random() * 0.6)
			x0, y0 = ex - nx * inset, ey - ny * inset
			x1, y1 = x0 + sdx * len, y0 + sdy * len
			if i > math.ceil(count * 0.35) then wait = math.random() * 0.25 * life end -- a third at once, the rest trickle
		else
			local th = phase + (i - 1 + math.random() * 0.6) / count * math.pi * 2
			local dx, dy = math.cos(th), math.sin(th)
			local edge = math.min((W / 2) / math.max(1e-6, math.abs(dx)), (H / 2) / math.max(1e-6, math.abs(dy)))
			local r0, r1 = edge * 0.8, edge + reach * (0.7 + math.random() * 0.6) -- born under the edge, out past it
			x0, y0 = W / 2 + dx * r0, H / 2 + dy * r0
			x1, y1 = W / 2 + dx * r1, H / 2 + dy * r1
		end
		local p, kind = take(tpl)
		if kind == "img" then p.ImageColor3 = colour else p.BackgroundColor3 = colour end
		p.ZIndex = layer.ZIndex
		local b = {
			p = p, kind = kind, layer = layer, W = W, H = H, t = -wait,
			life = life * (0.85 + math.random() * 0.3),
			x0 = x0, y0 = y0, x1 = x1, y1 = y1,
			size = (sMin + (sMax - sMin) * math.random()) * k,
			a0 = a0, shrink = shrink,
			rot0 = kind == "img" and math.random() * 360 or 0,
			spin = spin * (math.random() < 0.5 and -1 or 1) * (0.7 + math.random() * 0.6),
		}
		paint(b)
		p.Parent = layer
		live[#live + 1] = b
	end
	if not conn and #live > 0 then conn = RunService.Heartbeat:Connect(step) end
end

local count = 0
for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaBurst") and d:IsA("GuiObject") and not d:GetAttribute("FW_BurstWired") then
		d:SetAttribute("FW_BurstWired", true)
		local fire = function() emit(d) end
		local btn = d:IsA("GuiButton") and d or d:FindFirstAncestorWhichIsA("GuiButton")
		if btn then
			btn.Activated:Connect(fire)
		else
			d.InputBegan:Connect(function(input)
				local t = input.UserInputType
				if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then fire() end
			end)
		end
		d:GetAttributeChangedSignal("Burst"):Connect(fire)
		count = count + 1
	end
end
if count > 0 then
	local okv, v = pcall(function() return script:GetAttribute("FWv") end)
	print(("[Framewisp] _burst v%s: %d button%s throw particles on press"):format(tostring(okv and v or "?"), count, count == 1 and "" or "s"))
end
