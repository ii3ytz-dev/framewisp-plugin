end

local function collect(root)
	local parts = {}
	local function add(inst)
		local props = FADE_PROPS[inst.ClassName]
		if not props then return end
		for _, prop in ipairs(props) do
			local ok, rest = pcall(function() return inst[prop] end)
			if ok and type(rest) == "number" then
				parts[#parts + 1] = { inst = inst, prop = prop, rest = rest }
			end
		end
	end
	add(root)
	local function under(inst) -- an arrow or a card shows and hides itself: never faded from here
		for _, c in ipairs(inst:GetChildren()) do
			if not (c:GetAttribute("FigmaPointer") or c:GetAttribute("FigmaCard")) then add(c); under(c) end
		end
	end
	under(root)
	return parts
end

local function shown(el) -- a panel that _open shows flips ITS Visible, never the layer's
	local n = el
	while n and n:IsA("GuiObject") do
		if not n.Visible then return false end
		n = n.Parent
	end
	return true
end

local function hide(t)
	for _, part in ipairs(t.parts) do
		if part.inst.Parent then pcall(function() part.inst[part.prop] = 1 end) end
	end
end

local function play(t)
	t.gen = (t.gen or 0) + 1
	local gen, el = t.gen, t.el
	hide(t)
	task.spawn(function()
		local wait0 = math.max(0, num(el, "FadeinDelay", "FigmaFadeinDelay", 0))
		if wait0 > 0 then task.wait(wait0) end
		if t.gen ~= gen or not el.Parent then return end -- hidden again mid-delay: that run is stale
		local secs = math.max(0.02, num(el, "FadeinTime", "FigmaFadeinTime", 0.35))
		local info = TweenInfo.new(secs, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		for _, part in ipairs(t.parts) do
			if part.inst.Parent then
				TweenService:Create(part.inst, info, { [part.prop] = part.rest }):Play()
			end
		end
	end)
end

local targets = {}
for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaFadein") and d:IsA("GuiObject") then
		targets[#targets + 1] = { el = d, parts = collect(d) }
	end
end
if #targets == 0 then return end

for _, t in ipairs(targets) do
	t.was = shown(t.el)
	local n = t.el
	while n and n:IsA("GuiObject") do
		n:GetPropertyChangedSignal("Visible"):Connect(function()
			local now = shown(t.el)
			if now and not t.was then play(t) end
			t.was = now
		end)
		n = n.Parent
	end
	if t.was then play(t) else hide(t) end
end
