        shadow.Name = "FramewispShadow"; shadow:SetAttribute("FWTags", "[]"); shadow.Active = false
        shadow.Position = object.Position + UDim2.fromOffset(tonumber(ctx:attr(object, "shadowX", 0)) or 0, tonumber(ctx:attr(object, "shadowY", 8)) or 8)
        local spread = tonumber(ctx:attr(object, "shadowSpread", 0)) or 0
