-- Framewisp: _stroke animates only the UIGradient inside an existing UIStroke.
-- StrokeMode: 0 Rotation (default), 1 Offset. Only the selected channel moves.
-- StrokeAngle / StrokeRotate: initial angle and signed degrees per second.
-- StrokeDirection: travel heading (0 right, 90 down); StrokeSpeed: cycles/sec.
-- Offset translates a mirrored period of the source colors and opacity continuously.
-- StrokeStretch: gradient width (0.5..4); StrokePhase: 0..1 of the mirrored period.
-- Dense sources simplify once per stretch to fit Roblox's 20-key sequence limit.
-- StrokeOffsetX/Y: the gradient's resting Offset, in native normalized units.
-- Manual Stroke* attributes override exported FigmaStroke*. Fill stays untouched.
local RunService = game:GetService("RunService")
local gui = script.Parent
local roots = { gui }
for _, v in ipairs(gui:GetChildren()) do
	if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
		roots[#roots + 1] = v.Value
	end
end
local function number(el, key, fallback, lo, hi)
	local v = el:GetAttribute(key)
	if type(v) ~= "number" or v ~= v or math.abs(v) == math.huge then v = el:GetAttribute("Figma" .. key) end
	if type(v) ~= "number" or v ~= v or math.abs(v) == math.huge then return fallback end
	return math.clamp(v, lo, hi)
end
local function tagged(el)
	local value = el:GetAttribute("FigmaStroke")
	return value ~= nil and value ~= false and value ~= 0
end
local function inside(el)
	for _, root in ipairs(roots) do
		if el == root or el:IsDescendantOf(root) then return true end
	end
	return false
end
local function visible(el)
	local p = el
	while p do
		if p:IsA("GuiObject") and not p.Visible then return false end
		if (p:IsA("ScreenGui") or p:IsA("SurfaceGui") or p:IsA("BillboardGui")) and not p.Enabled then return false end
		p = p.Parent
	end
	return true
end
local function reduced(el)
	local p = el
	while p do
