local COLORS = {
    bg = Color3.fromRGB(14, 10, 22),
    card = Color3.fromRGB(27, 20, 39),
    raised = Color3.fromRGB(39, 29, 53),
    border = Color3.fromRGB(68, 52, 86),
    text = Color3.fromRGB(247, 243, 252),
    muted = Color3.fromRGB(177, 165, 190),
    accent = Color3.fromRGB(197, 161, 237),
    accentDark = Color3.fromRGB(80, 56, 103),
    green = Color3.fromRGB(86, 210, 143),
    red = Color3.fromRGB(240, 119, 137),
}

local function new(className: string, properties: {[string]: any}?, parent: Instance?): Instance
    local instance = Instance.new(className)
    if properties then
        for key, value in pairs(properties) do
            local target: any = instance
            target[key] = value
        end
    end
    if parent then instance.Parent = parent end
    return instance
end

local function corner(object: Instance, radius: number?)
    new("UICorner", { CornerRadius = UDim.new(0, radius or 7) }, object)
end

local function stroke(object: Instance, color: Color3?, transparency: number?)
    new("UIStroke", { Color = color or COLORS.border, Transparency = transparency or 0, Thickness = 1 }, object)
end

local function pascal(key: string): string
    return string.upper(string.sub(key, 1, 1)) .. string.sub(key, 2)
end

local function decodeTags(object: Instance): {string}
    local ok, value = pcall(function() return HttpService:JSONDecode(object:GetAttribute("FWTags") or "[]") end)
    return ok and type(value) == "table" and value or {}
end

local function hasTag(object: Instance, tag: string): boolean
    for _, value in ipairs(decodeTags(object)) do if value == tag then return true end end
    return false
end

local function setTag(object: Instance, tag: string, enabled: boolean)
    local tags = decodeTags(object)
    local output, found = {}, false
    for _, value in ipairs(tags) do
        if value == tag then found = true elseif not table.find(output, value) then table.insert(output, value) end
    end
    if enabled and not found then table.insert(output, tag) end
    object:SetAttribute("FWTags", HttpService:JSONEncode(output))
end

local function selectedGui(): {GuiObject}
    local result = {}
    for _, object in ipairs(Selection:Get()) do if object:IsA("GuiObject") then table.insert(result, object) end end
    return result
end

local function ensureGlobalRuntime()
    local folder = ReplicatedStorage:FindFirstChild("FramewispEffects")
    if folder and not folder:IsA("Folder") then folder:Destroy(); folder = nil end
    if not folder then folder = new("Folder", { Name = "FramewispEffects" }, ReplicatedStorage) end
    folder:SetAttribute("FWGenerated", true)
    local expected = {}
    for name, source in pairs(runtimeModules) do
        expected[name] = true
        local module = folder:FindFirstChild(name)
        if module and not module:IsA("ModuleScript") then module:Destroy(); module = nil end
        if not module then module = new("ModuleScript", { Name = name }, folder) end
        module:SetAttribute("FWGenerated", true)
        pcall(function() (module :: ModuleScript).Source = source end)
    end
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("ModuleScript") and child:GetAttribute("FWGenerated") and not expected[child.Name] then child:Destroy() end
    end
    local scripts = StarterPlayer:FindFirstChildOfClass("StarterPlayerScripts")
    if not scripts then scripts = new("StarterPlayerScripts", { Name = "StarterPlayerScripts" }, StarterPlayer) end
    local runtime = scripts:FindFirstChild("FramewispRuntime")
    if runtime and not runtime:IsA("LocalScript") then runtime:Destroy(); runtime = nil end
    if not runtime then runtime = new("LocalScript", { Name = "FramewispRuntime" }, scripts) end
    runtime:SetAttribute("FWGenerated", true)
    pcall(function() (runtime :: LocalScript).Source = runtimeSource end)
end

