	local host = fwScaleHost(el)
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function() fwScaleApply(host) end)
	end
	return ch
end
local function fwRotSet(el, key, deg) -- Rotation is shared by three runtimes too
	local base = el:GetAttribute("FW_RotBase")
	if base == nil then
		base = el.Rotation
		el:SetAttribute("FW_RotBase", base)
	end
	el:SetAttribute(key, deg)
	local total = 0
	for _, k in ipairs({ "r_juice", "r_spin", "r_tl", "r_hover" }) do
		local v = el:GetAttribute(k)
		if type(v) == "number" then total = total + v end
	end
	el.Rotation = base + total
end
local function findRoot()
	local fallback = nil
	for _, child in ipairs(gui:GetChildren()) do
		if child:IsA("BillboardGui") then -- _billboard: the design lives one level deeper
			local inner = child:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("ObjectValue") and child.Name == "FW_ExtraRoot" and child.Value then
			local inner = child.Value:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("GuiObject") then
			fallback = fallback or child
			if child:GetAttribute("FW_Owned") == true then return child end
		end
	end
	return fallback
end
local root = findRoot()
if not root then return end

local function panelFor(btn)
	local n = btn.Parent
	while n and n ~= gui do
		if n:GetAttribute("FigmaAction") == "panel" then return n end
		n = n.Parent
	end
	return root
end

local function findPanel(name, btn)
	if not name then return nil end
	local want = name:lower()
	local fallback = nil
	for _, d in ipairs(fwAll()) do
		if d:IsA("GuiObject") and d.Name:lower() == want then
			if d:GetAttribute("FigmaAction") == "panel" then return d end
			if not fallback and btn then
				local bad = (d == btn)
				if not bad then -- would this candidate contain the button?
					local n = btn.Parent
					while n and n ~= gui do
						if n == d then bad = true break end
						n = n.Parent
					end
				end
				if not bad then fallback = d end
			elseif not fallback then
				fallback = d
			end
		end
	end
	return fallback
end

local function centrePanel(p)
	if p.AnchorPoint == Vector2.new(0.5, 0.5) then return end
	if p.Parent then
		for _, ch in ipairs(p.Parent:GetChildren()) do
			if ch:IsA("UIListLayout") or ch:IsA("UIGridLayout") or ch:IsA("UITableLayout") or ch:IsA("UIPageLayout") then
				return
			end
		end
	end
	local ap, pos, sz = p.AnchorPoint, p.Position, p.Size
	p.Position = UDim2.new(
		pos.X.Scale + (0.5 - ap.X) * sz.X.Scale,
		pos.X.Offset + (0.5 - ap.X) * sz.X.Offset,
		pos.Y.Scale + (0.5 - ap.Y) * sz.Y.Scale,
		pos.Y.Offset + (0.5 - ap.Y) * sz.Y.Offset
	)
	p.AnchorPoint = Vector2.new(0.5, 0.5)
end

local function scaleOf(p)
	if not p:FindFirstChild("FW_Scale") then centrePanel(p) end
	return fwChannel(p, "k_act") -- the panel shares one UIScale with juice, via channels
end

local TIN_SHOW = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TIN_HIDE = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local hiding = {}
local function showPanel(p)
	local tw = hiding[p]
	if tw then
		hiding[p] = nil
		tw:Cancel()
	elseif p.Visible then
		return
	end
	local s = scaleOf(p)
	if not p.Visible then s.Value = 0 end
	p.Visible = true
	TweenService:Create(s, TIN_SHOW, { Value = 1 }):Play()
end
local function hidePanel(p)
	if not p.Visible or hiding[p] then return end
	local s = scaleOf(p)
	local tw = TweenService:Create(s, TIN_HIDE, { Value = 0 })
	hiding[p] = tw
	tw.Completed:Once(function()
		if hiding[p] ~= tw then return end
		hiding[p] = nil
		p.Visible = false
		s.Value = 1
	end)
	tw:Play()
end

local function tabGroupRoot(btn)
	local n = btn.Parent
	while n and n ~= gui do
		if n:GetAttribute("FigmaAction") == "tabgroup" then return n end
		n = n.Parent
	end
	return findRoot() or gui -- the ScreenGui holds nothing on a billboard import
end

local function setActive(tabBtn, on)
	for _, c in ipairs(tabBtn:GetDescendants()) do
		if c:GetAttribute("FigmaState") == "active" then c.Visible = on end
	end
end

local function selectTab(btn, animate)
	local groot = tabGroupRoot(btn)
	for _, other in ipairs(groot:GetDescendants()) do
		if other:GetAttribute("FigmaAction") == "tab" and tabGroupRoot(other) == groot then
			local ot = findPanel(other:GetAttribute("FigmaActionParam"), other)
			if ot then
				if other == btn then
					if animate then showPanel(ot) else ot.Visible = true end
				else
					if animate then hidePanel(ot) else ot.Visible = false end
				end
			end
			setActive(other, other == btn)
		end
	end
end

local wired = setmetatable({}, { __mode = "k" })
local function wire(btn)
	if wired[btn] then return end
	local action = btn:GetAttribute("FigmaAction")
	if not action or action == "panel" or action == "tabgroup" then return end
	if not (btn:IsA("TextButton") or btn:IsA("ImageButton")) then return end
	wired[btn] = true
	local param = btn:GetAttribute("FigmaActionParam")
	btn.Activated:Connect(function()
		if action == "close" then
			hidePanel((param and findPanel(param, btn)) or panelFor(btn))
		elseif action == "open" then
			local p = findPanel(param, btn)
			if p then showPanel(p) end
		elseif action == "toggle" then
			local p = findPanel(param, btn)
			if p then
				if p.Visible and not hiding[p] then hidePanel(p) else showPanel(p) end
			end
		elseif action == "tab" then
			selectTab(btn, true)
		end
	end)
end
for _, d in ipairs(fwAll()) do wire(d) end
for _, r in ipairs(fwRoots()) do r.DescendantAdded:Connect(wire) end

local seenGroup = {}
for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaAction") == "tab" then
		local g = tabGroupRoot(d)
		if not seenGroup[g] then
			seenGroup[g] = true
			selectTab(d, false)
		end
	end
end
]]
	stampRuntime(act)
	act:SetAttribute("FWv", 5)
	act.Parent = screen
	end

	do
		dropIfOurs(screen, "FramewispData", 2)
	end
	if hasBind and not screen:FindFirstChild("FramewispData") then
	-- Live data (Phase 3): a text with a FigmaBind template ("Coins: {Coins}")
	-- substitutes values from leaderstats / attributes / the player name in game
	-- and updates on change. Player-only (in the Studio editor the text is static).
	local data = Instance.new("LocalScript")
	data.Name = "FramewispData"
	data.Source = [[
-- Framewisp: live text from your Figma {tokens} — e.g. "Coins: {Coins}" shows
-- leaderstats.Coins and updates in game. Also {PlayerName}, {DisplayName}, {attr:X}.
-- Safe to delete: labels keep their last text, they just stop updating.
local Players = game:GetService("Players")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local plr = Players.LocalPlayer
if not plr then return end

local function resolveToken(tok)
	tok = tok:match("^%s*(.-)%s*$")
	if tok == "" then return "" end
	if tok == "PlayerName" or tok == "Player" then return plr.Name end
	if tok == "DisplayName" then return plr.DisplayName end
	local attr = tok:match("^attr:(.+)$")
	if attr then local v = plr:GetAttribute(attr); return v ~= nil and tostring(v) or "" end
	local path = tok
	if not path:find("%.") then path = "leaderstats." .. path end
	local node = plr
	for part in path:gmatch("[^%.]+") do
		if not node then return "" end
		node = node:FindFirstChild(part)
	end
	if node == nil then return "" end
	local ok, val = pcall(function() return node.Value end)
	if ok and val ~= nil then return tostring(val) end
	return tostring(node.Name)
end

local bound = setmetatable({}, { __mode = "k" })
local function escapeRichValue(value)
	return tostring(value)
		:gsub("&", "&amp;")
		:gsub("<", "&lt;")
		:gsub(">", "&gt;")
		:gsub('"', "&quot;")
		:gsub("'", "&apos;")
end
local function bindLabel(lbl)
	if bound[lbl] then return end
	local tmpl = lbl:GetAttribute("FigmaBind")
	if type(tmpl) ~= "string" then return end
	bound[lbl] = true
	local conns = {}
	local function on(sig, fn) conns[#conns + 1] = sig:Connect(fn) end
	local function render()
		lbl.Text = (tmpl:gsub("{([^}]+)}", function(tok)
			local value = resolveToken(tok)
			return lbl.RichText and escapeRichValue(value) or value
		end))
	end
	on(plr.AttributeChanged, render)
	local function watchStats(ls)
		for _, v in ipairs(ls:GetChildren()) do
			pcall(function() on(v:GetPropertyChangedSignal("Value"), render) end)
		end
		on(ls.ChildAdded, function(v)
			pcall(function() on(v:GetPropertyChangedSignal("Value"), render) end)
			render()
		end)
	end
	local ls = plr:FindFirstChild("leaderstats")
	if ls then watchStats(ls) end
	on(plr.ChildAdded, function(c)
		if c.Name == "leaderstats" then task.wait(); watchStats(c); render() end
	end)
	lbl.Destroying:Once(function()
		for _, c in ipairs(conns) do c:Disconnect() end
	end)
	render()
end

local function scan(d)
	if (d:IsA("TextLabel") or d:IsA("TextButton")) and d:GetAttribute("FigmaBind") then bindLabel(d) end
end
for _, d in ipairs(fwAll()) do scan(d) end
for _, r in ipairs(fwRoots()) do r.DescendantAdded:Connect(scan) end -- a billboard hangs off FW_ExtraRoot
]]
	stampRuntime(data)
	data:SetAttribute("FWv", 2)
	data.Parent = screen
	end

	if hasActions and root and initializeTabs then
	-- Hide inactive tabs at BUILD time: otherwise there is a frame on game entry
	-- where all content panels sit stacked on top of each other (the runtime init
	-- hides them only after scripts start). First tab of each group stays visible.
	do
		local function groupOf(btn)
			local n = btn.Parent
			while n and n ~= root and n.Parent do
				if n:GetAttribute("FigmaAction") == "tabgroup" then return n end
				n = n.Parent
			end
			return root
		end
		local seen = {}
		for _, d in ipairs(root:GetDescendants()) do
			if d:GetAttribute("FigmaAction") == "tab" then
				local g = groupOf(d)
				local t = tabTarget(root, d, d:GetAttribute("FigmaActionParam"))
				if t then t.Visible = not seen[g] end
				seen[g] = true
			end
		end
	end
	end

	if bbEmbed and not keepTheirs then
		embedRuntimes(bbEmbed)
	elseif bundleMode and not keepTheirs then
		bundleRuntimes(screen)
	end
	-- Name what will only come alive in a running game. Roblox never runs a
	-- LocalScript in edit mode, so hover, selection and drift are all frozen in the
	-- viewport no matter how right the import is — say so instead of letting the
	-- designer conclude the tag is broken.
	local live = {}
	if hasButtons then live[#live + 1] = "hover/click" end
	if hasSelect then live[#live + 1] = "selection" end
	if hasDrift then live[#live + 1] = "drift" end
	if hasBlink then live[#live + 1] = "blinking" end
	if hasBurst then live[#live + 1] = "particle bursts" end
	if hasPointer then live[#live + 1] = "pointer arrows" end
	if hasCard then live[#live + 1] = "hover cards" end
	if hasJuice then live[#live + 1] = "juice" end
	if hasTL then live[#live + 1] = "timelines" end
	if hasFloat then live[#live + 1] = "float" end
	if hasSpin then live[#live + 1] = "spin" end
	if hasShiny then live[#live + 1] = "shine" end
	if has3D then live[#live + 1] = "3D cards" end
	if hasActions then live[#live + 1] = "menu actions" end
	-- The manifest of what THIS import shipped. The load-time pass compares the
	-- screen against it: a script missing from a screen that once had it was
	-- deleted by the developer — the headers promise "Safe to delete", so it
	-- stays deleted until an explicit re-import puts it back.
	do
		local names = {}
		for _, c in ipairs(screen:GetChildren()) do
			if c:IsA("LocalScript") and c.Name:sub(1, 9) == "Framewisp" then
				names[#names + 1] = c.Name
			end
		end
		screen:SetAttribute("FW_RT", table.concat(names, ","))
		screen:SetAttribute("FW_Importing", nil)
		-- The manifest is the developer's WILL from here on: deleting a script in
		-- the editor updates it, so nothing may put that script back — not another
		-- import pass, and not the second plugin copy's old self-heal (see guard).
		if not screen:GetAttribute("FW_GuardEdit") and not game:GetService("RunService"):IsRunning() then
			screen:SetAttribute("FW_GuardEdit", true)
			screen.ChildRemoved:Connect(function(c)
				if screen:GetAttribute("FW_Importing") then return end
				if c:IsA("LocalScript") and c.Name:sub(1, 9) == "Framewisp" and type(screen:GetAttribute("FW_RT")) == "string" then
					local left = {}
					for _, k in ipairs(screen:GetChildren()) do
						if k:IsA("LocalScript") and k.Name:sub(1, 9) == "Framewisp" then left[#left + 1] = k.Name end
					end
					screen:SetAttribute("FW_RT", table.concat(left, ","))
				end
			end)
		end
	end
	-- The passport. Two plugin copies and one stale screen produced four rounds of
	-- "the fix did nothing" — this line settles in one look what is actually
	-- inside the screen and which plugin built it.
	do
		local rt = {}
		for _, c in ipairs(screen:GetChildren()) do
			if c:IsA("LocalScript") and c.Name:sub(1, 9) == "Framewisp" then
				rt[#rt + 1] = c.Name:gsub("^Framewisp", "") .. " v" .. tostring(c:GetAttribute("FWv") or "?")
			end
		end
		if #rt > 0 then
			print("[Framewisp] " .. screen.Name .. " · plugin " .. FW_BUILD .. " · runtimes: " .. table.concat(rt, ", "))
		end
	end
	local note = ""
	if #runtimeKept > 0 then
		-- Never silently. A developer who tuned a runtime must hear that we left it
		-- alone, or they will wonder why an update changed nothing for them.
		note = note .. " Kept your edited " .. table.concat(runtimeKept, ", ") .. " — not replaced, so your changes are safe."
	end
	if #live == 0 then return note end
	if bundleMode then
		note = note .. " Runtime bundled into one script."
	end
	return " Press Play to see " .. table.concat(live, ", ") .. " — Roblox only runs them in a running game." .. note
end

local function healthSummary(repaired, pending)
	local notes = {}
	if repaired > 0 then notes[#notes + 1] = ("Recovered %d orphan state layer(s)."):format(repaired) end
	if pending > 0 then notes[#notes + 1] = ("%d image(s) are waiting for Roblox to review them and stay blank until then. They appear by themselves once approved — keep Studio open; this can take a while when Roblox is busy."):format(pending) end
	return table.concat(notes, " ")
end

local function healthCheck(root)
	return healthSummary(repairOrphanStates(root), retryUnresolvedImages(root))
end

-- Existing imports receive runtime fixes as soon as the updated Studio plugin
-- loads; users do not have to delete/re-import every ScreenGui.
for _, sg in ipairs(StarterGui:GetChildren()) do
	if (sg:IsA("ScreenGui") or sg:IsA("SurfaceGui")) and (sg:GetAttribute("FW_Owned") or sg:GetAttribute("BB_DesignH")) then
		local root = findManagedRoot(sg)
		if root then
			local note = healthCheck(root)
			-- NO self-heal here — and the manifest is ENFORCED. The other installed
			-- plugin copy (the published one) still carries the old self-heal: it
			-- loads in BOTH Play worlds and re-injects its own runtimes into each,
			-- which is exactly the doubled scripts in the screenshot. Anything not
			-- in the manifest, and any same-name duplicate, is removed on sight.
			sg:SetAttribute("FW_GuardEdit", nil) -- connections died with the last session; the flag must not outlive them
			local raw = sg:GetAttribute("FW_RT")
			if type(raw) == "string" and raw ~= "" then
				local manifest = {}
				for name in raw:gmatch("[^,]+") do manifest[name] = true end
				local function sweep()
					if sg:GetAttribute("FW_Importing") then return end
					local seen = {}
					for _, c in ipairs(sg:GetChildren()) do
						if c:IsA("LocalScript") and c.Name:sub(1, 9) == "Framewisp" and c:GetAttribute("FW_Owned") then
							if not manifest[c.Name] or seen[c.Name] then
								c:Destroy()
							else
								seen[c.Name] = true
							end
						end
					end
					local missing = {}
					for name in raw:gmatch("[^,]+") do
						if not seen[name] then missing[#missing + 1] = name end
					end
					return missing
				end
				local missing = sweep()
				sg.ChildAdded:Connect(function(c)
					if c:IsA("LocalScript") and c.Name:sub(1, 9) == "Framewisp" then task.defer(sweep) end
				end)
				if missing and #missing > 0 then
					print(("[Framewisp] %s: %s deleted — those effects stay off. Re-import to restore."):format(
						sg.Name, table.concat(missing, ", ")))
				end
				if not sg:GetAttribute("FW_GuardEdit") and not game:GetService("RunService"):IsRunning() then
					sg:SetAttribute("FW_GuardEdit", true)
					sg.ChildRemoved:Connect(function(c)
						if sg:GetAttribute("FW_Importing") then return end
						if c:IsA("LocalScript") and c.Name:sub(1, 9) == "Framewisp" and type(sg:GetAttribute("FW_RT")) == "string" then
							local left = {}
							for _, k in ipairs(sg:GetChildren()) do
								if k:IsA("LocalScript") and k.Name:sub(1, 9) == "Framewisp" then left[#left + 1] = k.Name end
							end
							sg:SetAttribute("FW_RT", table.concat(left, ","))
						end
					end)
				end
			end
			if note ~= "" then print("[Framewisp] " .. sg.Name .. ": " .. note) end
		end
	end
end

-- ===================================================================== import

-- "Done! Imported" with nothing on screen is a support case of its own (nassh,
-- 28.09.2026: Live said delivered, Studio showed nothing, and nothing said why).
-- The import cannot see the viewport, but Studio can say what keeps a design out
-- of sight: UI hidden in the editor, a hidden top frame, images that do not load.
local function visibilityNote(root)
	local notes = {}
	local okShow, show = pcall(function() return StarterGui.ShowDevelopmentGui end)
	if okShow and show == false then
		notes[#notes + 1] = "Studio is hiding UI in the editor: StarterGui > ShowDevelopmentGui is off. Turn it on to see the design."
	end
	if root and root:IsA("GuiObject") and not root.Visible then
		notes[#notes + 1] = "The design's top frame '" .. root.Name .. "' is hidden (hidden in Figma, or a closed _panel): set its Visible on to see it."
	end
	return #notes > 0 and (" " .. table.concat(notes, " ")) or ""
end
local function watchImages(root)
	if not root then return end
	-- Only what should be ON SCREEN now: a hidden tab or a closed panel may never
	-- load its pictures until it is shown, and that is not a failure.
	local function shown(inst)
		local n = inst
		while n and n ~= root.Parent do
			if n:IsA("GuiObject") and not n.Visible then return false end
			n = n.Parent
		end
		return true
	end
	local labels, seen = {}, {}
	for _, d in ipairs(root:GetDescendants()) do
		if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" and not seen[d.Image]
			and (d.Image:find("^rbxassetid://") or d.Image:find("asset/%?id="))
			and d:GetAttribute("FW_ImageSource") ~= d.Image -- still in review: already reported as processing
			and shown(d) then
			seen[d.Image] = true
			labels[#labels + 1] = d
		end
	end
	if #labels == 0 then return end
	task.spawn(function()
		-- Two signals must agree before anyone is told their images are broken. The
		-- fetch status alone lied: preloading the id STRINGS reported "3 of 3 did not
		-- load" over the owner's own VIP button, fully drawn (29.09.2026). So the
		-- labels themselves are preloaded, and a failure counts only when that label
		-- has not loaded either.
		local failedIds = {}
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync(labels, function(id, st)
				if st == Enum.AssetFetchStatus.Failure then failedIds[id] = true end
			end)
		end)
		task.wait(2)
		if not root.Parent then return end
		local failed = 0
		for _, l in ipairs(labels) do
			if l.Parent and failedIds[l.Image] then
				local ok, loaded = pcall(function() return l.IsLoaded end)
				if ok and loaded == false then failed = failed + 1 end
			end
		end
		if failed == 0 then return end
		local msg = ("%d of %d image(s) did not load in this place, so parts of the design stay blank. Either Roblox is still reviewing them (press Retry unresolved images in a few minutes), or they were uploaded by a different Roblox account than the one this place belongs to: sign in to Framewisp in Figma with that account and send the design again."):format(failed, #labels)
		warn("[Framewisp] " .. msg)
		if lateNote then lateNote(msg) end
	end)
end

local function importByCode(code, liveRequest)
	local url = liveRequest and (BACKEND_URL .. "/live/transfer/" .. code .. "?rev=" .. tostring(liveRequest.rev) .. "&receiverId=" .. liveRequest.receiverId)
		or (BACKEND_URL .. "/import/" .. code)
	local headers = liveRequest and { ["x-live-token"] = liveRequest.token } or nil
	-- RequestAsync (unlike GetAsync) does NOT throw on 404/500, so a wrong or
	-- expired code shows the server's real message instead of "request failed".
	local ok, res = pcall(function()
		return HttpService:RequestAsync({ Url = url, Method = "GET", Headers = headers })
	end)
	if not ok then
		-- pcall now fails only on transport-level problems. Most common cause by
		-- far: Studio's PLUGIN permission for this domain was denied (the game's
		-- "Allow HTTP Requests" setting does NOT apply to plugins).
		local err = tostring(res):lower()
		if err:find("not enabled") or err:find("http requests") or err:find("permission") or err:find("not permitted") or err:find("denied") then
			return false, "Studio blocked the plugin's internet access. Plugins > Manage Plugins > Framewisp > Edit Permissions > allow api.framewisp.com, then retry."
		end
		return false, "Couldn't reach Framewisp. Check your internet and try again."
	end
	local ok2, bp = pcall(function()
		return HttpService:JSONDecode(res.Body)
	end)
	if not ok2 then
		return false, "Bad response (HTTP " .. tostring(res.StatusCode) .. ")"
	end
	if type(bp) ~= "table" then return false, "Bad blueprint response" end
	if bp.error then
		return false, bp.error
	end
	if not res.Success then return false, "Request failed (HTTP " .. tostring(res.StatusCode) .. ")" end
	if liveRequest and (bp.transferId ~= code or tonumber(bp.rev) ~= liveRequest.rev or tonumber(bp.seq) ~= liveRequest.seq) then
		return false, "live_superseded"
	end
	if liveRequest and not liveRequest.canApply() then return false, "live_paused" end
	if liveRequest then liveRequest.fetched = true end
	if bp.format ~= "framewisp-blueprint" then
		return false, "Not a Framewisp blueprint"
	end
	if type(bp.root) ~= "table" or type(bp.canvas) ~= "table"
		or type(bp.canvas.w) ~= "number" or type(bp.canvas.h) ~= "number" then
		return false, "Bad blueprint (missing root/canvas)"
	end
	if type(bp.warnings) == "table" then
		for _, w in ipairs(bp.warnings) do
			warn("[Framewisp] Conversion warning: " .. tostring(w.detail or w.code or "unknown"))
		end
	end
	local warningNote = ""
	if type(bp.warnings) == "table" and #bp.warnings > 0 then
		warningNote = (" %d conversion warning(s) — see Output."):format(#bp.warnings)
	end
	-- The backend embeds its push counter in the body; remember it so the auto-sync
	-- poller baselines on what was ACTUALLY imported (see lastImportRev).
	if not liveRequest then lastImportRev = tonumber(bp.rev) end

	-- _surface: the design renders on a Part's face, so its host is a SurfaceGui.
	-- Decided from the blueprint up front: Live Sync must not diff a surface design
	-- into a screen host (or back) — a change of host class means a fresh build.
	local rootAttrs = type(bp.root.attributes) == "table" and bp.root.attributes or {}
	local wantSurface = rootAttrs.FigmaSurface ~= nil and rootAttrs.FigmaBillboard == nil

	-- Live Sync: if this code is already imported and Sync is on, diff into the
	-- existing tree instead of building a duplicate — the developer keeps their
	-- scripts and hand-added children. Only touch a genuine Framewisp import.
	if syncMode then
		-- Find the existing import by its FW_Code ATTRIBUTE, not its name: the
		-- whole identity model (placeHasTarget) keys off FW_Code, and a developer
		-- who renames the ScreenGui must still be reconciled into — not have a
		-- second copy built beside their renamed, script-carrying original.
		local existing = nil
		for _, sg in ipairs(StarterGui:GetChildren()) do
			if (sg:IsA("ScreenGui") or sg:IsA("SurfaceGui")) and sg:GetAttribute("FW_Owned") and sg:GetAttribute(liveRequest and "FW_LiveTransfer" or "FW_Code") == code then
				existing = sg
				break
			end
		end
		-- A design that gained or lost _surface needs the other host class: build it
		-- fresh (the old host stays in StarterGui and is reported as an earlier import).
		if existing and existing:IsA("SurfaceGui") ~= wantSurface then existing = nil end
		if existing then
			if liveRequest and existing:GetAttribute("FW_LiveRev") == liveRequest.rev then
				return true, "This Live revision is already applied."
			end
			local ok3, summary = pcall(reconcileScreen, existing, bp)
			if ok3 and summary then
				if existing:IsA("SurfaceGui") then
					-- a resized design keeps mapping 1:1 onto the Part's face
					existing.CanvasSize = Vector2.new(bp.canvas.w, bp.canvas.h)
				end
				-- A push may introduce the first button/action/binding — inject the
				-- missing service scripts (existing ones are not duplicated).
				local existingRoot = findManagedRoot(existing)
				local note = existingRoot and healthCheck(existingRoot) or ""
				-- A sync can introduce/reorder tabs; initialize their editor state now.
				-- Startup self-heal remains false so merely opening Studio changes nothing.
				local okRuntime, runtimeErr = pcall(ensureRuntime, existing, existingRoot, true)
				if not okRuntime then
					warn("[Framewisp] Runtime update failed: " .. tostring(runtimeErr))
					if liveRequest then return false, "Runtime update failed (see Output). Send the design again after fixing the error." end
					note = note .. (note ~= "" and " " or "") .. "Runtime update needs attention (see Output)."
				end
				if liveRequest then existing:SetAttribute("FW_LiveRev", liveRequest.rev) end
				watchImages(existingRoot)
				return true, summary .. (note ~= "" and (" " .. note) or "") .. warningNote .. visibilityNote(existingRoot)
			elseif not ok3 then
				-- Reconcile threw AFTER partially mutating the LIVE tree. Falling through
				-- to a fresh full build now would leave two same-named ScreenGuis (one
				-- corrupt) and strand the developer's scripts — the exact failure this
				-- feature exists to prevent. Stop instead: the original tree is still
				-- present (partially updated) and recoverable, and nothing is duplicated.
				warn("[Framewisp] Live Sync error: " .. tostring(summary))
				return false, "Live Sync hit an error and stopped to protect your scene — nothing was duplicated (details in Output). To force a clean import, delete the '" .. existing.Name .. "' ScreenGui, then import again."
			end
			-- ok3 == true but summary == nil: the existing ScreenGui had no design root
			-- (not a real import) — fall through and build a fresh copy.
		end
	end

	local screen = Instance.new(wantSurface and "SurfaceGui" or "ScreenGui")
	screen.Name = liveRequest and ("Framewisp_Live_" .. tostring(bp.root.name or "Design")) or ("Framewisp_" .. code)
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	-- Without this the gui's basis is the viewport MINUS the Roblox topbar, so
	-- every Scale size is ~5% short of the Figma design in a live client (the
	-- aspect lock spreads the height loss to both axes) while emulation looks
	-- right. Full-viewport basis = what the 1920x1080 canvas fractions assume.
	-- Existing imports are reconciled, not recreated, so they keep their value.
	if not wantSurface then screen.IgnoreGuiInset = true end -- a SurfaceGui has no inset (and no such property)
	-- Build the root detached, then place it like the old plugin: centred and sized
	-- to the design's fraction of a 1920x1080 reference canvas, with an aspect lock,
	-- so a design does NOT stretch to fill the whole screen (children still scale
	-- relative to the design canvas, so proportions stay pixel-accurate).
	local root = build(bp.root, nil, bp.canvas.w, bp.canvas.h)
	-- A _3d card refuses to tilt when it holds a CanvasGroup: Studio renders those
	-- on a SurfaceGui unreliably. One rounded, clipping sub-frame (a mask) was
	-- enough to cost the whole effect. The converter no longer promotes one under a
	-- 3D card, but blueprints already exported still carry them — repair on import
	-- so the tilt works without waiting for a re-export. Only where the group is
	-- fully opaque: a translucent one exists to fade its whole subtree, and a Frame
	-- cannot do that.
	do
		local KEEP = { "Name", "Position", "Size", "AnchorPoint", "Rotation", "Visible", "ZIndex",
			"LayoutOrder", "BackgroundColor3", "BackgroundTransparency", "BorderSizePixel", "ClipsDescendants" }
		local flattened = 0
		for _, card in ipairs(root:GetDescendants()) do
			if card:GetAttribute("Figma3D") ~= nil or card:GetAttribute("FigmaTilt") ~= nil
				or card:GetAttribute("FigmaSwing") ~= nil then
				for _, d in ipairs(card:GetDescendants()) do
					-- A _fall box is flattened too: ONE canvas anywhere in the card and
					-- the 3D host refuses the whole tilt — _swing played as a flat
					-- up-and-down bob. Inside a 3D card the rain gives up its TILT
					-- instead (the runtime sees a plain Frame and un-tilts the copies,
					-- which a Frame clips fine); the card keeps its depth.
					if d:IsA("CanvasGroup") and d.GroupTransparency < 0.01 then
						local f = Instance.new("Frame")
						for _, k in ipairs(KEEP) do
							pcall(function() f[k] = d[k] end)
						end
						for k, v in pairs(d:GetAttributes()) do f:SetAttribute(k, v) end
						for _, kid in ipairs(d:GetChildren()) do kid.Parent = f end
						f.Parent = d.Parent
						d:Destroy()
						flattened = flattened + 1
					end
				end
			end
		end
		if flattened > 0 then
			print(("[Framewisp] _3D: flattened %d CanvasGroup(s) inside a 3D card so it can tilt."):format(flattened))
		end
	end
	local placeNote = placeRoot(root, bp)
	root.Parent = screen
	local bbGui, bbClick = nil, false
	if root:GetAttribute("FigmaBillboard") then
		-- World-space UI: everything inside is already scale-based, so the whole
		-- design maps 1:1 onto the billboard's face. Width in studs from the
		-- playground; height follows the design's aspect. Set Adornee and go.
		local studs = root:GetAttribute("BBStuds") or root:GetAttribute("FigmaBBStuds") or 8
		local bb = Instance.new("BillboardGui")
		bb.Name = root.Name .. "_Billboard"
		bb.Size = UDim2.new(studs, 0, studs * bp.canvas.h / math.max(1, bp.canvas.w), 0)
		bb.AlwaysOnTop = (root:GetAttribute("BBTop") or root:GetAttribute("FigmaBBTop") or 1) >= 1
		local dist = root:GetAttribute("BBDist") or root:GetAttribute("FigmaBBDist") or 0
		if dist > 0 then bb.MaxDistance = dist end
		bb.ResetOnSpawn = false
		-- Design colours, not world colours: with light influence on, the scene's
		-- lighting tints and darkens the UI — the same blueprint looked right in
		-- a ScreenGui and washed out on the billboard (customer screenshot).
		bb.LightInfluence = 0
		bb:SetAttribute("FW_Owned", true)
		bb.Parent = screen -- временно; в обычном режиме ниже уедет на парт
		-- The playground toggle: clickable billboards must live in PlayerGui
		-- (player input never reaches Gui objects parented under Workspace), plain
		-- ones ride on the Part with an embedded client Script (see embedRuntimes).
		bbClick = (root:GetAttribute("BBClick") or root:GetAttribute("FigmaBBClick") or 0) >= 1
		bbGui = bb
		-- Runtimes turn design px into rendered px by reading the design box off
		-- their host gui; stamp it on the billboard itself so the embedded Script
		-- (and any copy the developer duplicates) is self-sufficient.
		bb:SetAttribute("BB_DesignH", bp.canvas.h)
		bb:SetAttribute("BB_DesignW", bp.canvas.w)
		bb:SetAttribute("BB_TextFactor", TEXT_SIZE_FACTOR)
		if not bbClick then
			-- The pointer guides ensureRuntime's effect scan across to the Part, and
			-- keeps any legacy PlayerGui-hosted runtime able to find the billboard.
			local link = Instance.new("ObjectValue")
			link.Name = "FW_ExtraRoot"
			link:SetAttribute("FW_Owned", true)
			link.Value = bb
			link.Parent = screen
		end
		local anchor = workspace:FindFirstChild(root.Name .. "_BillboardAnchor")
		if not anchor then
			anchor = Instance.new("Part")
			anchor.Name = root.Name .. "_BillboardAnchor"
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanQuery = false
			anchor.Size = Vector3.new(1, 1, 1)
			anchor.Transparency = 0.6
			anchor.Color = Color3.fromRGB(109, 63, 242)
			local cam = workspace.CurrentCamera
			anchor.CFrame = cam and (cam.CFrame * CFrame.new(0, 0, -14)) or CFrame.new(0, 6, 0)
			anchor:SetAttribute("FW_Owned", true)
			anchor.Parent = workspace
		end
		-- A re-import lands on the SAME anchor (found by name above). Without this,
		-- every pass hung ANOTHER billboard on the part: identical copies stacked in
		-- one spot, rendering through each other, and Explorer listing several
		-- entries with the same name — so the properties you inspect belong to a
		-- stale copy while the fresh one sits next to it. Replace, never pile up.
		local stale = 0
		for _, old in ipairs(anchor:GetChildren()) do
			if old:IsA("BillboardGui") and old:GetAttribute("FW_Owned") then
				-- Its script host in StarterGui drove that copy and nothing else.
				-- Take it too, but only while every child is still ours: the moment
				-- the developer put their own script in there, it is their ScreenGui.
				for _, host in ipairs(StarterGui:GetChildren()) do
					local ptr = host:GetAttribute("FW_Owned") and host:FindFirstChild("FW_ExtraRoot")
					if ptr and ptr:IsA("ObjectValue") and ptr.Value == old then
						local mine = true
						for _, ch in ipairs(host:GetChildren()) do
							if not ch:GetAttribute("FW_Owned") then mine = false break end
						end
						if mine then host:Destroy() end
					end
				end
				old:Destroy()
				stale = stale + 1
			end
		end
		-- A previous CLICKABLE import keeps its BillboardGui inside a StarterGui
		-- host instead (Adornee on this anchor) — sweep that shape too, or a mode
		-- switch stacks a second copy of the UI on the same Part.
		for _, host in ipairs(StarterGui:GetChildren()) do
			if host:IsA("ScreenGui") and host:GetAttribute("FW_Owned") then
				for _, ch in ipairs(host:GetChildren()) do
					if ch:IsA("BillboardGui") and ch:GetAttribute("FW_Owned") and ch.Adornee == anchor then
						ch:Destroy()
						stale = stale + 1
						local mine = true
						for _, rest in ipairs(host:GetChildren()) do
							if not rest:GetAttribute("FW_Owned") then mine = false break end
						end
						if mine then host:Destroy() end
						break
					end
				end
			end
		end
		-- ADORNEE ONLY WHERE IT IS NEEDED. A BillboardGui renders at its Adornee if
		-- one is set, and at its PARENT otherwise. Setting both pinned the UI to
		-- the original anchor for ever: drag the billboard onto another object and
		-- it kept drawing at the old part — "I move it and it just disappears".
		-- Self-contained mode lives ON the part, so the parent already says where
		-- it belongs; the clickable mode lives in a ScreenGui and genuinely needs
		-- the pointer. Set below, per mode.
		-- _prompt: this billboard is the CUSTOM UI of a ProximityPrompt. The
		-- prompt instance lives on the anchor Part where the developer naturally
		-- edits it (KeyCode, HoldDuration, MaxActivationDistance are plain
		-- Properties). Replace-not-pile, same rule as the billboard itself.
		if root:GetAttribute("FigmaPrompt") then
			for _, old in ipairs(anchor:GetChildren()) do
				if old:IsA("ProximityPrompt") and old:GetAttribute("FW_Owned") then old:Destroy() end
			end
			local prompt = Instance.new("ProximityPrompt")
			prompt.Style = Enum.ProximityPromptStyle.Custom
			-- ALWAYS visible: with line-of-sight on, a prompt inside a crate or
			-- behind glass silently never shows — the "no light" effect. Off for
			-- good; the developer asked for a prompt they can actually see.
			prompt.RequiresLineOfSight = false
			-- The key the designer typed, carried as its KeyCode value (letters are
			-- their lowercase ASCII code). Unknown value = Roblox's own default, E.
			local kv = tonumber(root:GetAttribute("PromptKey") or root:GetAttribute("FigmaPromptKey"))
			if kv then
				for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
					if item.Value == kv then prompt.KeyboardKeyCode = item break end
				end
			end
			prompt.MaxActivationDistance = root:GetAttribute("FigmaPromptDist") or 10
			-- A design with a _hold element clearly wants a hold; without one the
			-- prompt triggers instantly. Both are one Properties edit away.
			-- Scan the ROOT: it is not parented into the BillboardGui yet, so
			-- bb:GetDescendants() here found nothing — HoldDuration came out 0 and
			-- the prompt triggered instantly instead of filling.
			local holds = false
			for _, d in ipairs(root:GetDescendants()) do
				if d:GetAttribute("FigmaHold") ~= nil then holds = true break end
			end
			local ph = root:GetAttribute("FigmaPromptHold")
			prompt.HoldDuration = ph or (holds and 0.6 or 0)
			prompt:SetAttribute("FW_Owned", true)
			prompt.Parent = anchor
			-- Visibility-on-approach belongs to the RUNTIME (wire() re-disables in
			-- Play). Disabling at BUILD time zeroed AbsoluteSize for the whole text
			-- fit pass — every label kept its raw box and the design shrank.
			placeNote = (placeNote and (placeNote .. " ") or "")
				.. "Prompt: a ProximityPrompt was placed on the anchor Part (Style=Custom) — edit its Key/Hold/Distance there, and connect .Triggered in your own script for the game logic."
		end
		if bbClick then
			-- Clickable mode: input only reaches Gui objects under PlayerGui, so the
			-- billboard stays in this ScreenGui (StarterGui clones it per player)
			-- and follows the anchor Part through Adornee — moving the Part still
			-- moves the UI, and buttons actually press.
			bb.Adornee = anchor
			bb.Parent = screen
		else
			-- No Adornee: the billboard renders at whatever Part it is parented to,
			-- so dragging it onto another object in Explorer moves the UI with it.
			bb.Adornee = nil
			bb.Parent = anchor -- живёт на парте; рантайм едет внутри (embedRuntimes)
		end
		root.AnchorPoint = Vector2.new(0.5, 0.5)
		root.Position = UDim2.fromScale(0.5, 0.5)
		root.Size = UDim2.fromScale(1, 1)
		local asp = root:FindFirstChildWhichIsA("UIAspectRatioConstraint")
		if asp then asp:Destroy() end -- the billboard's own aspect already matches
		root.Parent = bb
		placeNote = (placeNote and (placeNote .. " ") or "")
			.. (stale > 0
				and ("Billboard: replaced the previous UI on the existing anchor Part (" .. stale .. " stale copy removed).")
				or "Billboard: an anchor Part was created in front of the camera — move it where the UI belongs (or point Adornee at your own Part) and make it fully transparent.")
			.. (bbClick
				and " Clickable: the BillboardGui stays in StarterGui and follows the Part via Adornee, so buttons receive input."
				or " Self-contained: the runtime Script rides inside the BillboardGui — duplicate the Part and every copy keeps its effects. Drag the BillboardGui onto any other Part and the UI goes with it (a Model or Folder shows nothing — Roblox needs a Part or an Attachment).")
	end
	-- _surface: the host is already a SurfaceGui (see wantSurface); here it gets
	-- its canvas and its Part.
	if screen:IsA("SurfaceGui") then
		-- FixedSize in DESIGN px: every pixel of the design maps 1:1 onto the face, and
		-- the text scaler (it reads the root's AbsoluteSize) lands on exactly 1.
		local studs = root:GetAttribute("SFStuds") or root:GetAttribute("FigmaSFStuds") or 8
		local aspect = bp.canvas.h / math.max(1, bp.canvas.w)
		screen.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		screen.CanvasSize = Vector2.new(bp.canvas.w, bp.canvas.h)
		screen.Face = Enum.NormalId.Front
		-- Design colours, not scene-lit ones: the same call as _billboard.
		screen.LightInfluence = 0
		screen.AlwaysOnTop = (root:GetAttribute("SFTop") or root:GetAttribute("FigmaSFTop") or 0) >= 1
		local dist = root:GetAttribute("SFDist") or root:GetAttribute("FigmaSFDist") or 0
		if dist > 0 then screen.MaxDistance = dist end
		local anchorName = "Framewisp_" .. code .. "_Surface"
		local anchor = workspace:FindFirstChild(anchorName)
		local reused = anchor ~= nil and anchor:IsA("BasePart")
		if reused then
			-- A re-import keeps the Part where the developer put it; only its height
			-- follows a design whose proportions changed, so the UI never stretches.
			anchor.Size = Vector3.new(anchor.Size.X, anchor.Size.X * aspect, anchor.Size.Z)
		else
			anchor = Instance.new("Part")
			anchor.Name = anchorName
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.Size = Vector3.new(studs, studs * aspect, 0.2)
			anchor.Color = Color3.fromRGB(28, 28, 34)
			anchor.Material = Enum.Material.SmoothPlastic
			-- In front of the camera, upright, its FRONT face turned toward the viewer.
			local placed = CFrame.new(0, 6, 0)
			local cam = workspace.CurrentCamera
			if cam then
				local eye = cam.CFrame.Position
				local at = eye + cam.CFrame.LookVector * 14
				local flat = Vector3.new(eye.X, at.Y, eye.Z)
				placed = (flat - at).Magnitude > 0.01 and CFrame.lookAt(at, flat) or CFrame.new(at)
			end
			anchor.CFrame = placed
			anchor:SetAttribute("FW_Owned", true)
			anchor.Parent = workspace
		end
		-- Player input reaches a SurfaceGui's buttons through a ray at its Part, so the
		-- Part must be queryable (the same thing the _3d cards rely on).
		anchor.CanQuery = true
		screen.Adornee = anchor
		-- One UI per Part: an earlier import on this Part would render through the new
		-- one. Take it while everything in it is still ours; otherwise say so.
		local stale, kept = 0, 0
		for _, host in ipairs(StarterGui:GetChildren()) do
			if host:IsA("SurfaceGui") and host:GetAttribute("FW_Owned") and host.Adornee == anchor then
				local mine = true
				for _, ch in ipairs(host:GetChildren()) do
					if not ch:GetAttribute("FW_Owned") then mine = false break end
				end
				if mine then
					host:Destroy()
					stale = stale + 1
				else
					kept = kept + 1
				end
			end
		end
		if kept > 0 then
			warn(("[Framewisp] _surface: %d earlier SurfaceGui import(s) on '%s' carry your own scripts, so they were kept. Delete them or point their Adornee elsewhere, or both UIs draw on the same Part."):format(kept, anchor.Name))
		end
		root.AnchorPoint = Vector2.new(0.5, 0.5)
		root.Position = UDim2.fromScale(0.5, 0.5)
		root.Size = UDim2.fromScale(1, 1)
		local asp = root:FindFirstChildWhichIsA("UIAspectRatioConstraint")
		if asp then asp:Destroy() end -- the Part carries the aspect
		placeNote = "Surface: the UI renders on the front face of the Part '" .. anchor.Name .. "' in Workspace"
			.. (reused and (" (existing Part reused" .. (stale > 0 and (", " .. stale .. " older copy replaced") or "") .. ")") or "")
			.. " — move, rotate or resize it (keep its shape) and the UI follows. The SurfaceGui stays in StarterGui, so buttons, hovers and effects work in game."
	end
	stampDesign(screen, root, bp.canvas.w, bp.canvas.h)
	-- Live Sync anchors: FW_Owned marks the whole import as Framewisp-built, FW_Code
	-- ties this ScreenGui back to its source design so a re-import can find and diff it.
	screen:SetAttribute("FW_Owned", true)
	if liveRequest then
		screen:SetAttribute("FW_LiveTransfer", code)
	else
		screen:SetAttribute("FW_Code", code)
	end

	-- Repair the tree before runtime discovery, but start network retries only
	-- after commit so a runtime-build error cannot leave detached retry tasks.
	local repaired = repairOrphanStates(root)
	local liveNote = ensureRuntime(screen, root, true, bp.plan == "free", (bbGui and not bbClick) and bbGui or nil)
	-- Commit only after the whole managed tree + runtime is valid. A build error
	-- no longer leaves a half-imported ScreenGui in StarterGui.
	screen.Parent = StarterGui
	local note = healthSummary(repaired, retryUnresolvedImages(root))

	-- Editor-side text/stroke scaling (see attachScaler); a LocalScript keeps it
	-- correct in-game at any resolution.
	attachScaler(screen)

	-- Last word on billboard text. Three passes touch these labels (build, the
	-- editor scaler, Live Sync) and any one of them switching TextScaled back off
	-- leaves the design wrong at every distance. Settle it AFTER everyone else.
	if root:FindFirstAncestorWhichIsA("BillboardGui") then
		local labels = {}
		local function seal(d)
			if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
				-- Wrapping first: writing it after would clear TextScaled (see applyProps).
				d.TextWrapped = true
				d.TextScaled = true
				d:SetAttribute("FW_TextScaledMine", true)
				-- TextSize stops at 100 engine-wide and TextScaled obeys that: up close the
				-- box asks for ~145 and the glyphs freeze, which is the "мелкий текст"
				-- report exactly. A UITextSizeConstraint is the only way past the cap.
				local cap = d:FindFirstChild("FW_BBText")
				if not cap then
					cap = Instance.new("UITextSizeConstraint")
					cap.Name = "FW_BBText"
					cap:SetAttribute("FW_Owned", true)
					cap.Parent = d
				end
				cap.MaxTextSize = 1000 -- the documented default ceiling; plain TextScaled stops at 100
				cap.MinTextSize = 1
				labels[#labels + 1] = d
			end
		end
		seal(root)
		for _, d in ipairs(root:GetDescendants()) do seal(d) end
		-- Then hold the line. Something downstream of import has been switching
		-- these back off, so every label keeps a watcher that re-asserts the state and
		-- names the culprit in the Output instead of silently losing the property.
		for _, d in ipairs(labels) do
			local conn
			conn = d:GetPropertyChangedSignal("TextScaled"):Connect(function()
				if not d.Parent then conn:Disconnect() return end
				if d.TextScaled then return end
				d.TextScaled = true
				if not d:GetAttribute("FW_ScaledFought") then
					d:SetAttribute("FW_ScaledFought", true)
					warn(("[Framewisp] %s: something switched TextScaled off after import — put back on."):format(d.Name))
				end
			end)
		end
		-- EXACT 1:1 with Figma, in ONE pass and in design units only.
		-- TextSize is NOT a font size: it is the height of the font's whole-glyph
		-- bounding box, while Figma's number is an em. Solving one against the other
		-- is what rendered every billboard label small. Solve on WIDTH instead — the
		-- design's ink width is exported (FigmaTextW), and the screen path already
		-- sizes text that way. TextScaled picks TextSize = the box height, so the box
		-- height that makes the rendered advance width equal the design's is
		-- 100 * inkW / w100 design px. Everything inside a billboard shares one
		-- scalar, so this ratio holds at every distance, FOV and resolution.
		local canvasW, canvasH = bp.canvas.w, bp.canvas.h
		task.spawn(function()
			local left, fitted = #labels, 0
			for _ = 1, 8 do
				local rootAbs = root.AbsoluteSize
				left = 0
				for _, d in ipairs(labels) do
					if d.Parent and not d:GetAttribute("FW_TextFit") then
						local inkW = d:GetAttribute("FigmaTextW")
						local parent = d.Parent
						local pAbs = parent and parent:IsA("GuiObject") and parent.AbsoluteSize or nil
						if type(inkW) ~= "number" or inkW <= 0 or d.ContentText:find("\n")
							or d.BackgroundTransparency < 1 or not pAbs then
							d:SetAttribute("FW_TextFit", true) -- nothing to solve for
						elseif rootAbs.X < 2 or pAbs.X < 2 or pAbs.Y < 2 then
							left = left + 1 -- layout has not happened yet
						else
							local ok, b = pcall(function()
								local prm = Instance.new("GetTextBoundsParams")
								prm.Text = d.ContentText
								prm.Font = d.FontFace
								prm.Size = 100
								prm.Width = 1e6 -- never wrap: the design is one line
								prm.RichText = d.RichText
								return TextService:GetTextBoundsAsync(prm)
							end)
							if not ok or not b or b.X <= 0 then
								left = left + 1 -- font still loading
							else
								local k = canvasW / math.max(1, rootAbs.X) -- render px -> design px
								local pW, pH = pAbs.X * k, pAbs.Y * k
								local boxH = 100 * inkW / b.X
								-- SLACK IS MANDATORY: TextScaled turns wrapping on and cannot turn
								-- it off, so a box that hugs the ink wraps on a pixel of metric
								-- drift and the fitted size halves.
								local boxW = math.max(d.Size.X.Scale * pW, inkW * 1.08)
								local old, pos = d.Size, d.Position
								local new = UDim2.fromScale(boxW / math.max(1, pW), boxH / math.max(1, pH))
								local ax, ay = d.TextXAlignment, d.TextYAlignment
								local sx = (ax == Enum.TextXAlignment.Left and 1) or (ax == Enum.TextXAlignment.Right and -1) or 0
								local sy = (ay == Enum.TextYAlignment.Top and 1) or (ay == Enum.TextYAlignment.Bottom and -1) or 0
								-- VERTICAL: the box just grew from the design height to a whole line
								-- box (30 -> 87 design px for one keycap letter) and a glyph is NOT
								-- centred in it — Roblox pads this font to 1.82em where its own box
								-- is 1.37em. Place by BASELINE: the exporter measured how far the
								-- ink centre sits above the baseline (FigmaInkC, in em), the rendered
								-- em equals the design font size (the fit matched advance widths),
								-- and the baseline sits at BASE of the line box. TextBaseFrac and
								-- TextNudgeY on the label tune it without a re-convert.
								local inkC = d:GetAttribute("FigmaInkC")
								local emD = d:GetAttribute("FigmaFontSize")
								-- Where Roblox puts the baseline inside the line box is a FONT
								-- constant, and the engine reports it nowhere. 0.74 was measured for
								-- Press Start 2P (b 0.809, less the 0.125 em its glyphs sit above the
								-- baseline, which the exporter's probe reads low) — and applying that
								-- one number to every other font pushed whole labels off their
								-- plaques. A font nobody calibrated gets no guess: its box stays
								-- CENTRED on the design's ink, which is where it sat before any of
								-- this and is right to within a few percent for a normal typeface.
								-- Per-label TextBaseFrac still wins, for tuning without a re-convert.
								local fam = d.FontFace and tostring(d.FontFace.Family) or ""
								local baseF = d:GetAttribute("TextBaseFrac") or FW_BASE_FRAC[fam]
								local nudge = d:GetAttribute("TextNudgeY") or 0
								local yScale, why
								if type(inkC) == "number" and type(emD) == "number" and emD > 0 and type(baseF) == "number" then
									-- Position means whatever the ANCHOR says it means. These labels are
									-- centre-anchored, so a top-edge number written straight into Position
									-- lifted every one of them by half a box — and the fitted box is two
									-- to three times the design's height, which is why the whole design
									-- appeared to jump up. Convert through the anchor, both ways.
									local ay = d.AnchorPoint.Y
									local target = (pos.Y.Scale + (0.5 - ay) * old.Y.Scale) * pH -- the backend anchored this box ON the ink
									local topD = target - (baseF * boxH - inkC * emD) + nudge
									yScale = (topD + ay * boxH) / math.max(1, pH)
									why = ("baseline inkC %.3f em, base %.2f, anchor %.2f"):format(inkC, baseF, ay)
								else
									-- The box grows around its own centre, so a centre-anchored label
									-- does not move at all — and the backend already parked that centre
									-- on the design's ink.
									yScale = pos.Y.Scale + (new.Y.Scale - old.Y.Scale) / 2 * sy
									why = "centred on the design's ink (no calibrated baseline for this font)"
								end
								d.Size = new
								d.Position = UDim2.new(
									pos.X.Scale + (new.X.Scale - old.X.Scale) / 2 * sx, pos.X.Offset,
									yScale, pos.Y.Offset)
								-- the outline is a fraction of the box we just changed
								for _, st in ipairs(d:GetChildren()) do
									if st:IsA("UIStroke") and st:GetAttribute("FW_StrokeScaled") then
										local dsw = st:GetAttribute("FigmaTextStrokeW") or st:GetAttribute("FigmaStrokeW")
										if dsw and dsw > 0 then
											st.Thickness = dsw / math.max(1, math.min(boxW, boxH))
										end
									end
								end
								d:SetAttribute("FW_TextFit", true)
								fitted = fitted + 1
								print(("[Framewisp] fit %q: ink %d px, w100 %.0f -> box %.1fx%.1f, top y %.1f in a %.0fx%.0f parent · %s")
									:format(d.Name, inkW, b.X, boxW, boxH,
										yScale * pH - d.AnchorPoint.Y * boxH, pW, pH, why))
							end
						end
					end
				end
				if left == 0 then break end
				task.wait(0.3)
			end
			if left > 0 then
				warn(("[Framewisp] billboard text: %d label(s) could not be measured — tell support."):format(left))
			else
				print(("[Framewisp] billboard text: %d label(s) fitted to the design size."):format(fitted))
			end
		end)
		print(("[Framewisp] billboard text: %d label(s) set to TextScaled."):format(#labels))
	end

	-- A billboard-on-the-Part import leaves the ScreenGui as a mere script host.
	-- With the runtime embedded in the billboard there is nothing left to host —
	-- litter in StarterGui, drop it. A CLICKABLE billboard is the opposite: the
	-- ScreenGui IS its home (root is a descendant), never drop that one.
	if root:FindFirstAncestorWhichIsA("BillboardGui") and not root:IsDescendantOf(screen)
		and #screen:GetChildren() <= 1 then
		screen:Destroy()
	end
	-- Select the anchor Part the developer actually moves (Adornee points at it in
	-- both billboard modes); a screen import selects its design root as before.
	local bbHost = root.Parent
	if bbHost and bbHost:IsA("BillboardGui") then
		Selection:Set({ bbHost.Adornee or bbHost.Parent or root })
	else
		Selection:Set({ root })
	end
	-- Measurement report → backend, keyed by the import code. What actually
	-- rendered (positions, sizes, text bounds, the solved TextSize) lands next
	-- to the design's own numbers, so support can diff design px against
	-- rendered px from the code alone — no screenshots, no API keys, nothing
	-- for the user to install or click. Deferred so the text scaler settles;
	-- failures are silent, diagnostics must never scare anyone.
	if not liveRequest then
	task.delay(4, function()
		pcall(function()
			local nodes = {}
			local function rec(inst, depth)
				if #nodes >= 1500 or depth > 24 then return end
				if inst:IsA("GuiObject") or inst:IsA("LayerCollector") then
					local e = { n = inst.Name, c = inst.ClassName }
					if inst:IsA("GuiObject") then
						e.ap = { math.floor(inst.AbsolutePosition.X + 0.5), math.floor(inst.AbsolutePosition.Y + 0.5) }
						e.as = { math.floor(inst.AbsoluteSize.X + 0.5), math.floor(inst.AbsoluteSize.Y + 0.5) }
						if inst.Visible == false then e.v = false end
					end
					if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
						e.t = string.sub(inst.Text, 1, 40)
						e.ts = inst.TextSize
						if inst.TextScaled then e.sc = true end
						e.tb = { math.floor(inst.TextBounds.X + 0.5), math.floor(inst.TextBounds.Y + 0.5) }
						e.ink = inst:GetAttribute("FigmaInk")
						e.fs = inst:GetAttribute("FigmaFontSize")
						pcall(function() e.f = inst.FontFace.Family end)
					end
					nodes[#nodes + 1] = e
				end
				for _, ch in ipairs(inst:GetChildren()) do rec(ch, depth + 1) end
			end
			local top = (bbGui and bbGui.Parent) and bbGui or screen
			if not top or not top.Parent then return end
			rec(top, 0)
			-- the bundle stamp: proof of which runtime builds are IN this scene —
			-- "the fix changed nothing" turned out to mean "the fix never loaded"
			local stamps = {}
			local function stamp(host)
				for _, ch in ipairs(host:GetChildren()) do
					local fp = ch:GetAttribute("FW_Parts")
					if fp then stamps[#stamps + 1] = ch.Name .. "=" .. tostring(fp) end
					if ch:IsA("LocalScript") or ch:IsA("Script") then
						local v = ch:GetAttribute("FWv")
						if v then stamps[#stamps + 1] = ch.Name .. ":" .. tostring(v) end
					end
				end
			end
			stamp(screen)
			if bbGui then stamp(bbGui) end
			HttpService:RequestAsync({
				Url = BACKEND_URL .. "/import/" .. code .. "/diag",
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = HttpService:JSONEncode({ v = 1, build = FW_BUILD, runtimes = table.concat(stamps, " | "), nodes = nodes,
					pendingImages = (function() local n = 0 for i in pairs(unresolvedImages) do if i.Parent and (i == root or i:IsDescendantOf(root)) then n = n + 1 end end return n end)() }),
			})
		end)
	end)
	end
	-- Build stamp: "is the new plugin even loaded?" was guesswork three times over.
	-- The exporter's fingerprint travels in the code, the plugin's build is here —
	-- one glance answers which halves are current.
	if liveRequest then screen:SetAttribute("FW_LiveRev", liveRequest.rev) end
	watchImages(root)
	return true, "Done! Imported into StarterGui. [plugin " .. FW_BUILD .. " · exporter " .. tostring(bp.exporter or "?") .. "]" .. (note ~= "" and (" " .. note) or "")
		.. (placeNote and (" " .. placeNote) or "") .. liveNote .. warningNote .. visibilityNote(root)
end

-- ===================================================================== ui

local COL = {
	bg = Color3.fromRGB(22, 22, 27),
	field = Color3.fromRGB(29, 29, 35),
	surface = Color3.fromRGB(38, 38, 46),
	stroke = Color3.fromRGB(57, 57, 68),
	accent = Color3.fromRGB(112, 84, 183),
	accentHover = Color3.fromRGB(128, 99, 202),
	lilac = Color3.fromRGB(196, 181, 229),
	ink = Color3.fromRGB(24, 23, 29),
	text = Color3.fromRGB(237, 237, 242),
	dim = Color3.fromRGB(161, 161, 174),
	ok = Color3.fromRGB(129, 193, 156),
	err = Color3.fromRGB(238, 145, 154),
}

local function corner(inst, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = inst
end
local function stroke(inst, col, th)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = col
	s.Thickness = th or 1
	s.Parent = inst
	return s
end

-- UI helpers share one register: Studio compiles the plugin with full debug info.
local UI = {}
function UI.text(parent, text, size, color, position, dimensions, bold)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.BorderSizePixel = 0
	t.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
	t.Text = text
	t.TextSize = size
	t.TextColor3 = color
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.Position = position or UDim2.new()
	t.Size = dimensions or UDim2.fromScale(1, 1)
	t.Parent = parent
	return t
end
function UI.hover(button, normal, over)
	button.MouseEnter:Connect(function() button.BackgroundColor3 = over end)
	button.MouseLeave:Connect(function() button.BackgroundColor3 = normal end)
end
function UI.heading(parent, text, order, context)
	local heading = Instance.new("Frame")
	heading.Name = "CompactHeading"
	heading.BackgroundTransparency = 1
	heading.BorderSizePixel = 0
	heading.Size = UDim2.new(1, 0, 0, 24)
	heading.LayoutOrder = order
	heading.Parent = parent
	UI.text(heading, text, 16, COL.text, nil, UDim2.new(1, -70, 1, 0), true).Name = "Title"
	local mode = UI.text(heading, context or "", 10.5, COL.dim, UDim2.new(1, -70, 0, 0), UDim2.fromOffset(70, 24))
	mode.Name = "PanelName"
	mode.TextXAlignment = Enum.TextXAlignment.Right
	return heading
end
function UI.option(parent, name, titleText, order, toggle)
	local row = Instance.new("TextButton")
	row.Name = name
	row.Text = ""
	row.TextTransparency = 1
	row.AutoButtonColor = false
	row.BackgroundColor3 = COL.field
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, 30)
	row.LayoutOrder = order
	row.Parent = parent
	corner(row, 5)
	UI.text(row, titleText, 11.5, COL.text, nil, UDim2.new(0.48, 0, 1, 0)).Name = "Label"
	local value = UI.text(row, "", 11, COL.dim, UDim2.new(1, toggle and -39 or -13, 0, 0), UDim2.new(0.52, toggle and -45 or -18, 1, 0))
	value.Name = "Value"
	value.Font = Enum.Font.GothamMedium
	value.AnchorPoint = Vector2.new(1, 0)
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.TextTruncate = Enum.TextTruncate.AtEnd
	if toggle then
		local track = Instance.new("Frame")
		track.Name = "Switch"
		track.Size = UDim2.fromOffset(28, 16)
		track.Position = UDim2.new(1, 0, 0.5, 0)
		track.AnchorPoint = Vector2.new(1, 0.5)
		track.BorderSizePixel = 0
		track.BackgroundColor3 = COL.stroke
		track.Parent = row
		corner(track, 8)
		local handle = Instance.new("Frame")
		handle.Name = "Handle"
		handle.Size = UDim2.fromOffset(10, 10)
		handle.Position = UDim2.new(0, 3, 0.5, 0)
		handle.AnchorPoint = Vector2.new(0, 0.5)
		handle.BorderSizePixel = 0
		handle.BackgroundColor3 = COL.text
		handle.Parent = track
		corner(handle, 5)
	else
		local arrow = UI.text(row, ">", 11, COL.dim, UDim2.new(1, -8, 0, 0), UDim2.new(0, 8, 1, 0))
		arrow.TextXAlignment = Enum.TextXAlignment.Right
	end
	local line = Instance.new("Frame")
	line.Name = "Separator"
	line.Size = UDim2.new(1, 0, 0, 1)
	line.Position = UDim2.new(0, 0, 1, -1)
	line.BackgroundColor3 = COL.stroke
	line.BackgroundTransparency = 0.65
	line.BorderSizePixel = 0
	line.Parent = row
	UI.hover(row, COL.field, COL.surface)
	-- Both user clicks and programmatic sync changes still update this one
	-- source of truth. Text stays available to the original state handlers.
	row:GetPropertyChangedSignal("Text"):Connect(function() value.Text = row.Text end)
	return row
end
function UI.toggle(row, on)
	local track = row:FindFirstChild("Switch")
	if track then
		track.BackgroundColor3 = on and COL.accent or COL.stroke
		track.Handle.Position = UDim2.new(0, on and 15 or 3, 0.5, 0)
	end
	local value = row:FindFirstChild("Value")
	if value then value.TextColor3 = on and COL.lilac or COL.dim end
end

local toolbar = plugin:CreateToolbar("Framewisp")
-- Parentheses keep resolveImage's boolean return out of the toolbar label.
local button = toolbar:CreateButton("Framewisp", "Import a Figma design by code — Framewisp", (resolveImage(MASCOT_ICON)))
button.ClickableWhenViewportHidden = true

-- Studio remembers size by id. This revision opens with every import option
-- visible, with enough room for the native titlebar and the last-code shortcut.
local widget = plugin:CreateDockWidgetPluginGui(
	"FramewispImport8",
	DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, false, 340, 460, 280, 280)
)
widget.Title = "Framewisp v4.5 — Import"

local bg = Instance.new("Frame")
bg.Size = UDim2.fromScale(1, 1)
bg.BackgroundColor3 = COL.bg
bg.BorderSizePixel = 0
bg.Parent = widget

local content = Instance.new("ScrollingFrame")
content.Name = "ImportContent"
content.Size = UDim2.fromScale(1, 1)
content.BackgroundTransparency = 1
content.BorderSizePixel = 0
content.CanvasSize = UDim2.new()
content.AutomaticCanvasSize = Enum.AutomaticSize.Y
content.ScrollingDirection = Enum.ScrollingDirection.Y
content.ScrollBarThickness = 3
content.ScrollBarImageColor3 = COL.stroke
content.Parent = bg

local pad = Instance.new("UIPadding")
pad.PaddingTop = UDim.new(0, 14)
pad.PaddingBottom = UDim.new(0, 14)
pad.PaddingLeft = UDim.new(0, 14)
pad.PaddingRight = UDim.new(0, 14)
pad.Parent = content

local list = Instance.new("UIListLayout")
list.FillDirection = Enum.FillDirection.Vertical
list.SortOrder = Enum.SortOrder.LayoutOrder
list.HorizontalAlignment = Enum.HorizontalAlignment.Center
list.Padding = UDim.new(0, 7)
list.Parent = content

local function label(text, font, size, col, order, height)
	local l = UI.text(content, text, size, col, nil, UDim2.new(1, 0, 0, height))
	l.Font = font
	l.LayoutOrder = order
	return l
end
UI.heading(content, "Framewisp", 0, "Import")
UI.inputMode = plugin:GetSetting("fw_inputmode")
if UI.inputMode ~= "code" and UI.inputMode ~= "live" then
	UI.inputMode = type(plugin:GetSetting("fw_livetoken")) == "string" and plugin:GetSetting("fw_liveon") ~= false and "live" or "code"
end
UI.tabs = Instance.new("Frame")
UI.tabs.Name = "InputMode"
UI.tabs.BackgroundColor3 = COL.field
UI.tabs.BorderSizePixel = 0
UI.tabs.Size = UDim2.new(1, 0, 0, 30)
UI.tabs.LayoutOrder = 1
UI.tabs.Parent = content
corner(UI.tabs, 7)
UI.modeButtons = {}
do
	for i, mode in ipairs({ "code", "live" }) do
		local tab = Instance.new("TextButton")
		tab.Name = mode == "live" and "LiveMode" or "CodeMode"
		tab.Text = mode == "live" and "Live from Figma" or "Import code"
		tab.Font = Enum.Font.GothamMedium
		tab.TextSize = 11
		tab.AutoButtonColor = false
		tab.BorderSizePixel = 0
		tab.Position = UDim2.new((i - 1) / 2, 3, 0, 3)
		tab.Size = UDim2.new(0.5, -6, 1, -6)
		tab.Parent = UI.tabs
		corner(tab, 5)
		UI.modeButtons[mode] = tab
		tab.MouseButton1Click:Connect(function() if UI.setMode then UI.setMode(mode) end end)
	end
end
UI.codePanel = Instance.new("Frame")
UI.codePanel.Name = "CodeInputPanel"
UI.codePanel.BackgroundTransparency = 1
UI.codePanel.Size = UDim2.new(1, 0, 0, 42)
UI.codePanel.LayoutOrder = 2
UI.codePanel.Parent = content
UI.livePanel = Instance.new("Frame")
UI.livePanel.Name = "LiveInputPanel"
UI.livePanel.BackgroundColor3 = COL.field
UI.livePanel.BorderSizePixel = 0
UI.livePanel.Size = UDim2.new(1, 0, 0, 96)
UI.livePanel.LayoutOrder = 2
UI.livePanel.Visible = false
UI.livePanel.Parent = content
corner(UI.livePanel, 8)

local box = Instance.new("TextBox")
box.Name = "ImportCode"
box.PlaceholderText = "Paste your code"
box.Text = ""
box.ClearTextOnFocus = false
box.Font = Enum.Font.Code
box.TextSize = 20
box.TextXAlignment = Enum.TextXAlignment.Left
box.TextColor3 = COL.text
box.PlaceholderColor3 = COL.dim
box.BackgroundColor3 = COL.field
box.BorderSizePixel = 0
box.Size = UDim2.new(1, 0, 0, 42)
box.LayoutOrder = 2
box.Parent = UI.codePanel
corner(box, 8)
local boxStroke = stroke(box, COL.stroke, 1)
local boxPad = Instance.new("UIPadding")
boxPad.PaddingLeft = UDim.new(0, 12)
boxPad.PaddingRight = UDim.new(0, 12)
boxPad.Parent = box
box.Focused:Connect(function() boxStroke.Color = COL.lilac end)
box.FocusLost:Connect(function() boxStroke.Color = COL.stroke end)

-- The familiar four settings stay visible before Import. One quiet surface
-- groups them; the right-hand values and switches carry their current state.
UI.settings = Instance.new("Frame")
UI.settings.Name = "ImportSettings"
UI.settings.BackgroundColor3 = COL.field
UI.settings.BorderSizePixel = 0
UI.settings.Size = UDim2.new(1, 0, 0, 128)
UI.settings.LayoutOrder = 3
UI.settings.Parent = content
corner(UI.settings, 8)
do
	local inset = Instance.new("UIPadding")
	inset.PaddingTop = UDim.new(0, 4)
	inset.PaddingBottom = UDim.new(0, 4)
	inset.PaddingLeft = UDim.new(0, 12)
	inset.PaddingRight = UDim.new(0, 12)
	inset.Parent = UI.settings
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 0)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = UI.settings
end

local saved = plugin:GetSetting("fw_placement")
if saved == "full" or saved == "fit" then placementMode = saved end
local modeBtn = UI.option(UI.settings, "Placement", "Placement", 1, false)
local function modeLabel()
	return placementMode == "full" and "Exact artboard" or "Fit & centre"
end
modeBtn.Text = modeLabel()
modeBtn.MouseButton1Click:Connect(function()
	placementMode = (placementMode == "full") and "fit" or "full"
	plugin:SetSetting("fw_placement", placementMode)
	modeBtn.Text = modeLabel()
end)

local savedSync = plugin:GetSetting("fw_sync")
if savedSync == false then syncMode = false end
local syncBtn = UI.option(UI.settings, "LiveSync", "Live Sync", 2, true)
local function syncLabel()
	UI.toggle(syncBtn, syncMode)
	return syncMode and "On" or "Off"
end
syncBtn.Text = syncLabel()
syncBtn.MouseButton1Click:Connect(function()
	syncMode = not syncMode
	plugin:SetSetting("fw_sync", syncMode)
	syncBtn.Text = syncLabel()
	if UI.syncSettingsChanged then UI.syncSettingsChanged() end
end)

local autoSyncOn = plugin:GetSetting("fw_autosync") == true
local lastSyncCode = plugin:GetSetting("fw_lastcode")
local importBusy = false
if type(lastSyncCode) ~= "string" or lastSyncCode == "" then lastSyncCode = nil end
local autoBtn = UI.option(UI.settings, "AutoSync", "Auto-sync", 3, true)
local function autoLabel()
	UI.toggle(autoBtn, autoSyncOn)
	if autoSyncOn and lastSyncCode and UI.inputMode == "code" then return lastSyncCode end
	return autoSyncOn and "On" or "Off"
end
autoBtn.Text = autoLabel()

do
	local bundleMode = plugin:GetSetting("fw_bundle") == true
	local row = Instance.new("TextButton")
	row.Name = "BundleScripts"
	row.Text = ""
	row.AutoButtonColor = false
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 30)
	row.LayoutOrder = 4
	row.Parent = UI.settings
	local check = Instance.new("Frame")
	check.Size = UDim2.fromOffset(18, 18)
	check.Position = UDim2.new(0, 0, 0.5, 0)
	check.AnchorPoint = Vector2.new(0, 0.5)
	check.BorderSizePixel = 0
	check.Parent = row
	corner(check, 4)
	stroke(check, COL.stroke, 1)
	local tick = UI.text(check, "✓", 12, COL.text)
	tick.TextXAlignment = Enum.TextXAlignment.Center
	local text = UI.text(row, "Bake into one script", 11.5, COL.dim, UDim2.fromOffset(28, 0), UDim2.new(1, -28, 1, 0))
	local function paint()
		check.BackgroundColor3 = bundleMode and COL.accent or COL.surface
		tick.Visible = bundleMode
		text.TextColor3 = bundleMode and COL.text or COL.dim
	end
	paint()
	row.MouseButton1Click:Connect(function()
		bundleMode = not bundleMode
		plugin:SetSetting("fw_bundle", bundleMode)
		paint()
	end)
end

