-- Framewisp: _float — gentle levitation along one direction.
-- Safe to delete: the layout stays, only the drifting stops.
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local DIST, SPEED, ANGLE = 8, 0.6, 0

local function num(el, manual, auto, def)
	local v = el:GetAttribute(manual)
	if type(v) ~= "number" then v = el:GetAttribute(auto) end
	if type(v) ~= "number" then v = def end
	return v
end

local function laidOutBy(el)
	local p = el.Parent
	if not p then return false end
	return p:FindFirstChildWhichIsA("UIGridLayout") ~= nil
		or p:FindFirstChildWhichIsA("UIListLayout") ~= nil
		or p:FindFirstChildWhichIsA("UITableLayout") ~= nil
		or p:FindFirstChildWhichIsA("UIPageLayout") ~= nil
end

local function slotFor(el)
	if not laidOutBy(el) then return end
	local slot = Instance.new("Frame")
	slot.Name = el.Name .. "_FloatSlot"
	slot:SetAttribute("FW_Owned", true)
	slot.BackgroundTransparency = 1
	slot.BorderSizePixel = 0
	slot.Size = el.Size
	slot.Position = el.Position
	slot.AnchorPoint = el.AnchorPoint
	slot.LayoutOrder = el.LayoutOrder
	slot.ZIndex = el.ZIndex
	slot.Visible = el.Visible
	slot.Parent = el.Parent
	el.AnchorPoint = Vector2.new(0, 0)
	el.Position = UDim2.fromScale(0, 0)
	el.Size = UDim2.fromScale(1, 1)
	el.Parent = slot
end

local floaters = {}
for _, d in ipairs(fwAll()) do
