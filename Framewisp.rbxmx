	blink.Source = [==[
-- Framewisp: _blink — the layer disappears and comes back, forever.
-- Visible/hidden seconds, fade time and a start delay come from the plugin;
-- a Studio attribute (BlinkOn / BlinkOff / BlinkFade / BlinkDelay) wins.
-- Safe to delete: the layer simply stays visible.
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end

local FADE_PROPS = {
	ImageLabel = { "ImageTransparency", "BackgroundTransparency" },
	ImageButton = { "ImageTransparency", "BackgroundTransparency" },
	TextLabel = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
	TextButton = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
	TextBox = { "TextTransparency", "BackgroundTransparency" },
	Frame = { "BackgroundTransparency" },
	ScrollingFrame = { "BackgroundTransparency" },
	CanvasGroup = { "GroupTransparency" },
	UIStroke = { "Transparency" },
}

local function num(el, manual, auto, def)
	local v = el:GetAttribute(manual)
	if type(v) ~= "number" then v = el:GetAttribute(auto) end
	if type(v) ~= "number" then v = def end
	return v
end

local function collect(root)
	local parts = {}
	local function add(inst)
		local props = FADE_PROPS[inst.ClassName]
		if not props then return end
		for _, prop in ipairs(props) do
			local ok, rest = pcall(function() return inst[prop] end)
			if ok and type(rest) == "number" then
				parts[#parts + 1] = { inst = inst, prop = prop, rest = rest }
			end
		end
	end
	add(root)
	local function under(inst) -- an arrow or a card shows and hides itself: never faded from here
		for _, c in ipairs(inst:GetChildren()) do
			if not (c:GetAttribute("FigmaPointer") or c:GetAttribute("FigmaCard")) then add(c); under(c) end
		end
	end
	under(root)
	return parts
end

local targets = {}
for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaBlink") and d:IsA("GuiObject") then
		targets[#targets + 1] = { el = d, parts = collect(d) }
	end
end
if #targets == 0 then return end

local function fade(t, hidden, seconds)
	for _, part in ipairs(t.parts) do
		if part.inst.Parent then
			local goal = hidden and 1 or part.rest
			if seconds <= 0.001 then
				pcall(function() part.inst[part.prop] = goal end)
			else
				TweenService:Create(part.inst, TweenInfo.new(seconds, Enum.EasingStyle.Quad), { [part.prop] = goal }):Play()
			end
		end
	end
end

for _, t in ipairs(targets) do
	task.spawn(function()
		local el = t.el
		task.wait(num(el, "BlinkDelay", "FigmaBlinkDelay", 0))
		while el.Parent do
			local fadeS = math.max(0, num(el, "BlinkFade", "FigmaBlinkFade", 0.25))
			local onS = math.max(0.05, num(el, "BlinkOn", "FigmaBlinkOn", 1.2))
			local offS = math.max(0.05, num(el, "BlinkOff", "FigmaBlinkOff", 0.8))
			task.wait(onS)
			if not el.Parent then break end
			fade(t, true, fadeS)
			task.wait(offS + fadeS)
			if not el.Parent then break end
			fade(t, false, fadeS)
			task.wait(fadeS)
		end
	end)
end
