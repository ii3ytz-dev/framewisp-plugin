	pr.Source = [==[
-- Framewisp: _prompt — this billboard is the custom UI of a ProximityPrompt.
-- Visuals only: shows the UI when the prompt appears; while the key is held,
-- every _hold element fills with the hold colour — its OWN stroke repainted
-- through a gradient with a hard sweeping edge (no copies; the stroke turns
-- white and the gradient carries both colours, because gradients multiply).
-- Released early, the fill drains back instead of snapping. Colour/style:
-- Colour: a "HoldColor" (Color3) attribute on the _hold element.
-- Your game logic connects prompt.Triggered in your own script — the prompt
-- sits on the anchor Part, where KeyCode, HoldDuration and
-- MaxActivationDistance are plain Properties. Safe to delete for a static UI.
local pps = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwBillboards()
	local list = {}
	if gui:IsA("BillboardGui") then list[#list + 1] = gui end
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value and v.Value:IsA("BillboardGui") then
			list[#list + 1] = v.Value
		end
	end
	for _, v in ipairs(gui:GetDescendants()) do
		if v:IsA("BillboardGui") then list[#list + 1] = v end
	end
	return list
end
local function wire(bb)
	local root = bb:FindFirstChildWhichIsA("GuiObject")
	if not root or root:GetAttribute("FigmaPrompt") == nil then return end
	local anchor = bb.Adornee
	if typeof(anchor) ~= "Instance" then anchor = bb.Parent end
	if typeof(anchor) ~= "Instance" or not anchor:IsA("BasePart") then return end
	local prompt = anchor:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then return end
	bb.Enabled = false
	print(("[Framewisp] prompt runtime v%s on %s"):format(tostring(script:GetAttribute("FWv")), bb:GetFullName()))
	local fills = {}
	for _, d in ipairs(bb:GetDescendants()) do
		if d:GetAttribute("FigmaHold") ~= nil and d:IsA("GuiObject") then fills[#fills + 1] = d end
	end
	local wraps = {}
	for _, f in ipairs(fills) do
		local col = f:GetAttribute("HoldColor")
		if typeof(col) ~= "Color3" then
			local n = tonumber(f:GetAttribute("FigmaHoldColor"))
			col = n and Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
				or Color3.fromRGB(34, 197, 94)
		end
		do
			local st = f:FindFirstChildOfClass("UIStroke")
			local host, base
			if st then
				base = st.Color
				st.Color = Color3.new(1, 1, 1) -- gradients multiply; white lets the gradient paint
				host = st
			else
				base = f:IsA("ImageLabel") and f.ImageColor3 or f.BackgroundColor3
				if f:IsA("ImageLabel") then f.ImageColor3 = Color3.new(1, 1, 1)
				else f.BackgroundColor3 = Color3.new(1, 1, 1) end
				host = f
			end
			local grad = Instance.new("UIGradient")
			grad.Color = ColorSequence.new(base)
			grad.Parent = host
			print(("[Framewisp] hold %q: %s"):format(f.Name, st and "fills its stroke" or "BACKGROUND fill (this layer has no UIStroke)"))
			wraps[#wraps + 1] = { grad = grad, base = base, col = col }
		end
	end
	local function setFill(p)
		for _, w in ipairs(wraps) do
			if p >= 0.96 then
				w.grad.Color = ColorSequence.new(w.col)
			elseif p <= 0.001 then
				w.grad.Color = ColorSequence.new(w.base) -- the designed look, exactly
			else
				local edge = math.clamp(p * 1.08 - 0.04, 0.002, 0.996)
				w.grad.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, w.col),
					ColorSequenceKeypoint.new(edge, w.col),
					ColorSequenceKeypoint.new(math.min(edge + 0.002, 0.998), w.base),
					ColorSequenceKeypoint.new(1, w.base),
				})
			end
		end
	end
	local holding = nil
	local fillNow = 0
	local rawSetFill = setFill
	setFill = function(p) fillNow = p rawSetFill(p) end
	pps.PromptShown:Connect(function(pp)
		if pp == prompt then bb.Enabled = true setFill(0) end
	end)
	pps.PromptHidden:Connect(function(pp)
		if pp == prompt then bb.Enabled = false holding = nil setFill(0) end
	end)
	prompt.PromptButtonHoldBegan:Connect(function()
		local t0 = os.clock()
		holding = t0
		local dur = math.max(prompt.HoldDuration, 0.05)
		local conn
		conn = RunService.RenderStepped:Connect(function()
			if holding ~= t0 then conn:Disconnect() return end
			local p = math.min((os.clock() - t0) / dur, 1)
			setFill(p)
			if p >= 1 then conn:Disconnect() end
		end)
	end)
	local firedAt = 0
	prompt.PromptButtonHoldEnded:Connect(function()
		holding = nil
		if os.clock() - firedAt < 0.6 then return end -- a completed hold is not a release
		local from = fillNow -- drain back, 3x faster than the fill
		local t0 = os.clock()
		local dur = math.max(prompt.HoldDuration, 0.05) / 3 * from
		if dur <= 0 then setFill(0) return end
		local conn
		conn = RunService.RenderStepped:Connect(function()
			if holding then conn:Disconnect() return end
			local k = math.min((os.clock() - t0) / dur, 1)
			setFill(from * (1 - k))
			if k >= 1 then conn:Disconnect() end
		end)
	end)
	prompt.Triggered:Connect(function()
		firedAt = os.clock()
		holding = nil
		setFill(1)
		task.delay(0.45, function() if not holding then setFill(0) end end)
	end)
end
for _, bb in ipairs(fwBillboards()) do
	local ok, err = pcall(wire, bb)
	if not ok then warn("[Framewisp] prompt: " .. tostring(err)) end
end
