}]========],
    ["Ripple"] = [========[return {
    tag = "_ripple",
    setup = function(ctx, button)
        if not button:IsA("GuiButton") then return end
        ctx:on(button, "down", function()
            button.ClipsDescendants = true
            local wave = Instance.new("Frame")
            wave.Name = "FramewispRipple"; wave.AnchorPoint = Vector2.new(.5, .5); wave.Position = UDim2.fromScale(.5, .5); wave.Size = UDim2.fromOffset(0, 0)
            wave.BackgroundColor3 = ctx:hex(ctx:attr(button, "rippleColor", "#ffffff"), Color3.new(1, 1, 1)); wave.BackgroundTransparency = 1 - (tonumber(ctx:attr(button, "rippleOp", .4)) or .4)
            wave.BorderSizePixel = 0; wave.ZIndex = button.ZIndex + 20; wave.Parent = button
            local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1, 0); corner.Parent = wave
            local diameter = math.sqrt(button.AbsoluteSize.X ^ 2 + button.AbsoluteSize.Y ^ 2) * 2
            local animation = ctx:tween(wave, ctx:attr(button, "rippleTime", .45), { Size = UDim2.fromOffset(diameter, diameter), BackgroundTransparency = 1 })
