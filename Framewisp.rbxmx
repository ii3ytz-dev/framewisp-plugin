	-- _drift: an endless scrolling texture. Roblox cannot move a tile inside its
	-- own ImageLabel, so the LABEL moves instead — it is one tile larger than the
	-- window it sits in, and its offset is taken modulo the tile. The pattern
	-- repeats every tile, so "one tile along" and "not moved at all" are the same
	-- picture: the walk never ends and never shows a seam.
	local drift = Instance.new("LocalScript")
	drift.Name = "FramewispDrift"
	drift.Source = [==[
-- Framewisp: _drift — a tiled texture that scrolls forever.
-- Speed is design px/s; direction is a compass (0 = up, 270 = left).
-- Per-element Studio attributes DriftSpeed / DriftAngle win over the plugin's.
-- Safe to delete: the texture stays, it just stops moving.
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local SPEED, ANGLE = 40, 270

local function num(el, manual, auto, def)
	local v = el:GetAttribute(manual)
	if type(v) ~= "number" then v = el:GetAttribute(auto) end
	if type(v) ~= "number" then v = def end
	return v
end

local movers = {}
for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaDrift") and d:IsA("ImageLabel") then
		movers[#movers + 1] = { el = d, d = 0 }
	end
end
if #movers == 0 then return end

RunService.RenderStepped:Connect(function(dt)
	for _, m in ipairs(movers) do
		local el = m.el
		if el.Parent then
			local size = el.AbsoluteSize
			local tw = el.TileSize.X.Scale * size.X + el.TileSize.X.Offset
			local th = el.TileSize.Y.Scale * size.Y + el.TileSize.Y.Offset
			if tw > 0.5 and th > 0.5 then
				local designW = el:GetAttribute("FigmaTileW")
				local k = (type(designW) == "number" and designW > 0.5) and (tw / designW) or 1
				m.d = m.d + num(el, "DriftSpeed", "FigmaDriftSpeed", SPEED) * k * dt
				local a = math.rad(num(el, "DriftAngle", "FigmaDriftAngle", ANGLE))
				local dx, dy = math.sin(a) * m.d, -math.cos(a) * m.d
				local ax, ay = el.AnchorPoint.X * size.X, el.AnchorPoint.Y * size.Y
				el.Position = UDim2.fromOffset((dx % tw) - tw + ax, (dy % th) - th + ay)
			end
		end
	end
end)
]==]
	stampRuntime(drift)
	drift:SetAttribute("FWv", 2)
