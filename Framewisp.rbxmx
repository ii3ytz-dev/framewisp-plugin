	end

	if hasSelect and not screen:FindFirstChild("FramewispSelect") then
	-- _select: one live choice per parent. The button keeps its baked look and
	-- gains an outline that animates in when it is picked — the inventory-slot
	-- behaviour every shop UI ends up writing by hand.
	local sel = Instance.new("LocalScript")
	sel.Name = "FramewispSelect"
	sel.Source = [==[
-- Framewisp: _select — click a card to select it, one at a time per parent.
-- Put the tag on the thing that should light up: the outline square you drew
-- INSIDE the card works, and so does the card itself.
-- The outline colour/thickness/pop come from the plugin; a Studio attribute wins.
local TweenService = game:GetService("TweenService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function fwScaleHost(el) -- Roblox honours ONE UIScale per object
	local sc = el:FindFirstChild("FW_Scale")
	if not sc then
		sc = el:FindFirstChildWhichIsA("UIScale")
		if sc then
			sc.Name = "FW_Scale"
		else
			sc = Instance.new("UIScale")
			sc.Name = "FW_Scale"
			sc:SetAttribute("FW_Owned", true)
			sc.Parent = el
		end
	end
	return sc
end
local function fwScaleApply(host)
	local total = 1
	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("NumberValue") then total = total * ch.Value end
	end
	host.Scale = total
end
local function fwChannel(el, key) -- every runtime writes its OWN channel; the product applies once
	local host = fwScaleHost(el)
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function() fwScaleApply(host) end)
	end
	return ch
end
local function fwRotSet(el, key, deg) -- Rotation is shared by three runtimes too
	local base = el:GetAttribute("FW_RotBase")
	if base == nil then
		base = el.Rotation
		el:SetAttribute("FW_RotBase", base)
	end
	el:SetAttribute(key, deg)
	local total = 0
	for _, k in ipairs({ "r_juice", "r_spin", "r_tl", "r_hover" }) do
		local v = el:GetAttribute(k)
		if type(v) == "number" then total = total + v end
	end
	el.Rotation = base + total
end
local GREEN, WIDTH, POP, TIME = Color3.fromRGB(74, 222, 128), 3, 1.06, 0.18
local POP_TIME = 0.16

local function num(el, manual, auto, def)
	local v = el:GetAttribute(manual)
	if type(v) ~= "number" then v = el:GetAttribute(auto) end
	if type(v) ~= "number" then v = def end
	return v
end

local function colourOf(el)
	local v = el:GetAttribute("SelectColor")
	if typeof(v) == "Color3" then return v end
	if type(v) ~= "number" then v = el:GetAttribute("FigmaSelectColor") end
	if type(v) == "number" then return Color3.fromRGB(math.floor(v / 65536) % 256, math.floor(v / 256) % 256, v % 256) end
	return GREEN
end

local current = nil
local function outlineOf(btn)
	local st = btn:FindFirstChildWhichIsA("UIStroke")
	if not st then
		st = Instance.new("UIStroke")
		st.Name = "FWSelectOutline"
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Thickness = 0
		st.Transparency = 1
		st.Parent = btn
	end
	return st
end

local function scaleOf(btn)
	return fwChannel(btn, "k_select") -- its own channel: _smooth owns k_btn
end

local function paint(mark, on, btn)
	local st = outlineOf(mark)
	local t = num(mark, "SelectTime", "FigmaSelectTime", TIME)
	local w = num(mark, "SelectWidth", "FigmaSelectWidth", WIDTH)
	local rest = st:GetAttribute("FWRestWidth")
	if type(rest) ~= "number" then
		rest = st.Thickness
		st:SetAttribute("FWRestWidth", rest)
		st:SetAttribute("FWRestColor", st.Color)
		st:SetAttribute("FWRestAlpha", st.Transparency)
	end
	if t <= 0.001 then
		if on then
			st.Color = colourOf(mark)
			st.Thickness = st:GetAttribute("FW_StrokeScaled") and (w / math.max(1, math.min(btn.AbsoluteSize.X, btn.AbsoluteSize.Y))) or w
			st.Transparency = 0
		else
			st.Thickness = rest
			st.Transparency = st:GetAttribute("FWRestAlpha") or 1
		end
	elseif on then
		local info = TweenInfo.new(t, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		st.Color = colourOf(mark)
		TweenService:Create(st, info, { Thickness = w, Transparency = 0 }):Play()
	else
		TweenService:Create(st, TweenInfo.new(t), {
			Thickness = rest,
			Transparency = st:GetAttribute("FWRestAlpha") or 1,
		}):Play()
	end
	local pop = num(mark, "SelectPop", "FigmaSelectPop", POP)
	if on and pop > 1.001 and btn then
		local pt = math.max(t, POP_TIME)
		local sc = scaleOf(btn)
		local up = TweenService:Create(sc, TweenInfo.new(pt * 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = pop })
		up.Completed:Connect(function()
			TweenService:Create(sc, TweenInfo.new(pt * 0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 1 }):Play()
		end)
		up:Play()
	end
end

local function clickTargetFor(el)
	local n = el
	while n and n ~= gui do
		if n:IsA("GuiButton") then return n end
		n = n.Parent
	end
	return nil
end

for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaSelect") and d:IsA("GuiObject") then
		local mark = d
		local btn = clickTargetFor(mark)
		local host = btn or mark
		outlineOf(mark) -- built up front so the first click has nothing to create
		local group = host.Parent
		local function release(m)
			if not (m and m.Parent) then return end
			local pb = clickTargetFor(m) or m
			paint(m, false, pb)
			pb:SetAttribute("FWSelected", false)
			if pb.Parent then pb.Parent:SetAttribute("FWSelected", nil) end
		end
		local function choose()
			if current == mark then -- the same card takes its choice back
				release(mark)
				current = nil
				return
			end
			release(current)
			current = mark
			host:SetAttribute("FWSelected", true)
			if group then group:SetAttribute("FWSelected", host.Name) end
			paint(mark, true, host)
		end
		if btn then
			btn.MouseButton1Click:Connect(choose)
		else
			mark.Active = true
			mark.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					choose()
				end
			end)
		end
	end
end
