-- Framewisp: hand-authored timelines (fwtl v1) — intro lane once per appearance,
-- loop lane forever after. Channels: scale, rot, x, y, op, pitch.
-- Safe to delete: the layer simply keeps its designed pose.
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function fwScaleHost(el) -- Roblox honours ONE UIScale per object
	local sc = el:FindFirstChild("FW_Scale")
	if not sc then
		sc = el:FindFirstChildWhichIsA("UIScale")
		if sc then
			sc.Name = "FW_Scale"
		else
			sc = Instance.new("UIScale")
			sc.Name = "FW_Scale"
			sc:SetAttribute("FW_Owned", true)
			sc.Parent = el
		end
	end
	return sc
end
local function fwScaleApply(host)
	local total = 1
	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("NumberValue") then total = total * ch.Value end
	end
	host.Scale = total
end
local function fwChannel(el, key) -- every runtime writes its OWN channel; the product applies once
	local host = fwScaleHost(el)
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function() fwScaleApply(host) end)
	end
	return ch
end
local function fwRotSet(el, key, deg) -- Rotation is shared by three runtimes too
	local base = el:GetAttribute("FW_RotBase")
	if base == nil then
		base = el.Rotation
		el:SetAttribute("FW_RotBase", base)
	end
	el:SetAttribute(key, deg)
	local total = 0
	for _, k in ipairs({ "r_juice", "r_spin", "r_tl", "r_hover" }) do
		local v = el:GetAttribute(k)
		if type(v) == "number" then total = total + v end
	end
	el.Rotation = base + total
end

local DEFS = { scale = 1, rot = 0, x = 0, y = 0, op = 1, pitch = 0 }
local function cubicBezier(e, p)
	local x1, y1, x2, y2 = e:match("^c:([%-%d%.]+),([%-%d%.]+),([%-%d%.]+),([%-%d%.]+)$")
	x1, y1, x2, y2 = tonumber(x1) or 0, tonumber(y1) or 0, tonumber(x2) or 1, tonumber(y2) or 1
	local t = p
	for _ = 1, 8 do
		local omt = 1 - t
		local x = 3 * omt * omt * t * x1 + 3 * omt * t * t * x2 + t * t * t
		local dx = 3 * omt * omt * x1 + 6 * omt * t * (x2 - x1) + 3 * t * t * (1 - x2)
		if math.abs(dx) < 1e-6 then break end
		t = math.clamp(t - (x - p) / dx, 0, 1)
	end
	local o = 1 - t
	return 3 * o * o * t * y1 + 3 * o * t * t * y2 + t * t * t
end
local function ease(e, p)
	if type(e) == "string" and e:sub(1, 2) == "c:" then return cubicBezier(e, p) end
	if e == "out" then return 1 - (1 - p) ^ 3 end
	if e == "inout" then if p < 0.5 then return 4 * p * p * p else return 1 - ((-2 * p + 2) ^ 3) / 2 end end
	if e == "back" then local c = 2.2 return 1 + (c + 1) * (p - 1) ^ 3 + c * (p - 1) ^ 2 end
	if e == "hold" then if p >= 1 then return 1 else return 0 end end
	return p
end
local function sample(keys, t, def)
	if not keys or #keys == 0 then return def end
	if t <= keys[1].t then return keys[1].v end
	local last = keys[#keys]
	if t >= last.t then return last.v end
	for i = 2, #keys do
		if t <= keys[i].t then
			local k0, k1 = keys[i - 1], keys[i]
			local span = math.max(1e-6, k1.t - k0.t)
			return k0.v + (k1.v - k0.v) * ease(k1.e or "lin", (t - k0.t) / span)
		end
	end
	return last.v
end

local function fadeTargets(el)
	local map = {
		ImageLabel = { "ImageTransparency", "BackgroundTransparency" },
		ImageButton = { "ImageTransparency", "BackgroundTransparency" },
		TextLabel = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
		TextButton = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
		Frame = { "BackgroundTransparency" },
		ScrollingFrame = { "BackgroundTransparency" },
		CanvasGroup = { "GroupTransparency" },
		UIStroke = { "Transparency" },
	}
	local list = {}
	local function grab(inst)
		local props = map[inst.ClassName]
		if props then
			for _, pr in ipairs(props) do
				list[#list + 1] = { inst = inst, prop = pr, base = inst[pr] }
			end
		end
	end
	grab(el)
	local function under(inst) -- an arrow or a card shows and hides itself: never faded from here
		for _, c in ipairs(inst:GetChildren()) do
			if not (c:GetAttribute("FigmaPointer") or c:GetAttribute("FigmaCard")) then grab(c); under(c) end
		end
	end
	under(el)
	return list
end

local function slotFor(el)
	local p = el.Parent
	if not p or p:GetAttribute("FW_TLSlot") then return end
	local slot = Instance.new("Frame")
	slot.Name = el.Name .. "_TLSlot"
	slot.BackgroundTransparency = 1
	slot.Size = el.Size
	slot.Position = el.Position
	slot.AnchorPoint = el.AnchorPoint
	slot.LayoutOrder = el.LayoutOrder
	slot.ZIndex = el.ZIndex -- the wrapper takes the layer's PLACE, order included
	slot.Visible = el.Visible
	slot:SetAttribute("FW_Owned", true)
	slot:SetAttribute("FW_TLSlot", true)
	slot.Parent = p
	el.Size = UDim2.fromScale(1, 1)
	el.Position = UDim2.fromScale(0.5, 0.5)
	el.AnchorPoint = Vector2.new(0.5, 0.5)
	el.Parent = slot
end

local played = {}
local function wire(el)
	if not el:IsA("GuiObject") then return end
	local raw = el:GetAttribute("FigmaTimeline")
	if type(raw) ~= "string" or el:GetAttribute("FW_TL") then return end
	el:SetAttribute("FW_TL", true)
	local ok, tl = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok or type(tl) ~= "table" then return end
	slotFor(el)
	local entry = { el = el, tl = tl, t = 0, base = el.Rotation, fade = nil }
	local function start()
		entry.t = 0
		entry.fade = entry.fade or fadeTargets(el)
		played[el] = entry
	end
	if el.Visible then start() end
	el:GetPropertyChangedSignal("Visible"):Connect(function()
		if el.Visible then start() end
	end)
end
for _, d in ipairs(fwAll()) do wire(d) end
for _, r in ipairs(fwRoots()) do r.DescendantAdded:Connect(wire) end

RunService.RenderStepped:Connect(function(dt)
	for el, e in pairs(played) do
		if el.Parent and el.Visible then
			local tl = e.tl
			e.t = e.t + dt * ((tonumber(tl.fps) or 30) / 30)
			local lane, t01
			local iDur = 0
			if tl.intro then iDur = math.max(0.05, tonumber(tl.intro.dur) or 1) end
			if tl.intro and e.t < iDur then
				lane = tl.intro
				t01 = e.t / iDur
			elseif tl.loop then
				lane = tl.loop
				local d = math.max(0.05, tonumber(tl.loop.dur) or 1)
				t01 = ((e.t - iDur) % d) / d
			else
				lane = tl.intro
				t01 = 1
			end
			local ch = lane and lane.ch or nil
			local v = {}
			for name, def in pairs(DEFS) do
				v[name] = sample(ch and ch[name], t01, def)
			end
			local pr = math.rad(v.pitch)
			e.el.Size = UDim2.fromScale(v.scale, v.scale * math.abs(math.cos(pr)))
			e.el.Position = UDim2.fromScale(0.5 + v.x, 0.5 + v.y - math.sin(pr) * 0.09)
			e.el.Rotation = e.base + v.rot
			local fadeAmt = 1 - math.clamp(v.op, 0, 1)
			for _, tg in ipairs(e.fade) do
				tg.inst[tg.prop] = tg.base + (1 - tg.base) * fadeAmt
			end
		end
	end
end)
