retryImagesBtn.MouseButton1Click:Connect(function()
	local found, remaining, roots = 0, 0, 0
	for _, sg in ipairs(StarterGui:GetChildren()) do
		if (sg:IsA("ScreenGui") or sg:IsA("SurfaceGui")) and (sg:GetAttribute("FW_Owned") or sg:GetAttribute("BB_DesignH")) then
			local root = findManagedRoot(sg)
			if root then
				roots = roots + 1
				local before, left = retryUnresolvedImages(root, true)
				found = found + (before or 0)
				remaining = remaining + (left or 0)
			end
		end
	end
	if roots == 0 then
		status.TextColor3 = COL.dim
		status.Text = "No Framewisp UI was found in StarterGui."
	elseif found == 0 then
		status.TextColor3 = COL.ok
		status.Text = "All Framewisp images are already resolved."
	elseif remaining == 0 then
		status.TextColor3 = COL.ok
		status.Text = ("Resolved %d image(s)."):format(found)
	else
		status.TextColor3 = COL.dim
		status.Text = ("Retried %d image(s); %d still processing. Automatic retries continue in the background."):format(found, remaining)
	end
end)

-- ================================================================== auto-sync poll
-- One watcher at a time: bumping the generation retires any previous loop (toggle
-- flips, re-imports, new codes) without having to hunt down its thread.
local autoGen = 0

-- Settings are GLOBAL per user across every place. Only watch a code when THIS place
-- actually contains its import (FW_Code ScreenGui) — otherwise opening another
-- project would auto-build the synced GUI into the wrong game.
local function placeHasTarget()
	if not lastSyncCode then
		return false
	end
	for _, sg in ipairs(StarterGui:GetChildren()) do
		if (sg:IsA("ScreenGui") or sg:IsA("SurfaceGui")) and sg:GetAttribute("FW_Code") == lastSyncCode then
			return true
		end
	end
	return false
end

local function startAutoSync()
	autoGen = autoGen + 1
	local myGen = autoGen
	local code = lastSyncCode
	if not (UI.inputMode == "code" and autoSyncOn and syncMode and code) then return end
	task.spawn(function()
		-- Baseline on the rev we actually IMPORTED (persisted across restarts), so a
		-- push made while Studio was closed still lands on the first poll instead of
		-- being swallowed as "current".
		local lastRev = lastImportRev or tonumber(plugin:GetSetting("fw_lastrev"))
		local interval = 5
		-- A single 404 is NOT proof the code expired — the meta key can lag KV
		-- propagation right after a convert. Only give up after several in a row.
		local miss404 = 0
		while UI.inputMode == "code" and autoSyncOn and syncMode and myGen == autoGen do
			local ok, res = pcall(function()
				return HttpService:RequestAsync({ Url = BACKEND_URL .. "/import/" .. code .. "/version", Method = "GET" })
			end)
			if myGen ~= autoGen or UI.inputMode ~= "code" or not (autoSyncOn and syncMode) then break end
			if ok and res.Success then
				miss404 = 0 -- a 200 proves the code is alive; clear the miss streak
				local ok2, data = pcall(function()
					return HttpService:JSONDecode(res.Body)
				end)
				if ok2 and type(data) == "table" and type(data.rev) == "number" then
					-- The server sets the pace (3 s right after a push, 10 s for a code at
					-- rest): every poll is a billed request. An older server says nothing: 5 s.
					local pace = (type(data.pollMs) == "number" and data.pollMs >= 1000 and data.pollMs <= 60000) and data.pollMs / 1000 or 5
					if lastRev == nil then
						-- No known import rev (legacy import): current rev becomes the baseline.
						lastRev = data.rev
						interval = pace
					elseif data.rev ~= lastRev then
						if importBusy then
							-- A manual import (or the previous watcher pass) is still yielding.
							-- Keep the old baseline so this revision is retried next poll.
							interval = 2
						else
							status.TextColor3 = COL.dim
							status.Text = "Auto-sync: updating from Figma…"
							importBusy = true
							local ran, ok3, msg = pcall(importByCode, code)
							importBusy = false
							if myGen ~= autoGen then break end
							if ran and ok3 then
							-- Commit ONLY after success, and commit what was ACTUALLY
							-- imported (the body's own rev), not the poll's rev: a stale
							-- cache can serve a pre-push body under a bumped rev, and
							-- baselining on the poll's rev would drop that edit forever.
							-- With the body rev the next tick sees the gap and retries.
							lastRev = lastImportRev or data.rev
							plugin:SetSetting("fw_lastrev", lastRev)
							interval = pace
							status.TextColor3 = COL.ok
							status.Text = "Auto-sync " .. os.date("%H:%M:%S") .. " — " .. tostring(msg)
							else
								interval = math.min(math.max(interval, 5) * 2, 60) -- retry with backoff
								status.TextColor3 = COL.err
								status.Text = "Auto-sync error: " .. tostring(ran and msg or ok3)
							end
						end
					else
						interval = pace
					end
				end
			elseif ok and res.StatusCode == 404 then
				miss404 = miss404 + 1
				if miss404 >= 3 then
					-- Code genuinely gone (24h TTL). Stop cleanly and say what to do next.
					autoSyncOn = false
					plugin:SetSetting("fw_autosync", false)
					autoBtn.Text = autoLabel()
					status.TextColor3 = COL.err
					status.Text = "Auto-sync stopped: the code expired (24h). Convert in Figma again and import the new code (Figma may already show it)."
					break
				else
					-- Likely a transient propagation gap on a still-valid code — back
					-- off and keep watching instead of giving up on the first miss.
					interval = math.min(math.max(interval, 5) * 2, 60)
					status.TextColor3 = COL.dim
					status.Text = "Auto-sync: reconnecting…"
				end
			else
				-- Transport hiccup / rate limit: back off, keep watching.
				interval = math.min(interval * 2, 60)
			end
			task.wait(interval)
		end
	end)
end

autoBtn.MouseButton1Click:Connect(function()
	autoSyncOn = not autoSyncOn
	plugin:SetSetting("fw_autosync", autoSyncOn)
	autoBtn.Text = autoLabel()
	if UI.syncSettingsChanged then UI.syncSettingsChanged() end
end)
-- Resume watching across Studio restarts — but only in the place that actually
-- contains this import (see placeHasTarget).
if UI.inputMode == "code" and autoSyncOn and syncMode and lastSyncCode then
	if placeHasTarget() then
		startAutoSync()
	else
		status.TextColor3 = COL.dim
		status.Text = "Auto-sync paused — this place doesn't contain " .. lastSyncCode .. ". Import it here to resume."
	end
end

-- ================================================================ Live delivery
-- The link persists across modes; only an open Live tab in Edit mode receives.
-- The scoped controller avoids adding permanent main-chunk Luau registers.
do
local liveTok = plugin:GetSetting("fw_livetoken")
if type(liveTok) ~= "string" or not liveTok:match("^%x+$") then liveTok = nil end
local liveOn = liveTok ~= nil and plugin:GetSetting("fw_liveon") ~= false
local liveSeq, liveGen = 0, 0
local receiverId = HttpService:GenerateGUID(false):gsub("[^A-Za-z0-9_-]", "")
local EditRun = game:GetService("RunService")
local dirty, serverReady, pendingAck, lastFailure, pairBusy = true, false, nil, nil, false
local presenceAt = -math.huge
local panel = UI.livePanel
local title = UI.text(panel, "Live from Figma", 11.5, COL.text, UDim2.fromOffset(12, 8), UDim2.new(1, -116, 0, 16), true)
title.Name = "LiveTitle"
local state = UI.text(panel, "", 10.5, COL.dim, UDim2.new(1, -110, 0, 8), UDim2.fromOffset(98, 16))
state.Name = "LiveState"
state.TextXAlignment = Enum.TextXAlignment.Right
local help = UI.text(panel, "", 10.5, COL.dim, UDim2.fromOffset(12, 29), UDim2.new(1, -24, 0, 30))
help.Name = "LiveHelp"
help.TextWrapped = true
help.TextYAlignment = Enum.TextYAlignment.Top
local pair = Instance.new("TextBox")
pair.Name = "LivePairCode"
pair.PlaceholderText = "L-XXXXXX"
pair.Text = ""
pair.ClearTextOnFocus = false
pair.Font = Enum.Font.Code
pair.TextSize = 15
pair.TextColor3 = COL.text
pair.PlaceholderColor3 = COL.dim
pair.BackgroundColor3 = COL.bg
pair.BorderSizePixel = 0
pair.Position = UDim2.fromOffset(12, 52)
pair.Size = UDim2.new(1, -106, 0, 32)
pair.Parent = panel
corner(pair, 5)
do
	local inset = Instance.new("UIPadding")
	inset.PaddingLeft = UDim.new(0, 9)
	inset.PaddingRight = UDim.new(0, 9)
	inset.Parent = pair
end
local function action(name, text, position, dimensions)
	local b = Instance.new("TextButton")
	b.Name, b.Text = name, text
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 10.5
	b.TextColor3 = COL.text
	b.BackgroundColor3 = COL.surface
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Position, b.Size = position, dimensions
	b.Parent = panel
	corner(b, 5)
	UI.hover(b, COL.surface, COL.stroke)
	return b
end
local connect = action("LiveConnect", "Connect", UDim2.new(1, -86, 0, 52), UDim2.fromOffset(74, 32))
local toggle = action("LivePause", "Pause", UDim2.new(1, -86, 0, 30), UDim2.fromOffset(74, 28))
local enable = action("LiveEnableBoth", "Enable Live Sync + Auto-sync", UDim2.fromOffset(12, 67), UDim2.new(1, -24, 0, 29))
local function active()
	return UI.inputMode == "live" and liveOn and widget.Enabled and EditRun:IsEdit()
end
local function ready()
	return liveTok ~= nil and active() and syncMode and autoSyncOn
end
local function say(text, color)
	status.TextColor3 = color or COL.dim
	status.Text = text
end
lateNote = function(msg, good)
	status.TextColor3 = good and COL.ok or COL.err
	status.Text = status.Text .. " " .. msg
end
local function paintLive()
	local blocked = not (syncMode and autoSyncOn)
	pair.Visible, connect.Visible = liveTok == nil, liveTok == nil
	pair.TextEditable, pair.Active = liveTok == nil and not pairBusy, liveTok == nil and not pairBusy
	connect.Active = not pairBusy
	connect.Text = pairBusy and "Linking…" or "Connect"
	toggle.Visible = liveTok ~= nil
	toggle.Text = liveOn and "Pause" or "Resume"
	enable.Visible = blocked
	enable.Position = UDim2.fromOffset(12, liveTok and 70 or 94)
	panel.Size = UDim2.new(1, 0, 0, (liveTok and 70 or 96) + (blocked and 38 or 0))
	help.Size = UDim2.new(1, liveTok and -110 or -24, 0, 32)
	state.TextColor3, help.TextColor3 = COL.dim, COL.dim
	if not liveTok then
		state.Text = "Not linked"
		help.Text = "In Figma, choose Live and get a link code."
	elseif blocked then
		state.Text, state.TextColor3 = "Setup required", COL.err
		help.Text = "Enable Live Sync and Auto-sync to receive designs."
		help.TextColor3 = COL.err
	elseif not liveOn then
		state.Text = "Paused"
		help.Text = "Your account is still linked. Resume when ready."
	elseif not widget.Enabled or not EditRun:IsEdit() then
		state.Text = "Not receiving"
		help.Text = "Keep this panel open in Edit mode."
	elseif UI.inputMode ~= "live" then
		state.Text = "Code mode"
		help.Text = "Choose Live to receive designs from Figma."
	elseif importBusy then
		state.Text = "Importing…"
		help.Text = "Applying your design to this place."
	elseif pendingAck then
		state.Text = "Confirming…"
		help.Text = "Confirming delivery to Figma."
	elseif lastFailure then
		state.Text, state.TextColor3 = "Import failed", COL.err
		help.Text = "See the error below, then send the design again."
	elseif serverReady then
		state.Text, state.TextColor3 = "Ready", COL.ok
		help.Text = "Send a design from Figma. It will appear here."
	else
		state.Text = "Connecting…"
		help.Text = "Checking the Live connection."
	end
end
local function unlinked(why)
	liveTok, liveOn, pendingAck = nil, false, nil
	liveGen, liveSeq = liveGen + 1, 0
	serverReady = false
	plugin:SetSetting("fw_livetoken", nil)
	plugin:SetSetting("fw_liveon", false)
	paintLive()
	say(why, COL.err)
end
local function presenceUrl(forceInactive)
	return BACKEND_URL .. "/live/inbox?protocol=2&pace=1&liveSync=" .. (syncMode and "1" or "0") -- pace=1: this client follows pollMs
		.. "&autoSync=" .. (autoSyncOn and "1" or "0") .. "&active=" .. ((not forceInactive and active()) and "1" or "0")
		.. "&receiverId=" .. receiverId
end
local function responseBody(res)
	local ok, body = pcall(function() return HttpService:JSONDecode(res.Body) end)
	return ok and type(body) == "table" and body or {}
end
local function obsolete(res, body)
	return (res.StatusCode == 409 and body.error == "live_superseded")
		or (res.StatusCode == 404 and body.error == "live_transfer_not_found")
end
local function finishAck()
	local receipt = pendingAck
	if not receipt or not ready() then return false end
	if not receipt.acked then
		-- A large design can take longer than the server's presence lease to build.
		-- Renew before acknowledging, without re-running that completed build.
		if os.clock() - presenceAt >= 10 then
			local token = liveTok
			local ok, res = pcall(function()
				return HttpService:RequestAsync({ Url = presenceUrl(false), Method = "GET", Headers = { ["x-live-token"] = token } })
			end)
			if not ok or not res.Success or liveTok ~= token or not ready() then serverReady = false; return false end
			presenceAt = os.clock()
		end
		if receipt.needsRead then
			local ok, res = pcall(function()
				return HttpService:RequestAsync({ Url = BACKEND_URL .. "/live/transfer/" .. receipt.item.transferId
					.. "?rev=" .. tostring(receipt.item.rev) .. "&receiverId=" .. receiverId, Method = "GET",
					Headers = { ["x-live-token"] = liveTok } })
			end)
			if not ok then return false end
			if res.StatusCode == 401 then unlinked("Live link removed. Get a new link code in Figma."); return false end
			local body = responseBody(res)
			if obsolete(res, body) then
				if res.StatusCode == 404 then say("Live delivery expired before confirmation. Send the design again in Figma.", COL.err) end
				receipt.acked = true
			elseif res.Success and body.transferId == receipt.item.transferId and body.rev == receipt.item.rev and body.seq == receipt.item.seq then
				receipt.needsRead = nil -- re-register delivery, keeping the already completed build
			else
				presenceAt, serverReady = -math.huge, false
				return false
			end
			if not ready() then return false end
		end
	end
	if not receipt.acked then
		local ok, res = pcall(function()
			return HttpService:RequestAsync({
				Url = BACKEND_URL .. "/live/ack", Method = "POST",
				Headers = { ["x-live-token"] = liveTok, ["Content-Type"] = "application/json" },
				Body = HttpService:JSONEncode({ transferId = receipt.item.transferId, rev = receipt.item.rev,
					seq = receipt.item.seq, receiverId = receiverId, status = receipt.status, error = receipt.error }),
			})
		end)
		if not ok then serverReady = false; return false end
		if res.StatusCode == 401 then unlinked("Live link removed. Get a new link code in Figma."); return false end
		local body = responseBody(res)
		if not res.Success and not obsolete(res, body) then
			if body.error == "live_not_received" then receipt.needsRead = true end
			presenceAt, serverReady = -math.huge, false
			return false
		end
		if res.StatusCode == 404 then say("Live delivery expired before confirmation. Send the design again in Figma.", COL.err) end
		receipt.acked = true -- a lost response retries only this acknowledgement, never the build
	end
	if not ready() or pendingAck ~= receipt then return false end
	liveSeq = math.max(liveSeq, receipt.item.seq)
	pendingAck = nil
	return true
end
local function importOne(item)
	if not ready() or importBusy then return false end
	local token = liveTok
	local request = { token = token, receiverId = receiverId, rev = item.rev, seq = item.seq,
		canApply = function() return liveTok == token and ready() end }
	local what = type(item.name) == "string" and item.name ~= "" and item.name or "your design"
	lastFailure = nil
	say("Live: applying " .. what .. "…")
	importBusy = true
	paintLive()
	local building = true
	local generation = liveGen
	task.spawn(function()
		while building and liveTok == token and generation == liveGen do
			task.wait(5)
			if not building or liveTok ~= token or generation ~= liveGen then break end
			local ok, res = pcall(function()
				return HttpService:RequestAsync({ Url = presenceUrl(false), Method = "GET", Headers = { ["x-live-token"] = token } })
			end)
			if ok and res.Success and liveTok == token then presenceAt = os.clock() end
		end
	end)
	local ran, ok, message = pcall(importByCode, item.transferId, request)
	building = false
	importBusy = false
	if liveTok ~= token then return false end
	if not request.fetched then
		if message ~= "live_paused" and message ~= "live_superseded" then
			serverReady = false
			say("Live: " .. tostring(ran and message or ok) .. " — retrying.", COL.err)
		end
		paintLive()
		return false
	end
	if ran and ok then
		pendingAck = { item = item, status = "applied" }
		say("Live " .. os.date("%H:%M:%S") .. " — " .. tostring(message), COL.ok)
	else
		lastFailure = tostring(ran and message or ok)
		pendingAck = { item = item, status = "failed", error = lastFailure:sub(1, 500) }
		say("Live: " .. what .. " did not build — " .. lastFailure, COL.err)
	end
	paintLive()
	return finishAck()
end
local function validItem(item)
	return type(item) == "table" and type(item.seq) == "number" and item.seq == math.floor(item.seq) and item.seq > liveSeq
		and item.seq < math.huge and type(item.rev) == "number" and item.rev >= 1 and item.rev < math.huge and item.rev == math.floor(item.rev)
		and type(item.transferId) == "string" and #item.transferId == 51 and item.transferId:match("^lt_[0-9a-f]+$") ~= nil
end
local function livePoll()
	liveGen = liveGen + 1
	local my = liveGen
	if not liveTok then paintLive(); return end
	dirty = true
	task.spawn(function()
		local nextPoll, interval, previous = 0, 2, nil
		while liveTok and my == liveGen do
			local signature = presenceUrl(false)
			if signature ~= previous then dirty = true; serverReady = false; paintLive() end
			if dirty or os.clock() >= nextPoll then
				dirty, previous = false, signature
				local token = liveTok
				local ok, res = pcall(function()
					return HttpService:RequestAsync({ Url = signature, Method = "GET", Headers = { ["x-live-token"] = token } })
				end)
				if my ~= liveGen or liveTok ~= token then break end
				if ok and res.Success then
					local decoded, inbox = pcall(function() return HttpService:JSONDecode(res.Body) end)
					if decoded and type(inbox) == "table" and inbox.protocol == 2 and type(inbox.items) == "table" then
						-- The server sets the pace: fast while Figma is sending, slower when idle,
						-- slowest with the panel closed (each ask is a billed request). No hint: 2 s.
						interval = (type(inbox.pollMs) == "number" and inbox.pollMs >= 1000 and inbox.pollMs <= 30000) and inbox.pollMs / 1000 or 2
						presenceAt = os.clock()
						serverReady = inbox.ready == true and ready()
						if serverReady and not importBusy then
							local acknowledged = not pendingAck or finishAck()
							if acknowledged then
								for _, item in ipairs(inbox.items) do
									if my ~= liveGen or not ready() or importBusy then break end
									if validItem(item) and not importOne(item) then break end
								end
							end
						end
					else
						serverReady = false
						interval = math.min(interval * 2, 30)
						say("Live needs the current Framewisp service. Retry in a moment.", COL.err)
					end
				elseif ok and res.StatusCode == 401 then
					unlinked("Live link removed. Get a new link code in Figma.")
					break
				else
					serverReady = false
					interval = math.min(interval * 2, 30)
				end
				nextPoll = os.clock() + interval
				paintLive()
			end
			task.wait(0.25)
		end
	end)
end
connect.MouseButton1Click:Connect(function()
	if pairBusy or importBusy or UI.inputMode ~= "live" then return end
	local value = pair.Text:upper():gsub("[%s-]", "")
	if not value:match("^L[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]$") then
		say("Enter the L-XXXXXX link code shown in Figma.", COL.err)
		return
	end
	pairBusy = true
	paintLive()
	local ok, res = pcall(function()
		return HttpService:RequestAsync({ Url = BACKEND_URL .. "/live/claim", Method = "POST",
			Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ pair = value }) })
	end)
	pairBusy = false
	local decoded, data = false, nil
	if ok then decoded, data = pcall(function() return HttpService:JSONDecode(res.Body) end) end
	if ok and res.Success and decoded and type(data) == "table" and type(data.token) == "string" and data.token:match("^%x+$") then
		liveTok, liveOn, liveSeq, pendingAck = data.token, true, 0, nil
		plugin:SetSetting("fw_livetoken", liveTok)
		plugin:SetSetting("fw_liveon", true)
		pair.Text = ""
		say((syncMode and autoSyncOn) and "Account linked. Checking Live readiness…" or "Account linked. Enable Live Sync and Auto-sync to receive designs.", (syncMode and autoSyncOn) and COL.dim or COL.err)
		livePoll()
	else
		say(ok and "That link code expired or was already used. Get a new one in Figma." or "Could not reach Framewisp. Check the plugin's internet permissions and retry.", COL.err)
	end
	paintLive()
end)
toggle.MouseButton1Click:Connect(function()
	if not liveTok or importBusy then return end
	liveOn = not liveOn
	plugin:SetSetting("fw_liveon", liveOn)
	dirty, serverReady = true, false
	paintLive()
end)
enable.MouseButton1Click:Connect(function()
	if UI.inputMode ~= "live" then return end
	syncMode, autoSyncOn = true, true
	plugin:SetSetting("fw_sync", true)
	plugin:SetSetting("fw_autosync", true)
	syncBtn.Text, autoBtn.Text = syncLabel(), autoLabel()
	UI.syncSettingsChanged()
	say(liveTok and "Settings enabled. Checking Live readiness…" or "Settings enabled. Enter the link code from Figma.")
end)
UI.liveChanged = function()
	dirty, serverReady = true, false
	paintLive()
end
UI.paintLive = paintLive
widget:GetPropertyChangedSignal("Enabled"):Connect(UI.liveChanged)
plugin.Unloading:Connect(function()
	local token = liveTok
	liveGen = liveGen + 1
	if token then
		pcall(function() HttpService:RequestAsync({ Url = presenceUrl(true), Method = "GET", Headers = { ["x-live-token"] = token } }) end)
	end
end)
paintLive()
livePoll()
end

function UI.syncSettingsChanged()
	autoGen = autoGen + 1
	autoBtn.Text = autoLabel()
	if UI.inputMode == "code" then
		if autoSyncOn and not syncMode then
			status.TextColor3, status.Text = COL.err, "Auto-sync is paused. Enable Live Sync to update the existing import safely."
		elseif autoSyncOn and lastSyncCode and placeHasTarget() then
			startAutoSync()
		elseif autoSyncOn then
			status.TextColor3, status.Text = COL.dim, "Auto-sync is armed. Import a code into this place first."
		end
	end
	if UI.liveChanged then UI.liveChanged() end
end
function UI.setMode(mode, persist)
	if importBusy or (mode ~= "code" and mode ~= "live") then return end
	UI.inputMode = mode
	if persist ~= false then plugin:SetSetting("fw_inputmode", mode) end
	local manual = mode == "code"
	UI.codePanel.Visible, UI.livePanel.Visible = manual, not manual
	box.TextEditable, box.Active = manual, manual
	btn.Visible, btn.Active = manual, manual
	if UI.recall then UI.recall.Visible = manual and UI.recall.Text ~= ""; UI.recall.Active = manual end
	for name, tab in pairs(UI.modeButtons) do
		tab.BackgroundColor3 = name == mode and COL.surface or COL.field
		tab.TextColor3 = name == mode and COL.text or COL.dim
	end
	status.Text = ""
	UI.syncSettingsChanged()
end
UI.setMode(UI.inputMode, false)

btn.MouseButton1Click:Connect(function()
	if importBusy then return end
	if UI.inputMode ~= "code" then return end
	local code = (box.Text or ""):gsub("%s", ""):gsub("#", ""):upper()
	if code == "" then
		status.TextColor3 = COL.err
		status.Text = "Error: enter a code first."
		return
	end
	if #code ~= 6 or not code:match("^[A-Z0-9]+$") then
		status.TextColor3 = COL.err
		status.Text = "Error: import codes are exactly 6 letters/numbers (for example 97H5AM)."
		return
	end
	importBusy = true
	btn.Active = false
	btn.Text = "Importing…"
	status.TextColor3 = COL.dim
	status.Text = "Importing…"
	-- pcall so an unexpected build error never leaves the status stuck on "Importing…"
	local ran, ok, msg = pcall(importByCode, code)
	if not ran then
		ok, msg = false, "Import error: " .. tostring(ok)
	end
	importBusy = false
	btn.Active = true
	btn.Text = "Import to Studio"
	status.TextColor3 = ok and COL.ok or COL.err
	-- Plain-text "Error:" prefix (Studio fonts render ✓/✗ as tofu boxes), plus the
	-- green/red colour, so success/failure reads either way.
	status.Text = ok and msg or ("Error: " .. tostring(msg))
	if ok then
		-- This code is now the auto-sync target; rebase the watcher onto it. The
		-- imported rev persists alongside so a restart baselines correctly.
		lastSyncCode = code
		plugin:SetSetting("fw_lastcode", code)
		UI.rememberCode(code)
		plugin:SetSetting("fw_lastrev", lastImportRev)
		autoBtn.Text = autoLabel()
		if autoSyncOn then
			startAutoSync()
		end
	end
end)

button.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

-- ================================================================= UI Tools (editor)
-- A second toolbar + dock: edit an imported (or any) GUI right here in Studio — set
-- the anchor, nudge move/resize, switch Size between Scale/Offset, and CHANGE an
-- element's type (ImageLabel -> ImageButton, Frame -> ScrollingFrame, …). This closes
-- the "tweak after import without touching code" gap. Everything is undo-able.
local ChangeHistoryService = game:GetService("ChangeHistoryService")

local function record(name, fn)
	local id = ChangeHistoryService:TryBeginRecording(name)
	local ok, err = pcall(fn)
	if id then
		ChangeHistoryService:FinishRecording(id,
			ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
	end
	if not ok then
		warn("[Framewisp UI Tools] " .. tostring(err))
	end
	return ok, err
end

local function firstSelectedGui()
	for _, s in ipairs(Selection:Get()) do
		if s:IsA("GuiObject") then
			return s
		end
	end
	return nil
end

-- pixel size of the element's reference box (parent GuiObject, else the viewport)
local function parentSize(g)
	local p = g.Parent
	if p and p:IsA("GuiObject") then
		return p.AbsoluteSize
	end
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(1, 1)
end

-- Change an element's class: make the target, copy over every property it supports,
-- move all children (corners, strokes, gradients, nested GUIs, scripts) and attributes.
local CONVERT_CLASSES = {
	"Frame", "ScrollingFrame", "CanvasGroup",
	"TextLabel", "TextButton", "TextBox",
	"ImageLabel", "ImageButton", "ViewportFrame",
}
local CONVERT_PROPS = {
	"Name", "Position", "Size", "AnchorPoint", "Rotation", "Visible", "ZIndex",
	"LayoutOrder", "AutomaticSize", "SizeConstraint", "Active", "Selectable",
	"BackgroundColor3", "BackgroundTransparency", "BorderSizePixel", "BorderColor3",
	"BorderMode", "ClipsDescendants",
	"Image", "ImageColor3", "ImageTransparency", "ImageRectOffset", "ImageRectSize",
	"ScaleType", "SliceCenter", "SliceScale", "TileSize", "ResampleMode",
	"Text", "FontFace", "TextColor3", "TextSize", "TextScaled", "TextWrapped",
	"TextXAlignment", "TextYAlignment", "TextTransparency", "RichText", "LineHeight",
	"TextTruncate", "TextStrokeColor3", "TextStrokeTransparency",
}
local function convertClass(old, targetClass)
	if not old or old.ClassName == targetClass then
		return old
	end
	local new = Instance.new(targetClass)
	for _, prop in ipairs(CONVERT_PROPS) do
		pcall(function()
			new[prop] = old[prop] -- skips any property the target class doesn't have
		end)
	end
	for k, v in pairs(old:GetAttributes()) do
		new:SetAttribute(k, v)
	end
	for _, child in ipairs(old:GetChildren()) do
		child.Parent = new
	end
	new.Parent = old.Parent
	old:Destroy()
	return new
end

local StudioService = game:GetService("StudioService")

local toolsBtn = toolbar:CreateButton("UI Tools",
	"Edit imported UI in Studio — drag to move, pull the dots to resize, change element type", (resolveImage(UITOOLS_ICON)))
