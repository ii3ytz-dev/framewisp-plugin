	stampRuntime(burst)
	burst:SetAttribute("FWv", 2)
	burst.Parent = screen
	end

	do
		dropIfOurs(screen, "FramewispPointer", 9)
	end
	if hasPointer and not screen:FindFirstChild("FramewispPointer") then
	local ptr = Instance.new("LocalScript")
	ptr.Name = "FramewispPointer"
	-- _pointer: one arrow per group. It hides at start, and on hover (mouse), selection
	-- (gamepad) or touch it appears next to that button on the side and at the gap it
	-- was DRAWN at (the exporter measured both), then crawls to the next hovered button
	-- on a spring that keeps its speed when retargeted. It lingers PointerHold seconds
	-- after the cursor leaves. It is drawn above every button of its group (a z above
	-- the group's highest, its own subtree shifted with it, so Global mode agrees), and
	-- it never stays in a parent that lays its children out. A button that lives on
	-- another surface (a _3d card in the world) takes the arrow into that surface: it
	-- fades there instead of crawling through space it cannot cross. The exporter
	-- ships the arrow HIDDEN and leaves it out of its group's box (the import is the
	-- button, centred as the button); the runtime switches it on at transparency 1.
	-- Its MENU: out of the button it is drawn in, then up past any group that holds
	-- only one button (a "button + its arrow" group is not a menu). Several arrows in
	-- one menu are ONE arrow: the first travels, each of the others marks a button
	-- (FigmaPointerFor = that button's FigmaNodeId, else the nearest one) and where the
	-- arrow sits at it; only those buttons are served. A button with FigmaNoPointer
	-- (_nopointer) is never pointed at.
	ptr.Source = [==[
-- Framewisp: _pointer — an arrow that crawls to whichever button you hover.
-- Side and distance come from where you drew it; the plugin sets the feel. A
-- Studio attribute without the Figma prefix wins (PointerSide 0-4, PointerNudge,
-- PointerIn, PointerSpeed, PointerBounce, PointerHold, PointerBob, PointerBobAmp,
-- PointerPad, PointerTurn, PointerPress). NoPointer on a button keeps the arrow off
-- it. Safe to delete: the buttons keep working, the arrow stays hidden.
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function num(el, manual, auto, def, lo, hi)
	local v = el:GetAttribute(manual)
	if type(v) ~= "number" then v = el:GetAttribute(auto) end
	if type(v) ~= "number" or v ~= v then v = def end
	if lo and v < lo then v = lo end
	if hi and v > hi then v = hi end
	return v
end
local FADE_PROPS = {
	ImageLabel = { "ImageTransparency", "BackgroundTransparency" },
	ImageButton = { "ImageTransparency", "BackgroundTransparency" },
	TextLabel = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
	TextButton = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
	Frame = { "BackgroundTransparency" },
	CanvasGroup = { "GroupTransparency" },
	UIStroke = { "Transparency" },
}
local function collect(root)
	local parts = {}
	local function add(inst)
		for _, prop in ipairs(FADE_PROPS[inst.ClassName] or {}) do
			local ok, rest = pcall(function() return inst[prop] end)
			if ok and type(rest) == "number" then parts[#parts + 1] = { inst = inst, prop = prop, rest = rest } end
		end
	end
	add(root)
	for _, d in ipairs(root:GetDescendants()) do add(d) end
	return parts
end
local function setAlpha(parts, a) -- 0 hidden, 1 as drawn
	for _, part in ipairs(parts) do
		if part.inst.Parent then pcall(function() part.inst[part.prop] = part.rest + (1 - part.rest) * (1 - a) end) end
	end
end
local function laidOut(p)
	return p ~= nil and (p:FindFirstChildWhichIsA("UIGridLayout") ~= nil or p:FindFirstChildWhichIsA("UIListLayout") ~= nil
		or p:FindFirstChildWhichIsA("UITableLayout") ~= nil or p:FindFirstChildWhichIsA("UIPageLayout") ~= nil)
end
local function shown(el)
	local n = el
	while n and n:IsA("GuiObject") do
		if not n.Visible then return false end
		n = n.Parent
	end
	return true
end
local function fwChannel(el, key) -- one UIScale per object: every runtime multiplies into it
	local host = el:FindFirstChild("FW_Scale")
	if not host then
		host = el:FindFirstChildWhichIsA("UIScale")
		if host then host.Name = "FW_Scale" else
			host = Instance.new("UIScale")
			host.Name = "FW_Scale"
			host:SetAttribute("FW_Owned", true)
			host.Parent = el
		end
	end
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function()
			local total = 1
			for _, c in ipairs(host:GetChildren()) do
				if c:IsA("NumberValue") then total = total * c.Value end
			end
			host.Scale = total
		end)
	end
	return ch, host
end
local function hostBox(host) -- where fractions of this parent land on screen
	local hp, hs = host.AbsolutePosition, host.AbsoluteSize
	if host:IsA("ScrollingFrame") then
		local cs = host.AbsoluteCanvasSize
		if cs and cs.X > 0 and cs.Y > 0 then hp = hp - host.CanvasPosition; hs = cs end
	end
	return hp, hs
end
local function lift(el, home) -- above everything in `home`, subtree shifted along (Global mode)
	local top = 0
	for _, d in ipairs(home:GetDescendants()) do
		if d:IsA("GuiObject") and d ~= el and not d:IsDescendantOf(el) and d.ZIndex > top then top = d.ZIndex end
	end
	local delta = top + 2 - el.ZIndex
	if delta <= 0 then return end
	el.ZIndex = el.ZIndex + delta
	for _, d in ipairs(el:GetDescendants()) do
		if d:IsA("GuiObject") then d.ZIndex = d.ZIndex + delta end
	end
end
local function topOf(b, lc) -- the outermost layer under a surface: the arrow's home there
	local n = b
	while n.Parent and n.Parent ~= lc do n = n.Parent end
	return n
end

local ANGLE = { [1] = 0, [3] = 90, [2] = 180, [4] = 270 } -- drawn left of a button, the arrow points right
local function insideCard(b, stop)
	local n = b
	while n and n ~= stop do
		if n:GetAttribute("FigmaCard") then return true end
		n = n.Parent
	end
	return false
end
local arrows = {}
local conn = nil
local clock = 0

local function drawnOf(arr) -- where THIS arrow was drawn beside its button: side 1-4, gap in design px
	return math.floor(num(arr, "FigmaPointerDrawnSide", "FigmaPointerDrawnSide", 1, 1, 4) + 0.5),
		num(arr, "FigmaPointerDrawnGap", "FigmaPointerDrawnGap", 8, -2000, 2000)
end
local function sideOf(st, arr)
	arr = arr or st.el
	local s = math.floor(num(arr, "PointerSide", "FigmaPointerSide", 0, 0, 4) + 0.5)
	if s == 0 then s = (drawnOf(arr)) end
	return s
end

local function visualBox(b) -- what the player sees as the button: a group-turned-button is its drawn content
	local own = b.BackgroundTransparency < 0.99
		or (b:IsA("ImageButton") and b.Image ~= "" and b.ImageTransparency < 0.99)
		or (b:IsA("TextButton") and b.Text ~= "" and b.TextTransparency < 0.99)
	if own then return b.AbsolutePosition, b.AbsoluteSize end
	local x0, y0, x1, y1 = math.huge, math.huge, -math.huge, -math.huge
	for _, c in ipairs(b:GetChildren()) do
		if c:IsA("GuiObject") and c.Visible and not c:GetAttribute("FigmaPointer") and not c:GetAttribute("FigmaCard") and c:GetAttribute("FigmaState") == nil then
			local p, s = c.AbsolutePosition, c.AbsoluteSize
			if s.X > 0 and s.Y > 0 then
				x0, y0 = math.min(x0, p.X), math.min(y0, p.Y)
				x1, y1 = math.max(x1, p.X + s.X), math.max(y1, p.Y + s.Y)
			end
		end
	end
	if x0 == math.huge then return b.AbsolutePosition, b.AbsoluteSize end
	return Vector2.new(x0, y0), Vector2.new(x1 - x0, y1 - y0)
end

local function anchor(st, b) -- the arrow's centre next to b, in screen px
	local _, host = fwChannel(st.el, "k_ptr")
	local sc = host.Scale > 0 and host.Scale or 1
	local w, h = st.el.AbsoluteSize.X / sc, st.el.AbsoluteSize.Y / sc
	local k = w / st.designW
	local arr = st.forButton[b] or st.el -- the arrow drawn at THIS button says where to sit
	local side = sideOf(st, arr)
	local turn = num(arr, "PointerTurn", "FigmaPointerTurn", 1, 0, 1) >= 0.5
	local rot = turn and (ANGLE[side] - ANGLE[st.drawnSide]) or 0 -- the travelling arrow's art turns to match
	if rot % 180 ~= 0 then w, h = h, w end
	local _, drawnGap = drawnOf(arr)
	local gap = (drawnGap + num(arr, "PointerNudge", "FigmaPointerNudge", 0, -2000, 2000)) * k
	local p, s = visualBox(b)
	local cx, cy
	if side == 1 then cx, cy = p.X - gap - w / 2, p.Y + s.Y / 2
	elseif side == 2 then cx, cy = p.X + s.X + gap + w / 2, p.Y + s.Y / 2
	elseif side == 3 then cx, cy = p.X + s.X / 2, p.Y - gap - h / 2
	else cx, cy = p.X + s.X / 2, p.Y + s.Y + gap + h / 2 end
	return cx, cy, side, rot, k
end

local function place(st, x, y)
	local hp, hs = hostBox(st.el.Parent)
	if hs.X < 1 or hs.Y < 1 then return end
	st.el.Position = UDim2.fromScale((x - hp.X) / hs.X, (y - hp.Y) / hs.Y)
end

local function rehome(el, parent) -- sizes are fractions of the parent: keep the arrow's pixels, not its fractions
	local old = el.Parent
	local w, h = nil, nil
	if old and old:IsA("GuiObject") and old.AbsoluteSize.X >= 1 then
		w = old.AbsoluteSize.X * el.Size.X.Scale + el.Size.X.Offset
		h = old.AbsoluteSize.Y * el.Size.Y.Scale + el.Size.Y.Offset
	end
	el.Parent = parent
	local ps = parent:IsA("GuiObject") and parent.AbsoluteSize or nil
	if w and ps and ps.X >= 1 and ps.Y >= 1 and w > 0 and h > 0 then el.Size = UDim2.fromScale(w / ps.X, h / ps.Y) end
end

local function moveTo(st, b) -- into the surface b lives on (a _3d card is its own surface)
	local lc = b:FindFirstAncestorWhichIsA("LayerCollector")
	local parent = (lc == st.homeLC) and st.home or topOf(b, lc)
	if st.el.Parent ~= parent then
		rehome(st.el, parent)
		lift(st.el, parent)
		return true
	end
	return false
end

local tick

local function wake()
	if not conn then conn = RunService.Heartbeat:Connect(tick) end
end

local function enter(st, b)
	st.hovered[b] = true
	local jumped = moveTo(st, b) -- another surface: fade in there, never crawl across
	if jumped or st.v <= 0 then -- appearing from nothing: start right at the button
		local x, y, _, rot = anchor(st, b)
		st.x, st.y, st.vx, st.vy = x, y, 0, 0
		st.rot = st.rot0 + rot
		if jumped then st.v = 0 end
	end
	st.showing = true
	st.target = b
	wake()
end

local function leave(st, b)
	st.hovered[b] = nil
	if st.pressed == b then st.pressed = nil end
	if next(st.hovered) == nil then st.leftAt = clock end
	wake()
end

function tick(dt)
	clock = clock + dt
	local busy = false
	for _, st in ipairs(arrows) do
		local hold = num(st.el, "PointerHold", "FigmaPointerHold", 0.5, 0, 10)
		if st.showing and next(st.hovered) == nil and clock - (st.leftAt or clock) >= hold then st.showing = false end
		if st.target and not shown(st.target) then st.showing = false; st.hovered = {} end
		local inT = 0.18
		st.v = math.clamp(st.v + (st.showing and dt or -dt) / inT, 0, 1)
		if st.target and (st.showing or st.v > 0) then
			local tx, ty, side, rot, k = anchor(st, st.target)
			local want = ((st.pressed ~= nil and st.pressed == st.target) or ((st.poke or 0) > 0 and st.target ~= nil)) and 1 or 0 -- pressed: follow the (shrinking) edge and poke in on top
			local w0 = 2 * math.pi * num(st.el, "PointerSpeed", "FigmaPointerSpeed", 5, 0.5, 20)
			local z = 1 - num(st.el, "PointerBounce", "FigmaPointerBounce", 0.25, 0, 0.9)
			local n = math.max(1, math.ceil(dt / (1 / 120)))
			local h = dt / n
			local vmax = 72 * w0 * k -- a long way is a glide you can follow, not a blink: the spring's pace is capped
			for _ = 1, n do -- a spring that keeps its speed when the target changes: it crawls, it does not restart
				st.vx = st.vx + (w0 * w0 * (tx - st.x) - 2 * z * w0 * st.vx) * h
				st.vy = st.vy + (w0 * w0 * (ty - st.y) - 2 * z * w0 * st.vy) * h
				local sp = math.sqrt(st.vx * st.vx + st.vy * st.vy)
				if sp > vmax then st.vx, st.vy = st.vx * vmax / sp, st.vy * vmax / sp end
				st.x = st.x + st.vx * h
				st.y = st.y + st.vy * h
			end
			st.rot = st.rot + ((st.rot0 + rot) - st.rot) * math.min(1, dt * 14)
			local ox, oy = 0, 0
			local dirx = (side == 1 and -1) or (side == 2 and 1) or 0
			local diry = (side == 3 and -1) or (side == 4 and 1) or 0
			local style = math.floor(num(st.el, "PointerIn", "FigmaPointerIn", 0, 0, 2) + 0.5)
			if style == 2 then ox, oy = dirx * (1 - st.v) * 10 * k, diry * (1 - st.v) * 10 * k end -- slides in from its own side
			local poke = num(st.el, "PointerPress", "FigmaPointerPress", 10, 0, 200)
			if st.poke then st.poke = st.poke - dt; if st.poke <= 0 then st.poke = nil end end
			st.pk = (st.pk or 0) + (want - (st.pk or 0)) * math.min(1, dt * 30) -- held down: it pokes in toward the button
			ox, oy = ox - dirx * st.pk * poke * k, oy - diry * st.pk * poke * k
			if want > 0 or st.pk > 0.001 then busy = true end
			if num(st.el, "PointerBob", "FigmaPointerBob", 1, 0, 1) >= 0.5 and st.v >= 1 then
				local b = math.sin(clock * 2 * math.pi / 1.2) * num(st.el, "PointerBobAmp", "FigmaPointerBobAmp", 4, 0, 100) * k -- breathes toward the button
				ox, oy = ox + dirx * b, oy + diry * b
			end
			place(st, st.x + ox, st.y + oy)
			st.el.Rotation = st.rot
			local e = st.v
			local sc = 1
			if style == 0 then sc = 0.6 + 0.4 * (1 + 2.2 * (e - 1) ^ 3 + 1.2 * (e - 1) ^ 2) end -- pops with a little overshoot
			st.scale.Value = math.max(0.01, sc)
			setAlpha(st.parts, e)
			if st.showing or st.v > 0 then busy = true end
			if math.abs(st.vx) + math.abs(st.vy) > 1 then busy = true end
		end
		if st.v <= 0 and (st.lastV or 0) > 0 then setAlpha(st.parts, 0); st.scale.Value = 1 end -- the last step of a fade lands on nothing
		st.lastV = st.v
		if st.showing and next(st.hovered) == nil then busy = true end
		if num(st.el, "PointerBob", "FigmaPointerBob", 1, 0, 1) >= 0.5 and st.showing then busy = true end
	end
	if not busy and conn then conn:Disconnect(); conn = nil end
end

local blank = Instance.new("Frame") -- replaces Roblox's blue selection box on the group's buttons
blank.BackgroundTransparency = 1
blank.Name = "FW_NoSelection"

local function menuButtons(area, skip) -- the outermost buttons of a menu (a button in a button is part of it)
	local out = {}
	local function walk(n)
		for _, c in ipairs(n:GetChildren()) do
			if c:IsA("GuiObject") and c ~= skip and c.Visible and not c:GetAttribute("FigmaPointer") and not c:GetAttribute("FigmaCard") then
				if c:IsA("GuiButton") then out[#out + 1] = c else walk(c) end
			end
		end
	end
	walk(area)
	return out
end
local function menuOf(d) -- out of the button it is drawn in, then up past a group that is just one button and its arrow
	local area = d.Parent
	local up = d:FindFirstAncestorWhichIsA("GuiButton") -- drawn inside a button (even in a mask's clip frame there): it serves that button's menu
	if up and up.Parent and up.Parent:IsA("GuiObject") then area = up.Parent end
	while area and area:IsA("GuiButton") and area.Parent and area.Parent:IsA("GuiObject") do area = area.Parent end
	while area and area.Parent and area.Parent:IsA("GuiObject") and #menuButtons(area, d) <= 1 do area = area.Parent end
	return area
end
local function centre(g)
	local p, s = g.AbsolutePosition, g.AbsoluteSize
	return p.X + s.X / 2, p.Y + s.Y / 2
end

task.wait() -- sizes exist from the first rendered frame on
local menus, order = {}, {}
for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaPointer") and d:IsA("GuiObject") and not d:GetAttribute("FW_PointerWired") then
		d:SetAttribute("FW_PointerWired", true)
		local area = menuOf(d)
		if area then
			if not menus[area] then menus[area] = {}; order[#order + 1] = area end
			table.insert(menus[area], d)
		end
	end
end
for _, area in ipairs(order) do
	local list = menus[area]
	local d = list[1] -- the arrow that travels; the others only say where it sits at their button
	do
		local home = area
		while home and home:IsA("GuiObject") and laidOut(home) do home = home.Parent end
		if home and home ~= d.Parent then rehome(d, home) end -- out of the button (its _smooth scale is not the arrow's) and into the menu
		local st = {
			el = d, area = area, home = home, homeLC = d:FindFirstAncestorWhichIsA("LayerCollector"),
			drawnSide = (drawnOf(d)), forButton = {},
			designW = num(d, "FigmaPointerW", "FigmaPointerW", math.max(1, d.AbsoluteSize.X), 1),
			rot0 = d.Rotation, rot = d.Rotation, x = 0, y = 0, vx = 0, vy = 0, v = 0,
			showing = false, hovered = {}, parts = collect(d),
		}
		st.scale = fwChannel(d, "k_ptr")
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		lift(d, home)
		setAlpha(st.parts, 0)
		d.Visible = true -- it ships hidden (no part of the layout); from here it is shown by its transparency
		local all = {}
		for _, b in ipairs(area:GetDescendants()) do
			local ours = false
			for _, a in ipairs(list) do if b == a or b:IsDescendantOf(a) then ours = true break end end
			local np = b:GetAttribute("NoPointer") -- set by hand in Studio it wins, like every setting
			if np == nil then np = b:GetAttribute("FigmaNoPointer") end
			if b:IsA("GuiButton") and not ours and not insideCard(b, area) and not (np == true or (type(np) == "number" and np >= 0.5)) then
				all[#all + 1] = b
			end
		end
		local buttons = all
		if #list > 1 then -- several arrows in one menu: exactly the buttons they were drawn at
			buttons = {}
			for _, a in ipairs(list) do
				local want, pick = a:GetAttribute("FigmaPointerFor"), nil
				for _, b in ipairs(all) do if want ~= nil and b:GetAttribute("FigmaNodeId") == want then pick = b break end end
				if not pick then -- an older export: the nearest button to where it was drawn
					local ax, ay = centre(a)
					local bd = math.huge
					for _, b in ipairs(all) do
						local bx, by = centre(b)
						local dd = (bx - ax) ^ 2 + (by - ay) ^ 2
						if dd < bd then bd, pick = dd, b end
					end
				end
				if pick and not st.forButton[pick] then
					st.forButton[pick] = a
					buttons[#buttons + 1] = pick
				end
				if a ~= d then a.Visible = false end -- only the one that travels is ever seen
			end
		end
		st.buttons = buttons
		local pad = num(d, "PointerPad", "FigmaPointerPad", 1, 0, 1) >= 0.5
		for _, b in ipairs(buttons) do
			b.MouseEnter:Connect(function() enter(st, b) end)
			b.MouseLeave:Connect(function() leave(st, b) end)
			b.MouseButton1Down:Connect(function() st.pressed = b; st.poke = 0.2; wake() end) -- mouse and touch: held, and at least 0.2 s so a click reads
			b.MouseButton1Up:Connect(function() if st.pressed == b then st.pressed = nil end; wake() end)
			b.Activated:Connect(function(input) -- gamepad or keyboard: one quick poke
				local t = input and input.UserInputType
				if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then return end
				st.poke = 0.12
				wake()
			end)
			b.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch then enter(st, b) end
			end)
			b.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch then leave(st, b) end
			end)
			if pad and b.SelectionImageObject == nil then b.SelectionImageObject = blank end
		end
		if pad then
			local sel = nil
			GuiService:GetPropertyChangedSignal("SelectedObject"):Connect(function()
				local now = GuiService.SelectedObject
				if sel then leave(st, sel); sel = nil end
				for _, b in ipairs(buttons) do
					if b == now then sel = b; enter(st, b) break end
				end
			end)
		end
		arrows[#arrows + 1] = st
	end
end
if #arrows > 0 then
	local okv, v = pcall(function() return script:GetAttribute("FWv") end)
	print(("[Framewisp] _pointer v%s: %d arrow%s, %d button%s to point at"):format(tostring(okv and v or "?"), #arrows,
		#arrows == 1 and "" or "s", #arrows[1].buttons, #arrows[1].buttons == 1 and "" or "s"))
end
]==]
	stampRuntime(ptr)
	ptr:SetAttribute("FWv", 9)
	ptr.Parent = screen
	end

	do
		dropIfOurs(screen, "FramewispCard", 2)
	end
	if hasCard and not screen:FindFirstChild("FramewispCard") then
	local card = Instance.new("LocalScript")
	card.Name = "FramewispCard"
	-- _card: a drawn group that its button shows on hover. The owner is found by name
	-- (FigmaCardOwner) in the smallest group around the card that has a button called
	-- that — so ten inventory slots named "Slot" share one card and each shop "Buy"
	-- finds its own — else the button the card sits in. The card is lifted to the root
	-- of its design, above everything (subtree shifted, Global mode agrees), and sized
	-- there as it was: a scroll window or a mask can no longer cut it. It is placed by
	-- pinning one of its corners (CardCorner) to a point of the button (CardPoint), so
	-- a UIScale grows it out of that corner — "out of the button". At the screen edge
	-- the corner mirrors; still out, it is clamped. Shows after CardDelay, hides after
	-- CardHide unless the cursor is on the card itself (sticky). Moving to another owner
	-- glides on a spring. The game fills it: Owner attribute + FW_Owner ObjectValue.
	-- Turn over (CardTurn, off by default): the reverse is the layer named Back inside
	-- the card (Front, when named, is the face; else the face is everything next to
	-- Back — a BUTTON is never a side, so a "Back" button on the reverse works). A click
	-- on the owner (mouse, gamepad) or on the card itself, or a second tap on touch,
	-- turns it: the width follows |cos| of the angle about the card's centre, a 5% lift
	-- rides on its own UIScale channel, and past 90 degrees the sides swap. Hidden
	-- again, it rests face up.
	card.Source = [==[
-- Framewisp: _card — a card you drew appears next to its button on hover.
-- Corner of the card, point of the button, offset, entrance and delays come from
-- the plugin; a Studio attribute without the Figma prefix wins (CardCorner 0-8,
-- CardPoint 0-8, CardX, CardY, CardIn, CardTime, CardDelay, CardHide, CardFlip,
-- CardSticky, CardTurn, CardTurnTime). Fill it from your code:
-- card:GetAttributeChangedSignal("Owner"); the reverse is the layer named Back.
-- Safe to delete: the card simply stays hidden.
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function num(el, manual, auto, def, lo, hi)
	local v = el:GetAttribute(manual)
	if type(v) ~= "number" then v = el:GetAttribute(auto) end
	if type(v) ~= "number" or v ~= v then v = def end
	if lo and v < lo then v = lo end
	if hi and v > hi then v = hi end
	return v
end
local FADE_PROPS = {
	ImageLabel = { "ImageTransparency", "BackgroundTransparency" },
	ImageButton = { "ImageTransparency", "BackgroundTransparency" },
	TextLabel = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
	TextButton = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
	TextBox = { "TextTransparency", "BackgroundTransparency" },
	Frame = { "BackgroundTransparency" },
	ScrollingFrame = { "BackgroundTransparency" },
	CanvasGroup = { "GroupTransparency" },
	UIStroke = { "Transparency" },
}
local function collect(root)
	local parts = {}
	local function add(inst)
		for _, prop in ipairs(FADE_PROPS[inst.ClassName] or {}) do
			local ok, rest = pcall(function() return inst[prop] end)
			if ok and type(rest) == "number" then parts[#parts + 1] = { inst = inst, prop = prop, rest = rest } end
		end
	end
	add(root)
	for _, d in ipairs(root:GetDescendants()) do add(d) end
	return parts
end
local function setAlpha(parts, a)
	for _, part in ipairs(parts) do
		if part.inst.Parent then pcall(function() part.inst[part.prop] = part.rest + (1 - part.rest) * (1 - a) end) end
	end
end
local function shown(el)
	local n = el
	while n and n:IsA("GuiObject") do
		if not n.Visible then return false end
		n = n.Parent
	end
	return true
end
local function fwChannel(el, key)
	local host = el:FindFirstChild("FW_Scale")
	if not host then
		host = el:FindFirstChildWhichIsA("UIScale")
		if host then host.Name = "FW_Scale" else
			host = Instance.new("UIScale")
			host.Name = "FW_Scale"
			host:SetAttribute("FW_Owned", true)
			host.Parent = el
		end
	end
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function()
			local total = 1
			for _, c in ipairs(host:GetChildren()) do
				if c:IsA("NumberValue") then total = total * c.Value end
			end
			host.Scale = total
		end)
	end
	return ch, host
end
local function topOf(el)
	local n = el
	while n.Parent and not n.Parent:IsA("LayerCollector") do n = n.Parent end
	return n
end
local GRID = { [0] = { 0, 0 }, { 0.5, 0 }, { 1, 0 }, { 0, 0.5 }, { 0.5, 0.5 }, { 1, 0.5 }, { 0, 1 }, { 0.5, 1 }, { 1, 1 } }
local SIDE_BACK = { back = true, reverse = true, ["Рубашка"] = true, ["рубашка"] = true, ["Оборот"] = true, ["оборот"] = true }
local SIDE_FRONT = { front = true, face = true, ["Лицо"] = true, ["лицо"] = true }
local function sideIn(card, names) -- by NAME, two levels deep; a button is never a side
	local function walk(host, depth)
		for _, c in ipairs(host:GetChildren()) do
			if c:IsA("GuiObject") and not c:IsA("GuiButton") and (names[c.Name] or names[string.lower(c.Name)]) then return c end
		end
		if depth >= 2 then return nil end
		for _, c in ipairs(host:GetChildren()) do
			if c:IsA("GuiObject") and not c:IsA("GuiButton") then
				local f = walk(c, depth + 1)
				if f then return f end
			end
		end
		return nil
	end
	return walk(card, 1)
end
local function showSide(st, back) -- past 90 degrees the reverse, else the face as designed
	if not st.back then return end
	st.back.Visible = back
	for _, f in ipairs(st.fronts) do
		if f.Parent then f.Visible = (not back) and st.frontVis[f] end
	end
end

local function ownersFor(el, name)
	local out = {}
	if type(name) == "string" and name ~= "" then
		local want = string.lower(name)
		local host = el.Parent
		while host and not host:IsA("LayerCollector") do
			if host:IsA("GuiButton") and string.lower(host.Name) == want then out[#out + 1] = host end
			for _, d in ipairs(host:GetDescendants()) do
				if d:IsA("GuiButton") and d ~= el and not d:IsDescendantOf(el) and string.lower(d.Name) == want then out[#out + 1] = d end
			end
			if #out > 0 then return out end
			host = host.Parent
		end
	end
	local up = el:FindFirstAncestorWhichIsA("GuiButton") -- no name: the button it is drawn in
	if up then out[1] = up end
	return out
end

local cards = {}
local conn = nil
local clock = 0
local tick

local function wake()
	if not conn then conn = RunService.Heartbeat:Connect(tick) end
end

local function liftCard(st) -- to the design root, above everything, keeping its on-screen size
	local el = st.el
	local root = topOf(el)
	if root == el or el.Parent == root then return true end
	local a, rs = el.AbsoluteSize, root.AbsoluteSize
	if a.X < 1 or rs.X < 1 then return false end
	el.Size = UDim2.fromScale(a.X / rs.X, a.Y / rs.Y)
	el.Parent = root
	local top = 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiObject") and d ~= el and not d:IsDescendantOf(el) and d.ZIndex > top then top = d.ZIndex end
	end
	local delta = top + 10 - el.ZIndex
	if delta > 0 then
		el.ZIndex = el.ZIndex + delta
		for _, d in ipairs(el:GetDescendants()) do if d:IsA("GuiObject") then d.ZIndex = d.ZIndex + delta end end
	end
	return true
end

local function aim(st, owner) -- where the card's corner goes, and which corner, after flipping at the edge
	local el = st.el
	local _, host = fwChannel(el, "k_card")
	local sc = host.Scale > 0 and host.Scale or 1
	local w, h = el.AbsoluteSize.X / sc, el.AbsoluteSize.Y / sc
	if (st.tp or 0) > 0 and st.w0 then w, h = st.w0, st.h0 end -- turning: the width on screen is not the card's
	local k = w / st.designW
	local c = GRID[math.floor(num(el, "CardCorner", "FigmaCardCorner", 6, 0, 8) + 0.5)]
	local p = GRID[math.floor(num(el, "CardPoint", "FigmaCardPoint", 4, 0, 8) + 0.5)]
	local cx, cy, px, py = c[1], c[2], p[1], p[2]
	local ox = num(el, "CardX", "FigmaCardX", 0, -2000, 2000) * k
	local oy = num(el, "CardY", "FigmaCardY", 0, -2000, 2000) * k
	local op, os = owner.AbsolutePosition, owner.AbsoluteSize
	local function at() return op.X + os.X * px + ox, op.Y + os.Y * py + oy end
	local x, y = at()
	if num(el, "CardFlip", "FigmaCardFlip", 1, 0, 1) >= 0.5 then
		local lc = el:FindFirstAncestorWhichIsA("LayerCollector")
		local sw = lc and lc.AbsoluteSize or Vector2.new(1e6, 1e6)
		local L, T, R, B = 0, 0, sw.X, sw.Y
		if x - w * cx < L or x - w * cx + w > R then cx, px, ox = 1 - cx, 1 - px, -ox; x, y = at() end
		if y - h * cy < T or y - h * cy + h > B then cy, py, oy = 1 - cy, 1 - py, -oy; x, y = at() end
		local m = 8 * k
		local left = x - w * cx
		if left < L + m then x = x + (L + m - left) elseif left + w > R - m then x = x - (left + w - (R - m)) end
		local top = y - h * cy
		if top < T + m then y = y + (T + m - top) elseif top + h > B - m then y = y - (top + h - (B - m)) end
	end
	return x, y, cx, cy
end

local function show(st, owner)
	if not st.lifted then st.lifted = liftCard(st) end
	if st.owner ~= owner then
		st.owner = owner
		st.el:SetAttribute("Owner", owner.Name)
		st.ref.Value = owner
	end
	if st.v <= 0 then
		local x, y, cx, cy = aim(st, owner)
		st.x, st.y, st.vx, st.vy = x, y, 0, 0
		st.el.AnchorPoint = Vector2.new(cx, cy)
	end
	st.showing = true
	wake()
end

local function over(st)
	return st.inCard and num(st.el, "CardSticky", "FigmaCardSticky", 1, 0, 1) >= 0.5
end

local function turn(st) -- only a card that is up: the click that showed it must not also turn it
	if num(st.el, "CardTurn", "FigmaCardTurn", 0, 0, 1) < 0.5 or not st.showing or st.v < 0.5 then return end
	st.turned = not st.turned
	wake()
end

function tick(dt)
	clock = clock + dt
	local busy = false
	for _, st in ipairs(cards) do
		local delay = num(st.el, "CardDelay", "FigmaCardDelay", 0.25, 0, 5)
		local hide = num(st.el, "CardHide", "FigmaCardHide", 0.15, 0, 5)
		if st.pending and clock - st.pendingAt >= delay then
			if st.hovered[st.pending] then show(st, st.pending) end
			st.pending = nil
		end
		if st.showing and next(st.hovered) == nil and not over(st) and clock - (st.leftAt or clock) >= hide then st.showing = false end
		if st.owner and not shown(st.owner) then st.showing = false; st.hovered = {} end
		local t = num(st.el, "CardTime", "FigmaCardTime", 0.16, 0.02, 3)
		st.v = math.clamp(st.v + (st.showing and dt / t or -dt / (t * 0.75)), 0, 1)
		if st.owner and st.v > 0 then
			local x, y, cx, cy = aim(st, st.owner)
			local w0, z = 2 * math.pi * 6, 0.85
			local n = math.max(1, math.ceil(dt / (1 / 120)))
			local h = dt / n
			for _ = 1, n do -- another owner: the card glides there instead of popping twice
				st.vx = st.vx + (w0 * w0 * (x - st.x) - 2 * z * w0 * st.vx) * h
				st.vy = st.vy + (w0 * w0 * (y - st.y) - 2 * z * w0 * st.vy) * h
				st.x = st.x + st.vx * h
				st.y = st.y + st.vy * h
			end
			st.el.AnchorPoint = Vector2.new(cx, cy)
			local tt = num(st.el, "CardTurnTime", "FigmaCardTurnTime", 0.4, 0.05, 5)
			if num(st.el, "CardTurn", "FigmaCardTurn", 0, 0, 1) < 0.5 then st.turned = false end
			if (st.tp or 0) <= 0 then -- at rest: the true box, for the turn to come back to
				local _, host = fwChannel(st.el, "k_card")
				local sc0 = host.Scale > 0 and host.Scale or 1
				st.size0 = st.el.Size
				st.w0, st.h0 = st.el.AbsoluteSize.X / sc0, st.el.AbsoluteSize.Y / sc0
			end
			st.tp = math.clamp((st.tp or 0) + (st.turned and dt or -dt) / tt, 0, 1)
			local q = st.tp < 0.5 and 2 * st.tp * st.tp or 1 - (2 - 2 * st.tp) ^ 2 / 2 -- ease in and out
			local th = math.pi * q
			local kx, lift = math.max(0.001, math.abs(math.cos(th))), 1 + 0.05 * math.sin(th)
			local px, py = st.x, st.y
			if st.tp > 0 and st.size0 then
				local sz = st.size0
				st.el.Size = UDim2.new(sz.X.Scale * kx, sz.X.Offset * kx, sz.Y.Scale, sz.Y.Offset)
				local W, H = st.w0 * st.scale.Value, st.h0 * st.scale.Value
				px = st.x + (0.5 - cx) * (W - W * lift * kx) -- narrows about its centre, not the pinned corner
				py = st.y + (0.5 - cy) * (H - H * lift)
				busy = true
			elseif st.size0 and st.el.Size ~= st.size0 then
				st.el.Size = st.size0
			end
			st.turnCh.Value = lift
			local backNow = th > math.pi / 2 -- edge-on is where the sides swap
			if backNow ~= (st.backNow == true) then
				st.backNow = backNow
				showSide(st, backNow)
			end
			local parent = st.el.Parent
			local pp, ps = parent.AbsolutePosition, parent.AbsoluteSize
			if ps.X >= 1 and ps.Y >= 1 then
				st.el.Position = UDim2.fromScale((px - pp.X) / ps.X, (py - pp.Y) / ps.Y)
			end
			local style = math.floor(num(st.el, "CardIn", "FigmaCardIn", 0, 0, 2) + 0.5)
			local e = st.v
			local sc = 1
			if style == 0 then sc = 0.85 + 0.15 * (1 - (1 - e) ^ 3) -- grows out of the corner pinned to the button
			elseif style == 1 then sc = 0.5 + 0.5 * (1 + 2.2 * (e - 1) ^ 3 + 1.2 * (e - 1) ^ 2) end
			st.scale.Value = math.max(0.01, sc)
			setAlpha(st.parts, e)
			st.el.Visible = true
			busy = true
		elseif st.v <= 0 and st.el.Visible then
			st.el.Visible = false
			st.turned, st.tp, st.backNow = false, 0, false -- hidden again: it rests face up
			if st.size0 then st.el.Size = st.size0 end
			st.turnCh.Value = 1
			showSide(st, false)
		end
		if st.showing or st.pending or (next(st.hovered) ~= nil) then busy = true end
	end
	if not busy and conn then conn:Disconnect(); conn = nil end
end

task.wait() -- sizes exist from the first rendered frame on
for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaCard") and d:IsA("GuiObject") and not d:GetAttribute("FW_CardWired") then
		d:SetAttribute("FW_CardWired", true)
		local owners = ownersFor(d, d:GetAttribute("FigmaCardOwner"))
		if #owners == 0 then
			warn(("[Framewisp] _card %q: no button called %q around it — it stays hidden. Name the button in the tag (_card:Buy) or draw the card inside it."):format(
				d.Name, tostring(d:GetAttribute("FigmaCardOwner") or "?")))
		else
			local ref = d:FindFirstChild("FW_Owner") or Instance.new("ObjectValue")
			ref.Name = "FW_Owner"
			ref.Parent = d
			local st = {
				el = d, owners = owners, ref = ref, hovered = {}, v = 0, x = 0, y = 0, vx = 0, vy = 0,
				designW = num(d, "FigmaCardW", "FigmaCardW", math.max(1, d.AbsoluteSize.X), 1),
				showing = false, inCard = false,
			}
			st.parts = collect(d)
			st.scale = fwChannel(d, "k_card")
			st.turnCh = fwChannel(d, "k_turn")
			st.back = sideIn(d, SIDE_BACK)
			st.fronts, st.frontVis = {}, {}
			if st.back then
				local front = sideIn(d, SIDE_FRONT)
				if front then st.fronts = { front } else
					for _, c in ipairs(st.back.Parent:GetChildren()) do
						if c:IsA("GuiObject") and c ~= st.back then st.fronts[#st.fronts + 1] = c end
					end
				end
				for _, f in ipairs(st.fronts) do st.frontVis[f] = f.Visible end
				if num(d, "CardTurn", "FigmaCardTurn", 0, 0, 1) >= 0.5 then showSide(st, false) end
			elseif num(d, "CardTurn", "FigmaCardTurn", 0, 0, 1) >= 0.5 then
				warn(("[Framewisp] _card %q turns over on click, but nothing in it is called Back — it turns and shows the same face."):format(d.Name))
			end
			d.Visible = false
			st.lifted = liftCard(st)
			d.MouseEnter:Connect(function() st.inCard = true end)
			d.InputBegan:Connect(function(input) -- a click on the card turns it too, unless it lands on a button in it
				local t = input.UserInputType
				if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
				local pos = input.Position
				for _, b in ipairs(d:GetDescendants()) do
					if b:IsA("GuiButton") and shown(b) then -- a button on the hidden side is not in the way
						local p, s = b.AbsolutePosition, b.AbsoluteSize
						if pos.X >= p.X and pos.Y >= p.Y and pos.X <= p.X + s.X and pos.Y <= p.Y + s.Y then return end
					end
				end
				turn(st)
			end)
			d.MouseLeave:Connect(function() st.inCard = false; st.leftAt = clock; wake() end)
			local function enter(o)
				st.hovered[o] = true
				if st.showing then show(st, o) else st.pending = o; st.pendingAt = clock end
				wake()
			end
			local function leave(o)
				st.hovered[o] = nil
				if next(st.hovered) == nil then st.leftAt = clock end
				wake()
			end
			for _, o in ipairs(owners) do
				o.MouseEnter:Connect(function() enter(o) end)
				o.MouseLeave:Connect(function() leave(o) end)
				o.InputBegan:Connect(function(input) -- touch has no hover: a tap toggles it (or turns a card that turns)
					if input.UserInputType ~= Enum.UserInputType.Touch then return end
					if st.showing and st.owner == o and num(d, "CardTurn", "FigmaCardTurn", 0, 0, 1) >= 0.5 then turn(st)
					elseif st.showing and st.owner == o then st.hovered = {}; st.showing = false else st.hovered = { [o] = true }; show(st, o) end
					wake()
				end)
				o.Activated:Connect(function(input) -- mouse and gamepad; touch went through the tap above
					if input and input.UserInputType == Enum.UserInputType.Touch then return end
					if st.owner == o then turn(st) end
				end)
			end
			UserInputService.InputBegan:Connect(function(input) -- a tap anywhere else puts it away
				if input.UserInputType ~= Enum.UserInputType.Touch or not st.showing then return end
				local pos = input.Position
				local function inside(g)
					local p, s = g.AbsolutePosition, g.AbsoluteSize
					return pos.X >= p.X and pos.Y >= p.Y and pos.X <= p.X + s.X and pos.Y <= p.Y + s.Y
				end
				if inside(d) then return end
				for _, o in ipairs(owners) do if inside(o) then return end end
				st.hovered = {}
				st.showing = false
				wake()
			end)
			local sel = nil
			GuiService:GetPropertyChangedSignal("SelectedObject"):Connect(function()
				local now = GuiService.SelectedObject
				if sel then leave(sel); sel = nil end
				for _, o in ipairs(owners) do
					if o == now then sel = o; enter(o) break end
				end
			end)
			cards[#cards + 1] = st
		end
	end
end
if #cards > 0 then
	local okv, v = pcall(function() return script:GetAttribute("FWv") end)
	print(("[Framewisp] _card v%s: %d card%s, %d button%s show them"):format(tostring(okv and v or "?"), #cards,
		#cards == 1 and "" or "s", #cards[1].owners, #cards[1].owners == 1 and "" or "s"))
end
