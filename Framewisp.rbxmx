local MASCOT_ICON = "rbxassetid://107059867564082" -- mascot face (toolbar + header)
local UITOOLS_ICON = "rbxassetid://115997769122149" -- crossed hammer + wrench (UI Tools)
local useScale = true -- responsive UDim2.fromScale; false = fixed offset px
-- How the whole design lands on screen (toggled in the widget, persisted):
--   "fit"  = DEFAULT for first-time users: the design is centred and scaled to its
--            canvas fraction of 1920x1080, aspect-locked — never distorts, best
--            first impression for popups/panels.
--   "full" = "Exact (as in Figma)": the design keeps the SAME position & size it had
--            inside its Figma artboard. The blueprint carries the artboard ("screen")
--            size + the design's centre within it, so a button on the left of the
--            slide appears on the left of the Roblox screen, same proportion — even
--            when only that one button is selected. (No artboard info -> fills 1:1.)
local placementMode = "fit"
-- Live Sync: when a code that is already in StarterGui is re-imported, diff the new
-- blueprint against the existing tree (update in place, keep the developer's scripts
-- and hand-added children) instead of building a duplicate. Toggle in the UI.
local syncMode = true
-- rev of the most recently imported blueprint (embedded by the backend). The
-- auto-sync poller baselines on it, so pushes made while Studio was closed — or
-- between import and toggle-enable — are not silently swallowed as "baseline".
local lastImportRev = nil

-- ===================================================================== builder

local function color3(rgb)
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

-- Open Cloud uploads produce a Decal; ImageLabel.Image needs the Image asset id
-- INSIDE it. game:GetObjects loads the asset under the signed-in user (no HTTP,
-- no API key). Cached so identical decals resolve once.
local imageCache = {}
-- An image Roblox has not released yet (moderation / processing) draws NOTHING, and a
-- design that is mostly pictures then looks like no import at all — "my UI is
-- invisible, no errors" (many reports, 28–29.09.2026, when review took hours). While
-- it waits it shows a translucent block in the editor, so the layout is visibly
-- there. Archivable = false: Studio never saves, publishes or plays it — it lives
-- only in this editor session and goes the moment the picture arrives.
local PENDING_NAME = "FW_PendingImage"
local LAYOUT_CLASSES = { UIListLayout = true, UIGridLayout = true, UITableLayout = true, UIPageLayout = true }
local function pendingMark(inst, on)
	local old = inst:FindFirstChild(PENDING_NAME)
	if not on then
		if old then old:Destroy() end
		return
	end
	if old then return end
	for _, c in ipairs(inst:GetChildren()) do
		if LAYOUT_CLASSES[c.ClassName] then return end -- a layout would take it for an item
	end
	if inst.ImageTransparency >= 0.99 then return end -- drawn invisible on purpose
	local f = Instance.new("Frame")
	f.Name = PENDING_NAME
	f.Archivable = false
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Color3.fromRGB(139, 92, 246)
	f.BackgroundTransparency = 0.78
	f.AnchorPoint = Vector2.new(0, 0)
	f.Position = UDim2.fromScale(0, 0)
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = inst.ZIndex
	-- ours, and a helper: a sync must not take it for a developer's addition (that
	-- stashed whole nodes in FramewispRemoved instead of dropping them)
	f:SetAttribute("FW_Owned", true)
	f.Parent = inst
end
-- The panel's status line, for news that arrives after the import returned
-- (images approved late, images that never loaded). Set once the panel exists.
local lateNote = nil
local unresolvedImages = setmetatable({}, { __mode = "k" })
local imageRetryAfter = {}
local retryWorkers = setmetatable({}, { __mode = "k" })
local function resolveImage(rbx)
	if not rbx or rbx == "" then return rbx, true end
	local decalId = string.match(rbx, "%d+")
	if not decalId then return rbx, true end
	if imageCache[decalId] then return imageCache[decalId], true end
	-- One moderating Decal may be reused by dozens of labels. Coalesce calls while
	-- a lookup is in flight and add a short failure cooldown; success is still the
	-- only result cached for the session.
	local now = os.clock()
	if imageRetryAfter[decalId] and imageRetryAfter[decalId] > now then return rbx, false end
	imageRetryAfter[decalId] = math.huge
	local resolved = rbx
	local didResolve = false
	local ok, objects = pcall(function()
		return game:GetObjects("rbxassetid://" .. decalId)
	end)
	if ok and objects and objects[1] then
		local obj = objects[1]
		local texture = obj:IsA("Decal") and obj.Texture or nil
		for _, loaded in ipairs(objects) do loaded:Destroy() end
		if texture then
			local id = string.match(texture, "%d+")
			if id then
				resolved = "rbxassetid://" .. id
				didResolve = true
			end
		end
	end
	-- Never negative-cache a fresh/moderating Decal id. A failed first lookup used
	-- to poison the whole Studio session, so re-importing could never recover. The
	-- short cooldown only deduplicates bursts; background retries continue later.
	if didResolve then
		imageCache[decalId] = resolved
		imageRetryAfter[decalId] = nil
	else
		imageRetryAfter[decalId] = os.clock() + 1.5
	end
	return resolved, didResolve
end

local FONT_WEIGHT = {}
for _, w in ipairs(Enum.FontWeight:GetEnumItems()) do
	FONT_WEIGHT[w.Name] = w
end

local function makeFont(ff)
	local weight = FONT_WEIGHT[ff.weight] or Enum.FontWeight.Regular
	local style = ff.style == "Italic" and Enum.FontStyle.Italic or Enum.FontStyle.Normal
	local ok, font = pcall(function()
		return Font.new(ff.asset, weight, style)
	end)
	if ok then
		return font
	end
	return nil
end

local function udim2(x, y, pw, ph)
	if useScale and pw > 0 and ph > 0 then
		return UDim2.fromScale(x / pw, y / ph)
	end
	return UDim2.fromOffset(x, y)
end

local function applyModifier(m, parent)
	local inst = Instance.new(m.className)
	local p = m.properties
	if m.className == "UICorner" then
		local cr = p.CornerRadius
		inst.CornerRadius = UDim.new(cr.scale or 0, cr.offset or 0)
		-- Roblox now supports four independent corner radii. Each assignment is
		-- guarded so an older Studio build still keeps the common CornerRadius
		-- instead of dropping the whole modifier.
		if type(p.per) == "table" then
			local function setRadius(property, value)
				if type(value) ~= "table" then return end
				pcall(function()
					inst[property] = UDim.new(value.scale or 0, value.offset or 0)
				end)
			end
			setRadius("TopLeftRadius", p.per.TopLeft)
			setRadius("TopRightRadius", p.per.TopRight)
			setRadius("BottomRightRadius", p.per.BottomRight)
			setRadius("BottomLeftRadius", p.per.BottomLeft)
		end
	elseif m.className == "UIStroke" then
		inst.Color = color3(p.Color3)
		inst.Thickness = p.Thickness
		inst.Transparency = p.Transparency
		-- On a TEXT-capable instance the default Contextual mode outlines the
		-- GLYPHS, and a converted button carries no text of its own (Text = "") —
		-- so the border drew nothing at all. As a Frame the same design was fine,
		-- which is exactly how it read: "my stroke disappears when I add _button".
		-- A designed TEXT outline (FigmaTextStrokeW) still wants Contextual.
		if not p.FigmaTextStrokeW and parent
			and (parent:IsA("TextButton") or parent:IsA("TextLabel") or parent:IsA("TextBox")) then
			inst.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		end
		-- Inside / outside borders (BorderStrokePosition, Roblox Dec 2025). Wrapped:
		-- an older Studio has no such property and must not lose the whole import
		-- over a border position.
		if p.BorderStrokePosition then
			pcall(function()
				inst.BorderStrokePosition = Enum.BorderStrokePosition[p.BorderStrokePosition]
			end)
		end
		-- Figma miters a border's corners by default; UIStroke rounds them unless told.
		-- A blueprint without the field (older export) keeps the old rounded corners.
		if p.LineJoinMode then
			pcall(function()
				inst.LineJoinMode = Enum.LineJoinMode[p.LineJoinMode]
			end)
		end
		if p.FigmaStrokeW then
			inst:SetAttribute("FigmaStrokeW", p.FigmaStrokeW)
		end
		if p.FigmaTextStrokeW then
			inst:SetAttribute("FigmaTextStrokeW", p.FigmaTextStrokeW)
		end
	elseif m.className == "UIGradient" then
		local cks, aks = {}, {}
		for _, k in ipairs(p.Color) do
			table.insert(cks, ColorSequenceKeypoint.new(k.p, color3(k.rgb)))
		end
		for _, k in ipairs(p.Transparency) do
			table.insert(aks, NumberSequenceKeypoint.new(k.p, k.a))
		end
		inst.Color = ColorSequence.new(cks)
		inst.Transparency = NumberSequence.new(aks)
		inst.Rotation = p.Rotation or 0
	elseif m.className == "UIAspectRatioConstraint" then
		inst.AspectRatio = p.AspectRatio
	elseif m.className == "UIGridLayout" then
		-- _grid: fixed column count from the design. Cells/gaps here are DESIGN px;
		-- the scaler rebuilds them in screen px (Scale cells inside a ScrollingFrame
		-- resize against the canvas — the classic growing-gaps bug).
		inst.FillDirection = Enum.FillDirection.Horizontal
		inst.HorizontalAlignment = Enum.HorizontalAlignment.Left
		inst.VerticalAlignment = Enum.VerticalAlignment.Top
		inst.StartCorner = Enum.StartCorner.TopLeft
		inst.SortOrder = Enum.SortOrder.LayoutOrder
		inst.FillDirectionMaxCells = p.Cols or 0
		inst.CellSize = UDim2.fromOffset(p.FigmaCellW or 0, p.FigmaCellH or 0)
		inst.CellPadding = UDim2.fromOffset(p.FigmaGapX or 0, p.FigmaGapY or 0)
		inst:SetAttribute("FigmaCellW", p.FigmaCellW or 0)
		inst:SetAttribute("FigmaCellH", p.FigmaCellH or 0)
		inst:SetAttribute("FigmaGapX", p.FigmaGapX or 0)
		inst:SetAttribute("FigmaGapY", p.FigmaGapY or 0)
		-- How far a cell grows when hovered. Cells are anchored top-left, so the
		-- growth only ever needs room on the RIGHT and BELOW.
		inst:SetAttribute("FigmaHoverRoom", p.FigmaHoverRoom or 0)
		inst:SetAttribute("FigmaWinW", p.FigmaWinW or 0)
	elseif m.className == "UIListLayout" then
		-- _list: one row or one column, placed by the engine. The gap arrives as a
		-- FRACTION of the Items frame along the fill direction (that is how Padding
		-- scale is measured), so it keeps its proportion on every screen and no
		-- runtime has to chase it. An Offset import keeps design px: the whole tree
		-- is px there and scales as one.
		local vertical = p.FigmaListDir ~= "H"
		local a = p.FigmaListAlign
		inst.FillDirection = vertical and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
		inst.SortOrder = Enum.SortOrder.LayoutOrder
		if vertical then
			inst.HorizontalAlignment = (a == "Center" and Enum.HorizontalAlignment.Center)
				or (a == "End" and Enum.HorizontalAlignment.Right) or Enum.HorizontalAlignment.Left
			inst.VerticalAlignment = Enum.VerticalAlignment.Top
		else
			inst.VerticalAlignment = (a == "Center" and Enum.VerticalAlignment.Center)
				or (a == "End" and Enum.VerticalAlignment.Bottom) or Enum.VerticalAlignment.Top
			inst.HorizontalAlignment = Enum.HorizontalAlignment.Left
		end
		inst.Padding = useScale and UDim.new(p.FigmaGapS or 0, 0) or UDim.new(0, p.FigmaGap or 0)
		inst:SetAttribute("FigmaGap", p.FigmaGap or 0)
	elseif m.className == "UIPadding" then
		-- _grid: where the first card sits inside the frame (design px; the scaler
		-- rescales).
		inst.PaddingLeft = UDim.new(0, p.FigmaPadL or 0)
		inst.PaddingTop = UDim.new(0, p.FigmaPadT or 0)
		inst.PaddingBottom = UDim.new(0, p.FigmaPadB or 0)
		inst:SetAttribute("FigmaPadL", p.FigmaPadL or 0)
		inst:SetAttribute("FigmaPadT", p.FigmaPadT or 0)
		inst:SetAttribute("FigmaPadB", p.FigmaPadB or 0)
	elseif m.className == "UIShadow" then
		-- Native drop shadow (used when no shadow PNG could be exported). The whole
		-- applyModifier call is pcall-guarded, so Studio versions without UIShadow
		-- simply skip it instead of breaking the import.
		inst.Color = color3(p.Color3)
		inst.Transparency = p.Transparency
		-- These are UDims, and their SCALE is measured against the layer itself —
		-- the blur against its shorter side, the offset and spread against each
		-- axis. Written as fractions the engine keeps the shadow the same size
		-- relative to its card on every screen, with nothing running to maintain it.
		-- Pixels stay as the fallback for a blueprint made before the fractions.
		if type(p.BlurS) == "number" then
			inst.BlurRadius = UDim.new(p.BlurS, 0)
			inst.Spread = UDim2.fromScale(p.SpreadS and p.SpreadS.x or 0, p.SpreadS and p.SpreadS.y or 0)
			inst.Offset = UDim2.fromScale(p.OffsetS and p.OffsetS.x or 0, p.OffsetS and p.OffsetS.y or 0)
		else
			inst.Offset = UDim2.fromOffset(p.Offset.x, p.Offset.y)
			inst.BlurRadius = UDim.new(0, p.Blur or 0)
			inst.Spread = UDim2.fromOffset(p.Spread or 0, p.Spread or 0)
		end
		-- Inset turns a drop shadow into an inner one; wrapped because an older
		-- Studio has the class without the property.
		if p.Inset ~= nil then pcall(function() inst.Inset = p.Inset == true end) end
		inst.ZIndex = -(p.Order or 1)
	end
	-- Live Sync: modifiers are Framewisp's, so a re-sync can clear and rebuild them
	-- without disturbing a UICorner/UIStroke a developer added by hand.
	inst:SetAttribute("FW_Owned", true)
	-- A gradient can belong to the outline rather than the GuiObject's fill.
	-- Preserve that nesting on both a fresh import and Live Sync rebuilds.
	if m.modifiers then
		for _, child in ipairs(m.modifiers) do applyModifier(child, inst) end
	end
	inst.Parent = parent
end

local function applyProps(inst, p, pw, ph)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	if p.Size then
		inst.Size = udim2(p.Size.w, p.Size.h, pw, ph)
	end
	-- Centre pivot for every element (AnchorPoint 0.5): matches Figma's centre origin
	-- and is nicer for scaling/animation. Position is offset to the element's centre so
	-- it lands in the EXACT same spot — only the pivot changes. Nodes that already carry
	-- an explicit AnchorPoint (rotated/centred) keep their centre coords as-is.
	if p.AnchorPoint then
		inst.AnchorPoint = Vector2.new(p.AnchorPoint[1], p.AnchorPoint[2])
		if p.Position then
			inst.Position = udim2(p.Position.x, p.Position.y, pw, ph)
		end
	elseif p.Position and p.Size then
		inst.AnchorPoint = Vector2.new(0.5, 0.5)
		inst.Position = udim2(p.Position.x + p.Size.w / 2, p.Position.y + p.Size.h / 2, pw, ph)
	elseif p.Position then
		inst.Position = udim2(p.Position.x, p.Position.y, pw, ph)
	end
	if p.Position then
		-- The blueprint just declared this position the truth, so the ink anchor
		-- must re-derive its base from it. A base captured on an already-shifted
		-- label (an old build's offset, a hand-drag) survived re-imports and kept
		-- ONE label high while everything around it healed.
		inst:SetAttribute("FW_TextYS0", nil)
		inst:SetAttribute("FW_TextY0", nil)
	end
	if p.Rotation then
		inst.Rotation = p.Rotation
	end
	if p.ZIndex then
		inst.ZIndex = p.ZIndex
	end
	if p.LayoutOrder then
		inst.LayoutOrder = p.LayoutOrder
	end
	if p.Visible ~= nil then
		inst.Visible = p.Visible
	end
	if p.BackgroundColor3 then
		inst.BackgroundColor3 = color3(p.BackgroundColor3)
	end
	if p.BackgroundTransparency ~= nil then
		inst.BackgroundTransparency = p.BackgroundTransparency
	end
	if p.ClipsDescendants ~= nil and inst:IsA("GuiObject") then
		inst.ClipsDescendants = p.ClipsDescendants
	end
	if inst:IsA("CanvasGroup") and p.GroupTransparency ~= nil then
		inst.GroupTransparency = p.GroupTransparency
	end
	if inst:IsA("ScrollingFrame") then
		-- Nothing overflowed in the design, so the engine grows the canvas itself —
		-- on the axis the designer chose. A shop row that a script fills at runtime
		-- arrives this way, and pinning it to Y left it scrolling the wrong way.
		if p.AutomaticCanvasSize == "Y" or p.AutomaticCanvasSize == "X" then
			local sideways = p.AutomaticCanvasSize == "X"
			inst.CanvasSize = UDim2.new()
			inst.AutomaticCanvasSize = sideways and Enum.AutomaticSize.X or Enum.AutomaticSize.Y
			inst.ScrollingDirection = sideways and Enum.ScrollingDirection.X or Enum.ScrollingDirection.Y
		end
		-- A stated canvas, in design px, as a pure SCALE of the window — so it stays
		-- right on every screen with no runtime arithmetic. AutomaticCanvasSize cannot
		-- do this job: a scale-sized child is measured against the WINDOW and never
		-- contributes to the canvas, so the engine leaves the canvas at window size and
		-- the whole list below the fold is simply clipped.
		-- The children keep being measured against the window — that is what Roblox
		-- does, and re-basing them onto the canvas squashed every one of them by
		-- exactly canvas/window (a real user report: "everything is stretched").
		if p.CanvasSize and p.Size then
			local sw, sh = p.Size.w or 0, p.Size.h or 0
			local cw, ch = p.CanvasSize.w or 0, p.CanvasSize.h or 0
			inst.AutomaticCanvasSize = Enum.AutomaticSize.None
			-- CanvasSize.Scale is measured against the frame's PARENT, like Size —
			-- NOT against the scroll frame itself (the same rule UI Tools states in
			-- refFor). Dividing by the frame blew the canvas up by parent/frame and
			-- took every card with it: "everything is stretched and huge".
			if useScale and pw > 0 and ph > 0 then
				inst.CanvasSize = UDim2.fromScale(cw / pw, ch / ph)
			else
				inst.CanvasSize = UDim2.fromOffset(cw, ch)
			end
			-- Both axes are stated even when only one overflows: it keeps the box the
			-- children are measured in exactly the design's, instead of the window minus
			-- a scrollbar. What stops the other axis moving is the DIRECTION, chosen in
			-- the plugin (vertical by default).
			if p.ScrollingDirection == "X" then
				inst.ScrollingDirection = Enum.ScrollingDirection.X
			else
				inst.ScrollingDirection = Enum.ScrollingDirection.Y
			end
		end
		if p.FWGridScroll then
			-- _grid + _scroll: the scaler owns CanvasSize (manual, from the grid's
			-- real content height) — AutomaticCanvasSize mis-measures padded grids.
			inst.AutomaticCanvasSize = Enum.AutomaticSize.None
			inst.CanvasSize = UDim2.new()
			inst.ScrollingDirection = Enum.ScrollingDirection.Y
			inst:SetAttribute("FWGridScroll", true)
			-- The design reserved this many DESIGN px for the bar. The scaler resizes
			-- it with the rest of the UI: a fixed 6px bar eats a growing share of the
			-- row as the screen shrinks, and the fit cap takes that out of the cards.
			inst:SetAttribute("FigmaBar", p.ScrollBarThickness or 6)
		end
		if p.ScrollBarThickness then
			inst.ScrollBarThickness = p.ScrollBarThickness
		end
	end
	if (inst:IsA("TextButton") or inst:IsA("ImageButton")) and p.AutoButtonColor ~= nil then
		inst.AutoButtonColor = p.AutoButtonColor
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		if p.RichText ~= nil then
			inst.RichText = p.RichText
		end
		if p.Text ~= nil then
			inst.Text = p.Text
		end
		-- _textbox: the drawn text is the placeholder, the field starts empty and keeps
		-- what the player typed. Written before the fonts so the placeholder inherits
		-- the same face and size the scaler settles below.
		if inst:IsA("TextBox") then
			if p.PlaceholderText ~= nil then
				inst.PlaceholderText = p.PlaceholderText
			end
			if p.PlaceholderColor3 then
				inst.PlaceholderColor3 = color3(p.PlaceholderColor3)
			end
			if p.ClearTextOnFocus ~= nil then
				inst.ClearTextOnFocus = p.ClearTextOnFocus
			end
			if p.TextEditable ~= nil then
				inst.TextEditable = p.TextEditable
			end
		end
		if p.TextColor3 then
			inst.TextColor3 = color3(p.TextColor3)
		end
		if p.TextTransparency ~= nil then
			inst.TextTransparency = p.TextTransparency
		end
		if p.TextXAlignment then
			inst.TextXAlignment = Enum.TextXAlignment[p.TextXAlignment]
		end
		if p.TextYAlignment then
			inst.TextYAlignment = Enum.TextYAlignment[p.TextYAlignment]
		end
		-- ORDER MATTERS, and it cost an evening: the engine couples these two, so
		-- writing TextWrapped = false CLEARS TextScaled. Written the other way round
		-- the label silently lost its TextScaled on every billboard import while the
		-- blueprint plainly asked for it. TextWrapped first, TextScaled last, always.
		if p.TextWrapped ~= nil then
			inst.TextWrapped = p.TextWrapped
		end
		-- A multiple of TextSize, so the px scaler cannot break it. Sent for
		-- wrapped labels whose Figma line height differs from the font's own.
		if p.LineHeight then
			inst.LineHeight = p.LineHeight
		end
		-- TextScaled is honoured again, but only where the converter ASKS for it:
		-- _fit and world-space billboards. The old blanket experiment shrank every
		-- sibling label by its own ratio — that is why this used to be ignored, and
		-- why it stays opt-in per label instead of a global switch.
		if p.TextScaled ~= nil then
			inst.TextScaled = p.TextScaled
			inst:SetAttribute("FW_TextScaledMine", p.TextScaled)
		end
		if p.TextSize then
			-- Design px initially (like the old plugin); the FramewispTextScaler
			-- applies the factor + resolution scale via the FigmaFontSize attribute.
			inst.TextSize = p.TextSize
			-- …and the scaler owns it again. Without this, a re-import or Live Sync
			-- wrote the design px over the scaled size, the scaler read the change as
			-- a developer's hand edit (FW_TextOwn) and left that label at raw design
			-- px for good — big on a small screen, small on a big one.
			inst:SetAttribute("FW_TextMine", nil)
			inst:SetAttribute("FW_TextOwn", nil)
		end
		if p.FontFace then
			local f = makeFont(p.FontFace)
			if f then
				inst.FontFace = f
				-- Where this face puts its baseline inside the line box Roblox draws.
				-- Stamped on the label so the runtime scaler and the editor preview
				-- read the same number, and so it can be tuned by hand in Studio.
				local bf = FW_BASE_FRAC[tostring(f.Family)]
				if bf then
					-- refresh OUR stamp when the table improves; a value the
					-- developer tuned by hand (differs from what we stamped) stays
					local cur = inst:GetAttribute("TextBaseFrac")
					local st = inst:GetAttribute("FW_BaseStamp")
					if cur == nil or cur == st then
						inst:SetAttribute("TextBaseFrac", bf)
						inst:SetAttribute("FW_BaseStamp", bf)
					end
				end
			end
		end
	end
	if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		if p.Image ~= nil then
			inst:SetAttribute("FW_ImageSource", p.Image)
			local image, resolved = resolveImage(p.Image) -- backend gives a Decal id; resolve to the Image id
			inst.Image = image
			if resolved then unresolvedImages[inst] = nil else unresolvedImages[inst] = p.Image end
			pendingMark(inst, not resolved and p.Image ~= "")
		end
		if p.ImageTransparency ~= nil then
			inst.ImageTransparency = p.ImageTransparency
		end
		if p.ScaleType then
			inst.ScaleType = Enum.ScaleType[p.ScaleType]
		end
		if p.TileSize and p.Size then
			if useScale and p.Size.w > 0 and p.Size.h > 0 then
				inst.TileSize = UDim2.fromScale(p.TileSize.w / p.Size.w, p.TileSize.h / p.Size.h)
			else
				inst.TileSize = UDim2.fromOffset(p.TileSize.w, p.TileSize.h)
			end
		end
	end
end

-- _color: which property actually PAINTS a class. The importer seeds the Color
-- attribute from it so the slot is already in the Properties panel with the
-- design's own colour in it; the runtime writes the same property at run time.
FW_COLOR_PROP = { -- global, like stampDesign: the main chunk is at Luau's local-register ceiling
	Frame = "BackgroundColor3", ScrollingFrame = "BackgroundColor3", CanvasGroup = "BackgroundColor3",
	ImageLabel = "ImageColor3", ImageButton = "ImageColor3",
	TextLabel = "TextColor3", TextButton = "TextColor3", TextBox = "TextColor3",
}
function fwColorProp(inst) -- global for the same reason
	local prop = FW_COLOR_PROP[inst.ClassName]
	if prop == "TextColor3" then
		local ok, txt = pcall(function() return inst.Text end)
		if ok and txt == "" then return "BackgroundColor3" end -- a Framewisp button shell holds no text: its fill IS its colour
	end
	return prop
end

local rememberManagedOptionalProps
local function build(spec, parent, pw, ph, inBB)
	local inst = Instance.new(spec.className)
	local p = spec.properties or {}
	-- World-space context: the root of a _billboard design carries the marker and
	-- children inherit it through this flag — the tree is only parented into its
	-- BillboardGui after build, so an ancestor check could never see it here.
	inBB = inBB or (spec.attributes and spec.attributes.FigmaBillboard ~= nil) or false
	applyProps(inst, p, pw, ph)
	rememberManagedOptionalProps(inst, p)
	if spec.modifiers then
		for _, m in ipairs(spec.modifiers) do
			-- pcall: an unknown modifier class (e.g. UIShadow on an older Studio)
			-- must never take the whole import down with it.
			pcall(applyModifier, m, inst)
		end
	end
	-- Outlines scale with the design, not with the screen's pixel grid. In
	-- ScaledSize the engine reads Thickness as a fraction of the parent's shortest
	-- axis, so an outline keeps its proportion at any viewport and at any camera
	-- distance inside a billboard — where nothing else could scale it at all.
	if p.Size and p.Size.w and p.Size.h then
		local short = math.max(1, math.min(p.Size.w, p.Size.h))
		for _, st in ipairs(inst:GetChildren()) do
			-- ONLY box outlines. A text outline follows the GLYPHS and must grow with
			-- the font, not with the label's box (which is usually far taller than the
			-- letters) — that is the scaler's job. And the mode is only trustworthy up
			-- to a tenth of the short side; past that, stay in pixels.
			-- Inside a _billboard both rules bend: TextScaled makes the glyphs fill
			-- the box (and the fit pass re-solves the fraction against the inked box
			-- afterwards), while a pixel outline has NO viewport scaler to fall back
			-- on in world space — it would simply be wrong at every camera distance.
			-- So text outlines ride along and the cap loosens to what the mode still
			-- renders faithfully. This is what keeps every stroke 1:1 with Figma.
			if st:IsA("UIStroke") then
				local dsw = st:GetAttribute("FigmaStrokeW")
				if inBB and not dsw then dsw = st:GetAttribute("FigmaTextStrokeW") end
				local frac = dsw and dsw > 0 and dsw / short or nil
				if frac and frac <= (inBB and 0.35 or 0.1) and (inBB or not st:GetAttribute("FigmaTextStrokeW"))
					and pcall(function() st.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize end) then
					st.Thickness = frac
					st:SetAttribute("FW_StrokeScaled", true)
				end
			end
		end
	end
	if spec.attributes then
		for k, v in pairs(spec.attributes) do
			inst:SetAttribute(k, v)
		end
	end
	if spec.attributes and spec.attributes.FigmaColor ~= nil then
		local prop = fwColorProp(inst)
		local grad = inst:FindFirstChildOfClass("UIGradient")
		if prop and inst:GetAttribute("Color") == nil then
			if grad then
				inst:SetAttribute("Color", grad.Color) -- a ColorSequence: stops and positions editable in Properties, like Figma's
			else
				local ok, cur = pcall(function() return inst[prop] end)
				if ok and typeof(cur) == "Color3" then inst:SetAttribute("Color", cur) end
			end
		end
	end
	-- Live Sync ownership: every instance Framewisp builds is marked FW_Owned so a
	-- later re-import can tell its own instances apart from anything a developer
	-- added by hand (which must never be touched). Content nodes also carry
	-- FigmaNodeId (set above from spec.attributes) as their diff identity.
	inst:SetAttribute("FW_Owned", true)
	inst.Name = spec.name or spec.className
	-- this instance's design size becomes the parent frame for its children
	local myW = (p.Size and p.Size.w) or pw
	local myH = (p.Size and p.Size.h) or ph
	-- Children of a ScrollingFrame resolve Scale against the CANVAS, not the window
	-- (same rule as refFor in UI Tools) — hand them the box they will be measured in.
	if p.CanvasSize then
		myW = math.max(myW, p.CanvasSize.w or 0)
		myH = math.max(myH, p.CanvasSize.h or 0)
	end
	if spec.children then
		for _, ch in ipairs(spec.children) do
			build(ch, inst, myW, myH, inBB)
		end
	end
	inst.Parent = parent
	return inst
end

-- Safety net for blueprints made by older Figma/backend builds. State variants
-- only work under their owning control; an orphan `_hover` otherwise remains
-- Visible=false forever (the exact 97H5AM failure).
local function repairOrphanStates(root)
	local repaired = 0
	local nodes = { root }
	for _, d in ipairs(root:GetDescendants()) do nodes[#nodes + 1] = d end
	for _, d in ipairs(nodes) do
		local state = d:GetAttribute("FigmaState")
		if state then
			local owner = nil
			local n = d.Parent
			while n and n ~= root.Parent do
				if state == "active" then
					if n:GetAttribute("FigmaAction") == "tab" and (n:IsA("TextButton") or n:IsA("ImageButton")) then owner = n break end
				elseif n:IsA("TextButton") or n:IsA("ImageButton") then
					owner = n break
				end
				n = n.Parent
			end
			if not owner then
				d:SetAttribute("FigmaState", nil)
				d:SetAttribute("FW_RecoveredState", state)
				if d:IsA("GuiObject") then d.Visible = true end
				repaired = repaired + 1
				warn(("[Framewisp] Recovered orphan _%s layer '%s' (no owning button)."):format(tostring(state), d:GetFullName()))
			end
		end
	end
	return repaired
end

-- Fresh uploads can take a few seconds before game:GetObjects can expose the
-- inner Image id. Retry in the background and report anything still unresolved.
local function retryUnresolvedImages(root, retryNow)
	-- Restore retry state after Studio/plugin restart. A successfully resolved
	-- image differs from its saved Decal source, so only still-blank sources enter
	-- the queue again.
	local nodes = { root }
	for _, d in ipairs(root:GetDescendants()) do nodes[#nodes + 1] = d end
	for _, inst in ipairs(nodes) do
		if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			local source = inst:GetAttribute("FW_ImageSource")
			if type(source) == "string" and source ~= "" and inst.Image == source then
				unresolvedImages[inst] = source
				pendingMark(inst, true)
			else
				pendingMark(inst, false)
			end
		end
	end
	local function pending()
		local out = {}
		for inst, source in pairs(unresolvedImages) do
			if inst.Parent and (inst == root or inst:IsDescendantOf(root)) then
				out[#out + 1] = { inst = inst, source = source }
			end
		end
		return out
	end
	local initial = #pending()
	if initial == 0 then return 0, 0 end
	local function attemptPending()
		for _, item in ipairs(pending()) do
			-- A Live Sync may have assigned a newer source while this lookup was
			-- yielding. Never let an old retry overwrite that new image/generation.
			if unresolvedImages[item.inst] == item.source then
				if item.inst.Image ~= item.source then
					-- A developer manually replaced the image while moderation was
					-- pending. Their edit wins; stop managing this old source.
					unresolvedImages[item.inst] = nil
					pendingMark(item.inst, false)
				else
					local image, resolved = resolveImage(item.source)
					if unresolvedImages[item.inst] == item.source and item.inst.Image ~= item.source then
						unresolvedImages[item.inst] = nil
					elseif resolved and item.inst.Parent and unresolvedImages[item.inst] == item.source then
						item.inst.Image = image
						unresolvedImages[item.inst] = nil
						pendingMark(item.inst, false)
					end
				end
			end
		end
	end
	-- The UI's manual Retry button gets one immediate pass even when the existing
	-- background worker is sleeping. The same source/manual-edit guards still apply.
	if retryNow then attemptPending() end
	local remaining = #pending()
	if remaining == 0 then return initial, 0 end
	if retryWorkers[root] then return initial, remaining end
	retryWorkers[root] = true
	task.spawn(function()
		-- Roblox moderation commonly takes longer than the old ~20 second window —
		-- and on a bad day, hours: 28.09.2026 most fresh uploads sat in review for
		-- 4+ hours, and a twelve-minute give-up left every such design blank under
		-- "Done!" until Studio restarted. Quick tries first, then every two minutes
		-- for as long as six hours; each try is a local Studio lookup, not a billed
		-- request. The source stays marked either way, so the manual button, Live
		-- Sync and the next Studio session still pick it up.
		local schedule = { 2, 3, 5, 10, 20, 30, 60, 120, 180, 300 }
		for _ = 1, 175 do schedule[#schedule + 1] = 120 end
		for _, delay in ipairs(schedule) do
			task.wait(delay)
			if not root.Parent then retryWorkers[root] = nil return end -- the design was deleted
			attemptPending()
			if #pending() == 0 then
				print(("[Framewisp] All %d delayed image(s) resolved."):format(initial))
				if lateNote then lateNote(("Roblox approved the %d image(s) that were in review — they are in the design now."):format(initial), true) end
				retryWorkers[root] = nil
				return
			end
		end
		local left = pending()
		if #left > 0 then
			warn(("[Framewisp] %d image(s) are still unavailable after retries. They may be moderating or rejected:"):format(#left))
			for _, item in ipairs(left) do warn("  - " .. item.inst:GetFullName() .. " <- " .. tostring(item.source)) end
		end
		retryWorkers[root] = nil
	end)
	return initial, remaining
end

-- ================================================================== live sync
-- Forward declaration: reconcileScreen (below) re-runs the editor-side scaler after
-- a sync, but attachScaler is defined further down. Declared here so the reconcile
-- functions capture it as an upvalue instead of a nil global.
local attachScaler

-- Re-importing a code that is already in StarterGui does NOT rebuild from scratch.
-- We DIFF the new blueprint against the existing tree by FigmaNodeId and update in
-- place, so a developer's scripts, hand-added children and tweaks survive. Identity:
--   FigmaNodeId  — the source layer a content instance came from (diff key)
--   FW_Owned     — this instance was built by Framewisp (safe to touch); anything
--                  WITHOUT it was added by the developer and is never modified.

local MODIFIER_CLASSES = {
	UICorner = true, UIStroke = true, UIGradient = true, UIAspectRatioConstraint = true,
	UIShadow = true, UIPadding = true, UIListLayout = true, UIGridLayout = true,
	UITableLayout = true, UIScale = true, UISizeConstraint = true, UITextSizeConstraint = true,
}
-- FW_Owned helpers that carry no FigmaNodeId and regenerate themselves — never
-- diff-matched, orphaned or destroyed by a sync.
local HELPER_NAMES = { FWScale = true, FWTextBig = true, FramewispShade = true, FramewispPress = true, FramewispSmooth = true, FW_PendingImage = true }

local function isModifier(c) return MODIFIER_CLASSES[c.ClassName] == true end
local function isHelper(c) return HELPER_NAMES[c.Name] == true or c:IsA("LuaSourceContainer") end
-- A child Framewisp built that reconcile may match / replace / remove.
local function isManaged(c)
	return c:GetAttribute("FW_Owned") == true and not isModifier(c) and not isHelper(c)
end
local function specId(spec) return spec.attributes and spec.attributes.FigmaNodeId end
local function specKey(spec) return spec.className .. "|" .. (spec.name or spec.className) end

-- Move a removed-but-referenceable instance out of the tree instead of deleting it:
-- a developer may have wired game logic to it, so keep it recoverable.
local function orphan(inst, screen)
	local folder = screen:FindFirstChild("FramewispRemoved")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "FramewispRemoved"
		folder:SetAttribute("FW_Owned", true)
		folder.Parent = screen
	end
	inst.Parent = folder
	-- A Folder does NOT hide its GuiObject children — they keep RENDERING on
	-- screen. A removed full-screen panel then stretches over the whole UI as
	-- "garbage". Hide the removed instance so FramewispRemoved stays a
	-- recoverable stash, not visible junk. (Re-adopting reapplies Visible from
	-- the spec, so this never keeps a returning element hidden.)
	if inst:IsA("GuiObject") then inst.Visible = false end
end

-- Clear Framewisp-owned modifiers on inst and rebuild from spec.modifiers. A UICorner
-- or UIStroke a developer added by hand has no FW_Owned attribute and is left alone.
-- FWScale (the text scaler's UIScale) is FW_Owned but must survive — skip it.
local function refreshModifiers(inst, mods)
	for _, c in ipairs(inst:GetChildren()) do
		if isModifier(c) and c:GetAttribute("FW_Owned") and c.Name ~= "FWScale" then
			c:Destroy()
		end
	end
	if mods then
		for _, m in ipairs(mods) do pcall(applyModifier, m, inst) end
	end
end

-- Move a developer's own children (scripts, hand-added GuiObjects — anything NOT
-- FW_Owned) from an old instance onto a replacement. Used when a node keeps its
-- FigmaNodeId but changed Roblox class between imports, so the developer's work
-- follows the node instead of being stranded in FramewispRemoved.
local function adoptDeveloperChildren(old, new)
	for _, c in ipairs(old:GetChildren()) do
		if c:GetAttribute("FW_Owned") ~= true then
			c.Parent = new
		end
	end
end

-- A generated wrapper (Cells, Canvas) carries no FigmaNodeId of its own, but the
-- real design nodes inside it are exactly what a developer's scripts reference —
-- stash the wrapper instead of destroying them with it.
local function hasDesignDescendant(inst)
	for _, d in ipairs(inst:GetDescendants()) do
		if d:GetAttribute("FigmaNodeId") then return true end
	end
	return false
end

local function hasDeveloperDescendant(inst)
	for _, d in ipairs(inst:GetDescendants()) do
		if d:GetAttribute("FW_Owned") ~= true then return true end
	end
	return false
end

-- Wrapper insertion/removal (for example Frame[A] <-> Frame[Canvas[A]]) changes
-- parent-local diff boundaries. Snapshot top-level developer additions so they
-- can follow the same FigmaNodeId even when the managed wrapper structure moves.
local function snapshotDeveloperAttachments(root)
	local records = {}
	local owners = { root }
	for _, d in ipairs(root:GetDescendants()) do
		if d:GetAttribute("FW_Owned") == true then owners[#owners + 1] = d end
	end
	local function locator(owner)
		local path = {}
		local n = owner
		while n do
			local id = n:GetAttribute("FigmaNodeId")
			if id then return { baseId = id, path = path } end
			if n == root then return { atRoot = true, path = path } end
			table.insert(path, 1, n.ClassName .. "|" .. n.Name)
			n = n.Parent
		end
		return { atRoot = true, path = path }
	end
	for _, owner in ipairs(owners) do
		for _, child in ipairs(owner:GetChildren()) do
			if child:GetAttribute("FW_Owned") ~= true then
				records[#records + 1] = { child = child, locator = locator(owner) }
			end
		end
	end
	return records
end

local function restoreDeveloperAttachments(activeRoot, records)
	local byId = {}
	local nodes = { activeRoot }
	for _, d in ipairs(activeRoot:GetDescendants()) do nodes[#nodes + 1] = d end
	for _, d in ipairs(nodes) do
		local id = d:GetAttribute("FigmaNodeId")
		if id and not byId[id] then byId[id] = d end
	end
	for _, record in ipairs(records) do
		local child = record.child
		if not (child == activeRoot or child:IsDescendantOf(activeRoot)) then
			local loc = record.locator
			local target = loc.baseId and byId[loc.baseId] or (loc.atRoot and activeRoot or nil)
			if target then
				for _, key in ipairs(loc.path) do
					local nextTarget = nil
					for _, c in ipairs(target:GetChildren()) do
						if c:GetAttribute("FW_Owned") == true and c.ClassName .. "|" .. c.Name == key then
							nextTarget = c
							break
						end
					end
					if not nextTarget then break end -- wrapper changed: fall back to nearest stable owner
					target = nextTarget
				end
				child.Parent = target
			end
		end
	end
end

-- Root's visual modifiers only (never the aspect lock, layout, padding or FWScale).
local ROOT_VISUAL_MODS = { UICorner = true, UIStroke = true, UIGradient = true, UIShadow = true }
local function refreshRootModifiers(inst, mods)
	for _, c in ipairs(inst:GetChildren()) do
		if ROOT_VISUAL_MODS[c.ClassName] and c:GetAttribute("FW_Owned") then
			c:Destroy()
		end
	end
	if mods then
		for _, m in ipairs(mods) do
			if ROOT_VISUAL_MODS[m.className] then pcall(applyModifier, m, inst) end
		end
	end
end

-- Place the design root on screen: Exact (maps to the Figma artboard), whole-artboard
-- fill, or Fit & centre — all aspect-locked so nothing stretches. Idempotent: clears
-- any prior direct-child aspect lock, so it is safe to re-run on a Live Sync (the new
-- design's canvas size / place become the source of truth, avoiding drift).
-- Returns a note when "Exact" could not be honoured. It used to say so only in the
-- Output window, which nobody has open — so the toggle read "same spot as Figma"
-- and quietly centred the design, over and over.
local function placeRoot(root, bp)
	local fellBack = false
	for _, c in ipairs(root:GetChildren()) do
		if c:IsA("UIAspectRatioConstraint") and c:GetAttribute("FW_Owned") then c:Destroy() end
	end
	local scr = bp.screen
	local hasScreen = type(scr) == "table" and type(scr.w) == "number" and type(scr.h) == "number"
		and scr.w > 0 and scr.h > 0
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = bp.canvas.w / math.max(bp.canvas.h, 1)
	aspect:SetAttribute("FW_Owned", true)
	if placementMode == "full" and hasScreen then
		-- World / Exact: `place` is the design's CENTRE within the artboard; anchor 0.5
		-- keeps render-bounds and rotation consistent. build() already set root.Rotation.
		local px = (type(bp.place) == "table" and tonumber(bp.place.x)) or 0
		local py = (type(bp.place) == "table" and tonumber(bp.place.y)) or 0
		root.Position = UDim2.fromScale(px / scr.w, py / scr.h)
		root.Size = UDim2.fromScale(bp.canvas.w / scr.w, bp.canvas.h / scr.h)
		aspect.AspectType = Enum.AspectType.FitWithinMaxSize
	else
		-- Fit & centre — and ALSO the fallback for "Exact" without artboard info.
		-- "Exact" used to treat a screen-less blueprint as "the design IS the
		-- screen" and set Size(1,1): correct for a real whole-artboard export,
		-- but a bare panel exported without an artboard blew up to the entire
		-- viewport (real user report: a 766x678 VIP frame filling the screen).
		-- With no reference there is nothing to be exact against — centre it.
		-- The canvas fraction of 1920x1080 is CLAMPED to 1, so a full-HD or
		-- larger artboard still fills the screen exactly as before, while a
		-- panel lands at its designed fraction, aspect-locked.
		if placementMode == "full" then
			warn("[Framewisp] Exact layout: this convert has no artboard reference (the frame was exported on its own), so it was centred instead. For the exact Figma position, place the frame inside a screen-size artboard and convert again.")
			fellBack = true
		end
		root.Position = UDim2.fromScale(0.5, 0.5)
		local REF_W, REF_H = 1920, 1080
		root.Size = UDim2.fromScale(math.min(bp.canvas.w / REF_W, 1), math.min(bp.canvas.h / REF_H, 1))
		aspect.AspectType = Enum.AspectType.FitWithinMaxSize
	end
	aspect.Parent = root
	if fellBack then
		return "Exact layout needs an artboard: this frame was exported on its own, so it was centred. Put it inside a screen-size frame in Figma and convert again."
	end
	return nil
end

-- Remember only optional properties that the PREVIOUS blueprint actually owned.
-- A missing property must reset when a Figma tag/style was removed, but must not
-- erase an unrelated manual Studio edit on a property Framewisp never supplied.
local OPTIONAL_PROP_MARKERS = {
	Rotation = "FW_HadRotation",
	Visible = "FW_HadVisible",
	RichText = "FW_HadRichText",
}
rememberManagedOptionalProps = function(inst, p)
	for prop, marker in pairs(OPTIONAL_PROP_MARKERS) do
		inst:SetAttribute(marker, p[prop] ~= nil and true or nil)
	end
end

local function resetRemovedProps(inst, p)
	if inst:IsA("GuiObject") then
		if p.Rotation == nil and inst:GetAttribute(OPTIONAL_PROP_MARKERS.Rotation) then inst.Rotation = 0 end
		if p.Visible == nil and inst:GetAttribute(OPTIONAL_PROP_MARKERS.Visible) then inst.Visible = true end
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		if p.RichText == nil and inst:GetAttribute(OPTIONAL_PROP_MARKERS.RichText) then inst.RichText = false end
	end
	-- A picture that MOVED (a card that gained a shadow hands its paint to an "Art"
	-- child) leaves the old one behind: applyProps only ever writes properties the
	-- new spec carries, so the shell kept drawing the previous image UNDER the new
	-- child — the same art twice, at two sizes. Only we ever set this, and only via
	-- FW_ImageSource, so clearing it cannot touch a developer's own image.
	if (inst:IsA("ImageLabel") or inst:IsA("ImageButton")) and p.Image == nil
		and inst:GetAttribute("FW_ImageSource") ~= nil then
		inst.Image = ""
		inst:SetAttribute("FW_ImageSource", nil)
		pendingMark(inst, false)
	end
end

local reconcileNode
-- Match spec.children against inst's managed children (by FigmaNodeId, or by
-- class+name for id-less internal nodes like "Canvas"/shadows), then update / add /
-- remove. `stat` accumulates the {upd, add, rem} counts for the summary line.
local function reconcileChildren(spec, inst, screen, myW, myH, stat)
	-- Snapshot the ORIGINAL managed children first. The gone-pass must iterate this
	-- list, NOT inst:GetChildren() again — build() below adds new nodes mid-pass and
	-- those must not be seen as "removed" and immediately destroyed.
	local existing, byId, byKey = {}, {}, {}
	for _, c in ipairs(inst:GetChildren()) do
		if isManaged(c) then
			existing[#existing + 1] = c
			local id = c:GetAttribute("FigmaNodeId")
			if id then
				byId[id] = c
			else
				local k = c.ClassName .. "|" .. c.Name
				byKey[k] = byKey[k] or c
			end
		end
	end
	local matched = {}
	for _, chspec in ipairs(spec.children or {}) do
		local id = specId(chspec)
		-- An id-bearing spec matches by id ONLY (never fall back to name — that would
		-- let a brand-new node adopt an unrelated id-less instance). Id-less internal
		-- nodes (Canvas / shadows / background) match by class+name.
		local ex
		if id then ex = byId[id] else ex = byKey[specKey(chspec)] end
		if ex and ex.ClassName == chspec.className and not matched[ex] then
			matched[ex] = true
			reconcileNode(chspec, ex, screen, myW, myH, stat)
		elseif id and ex and ex.ClassName ~= chspec.className and not matched[ex] then
			-- Replace only this node's shell. Move the old managed children into it
			-- and reconcile recursively so developer additions nested at ANY depth
			-- stay attached to their original FigmaNodeId owners.
			local shellSpec = {}
			for k, v in pairs(chspec) do if k ~= "children" then shellSpec[k] = v end end
			local newInst = build(shellSpec, nil, myW, myH)
			adoptDeveloperChildren(ex, newInst)
			for _, child in ipairs(ex:GetChildren()) do
				if isManaged(child) then child.Parent = newInst end
			end
			newInst.Parent = inst
			matched[ex] = true
			orphan(ex, screen)
			stat.add = stat.add + 1
			stat.rem = stat.rem + 1
			local p = chspec.properties or {}
			local childW = (p.Size and p.Size.w) or myW
			local childH = (p.Size and p.Size.h) or myH
			reconcileChildren(chspec, newInst, screen, childW, childH, stat)
		else
			local newInst = build(chspec, inst, myW, myH) -- genuinely new node
			stat.add = stat.add + 1
		end
	end
	-- Gone: original managed children with no matching spec this pass.
	for _, c in ipairs(existing) do
		if not matched[c] then
			if c:GetAttribute("FigmaNodeId") or hasDesignDescendant(c) or hasDeveloperDescendant(c) then
				orphan(c, screen) -- a real design node a developer might reference — keep it recoverable
			else
				c:Destroy() -- pure Framewisp decoration (old shadow / background) — safe to drop
			end
			stat.rem = stat.rem + 1
		end
	end
end

function reconcileNode(spec, inst, screen, pw, ph, stat)
	local p = spec.properties or {}
	resetRemovedProps(inst, p)
	applyProps(inst, p, pw, ph)
	rememberManagedOptionalProps(inst, p)
	-- A renamed layer keeps its id but must adopt the new name (build() sets it too);
	-- otherwise name-based lookups and name-matched shadow siblings drift.
	inst.Name = spec.name or spec.className
	-- Text changed? Drop the scaler's cached original ("FW_Text0") so the next pass
	-- re-baselines and can size the new text width-exact instead of the fallback path.
	if p.Text ~= nil then inst:SetAttribute("FW_Text0", nil) end
	refreshModifiers(inst, spec.modifiers)
	-- Clear FW-managed design attributes the new spec no longer carries, THEN set
	-- the current ones. Without the clear, REMOVING a tag in Figma (e.g. _nodim,
	-- _open, _bind) leaves the old Figma* attribute stale on Live Sync — the image
	-- keeps not-dimming / the button keeps opening, "same as before the edit".
	-- FigmaNodeId is the match anchor and is always re-set below — never drop it.
	local want = spec.attributes or {}
	for k in pairs(inst:GetAttributes()) do
		if k:sub(1, 5) == "Figma" and k ~= "FigmaNodeId" and want[k] == nil then
			inst:SetAttribute(k, nil)
		end
	end
	if spec.attributes then
		for k, v in pairs(spec.attributes) do inst:SetAttribute(k, v) end
	end
	inst:SetAttribute("FW_Owned", true)
	stat.upd = stat.upd + 1
	local myW = (p.Size and p.Size.w) or pw
	local myH = (p.Size and p.Size.h) or ph
	-- Children of a ScrollingFrame resolve Scale against the CANVAS, not the window
	-- (same rule as refFor in UI Tools) — hand them the box they will be measured in.
	if p.CanvasSize then
		myW = math.max(myW, p.CanvasSize.w or 0)
		myH = math.max(myH, p.CanvasSize.h or 0)
	end
	reconcileChildren(spec, inst, screen, myW, myH, stat)
end


function fwInkAnchor(d, k)
	if not (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) then return end
	-- Why (or why not) this label was anchored, readable in the Properties panel:
	-- one silent gate exit cost a full round of guessing which label it was.
	local function why(r) d:SetAttribute("FW_Anchor", r) end
	if d.TextScaled then return why("TextScaled — Roblox owns the fit") end
	if d:FindFirstAncestorWhichIsA("BillboardGui") then return why("billboard") end
	local emD = d:GetAttribute("FigmaFontSize")
	if type(emD) ~= "number" then return why("no FigmaFontSize") end
	local baseY = d:GetAttribute("FigmaBaseY")
	-- the MEASURED Roblox fraction beats the design font's metric
	local baseF = d:GetAttribute("TextBaseFrac") or d:GetAttribute("FigmaBaseF")
	local inkC = d:GetAttribute("FigmaInkC")
	if type(baseF) ~= "number" then return why("no baseline fraction") end
	if type(baseY) ~= "number" and type(inkC) ~= "number" then return why("no baseline from the export — re-export") end
	if d.AbsoluteSize.Y < 1 then return why("not laid out yet") end
	local ph = d.Parent and d.Parent:IsA("GuiObject") and d.Parent.AbsoluteSize.Y or 0
	if ph < 1 then return why("parent not laid out") end
	local L = d.TextSize
	local host = d:FindFirstChild("FW_Scale")
	local ch = host and host:FindFirstChild("k_text")
	if ch then L = L * ch.Value end
	-- The label's own UIScale inflates its AbsoluteSize, while FW_TextPad keeps the
	-- text in the design box: measure the line against that box, not the grown one.
	local boxH = d.AbsoluteSize.Y / ((host and host.Scale > 0) and host.Scale or 1)
	local pos = d.Position
	-- Undo whatever a previous build wrote. Older builds shifted the OFFSET, and
	-- the game's scaler moved labels again in Play — text that jumped on run and
	-- could slide into a clipping shell. The shift is proportional to the
	-- viewport (every term scales with k), so written into the SCALE it is a
	-- static fact of the design: nothing moves at run time, ever.
	local yOff = pos.Y.Offset
	local legacy = d:GetAttribute("FW_TextY0")
	if type(legacy) == "number" then
		yOff = legacy
		d:SetAttribute("FW_TextY0", nil)
	end
	local ys0 = d:GetAttribute("FW_TextYS0")
	if type(ys0) ~= "number" then
		ys0 = pos.Y.Scale
		d:SetAttribute("FW_TextYS0", ys0)
	end
	local ay = d.TextYAlignment
	local lineTop
	if ay == Enum.TextYAlignment.Center then lineTop = boxH / 2 - L / 2
	elseif ay == Enum.TextYAlignment.Top then lineTop = 0
	else lineTop = boxH - L end
	local shift
	if type(baseY) == "number" then
		shift = baseY * k - (lineTop + baseF * L) -- Roblox's baseline onto the design's
	else
		if ay ~= Enum.TextYAlignment.Center then return end
		shift = L / 2 - (baseF * L - inkC * emD * k) -- older export: centre the ink
	end
	-- a wrong answer must not throw the label: past its own height, leave it be
	if math.abs(shift) > boxH then
		return why(string.format("shift %.1f px exceeds the label — the numbers do not describe it", shift))
	end
	d.Position = UDim2.new(pos.X.Scale, pos.X.Offset, ys0 + shift / ph, yOff)
	why(string.format("ok %+.1f px (L=%.1f baseF=%.3f align=%s)", shift, L, baseF, tostring(ay)))
end

function stampDesign(screen, root, w, h) -- global, like attachScaler: the main chunk is at Luau's local-register ceiling
	for _, host in ipairs({ screen, root }) do
		if host then
			host:SetAttribute("BB_DesignH", h)
			host:SetAttribute("BB_DesignW", w)
			host:SetAttribute("BB_TextFactor", TEXT_SIZE_FACTOR)
		end
	end
end

local function reconcileScreen(screen, bp)
	local placeNote = nil
	local w, h = bp.canvas.w, bp.canvas.h
	-- One-time cleanup: an older plugin left removed elements RENDERING inside
	-- FramewispRemoved (a Folder doesn't hide GuiObjects). Sweep it hidden so a
	-- single sync clears accumulated on-screen junk without a manual delete.
	local removedFolder = screen:FindFirstChild("FramewispRemoved")
	if removedFolder then
		for _, c in ipairs(removedFolder:GetChildren()) do
			if c:IsA("GuiObject") then c.Visible = false end
		end
	end
	local rootSpec = bp.root
	local rootId = specId(rootSpec)
	-- The design root is the FW_Owned GuiObject child of the ScreenGui (service
	-- scripts are siblings; FramewispRemoved is a Folder). Prefer an id match.
	local existingRoot
	for _, c in ipairs(screen:GetChildren()) do
		if c:IsA("GuiObject") and c:GetAttribute("FW_Owned") then
			if rootId and c:GetAttribute("FigmaNodeId") == rootId then
				existingRoot = c
				break
			end
			existingRoot = existingRoot or c
		end
	end
	if not existingRoot then return nil end
	local developerAttachments = snapshotDeveloperAttachments(existingRoot)

	local stat = { upd = 0, add = 0, rem = 0 }
	-- Some visual changes legitimately change the Roblox class (for example a
	-- Frame becomes a CanvasGroup when group opacity is introduced). Child nodes
	-- already rebuild on class changes, but the root used to be updated in place,
	-- so GroupTransparency was silently ignored and could then stay stale. Build
	-- only a replacement SHELL detached first, then reconcile the existing managed
	-- children into it. This preserves developer scripts/objects at every depth.
	if existingRoot.ClassName ~= rootSpec.className then
		local shellSpec = {}
		for k, v in pairs(rootSpec) do if k ~= "children" then shellSpec[k] = v end end
		local replacement = build(shellSpec, nil, w, h)
		placeNote = placeRoot(replacement, bp) or placeNote
		adoptDeveloperChildren(existingRoot, replacement)
		for _, child in ipairs(existingRoot:GetChildren()) do
			if isManaged(child) then child.Parent = replacement end
		end
		replacement.Parent = screen
		orphan(existingRoot, screen)
		local p = rootSpec.properties or {}
		local myW = (p.Size and p.Size.w) or w
		local myH = (p.Size and p.Size.h) or h
		reconcileChildren(rootSpec, replacement, screen, myW, myH, stat)
		restoreDeveloperAttachments(replacement, developerAttachments)
		stampDesign(screen, replacement, w, h)
		attachScaler(screen)
		Selection:Set({ replacement })
		return ("Synced — root rebuilt %s → %s; %d updated, %d added, %d removed. Scripts and unmanaged children were kept; Framewisp-owned properties now match Figma."):format(
			existingRoot.ClassName, replacement.ClassName, stat.upd, stat.add, stat.rem
		)
	end

	-- Refresh the root's own visuals + modifiers, then RE-PLACE it from the new design
	-- (placeRoot recomputes position/size/aspect from the new canvas & placement — so a
	-- resized or moved design doesn't drift). applyProps sets geometry first; placeRoot
	-- overrides it with the correct on-screen placement.
	local p = rootSpec.properties or {}
	resetRemovedProps(existingRoot, p)
	applyProps(existingRoot, p, w, h)
	rememberManagedOptionalProps(existingRoot, p)
	existingRoot.Name = rootSpec.name or existingRoot.Name
	refreshRootModifiers(existingRoot, rootSpec.modifiers)
	local want = rootSpec.attributes or {}
	for k in pairs(existingRoot:GetAttributes()) do
		-- The top-level blueprint can legitimately change from the source node to
		-- an id-less Holder (for example when a root PNG shadow is introduced).
		-- Keeping the old FigmaNodeId on that wrapper creates duplicate identities
		-- and restores developer attachments onto the wrong instance.
		if k:sub(1, 5) == "Figma" and want[k] == nil then existingRoot:SetAttribute(k, nil) end
	end
	for k, v in pairs(want) do existingRoot:SetAttribute(k, v) end
	placeNote = placeRoot(existingRoot, bp) or placeNote
	stampDesign(screen, existingRoot, w, h)
	local myW = (p.Size and p.Size.w) or w
	local myH = (p.Size and p.Size.h) or h
	reconcileChildren(rootSpec, existingRoot, screen, myW, myH, stat)
	restoreDeveloperAttachments(existingRoot, developerAttachments)

	-- Re-run editor-side scaling so any changed/added text sizes correctly, and
	-- keep the design selected for the user.
	attachScaler(screen)
	Selection:Set({ existingRoot })
	return ("Synced — %d updated, %d added, %d removed. Scripts and unmanaged children were kept; Framewisp-owned properties now match Figma."):format(stat.upd, stat.add, stat.rem)
		.. (placeNote and (" " .. placeNote) or "")
end

-- ===================================================================== scaler

-- TextSize / stroke thickness are ABSOLUTE px and don't follow the fromScale
-- frame, so they're recomputed as design px x (rendered height / design height).
-- This hooks that (re)scaler to an imported ScreenGui: applied now and on every
-- viewport resize. Called for fresh imports AND re-attached to previously
-- imported GUIs on every Studio session start — otherwise a place reopened (or
-- opened on another machine with a different viewport) keeps the OLD machine's
-- pixel values: layout adapts but text stays small/large and drifts off its spot.
local TextService = game:GetService("TextService")

-- One resize connection per screen. attachScaler is re-run after every Live Sync,
-- so without this each sync would stack another AbsoluteSize handler (a leak that
-- makes the scaler fire N times per resize). Weak keys let collected GUIs drop out.
local scalerConns = setmetatable({}, { __mode = "k" })

local function findManagedRoot(screen)
	local fallback = nil
	for _, child in ipairs(screen:GetChildren()) do
		if child:IsA("BillboardGui") then
			local inner = child:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("ObjectValue") and child.Name == "FW_ExtraRoot" and child.Value then
			-- _billboard: the collector sits on its anchor Part, so the pointer is
			-- the way home. Miss it and the scaler never attaches — TextSize stays
			-- in fixed px while the billboard shrinks and the text swells.
			local inner = child.Value:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("GuiObject") then
			fallback = fallback or child
			if child:GetAttribute("FW_Owned") == true then return child end
		end
	end
	return fallback -- legacy imports created before FW_Owned
end

function attachScaler(screen)
	local root = findManagedRoot(screen)
	local designH = screen:GetAttribute("BB_DesignH") or (root and root:GetAttribute("BB_DesignH"))
	if not root or type(designH) ~= "number" or designH <= 0 then return end
	-- A world-space design has no viewport to fit: the BillboardGui scales itself
	-- with camera distance, so its AbsoluteSize changes on every camera move and
	-- this pass would re-solve the whole tree each frame (Output spam, wasted work)
	-- only to fight the TextScaled the labels need. Leave billboards alone.
	if root:FindFirstAncestorWhichIsA("BillboardGui") then return end
	-- Drop any previous scaler hooked to this screen (a prior import/sync pass).
	local prev = scalerConns[screen]
	if prev then prev:Disconnect() end
	local designW = screen:GetAttribute("BB_DesignW") or root:GetAttribute("BB_DesignW")
	local factor = screen:GetAttribute("BB_TextFactor") or root:GetAttribute("BB_TextFactor") or TEXT_SIZE_FACTOR
	-- WIDTH-EXACT text sizing. The design carries each label's tight glyph width
	-- (FigmaTextW). We measure the SUBSTITUTE font's advance width at TextSize 100
	-- (GetTextBoundsAsync) and solve linearly for the TextSize that spans exactly
	-- the design footprint — metric-exact for any font, no 1.16-style guessing.
	-- Cached per FONT FACE + TEXT, never per label: two labels that read the same
	-- string in the same face must get the same number. Cached per label, the one
	-- measured while the font was still downloading kept the FALLBACK face's advance
	-- and rendered at another size than its twins (three identical "ON" buttons,
	-- the first one big — only on machines that had not downloaded the font yet).
	-- false = definitively unmeasurable (empty text).
	local byKey = {}
	local facesReady = {}
	local ContentProvider = game:GetService("ContentProvider")
	local function faceOf(d)
		local f = d.FontFace
		if not f then return "?" end
		return tostring(f.Family) .. "|" .. tostring(f.Weight) .. "|" .. tostring(f.Style)
	end
	local function textKey(d)
		return faceOf(d) .. "|" .. (d.ContentText:gsub("^%s+", ""):gsub("%s+$", ""))
	end
	local reverified = false
	-- _grid canvas rewiring: one AbsoluteContentSize connection per grid; the
	-- closure is refreshed each pass so it always uses the current k.
	local gridInfo = setmetatable({}, { __mode = "k" })
	-- A datamodel that is not being rendered reports a 1x1 viewport while its GUIs
	-- keep a stale, collapsed AbsoluteSize. Every path that writes geometry checks
	-- this: press Play and the EDITOR datamodel goes exactly like that, and writing
	-- from it is how a play session ended up with cards a third of their size.
	local function fwRenders()
		local cam = workspace.CurrentCamera
		return cam ~= nil and cam.ViewportSize.X >= 2 and cam.ViewportSize.Y >= 2
	end

	-- How far a hovered card reaches past its cell, in DESIGN px. Only used to keep
	-- a hand-typed SmoothHover from being clipped; the converter already reserved
	-- the room it knew about, so this never moves a design that was imported whole.
	local function fwHoverRoom(cells, cellW, cellH)
		local hs = 1
		if cells then
			for _, c in ipairs(cells:GetChildren()) do
				if c:IsA("GuiObject") and c:GetAttribute("FigmaSmooth") then
					local v = c:GetAttribute("SmoothHover") or c:GetAttribute("FigmaSmoothHover") or 1.08
					if type(v) == "number" and v > hs then hs = v end
				end
			end
		end
		if hs <= 1 then return 0, 0 end
		return cellW * (hs - 1) / 2, cellH * (hs - 1) / 2
	end

	local gridGeometry, gridScroll -- mutually recursive: a re-fit updates the canvas

	-- The one ratio the whole grid rides: the frame's real width over its design
	-- width. Measured on the FRAME, never on the canvas — a canvas already has the
	-- scrollbar taken out of it while the design width counts that bar in.
	local function gridRatio(cells, fallback, smScale)
		local grid = cells and cells:FindFirstChildWhichIsA("UIGridLayout")
		if not grid then return fallback end
		-- An import older than this attribute cannot tell us its window width, and
		-- guessing it from the row assumes a pixel-tight design, which oversizes every
		-- cell whenever the design has slack. The interface ratio at least stays
		-- consistent with the rest of the UI.
		local winW = grid:GetAttribute("FigmaWinW") or 0
		if winW <= 0 then return fallback end
		local host = cells.Parent
		local live = ((host and host:IsA("ScrollingFrame")) and host.AbsoluteSize.X or cells.AbsoluteSize.X) / smScale
		if live <= 1 then return fallback end
		return live / winW
	end

	-- Design px -> screen px for everything the grid owns. Fractions are kept: the
	-- layout accumulates its own steps, and rounding each gap down walked the last
	-- column off the design by a pixel per column.
	function gridGeometry(d, k, kx, smScale)
		if d:IsA("UIPadding") and d:GetAttribute("FigmaPadL") ~= nil then
			local gs = gridRatio(d.Parent, kx, smScale)
			d.PaddingLeft = UDim.new(0, (d:GetAttribute("FigmaPadL") or 0) * gs)
			d.PaddingTop = UDim.new(0, (d:GetAttribute("FigmaPadT") or 0) * gs)
			d.PaddingBottom = UDim.new(0, (d:GetAttribute("FigmaPadB") or 0) * gs)
			return
		end
		if not (d:IsA("UIGridLayout") and d:GetAttribute("FigmaCellW") ~= nil) then return end
		local cells = d.Parent
		local cols = math.max(1, d.FillDirectionMaxCells)
		local gs = gridRatio(cells, kx, smScale)
		local cellWD = d:GetAttribute("FigmaCellW") or 0
		local cellHD = d:GetAttribute("FigmaCellH") or 0
		local gapXD = d:GetAttribute("FigmaGapX") or 0
		local gapYD = d:GetAttribute("FigmaGapY") or 0
		local pad = cells and cells:FindFirstChildWhichIsA("UIPadding")
		local padLD = (pad and pad:GetAttribute("FigmaPadL")) or 0

		-- The scrollbar is the only part of this measured in screen px: rescale it
		-- with the design, or it eats a growing share of the row as the screen shrinks.
		local sf = cells and cells.Parent
		local barD = 0
		if sf and sf:IsA("ScrollingFrame") then
			barD = sf:GetAttribute("FigmaBar") or sf.ScrollBarThickness
			-- The bar is re-derived from the design on every layout pass, which quietly
			-- undid anyone who set the thickness by hand in Studio. Remember what WE wrote:
			-- if the live value is not it, a developer changed it — adopt their number as
			-- the new design value instead of overwriting it on the next pass.
			local mineBar = sf:GetAttribute("FW_BarPx")
			if type(mineBar) == "number" and math.abs(sf.ScrollBarThickness - mineBar) > 0.5 then
				barD = sf.ScrollBarThickness / (gs > 0.001 and gs or 1)
				sf:SetAttribute("FigmaBar", barD)
			end
			local wantBar = math.max(2, barD * gs)
			sf.ScrollBarThickness = wantBar
			sf:SetAttribute("FW_BarPx", wantBar)
		end

		-- SAFETY NET ONLY. The converter sized the window to hold this row, so the
		-- design fits by construction; this bites only when someone has since made
		-- the frame narrower in Studio.
		-- What the converter actually RESERVED — it widened the window by exactly this,
		-- and only for a scroll window that is not the export root. Reading the hover off
		-- the cards instead would charge the row for room nobody took, and the cap below
		-- would shave every cell to pay for it. Only a legacy import, from before the
		-- attribute existed, still has to be measured that way.
		local roomD = d:GetAttribute("FigmaHoverRoom")
		if roomD == nil then roomD = select(1, fwHoverRoom(cells, cellWD, cellHD)) end
		-- Measured on the FRAME: the canvas has the bar taken out of it already, and
	-- the budget below subtracts that bar once by design.
	local hostW = ((sf and sf:IsA("ScrollingFrame")) and sf.AbsoluteSize.X) or (cells and cells.AbsoluteSize.X) or 0
	local availD = (hostW / smScale) / math.max(gs, 1e-6)
		local cellW = cellWD
		if availD > 1 then
			local maxD = (availD - padLD - (cols - 1) * gapXD - barD - roomD) / cols
			if maxD > 0 and maxD < cellW then cellW = maxD end
		end
		local cellH = cellHD * (cellW / math.max(cellWD, 1e-6)) -- keep the card's shape

		d.CellSize = UDim2.fromOffset(math.max(1, cellW * gs), math.max(1, cellH * gs))
		d.CellPadding = UDim2.fromOffset(gapXD * gs, gapYD * gs)

		-- Re-fit when the WINDOW changes size, not just when the whole GUI does:
		-- dragging the ScrollingFrame's own handles left the cells at their old width.
		local info = gridInfo[d]
		if not info then
			info = {}
			gridInfo[d] = info
		end
		if cells and not info.sizeWired then
			info.sizeWired = true
			cells:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				if info.refit and not info.busy and fwRenders() then
					info.busy = true
					info.refit()
					info.busy = false
				end
			end)
		end
		info.refit = function()
			gridGeometry(d, k, kx, smScale)
			if pad then gridGeometry(pad, k, kx, smScale) end -- the origin rides along
			if sf then gridScroll(sf) end
		end
	end

	-- _grid + _scroll: we own CanvasSize (AutomaticCanvasSize cannot work here — our
	-- only content child is Scale-sized, its long-standing broken case). The row
	-- count comes from what the layout ACTUALLY produced, so an early wrap can never
	-- leave the canvas short.
	function gridScroll(sf)
		if not (sf:IsA("ScrollingFrame") and sf:GetAttribute("FWGridScroll")) then return end
		local cells, grid
		for _, c in ipairs(sf:GetChildren()) do
			if c.Name == "Cells" and c:GetAttribute("FW_Owned") then
				local g = c:FindFirstChildWhichIsA("UIGridLayout")
				if g then cells, grid = c, g break end
			end
		end
		if not grid then return end
		local pad = cells:FindFirstChildWhichIsA("UIPadding")
		local info = gridInfo[grid]
		if not info then
			info = {}
			gridInfo[grid] = info
		end
		if not info.canvasWired then
			info.canvasWired = true
			grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				if info.set and fwRenders() then info.set() end
			end)
			-- Slots added or removed by a game script at runtime: the layout may not
			-- have flushed yet, so watch the children themselves as well.
			cells.ChildAdded:Connect(function() if info.set and fwRenders() then info.set() end end)
			cells.ChildRemoved:Connect(function() if info.set and fwRenders() then info.set() end end)
		end
		info.set = function()
			local cellH = grid.CellSize.Y.Offset
			local gapY = grid.CellPadding.Y.Offset
			local pt = pad and pad.PaddingTop.Offset or 0
			local pb = pad and pad.PaddingBottom.Offset or 0
			-- Rows as the ENGINE laid them out, not as the column count predicts: it
			-- wraps early whenever a row is a hair too wide, and a predicted row count
			-- would then leave the last rows outside the canvas.
			local step = cellH + gapY
			local rows = 0
			if step > 0 then
				rows = math.max(0, math.floor((grid.AbsoluteContentSize.Y + gapY) / step + 0.5))
			end
			if rows == 0 then
				local n = 0
				for _, c in ipairs(cells:GetChildren()) do
					if c:IsA("GuiObject") and c.Visible then n = n + 1 end
				end
				rows = math.ceil(n / math.max(1, grid.FillDirectionMaxCells))
			end
			local h = rows > 0 and (pt + rows * cellH + (rows - 1) * gapY + pb) or 0
			-- A canvas a fraction taller than its window still counts as scrollable:
			-- the list drifts a pixel or two and clips the first row.
			if h <= sf.AbsoluteWindowSize.Y + 1 then h = 0 end
			sf.CanvasSize = UDim2.fromOffset(0, h)
		end
		info.set()
	end

	-- The compositor, INSIDE the scaler: this runs in the plugin chunk, which cannot
	-- see the copies injected into the runtime strings, and the main chunk has no
	-- register room left for another top-level local.
	local function fwChannel(el, key)
	local host = el:FindFirstChild("FW_Scale")
	if not host then
		host = el:FindFirstChildWhichIsA("UIScale")
		if host then
			host.Name = "FW_Scale"
		else
			host = Instance.new("UIScale")
			host.Name = "FW_Scale"
			host:SetAttribute("FW_Owned", true)
			host.Parent = el
		end
	end
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function()
			local total = 1
			for _, c in ipairs(host:GetChildren()) do
				if c:IsA("NumberValue") then total = total * c.Value end
			end
			host.Scale = total
		end)
	end
	return ch
	end
	local lastMeasureErr = nil
	local function measure(d)
		local key = textKey(d)
		local cached = byKey[key]
		if cached ~= nil then return cached or nil end
		-- The face is DOWNLOADED first: a probe that lands mid-download measures the
		-- fallback face. PreloadAsync on the label yields until its font is in.
		local face = faceOf(d)
		if not facesReady[face] then
			facesReady[face] = true
			pcall(function() ContentProvider:PreloadAsync({ d }) end)
		end
		local ok, b = pcall(function()
			local prm = Instance.new("GetTextBoundsParams")
			-- trim: Figma's tight bounds exclude edge spaces, advance width doesn't
			prm.Text = (d.ContentText:gsub("^%s+", ""):gsub("%s+$", ""))
			prm.Font = d.FontFace
			prm.Size = 100
			prm.Width = 1e6 -- finite (defensive: some builds may reject inf)
			return TextService:GetTextBoundsAsync(prm)
		end)
		if ok and b and b.X > 0 then
			byKey[key] = b.X
			return b.X
		end
		if ok then
			byKey[key] = false -- empty text: definitively unmeasurable
		else
			lastMeasureErr = tostring(b) -- surfaced in the Output diagnostic line
		end
		return nil -- transient failure (font still loading): retry next apply
	end
	-- Roblox hard-caps TextSize at 100. Big display text (a 96px font near 1:1
	-- scale needs ~113+) silently rendered too small — the exact "text is smaller
	-- on the PC" bug. Spill the remainder into a UIScale child: rendered size =
	-- TextSize x Scale, unlimited. Scale 1 when not needed.
	-- NOT TextScaled + a Min == Max UITextSizeConstraint: that was tried for crisper
	-- glyphs and it stops at 100 as well. In the live Studio reports of 26.09.2026
	-- all 33 labels on that path had TextBounds.Y exactly 100, boxes tall enough
	-- for 190 included, and a shop's S-H-O-P (Press Start 2P, 154 solved) drew at
	-- 100: a third smaller than Figma. Such constraints are removed on sight.
	-- The UIScale grows the label's box about its AnchorPoint; textPad insets the
	-- text area back to exactly the design box, so the words stay where Figma put
	-- them whatever the anchor and the alignment (children follow the same area).
	local padWired = setmetatable({}, { __mode = "k" })
	local function textPad(d, s)
		local pad = d:FindFirstChild("FW_TextPad")
		if s <= 1.0001 then
			if pad then pad:Destroy() end
			return
		end
		if not pad then
			if d:FindFirstChildWhichIsA("UIPadding") then return end -- the developer's padding owns the text area
			pad = Instance.new("UIPadding")
			pad.Name = "FW_TextPad"
			pad:SetAttribute("FW_Owned", true)
			pad.Parent = d
		end
		local a, g = d.AnchorPoint, 1 - 1 / s
		pad.PaddingLeft = UDim.new(a.X * g, 0)
		pad.PaddingRight = UDim.new((1 - a.X) * g, 0)
		pad.PaddingTop = UDim.new(a.Y * g, 0)
		pad.PaddingBottom = UDim.new((1 - a.Y) * g, 0)
		if not padWired[d] then
			padWired[d] = true
			-- a layout slot re-anchors a label after the fact: the inset follows
			d:GetPropertyChangedSignal("AnchorPoint"):Connect(function()
				local h = d:FindFirstChild("FW_Scale")
				local c = h and h:FindFirstChild("k_text")
				textPad(d, c and c.Value or 1)
			end)
		end
	end
	-- A text stroke is drawn inside its label's spill: divide it back out so the
	-- outline stays the design's width at any text size.
	local function spillOver(x)
		local sp, n = 1, x.Parent
		while n and n ~= root do
			local h = n:FindFirstChild("FW_Scale")
			local c = h and h:FindFirstChild("k_text")
			if c and c.Value > 0 then sp = sp * c.Value end
			n = n.Parent
		end
		return sp
	end
	local function setTextPx(d, t, exact)
		-- Inside a BillboardGui the label sizes ITSELF (TextScaled): a px value
		-- computed here is huge at spawn and wrong at every distance, and chasing
		-- it from a script always lags a frame behind the camera.
		if d:FindFirstAncestorWhichIsA("BillboardGui") then return end
		local mine = d:GetAttribute("FW_TextMine")
		if type(mine) == "number" and (math.abs(d.TextSize - mine) > 0.5
			or d.TextScaled ~= (d:GetAttribute("FW_TextScaledMine") == true)) then
			d:SetAttribute("FW_TextOwn", true)
		end
		if d:GetAttribute("FW_TextOwn") then return end
		local sc = fwChannel(d, "k_text")
		local con = d:FindFirstChild("FWTextBig")
		if con then con:Destroy() end
		d.TextScaled = false
		if t > 100 then
			sc.Value = t / 100
			d.TextSize = 100
		else
			sc.Value = 1
			-- Width-exact labels round DOWN: TextSize is an integer, and rounding
			-- a fractional solve UP rendered the string a few % wider than the
			-- design — a clipping frame then ate edge letters Figma keeps ("P").
			local px = exact and math.floor(t) or math.floor(t + 0.5)
			d.TextSize = math.max(1, px)
		end
		textPad(d, sc.Value)
		d:SetAttribute("FW_TextMine", d.TextSize)
		d:SetAttribute("FW_TextScaledMine", d.TextScaled)
	end
	-- Generation counter: apply() yields inside measure(), so a resize during a
	-- cold-cache pass starts a NEWER run — the stale one must stop writing.
	local gen = 0
	local coldTries = 0
	-- Every import builds a NEW ScreenGui, so earlier ones stay in StarterGui and
	-- keep running their OWN runtimes on their OWN copy of the design. Two screens
	-- stacked look like one, and the older script's effects land on top of the new
	-- one's — which reads as "the fix did nothing" and cost several rounds of it.
	local function warnStaleScreens(fresh)
		local host = fresh.Parent
		if not host then return end
		local others = {}
		for _, sg in ipairs(host:GetChildren()) do
			if sg ~= fresh and (sg:IsA("ScreenGui") or sg:IsA("SurfaceGui")) and sg.Name:sub(1, 10) == "Framewisp_" then
				others[#others + 1] = sg.Name
			end
		end
		if #others == 0 then return end
		warn(("[Framewisp] %d earlier import%s still in %s: %s. They run their own copy of the "
			.. "design and their own effect scripts, on top of this one — delete the ones you no "
			.. "longer need, or what you see is the older import."):format(
			#others, #others == 1 and "" or "s", host.Name, table.concat(others, ", ")))
	end

	local function apply()
		-- Press Play and the edit datamodel stops rendering: viewport goes to
		-- 1x1 and every AbsoluteSize collapses. Reacting to that collapse
		-- rewrote the grid with junk sizes, which the play session then showed.
		-- The GUI in play has its own runtime scaler; this pass is the editor's.
		if game:GetService("RunService"):IsRunning() then return end
		gen = gen + 1
		local myGen = gen
		-- A root-level _smooth button tweens a UIScale on the root itself; that
		-- inflates AbsoluteSize and re-ran this solver mid-hover, double-scaling
		-- text (render transform x TextSize). Solve against the UNSCALED size.
		local sm = root:FindFirstChild("FW_Scale") or root:FindFirstChild("FramewispSmooth") or root:FindFirstChild("FWActScale")
		local smScale = (sm and sm:IsA("UIScale") and sm.Scale > 0) and sm.Scale or 1
		local k = root.AbsoluteSize.Y / designH / smScale
		if k <= 0 then return end
		-- A datamodel that is not being rendered reports a 1x1 viewport while its
		-- GUIs keep a stale, collapsed AbsoluteSize. Writing geometry from that
		-- is how a Play session ended up with cards a third of their size.
		if not fwRenders() then return end
		if root.AbsoluteSize.X < 2 or root.AbsoluteSize.Y < 2 then return end
		local kx = (type(designW) == "number" and designW > 0) and root.AbsoluteSize.X / designW / smScale or k
		local exact, fallback = 0, 0
		local transient = false
		for _, d in ipairs(root:GetDescendants()) do
			if myGen ~= gen then return end -- superseded by a newer run
			local fs = d:GetAttribute("FigmaFontSize")
			if fs then
				local m = nil
				local tw = d:GetAttribute("FigmaTextW")
				if type(tw) == "number" and tw > 0 then
					-- If a game script rewrote the text, the design width no longer
					-- applies — that label drops to the factor path.
					local t0 = d:GetAttribute("FW_Text0")
					if t0 == nil then
						t0 = d.ContentText
						d:SetAttribute("FW_Text0", t0)
					end
					if d.ContentText == t0 then
						m = measure(d)
						-- nil with no cache entry = font still loading; the label
						-- falls to the factor path (often wider than the design) and
						-- nothing re-runs until a resize — schedule our own retry.
						if m == nil and byKey[textKey(d)] == nil then transient = true end
						-- The advance at size 100 is a FONT constant. Stamp it, and
						-- the game never measures: on the client the first probe can
						-- land while the font is still downloading, get the fallback
						-- face's numbers, and CACHE them — every label then renders
						-- ~16% oversized for the whole session, ink climbing out the
						-- top of its plate ("весь текст наверх при Play").
						if m then d:SetAttribute("FW_M100", m) end
					end
					if myGen ~= gen then return end -- measure() may have yielded
				end
				if m then
					setTextPx(d, 100 * (tw * kx) / m, true)
					exact = exact + 1
				else
					-- multi-line / rich / rewritten / measure failure: the em path — the face's
					-- own TextSize per em; the flat factor only for a font not in the table
					local f = d.FontFace
					setTextPx(d, fs * k * ((f and FW_EM_RATIO[tostring(f.Family)]) or factor))
					fallback = fallback + 1
				end
				fwInkAnchor(d, k)
				-- The editor's verdict, in root fractions, stamped on the label. The
				-- game compares its own outcome against this and PRINTS what moved —
				-- size, position, or nothing — because five rounds of "в Play выше"
				-- could not name which property actually changed.
				local rootH = root.AbsoluteSize.Y
				if rootH > 1 and d.AbsoluteSize.Y > 0 then
					d:SetAttribute("FW_EDbg", string.format("%.4f|%.4f",
						d.TextSize / rootH,
						(d.AbsolutePosition.Y - root.AbsolutePosition.Y + d.AbsoluteSize.Y / 2) / rootH))
				end
			end
			local swMine = d:GetAttribute("FW_StrokeMine")
			if type(swMine) == "number" and math.abs(d.Thickness - swMine) > 0.01 then
				d:SetAttribute("FW_StrokeOwn", true)
			end
			-- A ScaledSize stroke is a FRACTION of its parent: writing pixels into it
			-- would blow the outline up by two orders of magnitude. The engine owns it —
			-- by its real mode, not only by the import's mark: UI Tools' Scale on a design
			-- it could not measure (nested in the developer's frame, the 2nd design of a
			-- screen) switched the mode without the mark, and the next pass drew 480 px
			-- outlines (report 30.09). Pixels already written that way are turned back
			-- into the fraction they meant.
			local okMode, isFrac = pcall(function() return d.StrokeSizingMode == Enum.StrokeSizingMode.ScaledSize end)
			if d:GetAttribute("FW_StrokeScaled") or (okMode and isFrac) then
				d:SetAttribute("FW_StrokeScaled", true)
				local host = d.Parent
				if d.Thickness > 0.5 and (d:GetAttribute("FigmaStrokeW") or d:GetAttribute("FigmaTextStrokeW"))
					and host and host:IsA("GuiObject") and math.min(host.AbsoluteSize.X, host.AbsoluteSize.Y) > 1 then
					d.Thickness = d.Thickness / math.min(host.AbsoluteSize.X, host.AbsoluteSize.Y)
				end
			elseif not d:GetAttribute("FW_StrokeOwn") then
				local sw = d:GetAttribute("FigmaStrokeW")
				-- Floor at 0.35 (not 1): UIStroke renders sub-pixel thickness with AA, and
				-- flooring a downscaled hairline to a full 1px made thin outlines visibly
				-- fatter than the design at small viewports.
				if sw then d.Thickness = math.max(0.35, sw * k) end
				local tsw = d:GetAttribute("FigmaTextStrokeW")
				if tsw then
					-- Stroke width is authored geometry. The font fallback multiplier
					-- compensates glyph metrics, not the outline (it made ACCEPT 16% bolder).
					-- FW_StrokeExtra: a gleam halo's extra width, screen px like the outline itself
					d.Thickness = math.max(0.35, (tsw * k + (d:GetAttribute("FW_StrokeExtra") or 0)) / spillOver(d))
				end
				if sw or tsw then d:SetAttribute("FW_StrokeMine", d.Thickness) end
			end
			gridGeometry(d, k, kx, smScale)
		gridScroll(d)
		end
		-- One diagnostic line per pass (View > Output): proves WHICH plugin ran
		-- and whether width-exact sizing engaged — or why it didn't.
		gridScroll(root) -- the root can BE the scrolling grid
		print(("[Framewisp] %s: text %d width-exact, %d fallback%s"):format(
			screen.Name, exact, fallback,
			lastMeasureErr and (" | measure error: " .. lastMeasureErr) or ""))
		warnStaleScreens(screen)
		if transient and coldTries < 6 then
			coldTries = coldTries + 1
			task.delay(0.5, function()
				if myGen == gen then apply() end
			end)
		elseif not reverified and exact > 0 then
			-- Once more, two seconds on, with every face surely in: measured afresh,
			-- a number taken during a download is replaced before it is stamped for good.
			reverified = true
			task.delay(2, function()
				table.clear(byKey)
				apply()
			end)
		end
	end
	-- GetTextBoundsAsync yields, so apply() must never run directly inside the
	-- AbsoluteSize signal; defer + coalesce resize bursts into one trailing run.
	local pending = false
	local function schedule()
		if pending then return end
		pending = true
		task.spawn(function()
			task.wait()
			pending = false
			apply()
		end)
	end
	scalerConns[screen] = root:GetPropertyChangedSignal("AbsoluteSize"):Connect(schedule)
	-- A billboard resizes with camera distance; its inner root follows, but the
	-- collector itself is the signal that fires first — listen to both so text
	-- tracks the walk-away instead of lagging a frame behind it.
	local bbHost = root.Parent
	if bbHost and bbHost:IsA("BillboardGui") then
		bbHost:GetPropertyChangedSignal("AbsoluteSize"):Connect(schedule)
	end
	task.spawn(function()
		-- AbsoluteSize can be 0 right after parenting; wait briefly, then apply.
		local deadline = os.clock() + 3
		while root.Parent and root.AbsoluteSize.Y <= 0 and os.clock() < deadline do
			task.wait(0.05)
		end
		apply()
	end)
end

-- Self-heal GUIs imported in earlier sessions (possibly on another machine).
-- Descendants, not children: a design filed away in a Folder — or moved into the
-- developer's own ScreenGui, which is where most of them end up — is still a
-- design, and it used to get no editor preview at all, so its text sat at raw
-- Figma px in the viewport while the running game drew it correctly.
for _, sg in ipairs(StarterGui:GetDescendants()) do
	if sg:IsA("LayerCollector") then
		local mine = findManagedRoot(sg)
		if sg:GetAttribute("BB_DesignH") or (mine and mine:GetAttribute("BB_DesignH")) then
			attachScaler(sg)
		end
	end
end

-- ================================================================ runtime scripts
-- Service scripts are injected ONLY when the tree needs them: an idle service in
-- someone's GUI is clutter. Scaler — when there are texts/strokes, button FX —
-- when there are buttons, Actions — for action tags, Data — for {bindings}.
-- Runs on fresh builds AND after Live Sync: a new push may introduce the first
-- button/binding, so the missing script gets added (existing ones stay untouched).
-- Returns a short note naming the behaviours that were wired, or "" when the tree
-- has none. Every one of them is a LocalScript, and Roblox does not run LocalScripts
-- in edit mode — without being told, a designer sees a static picture and concludes
-- the tag is broken. It is the single most common "it does not work" report.
-- The page a _tab:Name button shows, chosen at BUILD time exactly as the game's
-- findPanel chooses it: a _panel of that name wins; otherwise the first element of
-- that name that is neither the tab button itself nor a frame holding it. The
-- natural naming "Enemies_tab:Enemies" gives the BUTTON the name Enemies too, and
-- without the exclusion the import hid the tab button instead of its page — the
-- game then showed the page while Studio showed a missing button.
local function tabTarget(root, btn, nm)
	if not nm then return nil end
	local want = nm:lower()
	local fb = nil
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiObject") and d.Name:lower() == want then
			if d:GetAttribute("FigmaAction") == "panel" then return d end
			if not fb and d ~= btn and not btn:IsDescendantOf(d) then fb = d end
		end
	end
	return fb
end

local function ensureRuntime(screen, root, initializeTabs, freeImport, bbEmbed)
	screen:SetAttribute("FW_Importing", true) -- the guard must not eat scripts mid-injection
	-- These live INSIDE the function on purpose. Studio compiles plugins with full
	-- debug info, and then every top-level local of the main chunk holds a register
	-- at once — the chunk was already at Luau's 200 ceiling, so six more up there
	-- refused to load the whole plugin. Nothing outside this function needs them.
	-- Fingerprint of exactly what we shipped. Every runtime openly invites tuning
	-- ("========== tune the feel here =========="), and until now an update silently
	-- destroyed that work: the version gate only asked "is this old?", never "is this
	-- still ours?". An untouched script is ours to replace; an edited one is the
	-- developer's, and it stays — we say so instead of deleting it.
	local function srcHash(src)
		local h = 5381
		for i = 1, #src do
			h = (h * 33 + string.byte(src, i)) % 4294967291
		end
		return h
	end

	-- Names of runtimes we declined to replace because the developer edited them.
	local runtimeKept = {}
	-- Drops an outdated runtime — unless the developer has edited it, in which case
	-- their copy wins and the caller finds it still there (so nothing is re-created).
	-- EVERY copy, not the first one FindFirstChild happens to return. Two Framewisp
	-- plugins installed side by side (a published build and a local one) each inject
	-- their own runtime under the same name, and the older of the two goes on running
	-- its own effects next to the new one. From the outside that is indistinguishable
	-- from "the fix did nothing", and it cost several rounds of exactly that.
	local function dropIfOurs(screen, name, version)
		local dupes = 0
		for _, old in ipairs(screen:GetChildren()) do
			if old.Name == name and old:IsA("LocalScript") then
				dupes = dupes + 1
				if old:GetAttribute("FWv") ~= version then
					local stamp = old:GetAttribute("FW_Src")
					local edited = false
					if type(stamp) == "number" then
						local ok, live = pcall(function() return srcHash(old.Source) end)
						edited = ok and live ~= stamp
					end
					if edited then
						runtimeKept[#runtimeKept + 1] = name
					else
						old:Destroy()
						dupes = dupes - 1
					end
				end
			end
		end
		if dupes > 1 then
			warn(("[Framewisp] %d copies of %s are in %s. Another Framewisp plugin is installed and "
				.. "injecting its own — they both run, and the older one's effects land on top. "
				.. "Keep one plugin, or delete the extra script."):format(dupes, name, screen.Name))
		end
	end

	-- Stamps a freshly created runtime so a later update can tell ours from edited.
	local function stampRuntime(inst)
		inst:SetAttribute("FW_Owned", true)
		local ok, h = pcall(function() return srcHash(inst.Source) end)
		if ok then inst:SetAttribute("FW_Src", h) end
	end


	-- ONE-SCRIPT MODE (optional, off by default). Same blocks, same conditions — only
	-- what the design actually needs is included — merged into a single LocalScript
	-- after they are built. Two rules make the merge behave exactly like the separate
	-- scripts it replaces:
	--   * each block runs in its OWN thread (task.spawn), because several of them
	--     wait — _3D deliberately sleeps 0.1s before moving cards — and in one thread
	--     that wait would hold up everything after it;
	--   * each block is a function, because blocks use a bare `return` to bail out
	--     ("no movers, nothing to do") and at file level that would kill the rest.
	-- A block that errors now warns and leaves the others running, which separate
	-- scripts already gave us for free.
	local BUNDLE_NAME = "Framewisp"
	local function bundleRuntimes(screen)
		local parts = {}
		for _, d in ipairs(screen:GetChildren()) do
			if d:IsA("LocalScript") and d:GetAttribute("FW_Owned") and d.Name ~= BUNDLE_NAME
				and string.sub(d.Name, 1, 9) == "Framewisp" then
				parts[#parts + 1] = d
			end
		end
		if #parts == 0 then return end
		table.sort(parts, function(a, b) return a.Name < b.Name end)
		local out = {
			"-- Framewisp runtime. Every behaviour your design asked for, in one script.",
			"-- Each section below is independent: delete one, the rest keep working.",
			"-- Sections in this build: see the FW_Parts attribute on this script.",
			"",
		}
		local stamp = {}
		for _, part in ipairs(parts) do
			stamp[#stamp + 1] = string.sub(part.Name, 10) .. ":" .. tostring(part:GetAttribute("FWv"))
			out[#out + 1] = "-- ======================================== " .. part.Name
			out[#out + 1] = "task.spawn(function()"
			out[#out + 1] = "local ok, err = pcall(function()"
			out[#out + 1] = part.Source
			out[#out + 1] = "end)"
			out[#out + 1] = "if not ok then warn(\"[Framewisp] " .. part.Name .. ": \" .. tostring(err)) end"
			out[#out + 1] = "end)"
			out[#out + 1] = ""
		end
		local one = Instance.new("LocalScript")
		one.Name = BUNDLE_NAME
		one.Source = table.concat(out, "\n")
		one:SetAttribute("FW_Parts", table.concat(stamp, "|"))
		stampRuntime(one)
		one.Parent = screen
		for _, part in ipairs(parts) do part:Destroy() end
	end

	-- SELF-CONTAINED BILLBOARD (plain, non-clickable _billboard). The same blocks,
	-- merged the same way as the bundle — but into a Script with RunContext=Client
	-- parented INSIDE the BillboardGui on its anchor Part. Unlike a LocalScript,
	-- such a Script runs on every player's client even from Workspace, so the
	-- billboard needs no StarterGui host at all: duplicate or move the anchor Part,
	-- copy it to another place — every copy keeps its effects.
	local function embedRuntimes(bbTarget)
		local parts = {}
		for _, d in ipairs(screen:GetChildren()) do
			if d:IsA("LocalScript") and d:GetAttribute("FW_Owned")
				and string.sub(d.Name, 1, 9) == "Framewisp" then
				parts[#parts + 1] = d
			end
		end
		if #parts == 0 then return end
		local one = Instance.new("Script")
		-- An old Studio without client RunContext would run this on the SERVER —
		-- worse than the PlayerGui host path, so fall back to it instead.
		if not pcall(function() one.RunContext = Enum.RunContext.Client end) then
			one:Destroy()
			return
		end
		table.sort(parts, function(a, b) return a.Name < b.Name end)
		local out = {
			"-- Framewisp billboard runtime. RunContext=Client makes this Script run on",
			"-- each player's client even from Workspace (a LocalScript here would not),",
			"-- so the billboard is self-contained: move or duplicate the anchor Part and",
			"-- every copy keeps its effects. Sections are independent: delete one, the",
			"-- rest keep working.",
			"",
		}
		local stamp = {}
		for _, part in ipairs(parts) do
			stamp[#stamp + 1] = string.sub(part.Name, 10) .. ":" .. tostring(part:GetAttribute("FWv"))
			out[#out + 1] = "-- ======================================== " .. part.Name
			out[#out + 1] = "task.spawn(function()"
			out[#out + 1] = "local ok, err = pcall(function()"
			out[#out + 1] = part.Source
			out[#out + 1] = "end)"
			out[#out + 1] = "if not ok then warn(\"[Framewisp] " .. part.Name .. ": \" .. tostring(err)) end"
			out[#out + 1] = "end)"
			out[#out + 1] = ""
		end
		local old = bbTarget:FindFirstChild(BUNDLE_NAME)
		if old and old:GetAttribute("FW_Owned") then old:Destroy() end
		one.Name = BUNDLE_NAME
		one.Source = table.concat(out, "\n")
		one:SetAttribute("FW_Parts", table.concat(stamp, "|"))
		stampRuntime(one)
		one.Parent = bbTarget
		for _, part in ipairs(parts) do part:Destroy() end
	end

	local bundleMode = plugin:GetSetting("fw_bundle") == true
	-- An unedited bundle is disposable: it is rebuilt from the same blocks every
	-- import. An edited one is the developer's work — then we add nothing at all,
	-- because injecting the separate scripts alongside it would double every effect.
	local keepTheirs = false
	do
		local old = screen:FindFirstChild(BUNDLE_NAME)
		if old and old:IsA("LocalScript") and old:GetAttribute("FW_Owned") then
			local mark = old:GetAttribute("FW_Src")
			local ok, live = pcall(function() return srcHash(old.Source) end)
			if type(mark) == "number" and ok and live ~= mark then
				keepTheirs = true
				runtimeKept[#runtimeKept + 1] = BUNDLE_NAME
			else
				old:Destroy()
			end
		end
	end
	local hasScale, hasButtons, hasActions, hasBind, has3D, hasShiny, hasSpin = false, false, false, false, false, false, false
	local hasFloat, hasSelect, hasDrift = false, false, false
	local hasPrompt = false
	local hasFlow = false
	local hasStroke = false
	local hasFall = false
	local hasFocus = false
	local hasBlink = false
	local hasFadein = false
	local hasColor = false
	local hasBurst = false
	local hasPointer, hasCard = false, false
	local hasJuice = false
	local hasTL = false
	-- A _billboard design lives on its anchor Part, not under this ScreenGui, so
	-- scanning only our own descendants decided "no effects here" and injected
	-- NOTHING — the billboard came back with zero scripts inside it.
	local scanList = {}
	for _, d in ipairs(screen:GetDescendants()) do scanList[#scanList + 1] = d end
	for _, v in ipairs(screen:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			for _, d in ipairs(v.Value:GetDescendants()) do scanList[#scanList + 1] = d end
		end
	end
	for _, d in ipairs(scanList) do
		if d:GetAttribute("FigmaFontSize") ~= nil or d:GetAttribute("FigmaStrokeW") ~= nil or d:GetAttribute("FigmaTextStrokeW") ~= nil or d:GetAttribute("FigmaCellW") ~= nil then
			hasScale = true
		end
		if d:GetAttribute("Figma3D") ~= nil or d:GetAttribute("FigmaTilt") ~= nil
			or d:GetAttribute("FigmaSwing") ~= nil then
			has3D = true
			if d:GetAttribute("Figma3D") ~= nil and d:GetAttribute("FigmaTiltMax") == 0 and d:GetAttribute("FigmaTilt") == nil then
				warn(("[Framewisp] _3d on %q: Tilt strength is 0 and there is no _tilt pose — the card renders in the world but nothing will move. Raise Tilt strength in the effect panel."):format(d.Name))
			end
		end
		if d:GetAttribute("FigmaShiny") ~= nil or d:GetAttribute("FigmaGlint") ~= nil then
			hasShiny = true
		end
		if d:GetAttribute("FigmaSpin") ~= nil then
			hasSpin = true
		end
		if d:GetAttribute("FigmaFloat") ~= nil then
			hasFloat = true
		end
		if d:GetAttribute("FigmaBlink") ~= nil then
			hasBlink = true
		end
		if d:GetAttribute("FigmaFadein") ~= nil then
			hasFadein = true
		end
		if d:GetAttribute("FigmaColor") ~= nil then
			hasColor = true
		end
		if d:GetAttribute("FigmaBurst") ~= nil then
			hasBurst = true
		end
		if d:GetAttribute("FigmaPointer") ~= nil then
			hasPointer = true
		end
		if d:GetAttribute("FigmaCard") ~= nil then
			hasCard = true
		end
		if d:GetAttribute("FigmaTimeline") ~= nil then
			hasTL = true
		end
		if d:GetAttribute("FigmaPop") ~= nil or d:GetAttribute("FigmaPulse") ~= nil or d:GetAttribute("FigmaShake") ~= nil
			or d:GetAttribute("FigmaWiggle") ~= nil or d:GetAttribute("FigmaGlow") ~= nil or d:GetAttribute("FigmaRays") ~= nil
			or d:GetAttribute("FigmaCascade") ~= nil or d:GetAttribute("FigmaJelly") ~= nil or d:GetAttribute("FigmaPixels") ~= nil
			or d:GetAttribute("FigmaReveal") ~= nil or d:GetAttribute("FigmaSwing") ~= nil or d:GetAttribute("FigmaGleam") ~= nil
			or d:GetAttribute("FigmaDrop") ~= nil then
			hasJuice = true
		end
		if d:GetAttribute("FigmaDrift") ~= nil then
			hasDrift = true
		end
		if d:GetAttribute("FigmaPrompt") ~= nil then
			hasPrompt = true
		end
		if d:GetAttribute("FigmaFlow") ~= nil then
			hasFlow = true
		end
		if d:GetAttribute("FigmaStroke") ~= nil then
			hasStroke = true
		end
		if d:GetAttribute("FigmaFall") ~= nil then
			hasFall = true
		end
		if d:GetAttribute("FigmaFocus") ~= nil then
			hasFocus = true
		end
		if d:GetAttribute("FigmaSelect") ~= nil then
			hasSelect = true
		end
		if d:IsA("TextButton") or d:IsA("ImageButton") or d:GetAttribute("FigmaLean") ~= nil or d:GetAttribute("FigmaColorPick") ~= nil then
			hasButtons = true -- _lean and a hover colour live in the button runtime but are never promoted to a button
		end
		if d:GetAttribute("FigmaAction") ~= nil then
			hasActions = true
		end
		if d:GetAttribute("FigmaBind") ~= nil then
			hasBind = true
		end
	end

	-- A Free import carries no Pro features — the server strips them before the
	-- blueprint is written. So anything found here was typed in by hand, and
	-- honouring it would make the plan a suggestion. Existing runtimes are left
	-- exactly as they are: this only declines to ADD new ones.
	if freeImport then
		-- ...and SAY which ones, by name. Declining in silence is why "I have flow
		-- on but it doesn't move in-game" arrives as a bug report instead of a
		-- question about the plan: the design looks converted, the effect is simply
		-- never wired, and nothing anywhere admits it.
		local held = {}
		local note = function(on, name) if on then held[#held + 1] = name end end
		note(hasButtons, "buttons"); note(hasActions, "actions"); note(hasBind, "{bindings}")
		note(has3D, "_3d"); note(hasShiny, "_shiny"); note(hasSpin, "_spin")
		note(hasFloat, "_float"); note(hasSelect, "_select"); note(hasDrift, "_drift")
		note(hasBlink, "_blink"); note(hasPrompt, "_prompt"); note(hasFlow, "_flow")
		note(hasStroke, "_stroke")
		note(hasFall, "_fall"); note(hasFocus, "_focus")
		note(hasFadein, "_fadein"); note(hasColor, "_color"); note(hasBurst, "_burst"); note(hasPointer, "_pointer"); note(hasCard, "_card")
		note(hasJuice, "juice effects"); note(hasTL, "timelines")
		if #held > 0 then
			warn("[Framewisp] This is a FREE import, so these were not wired: "
				.. table.concat(held, ", ") .. ". The design imported in full; the moving parts need a licence.")
		end
		hasButtons, hasActions, hasBind, has3D, hasShiny, hasSpin = false, false, false, false, false, false
		hasFloat, hasSelect, hasDrift, hasBlink = false, false, false, false
		hasFadein = false
		hasColor = false
		hasBurst = false
		hasPointer, hasCard = false, false
		hasPrompt = false
		hasFlow = false
		hasStroke = false
		hasFall = false
		hasFocus = false
		hasJuice = false
		hasTL = false
	end

	-- Their bundle, their rules: add nothing next to a runtime the developer edited.
	if keepTheirs then
		hasScale, hasButtons, hasActions, hasBind, has3D, hasShiny, hasSpin = false, false, false, false, false, false, false
		hasStroke = false
		hasFloat, hasSelect, hasDrift = false, false, false
		hasJuice = false
		hasBurst = false
		hasPointer, hasCard = false, false
		hasTL = false
	end

	do
		dropIfOurs(screen, "FramewispTextScaler", 30)
	end
	if hasScale and not screen:FindFirstChild("FramewispTextScaler") then
	local scaler = Instance.new("LocalScript")
	scaler.Name = "FramewispTextScaler"
	scaler.Source = [[
-- Framewisp: keeps text and stroke sizes accurate at any screen resolution.
-- Safe to delete only if your UI never changes resolution (text will stop scaling).
local TextService = game:GetService("TextService")
local gui = script.Parent
do
	local okv, v = pcall(function() return script:GetAttribute("FWv") end)
	print("[Framewisp] TextScaler v" .. tostring(okv and v or "?") .. " in " .. gui.Name .. " — baselines are static, Play moves nothing")
end
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function fwScaleHost(el) -- Roblox honours ONE UIScale per object
	local sc = el:FindFirstChild("FW_Scale")
	if not sc then
		sc = el:FindFirstChildWhichIsA("UIScale")
		if sc then
			sc.Name = "FW_Scale"
		else
			sc = Instance.new("UIScale")
			sc.Name = "FW_Scale"
			sc:SetAttribute("FW_Owned", true)
			sc.Parent = el
		end
	end
	return sc
end
local function fwScaleApply(host)
	local total = 1
	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("NumberValue") then total = total * ch.Value end
	end
	host.Scale = total
end
local function fwChannel(el, key) -- every runtime writes its OWN channel; the product applies once
	local host = fwScaleHost(el)
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function() fwScaleApply(host) end)
	end
	return ch
end
local function fwRotSet(el, key, deg) -- Rotation is shared by three runtimes too
	local base = el:GetAttribute("FW_RotBase")
	if base == nil then
		base = el.Rotation
		el:SetAttribute("FW_RotBase", base)
	end
	el:SetAttribute(key, deg)
	local total = 0
	for _, k in ipairs({ "r_juice", "r_spin", "r_tl", "r_hover" }) do
		local v = el:GetAttribute(k)
		if type(v) == "number" then total = total + v end
	end
	el.Rotation = base + total
end
local function findRoot()
	local dw, dh = gui:GetAttribute("BB_DesignW"), gui:GetAttribute("BB_DesignH")
	for _, d in ipairs(fwAll()) do -- slots transport the design; only stampDesign marks its actual bounds
		if d:IsA("GuiObject") and d:GetAttribute("FW_Owned") == true then
			local w, h = d:GetAttribute("BB_DesignW"), d:GetAttribute("BB_DesignH")
			if type(w) == "number" and w > 0 and type(h) == "number" and h > 0
				and (dw == nil or w == dw) and (dh == nil or h == dh) then
				return d -- retain this object when Card3D reparents it into a SurfaceGui
			end
		end
	end
	local fallback = nil
	for _, child in ipairs(gui:GetChildren()) do
		if child:IsA("BillboardGui") then -- _billboard: the design lives one level deeper
			local inner = child:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("ObjectValue") and child.Name == "FW_ExtraRoot" and child.Value then
			local inner = child.Value:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("GuiObject") then
			fallback = fallback or child
			if child:GetAttribute("FW_Owned") == true then return child end
		end
	end
	return fallback
end
local root = findRoot()
if not root then return end
local designH = gui:GetAttribute("BB_DesignH") or 1080
local designW = gui:GetAttribute("BB_DesignW")
local factor = gui:GetAttribute("BB_TextFactor") or 1.16
local byKey, facesReady = {}, {}
local reverified = false
local EM = { -- TextSize per design em of each bundled face: a label not sized by its width uses its em
	["rbxasset://fonts/families/AccanthisADFStd.json"] = 1.168,
	["rbxasset://fonts/families/AmaticSC.json"] = 1.261,
	["rbxasset://fonts/families/Arimo.json"] = 1.1172,
	["rbxasset://fonts/families/Balthazar.json"] = 1.018,
	["rbxasset://fonts/families/Bangers.json"] = 1.064,
	["rbxasset://fonts/families/BuilderExtended.json"] = 1.26,
	["rbxasset://fonts/families/BuilderMono.json"] = 1.26,
	["rbxasset://fonts/families/BuilderSans.json"] = 1.26,
	["rbxasset://fonts/families/ComicNeueAngular.json"] = 1.209,
	["rbxasset://fonts/families/Creepster.json"] = 1.1689,
	["rbxasset://fonts/families/DenkOne.json"] = 1.25,
	["rbxasset://fonts/families/Fondamento.json"] = 1.3838,
	["rbxasset://fonts/families/FredokaOne.json"] = 1.21,
	["rbxasset://fonts/families/GrenzeGotisch.json"] = 1.48,
	["rbxasset://fonts/families/Guru.json"] = 1.1846,
	["rbxasset://fonts/families/HighwayGothic.json"] = 1.107,
	["rbxasset://fonts/families/Inconsolata.json"] = 1.049,
	["rbxasset://fonts/families/IndieFlower.json"] = 1.459,
	["rbxasset://fonts/families/JosefinSans.json"] = 1.0,
	["rbxasset://fonts/families/Jura.json"] = 1.183,
	["rbxasset://fonts/families/Kalam.json"] = 1.594,
	["rbxasset://fonts/families/LegacyArial.json"] = 1.1172,
	["rbxasset://fonts/families/LegacyArimo.json"] = 1.1172,
	["rbxasset://fonts/families/LuckiestGuy.json"] = 1.0,
	["rbxasset://fonts/families/Merriweather.json"] = 1.257,
	["rbxasset://fonts/families/Michroma.json"] = 1.4219,
	["rbxasset://fonts/families/Montserrat.json"] = 1.219,
	["rbxasset://fonts/families/Nunito.json"] = 1.364,
	["rbxasset://fonts/families/Oswald.json"] = 1.482,
	["rbxasset://fonts/families/PatrickHand.json"] = 1.354,
	["rbxasset://fonts/families/PermanentMarker.json"] = 1.4268,
	["rbxasset://fonts/families/PressStart2P.json"] = 1.834, -- Figma's face is 1.790x wider than this file: 1.0244 x 1.790
	["rbxasset://fonts/families/Roboto.json"] = 1.1719,
	["rbxasset://fonts/families/RobotoCondensed.json"] = 1.1719,
	["rbxasset://fonts/families/RobotoMono.json"] = 1.3188,
	["rbxasset://fonts/families/RomanAntique.json"] = 1.049,
	["rbxasset://fonts/families/Sarpanch.json"] = 1.4,
	["rbxasset://fonts/families/SourceSansPro.json"] = 1.257,
	["rbxasset://fonts/families/SpecialElite.json"] = 1.0,
	["rbxasset://fonts/families/TitilliumWeb.json"] = 1.521,
	["rbxasset://fonts/families/Ubuntu.json"] = 1.121,
	["rbxasset://fonts/families/Zekton.json"] = 1.2,
}
local ContentProvider = game:GetService("ContentProvider")
local function faceOf(d)
	local f = d.FontFace
	if not f then return "?" end
	return tostring(f.Family) .. "|" .. tostring(f.Weight) .. "|" .. tostring(f.Style)
end
local function textKey(d)
	return faceOf(d) .. "|" .. (d.ContentText:gsub("^%s+", ""):gsub("%s+$", ""))
end
local gridInfo = setmetatable({}, { __mode = "k" })
local function fwRenders()
	local cam = workspace.CurrentCamera
	return cam ~= nil and cam.ViewportSize.X >= 2 and cam.ViewportSize.Y >= 2
end

local function fwHoverRoom(cells, cellW, cellH)
	local hs = 1
	if cells then
		for _, c in ipairs(cells:GetChildren()) do
			if c:IsA("GuiObject") and c:GetAttribute("FigmaSmooth") then
				local v = c:GetAttribute("SmoothHover") or c:GetAttribute("FigmaSmoothHover") or 1.08
				if type(v) == "number" and v > hs then hs = v end
			end
		end
	end
	if hs <= 1 then return 0, 0 end
	return cellW * (hs - 1) / 2, cellH * (hs - 1) / 2
end

local gridGeometry, gridScroll -- mutually recursive: a re-fit updates the canvas

local function gridRatio(cells, fallback, smScale)
	local grid = cells and cells:FindFirstChildWhichIsA("UIGridLayout")
	if not grid then return fallback end
	local winW = grid:GetAttribute("FigmaWinW") or 0
	if winW <= 0 then return fallback end
	local host = cells.Parent
	local live = ((host and host:IsA("ScrollingFrame")) and host.AbsoluteSize.X or cells.AbsoluteSize.X) / smScale
	if live <= 1 then return fallback end
	return live / winW
end

function gridGeometry(d, k, kx, smScale)
	if d:IsA("UIPadding") and d:GetAttribute("FigmaPadL") ~= nil then
		local gs = gridRatio(d.Parent, kx, smScale)
		d.PaddingLeft = UDim.new(0, (d:GetAttribute("FigmaPadL") or 0) * gs)
		d.PaddingTop = UDim.new(0, (d:GetAttribute("FigmaPadT") or 0) * gs)
		d.PaddingBottom = UDim.new(0, (d:GetAttribute("FigmaPadB") or 0) * gs)
		return
	end
	if not (d:IsA("UIGridLayout") and d:GetAttribute("FigmaCellW") ~= nil) then return end
	local cells = d.Parent
	local cols = math.max(1, d.FillDirectionMaxCells)
	local gs = gridRatio(cells, kx, smScale)
	local cellWD = d:GetAttribute("FigmaCellW") or 0
	local cellHD = d:GetAttribute("FigmaCellH") or 0
	local gapXD = d:GetAttribute("FigmaGapX") or 0
	local gapYD = d:GetAttribute("FigmaGapY") or 0
	local pad = cells and cells:FindFirstChildWhichIsA("UIPadding")
	local padLD = (pad and pad:GetAttribute("FigmaPadL")) or 0

	local sf = cells and cells.Parent
	local barD = 0
	if sf and sf:IsA("ScrollingFrame") then
		barD = sf:GetAttribute("FigmaBar") or sf.ScrollBarThickness
		local mineBar = sf:GetAttribute("FW_BarPx")
		if type(mineBar) == "number" and math.abs(sf.ScrollBarThickness - mineBar) > 0.5 then
			barD = sf.ScrollBarThickness / (gs > 0.001 and gs or 1)
			sf:SetAttribute("FigmaBar", barD)
		end
		local wantBar = math.max(2, barD * gs)
		sf.ScrollBarThickness = wantBar
		sf:SetAttribute("FW_BarPx", wantBar)
	end

	local roomD = d:GetAttribute("FigmaHoverRoom")
	if roomD == nil then roomD = select(1, fwHoverRoom(cells, cellWD, cellHD)) end
	local hostW = ((sf and sf:IsA("ScrollingFrame")) and sf.AbsoluteSize.X) or (cells and cells.AbsoluteSize.X) or 0
	local availD = (hostW / smScale) / math.max(gs, 1e-6)
	local cellW = cellWD
	if availD > 1 then
		local maxD = (availD - padLD - (cols - 1) * gapXD - barD - roomD) / cols
		if maxD > 0 and maxD < cellW then cellW = maxD end
	end
	local cellH = cellHD * (cellW / math.max(cellWD, 1e-6)) -- keep the card's shape

	d.CellSize = UDim2.fromOffset(math.max(1, cellW * gs), math.max(1, cellH * gs))
	d.CellPadding = UDim2.fromOffset(gapXD * gs, gapYD * gs)

	local info = gridInfo[d]
	if not info then
		info = {}
		gridInfo[d] = info
	end
	if cells and not info.sizeWired then
		info.sizeWired = true
		cells:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if info.refit and not info.busy and fwRenders() then
				info.busy = true
				info.refit()
				info.busy = false
			end
		end)
	end
	info.refit = function()
		gridGeometry(d, k, kx, smScale)
		if pad then gridGeometry(pad, k, kx, smScale) end -- the origin rides along
		if sf then gridScroll(sf) end
	end
end

function gridScroll(sf)
	if not (sf:IsA("ScrollingFrame") and sf:GetAttribute("FWGridScroll")) then return end
	local cells, grid
	for _, c in ipairs(sf:GetChildren()) do
		if c.Name == "Cells" and c:GetAttribute("FW_Owned") then
			local g = c:FindFirstChildWhichIsA("UIGridLayout")
			if g then cells, grid = c, g break end
		end
	end
	if not grid then return end
	local pad = cells:FindFirstChildWhichIsA("UIPadding")
	local info = gridInfo[grid]
	if not info then
		info = {}
		gridInfo[grid] = info
	end
	if not info.canvasWired then
		info.canvasWired = true
		grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			if info.set and fwRenders() then info.set() end
		end)
		cells.ChildAdded:Connect(function() if info.set and fwRenders() then info.set() end end)
		cells.ChildRemoved:Connect(function() if info.set and fwRenders() then info.set() end end)
	end
	info.set = function()
		local cellH = grid.CellSize.Y.Offset
		local gapY = grid.CellPadding.Y.Offset
		local pt = pad and pad.PaddingTop.Offset or 0
		local pb = pad and pad.PaddingBottom.Offset or 0
		local step = cellH + gapY
		local rows = 0
		if step > 0 then
			rows = math.max(0, math.floor((grid.AbsoluteContentSize.Y + gapY) / step + 0.5))
		end
		if rows == 0 then
			local n = 0
			for _, c in ipairs(cells:GetChildren()) do
				if c:IsA("GuiObject") and c.Visible then n = n + 1 end
			end
			rows = math.ceil(n / math.max(1, grid.FillDirectionMaxCells))
		end
		local h = rows > 0 and (pt + rows * cellH + (rows - 1) * gapY + pb) or 0
		if h <= sf.AbsoluteWindowSize.Y + 1 then h = 0 end
		sf.CanvasSize = UDim2.fromOffset(0, h)
	end
	info.set()
end

local function measure(d) -- per face + text, after the face is downloaded
	local key = textKey(d)
	local cached = byKey[key]
	if cached ~= nil then return cached or nil end
	local face = faceOf(d)
	if not facesReady[face] then
		facesReady[face] = true
		pcall(function() ContentProvider:PreloadAsync({ d }) end)
	end
	local ok, b = pcall(function()
		local prm = Instance.new("GetTextBoundsParams")
		prm.Text = (d.ContentText:gsub("^%s+", ""):gsub("%s+$", ""))
		prm.Font = d.FontFace
		prm.Size = 100
		prm.Width = 1e6
		return TextService:GetTextBoundsAsync(prm)
	end)
	if ok and b and b.X > 0 then
		byKey[key] = b.X
		return b.X
	end
	if ok then
		byKey[key] = false
	end
	return nil
end
local function stampVote() -- twins agree: the stamp most labels of one face + text carry
	local votes, best = {}, {}
	for _, d in ipairs(root:GetDescendants()) do
		local st = d:GetAttribute("FW_M100")
		if type(st) == "number" and st > 0 and d:GetAttribute("FigmaTextW") then
			local key = textKey(d)
			local r = math.floor(st * 10 + 0.5) / 10
			votes[key] = votes[key] or {}
			votes[key][r] = (votes[key][r] or 0) + 1
		end
	end
	for key, tally in pairs(votes) do
		local top, n = nil, 0
		for v, c in pairs(tally) do
			if c > n or (c == n and top and v > top) then top, n = v, c end
		end
		best[key] = top
	end
	return best
end
local padWired = setmetatable({}, { __mode = "k" })
local function textPad(d, s) -- the spill grows the box about its AnchorPoint: inset the text back to the design box
	local pad = d:FindFirstChild("FW_TextPad")
	if s <= 1.0001 then
		if pad then pad:Destroy() end
		return
	end
	if not pad then
		if d:FindFirstChildWhichIsA("UIPadding") then return end -- the developer's padding owns the text area
		pad = Instance.new("UIPadding")
		pad.Name = "FW_TextPad"
		pad:SetAttribute("FW_Owned", true)
		pad.Parent = d
	end
	local a, g = d.AnchorPoint, 1 - 1 / s
	pad.PaddingLeft = UDim.new(a.X * g, 0)
	pad.PaddingRight = UDim.new((1 - a.X) * g, 0)
	pad.PaddingTop = UDim.new(a.Y * g, 0)
	pad.PaddingBottom = UDim.new((1 - a.Y) * g, 0)
	if not padWired[d] then
		padWired[d] = true
		d:GetPropertyChangedSignal("AnchorPoint"):Connect(function() -- a layout slot re-anchors it later
			local h = d:FindFirstChild("FW_Scale")
			local c = h and h:FindFirstChild("k_text")
			textPad(d, c and c.Value or 1)
		end)
	end
end
local function spillOver(x) -- a stroke or a gleam copy is drawn inside its label's spill
	local sp, n = 1, x.Parent
	while n and n ~= root do
		local h = n:FindFirstChild("FW_Scale")
		local c = h and h:FindFirstChild("k_text")
		if c and c.Value > 0 then sp = sp * c.Value end
		n = n.Parent
	end
	return sp
end
local function setTextPx(d, t, exact)
	if d:FindFirstAncestorWhichIsA("BillboardGui") then return end -- billboards size their own text
	local mine = d:GetAttribute("FW_TextMine")
	if type(mine) == "number" and (math.abs(d.TextSize - mine) > 0.5
		or d.TextScaled ~= (d:GetAttribute("FW_TextScaledMine") == true)) then
		d:SetAttribute("FW_TextOwn", true)
	end
	if d:GetAttribute("FW_TextOwn") then return end
	local sc = fwChannel(d, "k_text")
	local con = d:FindFirstChild("FWTextBig")
	if con then con:Destroy() end -- TextScaled + Min==Max stops at 100 too: the spill is the only way past it
	d.TextScaled = false
	if t > 100 then
		sc.Value = t / 100
		d.TextSize = 100
	else
		sc.Value = 1
		local px = exact and math.floor(t) or math.floor(t + 0.5)
		d.TextSize = math.max(1, px)
	end
	textPad(d, sc.Value)
	d:SetAttribute("FW_TextMine", d.TextSize)
	d:SetAttribute("FW_TextScaledMine", d.TextScaled)
end
local gen = 0
local coldTries = 0
local printedPass = false
local smHooked, smPend = nil, false
local apply
local function smRerun()
	if smPend then return end
	smPend = true
	task.delay(0.2, function()
		smPend = false
		apply()
	end)
end
function apply()
	gen = gen + 1
	local myGen = gen
	local sm = root:FindFirstChild("FW_Scale") or root:FindFirstChild("FramewispSmooth") or root:FindFirstChild("FWActScale")
	local smScale = (sm and sm:IsA("UIScale") and sm.Scale > 0) and sm.Scale or 1
	if sm and sm ~= smHooked and sm:IsA("UIScale") then
		smHooked = sm
		sm:GetPropertyChangedSignal("Scale"):Connect(smRerun) -- solved mid-tween = a size compensating a scale that finished at 1
	end
	local k = root.AbsoluteSize.Y / designH / smScale
	if k <= 0 then return end
	if not fwRenders() then return end
	if root.AbsoluteSize.X < 2 or root.AbsoluteSize.Y < 2 then return end
	local kx = (type(designW) == "number" and designW > 0) and root.AbsoluteSize.X / designW / smScale or k
	local transient = false
	local nExact, nFallback = 0, 0
	local measured = false
	local agreed = stampVote()
	for _, d in ipairs(root:GetDescendants()) do
		if myGen ~= gen then return end
		local fs = d:GetAttribute("FigmaFontSize")
		if fs and d.Name ~= "FW_GleamShine" then -- a gleam copy inherits its label's spill: solving it again doubled it
			local m = nil
			local tw = d:GetAttribute("FigmaTextW")
			if type(tw) == "number" and tw > 0 then
				local t0 = d:GetAttribute("FW_Text0")
				if t0 == nil then
					t0 = d.ContentText
					d:SetAttribute("FW_Text0", t0)
				end
				if d.ContentText == t0 then
					m = agreed[textKey(d)] or d:GetAttribute("FW_M100")
					if m == nil then m = measure(d); measured = true end -- stamped at import; twins vote; else measured here
					if m == nil and byKey[textKey(d)] == nil then transient = true end
				end
				if myGen ~= gen then return end
			end
			if m then
				setTextPx(d, 100 * (tw * kx) / m, true)
				nExact = nExact + 1
			else
				local f = d.FontFace
				setTextPx(d, fs * k * ((f and EM[tostring(f.Family)]) or factor))
				nFallback = nFallback + 1
			end
		end
		local swMine = d:GetAttribute("FW_StrokeMine")
		if type(swMine) == "number" and math.abs(d.Thickness - swMine) > 0.01 then
			d:SetAttribute("FW_StrokeOwn", true)
		end
		local okMode, isFrac = pcall(function() return d.StrokeSizingMode == Enum.StrokeSizingMode.ScaledSize end)
		if d:GetAttribute("FW_StrokeScaled") or (okMode and isFrac) then -- a fraction, not pixels
			d:SetAttribute("FW_StrokeScaled", true)
			local host = d.Parent
			if d.Thickness > 0.5 and (d:GetAttribute("FigmaStrokeW") or d:GetAttribute("FigmaTextStrokeW"))
				and host and host:IsA("GuiObject") and math.min(host.AbsoluteSize.X, host.AbsoluteSize.Y) > 1 then
				d.Thickness = d.Thickness / math.min(host.AbsoluteSize.X, host.AbsoluteSize.Y)
			end
		elseif not d:GetAttribute("FW_StrokeOwn") then
			local sw = d:GetAttribute("FigmaStrokeW")
			if sw then d.Thickness = math.max(0.35, sw * k) end
			local tsw = d:GetAttribute("FigmaTextStrokeW")
			if tsw then
				d.Thickness = math.max(0.35, (tsw * k + (d:GetAttribute("FW_StrokeExtra") or 0)) / spillOver(d)) -- geometry, not font compensation; a gleam halo keeps its extra
			end
			if sw or tsw then d:SetAttribute("FW_StrokeMine", d.Thickness) end
		end
		gridGeometry(d, k, kx, smScale)
		gridScroll(d)
	end
	gridScroll(root) -- the root can BE the scrolling grid
	if not printedPass and (nExact + nFallback) > 0 then
		printedPass = true
		print(("[Framewisp] TextScaler: %d width-exact, %d fallback"):format(nExact, nFallback))
		local rootH = root.AbsoluteSize.Y
		local worst, shown = {}, 0
		if rootH > 1 then
			for _, d in ipairs(root:GetDescendants()) do
				local tag = d:GetAttribute("FW_EDbg")
				if type(tag) == "string" and d:IsA("TextLabel") and d.AbsoluteSize.Y > 0 then
					local eL, eC = tag:match("([%d.]+)|([%d.]+)")
					eL, eC = tonumber(eL), tonumber(eC)
					if eL and eC then
						local pL = d.TextSize / rootH
						local pC = (d.AbsolutePosition.Y - root.AbsolutePosition.Y + d.AbsoluteSize.Y / 2) / rootH
						local dl, dc = pL - eL, pC - eC
						if math.abs(dl) > 0.002 or math.abs(dc) > 0.002 then
							worst[#worst + 1] = { n = d.Name, dl = dl * rootH, dc = dc * rootH }
						end
					end
				end
			end
		end
		table.sort(worst, function(a, b) return math.abs(a.dc) + math.abs(a.dl) > math.abs(b.dc) + math.abs(b.dl) end)
		for i = 1, math.min(3, #worst) do
			local x = worst[i]
			print(("[Framewisp] play vs edit %q: size %+.1f px, centre %+.1f px"):format(x.n, x.dl, x.dc))
		end
		if #worst == 0 then
			print("[Framewisp] play matches the editor within 0.2% — any remaining shift is pure rendering")
		end
	end
	if transient and coldTries < 6 then
		coldTries = coldTries + 1
		task.delay(0.5, function()
			if myGen == gen then apply() end
		end)
	elseif measured and not reverified then
		reverified = true
		task.delay(2, function() table.clear(byKey); apply() end) -- once more with every face surely downloaded
	end
end
local pending = false
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	if pending then return end
	pending = true
	task.spawn(function()
		task.wait()
		pending = false
		apply()
	end)
end)
apply()
]]
	stampRuntime(scaler)
	scaler:SetAttribute("FWv", 30)
	scaler.Parent = screen
	end

	do
		-- Replace an outdated FX BEFORE injecting: otherwise a reimport sees the old
		-- script, skips creating the new one, and the cleanup below removes the old —
		-- leaving buttons with no animation at all.
		dropIfOurs(screen, "FramewispButtonFX", 34)
	end
	if hasButtons and not screen:FindFirstChild("FramewispButtonFX") then
	-- Hover/press feedback: darken the button's OWN textures via ImageColor3 (no
	-- overlay frames — the clean way). Every image inside the button dims together;
	-- a layer tagged _nodim in Figma (FigmaNoDim attribute) is left at full
	-- brightness. Designer _hover/_clicked variants still take priority, and flat
	-- buttons with nothing to tint fall back to Roblox's own AutoButtonColor.
	-- slotFor() inside this runtime is used by BOTH _up and _turn. A layout owns a
	-- cell's position and its pivot: the lift was cancelled outright, and a rotation
	-- swung around the corner the layout pinned instead of the card's middle. Giving
	-- the button its own slot takes the layout out of the equation for both, and the
	-- call is idempotent — once wrapped, the parent has no layout and it returns.
	local fx = Instance.new("LocalScript")
	fx.Name = "FramewispButtonFX"
	fx.Source = [[
-- Framewisp: hover/press feedback for buttons (darkens their images).
-- Tag a layer "_nodim" in Figma to keep it at full brightness.
-- Safe to delete: buttons stay, only the hover effect stops.
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function fwScaleHost(el) -- Roblox honours ONE UIScale per object
	local sc = el:FindFirstChild("FW_Scale")
	if not sc then
		sc = el:FindFirstChildWhichIsA("UIScale")
		if sc then
			sc.Name = "FW_Scale"
		else
			sc = Instance.new("UIScale")
			sc.Name = "FW_Scale"
			sc:SetAttribute("FW_Owned", true)
			sc.Parent = el
		end
	end
	return sc
end
local function fwScaleApply(host)
	local total = 1
	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("NumberValue") then total = total * ch.Value end
	end
	host.Scale = total
end
local function fwChannel(el, key) -- every runtime writes its OWN channel; the product applies once
	local host = fwScaleHost(el)
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function() fwScaleApply(host) end)
	end
	return ch
end
local function fwRotSet(el, key, deg) -- Rotation is shared by three runtimes too
	local base = el:GetAttribute("FW_RotBase")
	if base == nil then
		base = el.Rotation
		el:SetAttribute("FW_RotBase", base)
	end
	el:SetAttribute(key, deg)
	local total = 0
	for _, k in ipairs({ "r_juice", "r_spin", "r_tl", "r_hover" }) do
		local v = el:GetAttribute(k)
		if type(v) == "number" then total = total + v end
	end
	el.Rotation = base + total
end
local function findRoot()
	local fallback = nil
	for _, child in ipairs(gui:GetChildren()) do
		if child:IsA("BillboardGui") then -- _billboard: the design lives one level deeper
			local inner = child:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("ObjectValue") and child.Name == "FW_ExtraRoot" and child.Value then
			local inner = child.Value:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("GuiObject") then
			fallback = fallback or child
			if child:GetAttribute("FW_Owned") == true then return child end
		end
	end
	return fallback
end
local root = findRoot()
if not root then return end
local HOVER, PRESS = 0.8, 0.62
local TIME = 0.08
local UP_DIST, UP_TIME = 6, 0.12
local TURN_ANGLE, TURN_TIME = -5, 0.14
local LEAN_ANGLE, LEAN_TIME = -8, 0.14
-- ========================== tune the feel here ==========================
-- MAGNET_PULL — how far a _magnet button leans toward the cursor.
--   0.15 = shy   ·   0.35 = default, juicy   ·   0.6 = clingy
-- MAGNET_RADIUS — attraction zone around the button, in screen px.
--   30 = touchy   ·   60 = default   ·   120 = feels it from afar
-- ========================================================================
local MAGNET_PULL = 0.35
local MAGNET_RADIUS = 60
local GuiService = game:GetService("GuiService")
local function magnetPx() -- design px -> screen px, defined here because the loop runs first
	local r = gui:FindFirstChildWhichIsA("GuiObject")
	if not r then -- a billboard design lives one level deeper, or hangs off FW_ExtraRoot
		for _, v in ipairs(gui:GetChildren()) do
			if v:IsA("BillboardGui") then -- clickable _billboard: kept inside this ScreenGui
				r = v:FindFirstChildWhichIsA("GuiObject")
				break
			end
			if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
				r = v.Value:FindFirstChildWhichIsA("GuiObject")
				break
			end
		end
	end
	local dh = gui:GetAttribute("BB_DesignH")
	if r and type(dh) == "number" and dh > 0 and r.AbsoluteSize.Y > 1 then return r.AbsoluteSize.Y / dh end
	return 1
end
local magnets = {}
local magnetLoop = nil
local function startMagnetLoop()
	if magnetLoop then return end
	magnetLoop = RunService.RenderStepped:Connect(function(dt)
		dt = math.min(dt, 1 / 20)
		local mouse = UserInputService:GetMouseLocation()
		local inset = GuiService:GetGuiInset()
		for _, m in ipairs(magnets) do
			local b = m.btn
			if b.Parent then
				if not m.base then m.base = b.Position end
				local p = b.AbsolutePosition
				local sz = b.AbsoluteSize
				local mx, my = mouse.X - inset.X, mouse.Y - inset.Y
				local radius = m.radius * magnetPx() -- a DESIGN distance: 15 px must mean 15 px of the mockup
				local col = b:FindFirstAncestorWhichIsA("SurfaceGui")
				if col and col:GetAttribute("FW_RectW") then
					local rx, ry = col:GetAttribute("FW_RectX"), col:GetAttribute("FW_RectY")
					local rw, rh = col:GetAttribute("FW_RectW"), col:GetAttribute("FW_RectH")
					if rw and rw > 0 and rh and rh > 0 then
						local cs = col.CanvasSize
						local kx = cs.X / rw
						mx = (mouse.X - rx) * kx
						my = (mouse.Y - ry) * (cs.Y / rh)
						radius = radius * kx
					end
				end
				local par = b.Parent -- rest centre from the LAYOUT: stable, and never our own output
				local ppos = par and par:IsA("GuiObject") and par.AbsolutePosition or Vector2.new(0, 0)
				local psz = par and par:IsA("GuiObject") and par.AbsoluteSize or sz
				local cx, cy
				if par and par:IsA("GuiObject") and psz.X > 1 then
					local ap = b.AnchorPoint
					cx = ppos.X + m.base.X.Scale * psz.X + m.base.X.Offset + (0.5 - ap.X) * sz.X
					cy = ppos.Y + m.base.Y.Scale * psz.Y + m.base.Y.Offset + (0.5 - ap.Y) * sz.Y
				else
					cx = p.X + sz.X / 2 - m.ox
					cy = p.Y + sz.Y / 2 - m.oy
				end
				m.cx0, m.cy0 = cx, cy
				local dx, dy = mx - cx, my - cy
				local nearX = math.abs(dx) - sz.X / 2
				local nearY = math.abs(dy) - sz.Y / 2
				local tx, ty = 0, 0
				if math.max(nearX, nearY) < radius then
					tx = dx * m.pull
					ty = dy * m.pull
					local len = math.sqrt(tx * tx + ty * ty)
					if len > radius then
						tx = tx / len * radius
						ty = ty / len * radius
					end
				end
				local K, C = 260, 14
				m.vx = m.vx + (-K * (m.ox - tx) - C * m.vx) * dt
				m.vy = m.vy + (-K * (m.oy - ty) - C * m.vy) * dt
				m.ox = m.ox + m.vx * dt
				m.oy = m.oy + m.vy * dt
				if math.abs(m.ox - tx) < 0.2 and math.abs(m.oy - ty) < 0.2 -- settle on ANY target: writing Position every frame re-lays out the subtree
					and math.abs(m.vx) < 2 and math.abs(m.vy) < 2 then
					m.ox, m.oy, m.vx, m.vy = tx, ty, 0, 0
				end
				local px, py = math.floor(m.ox + 0.5), math.floor(m.oy + 0.5)
				if px ~= m.lastX or py ~= m.lastY then
					m.lastX, m.lastY = px, py
					b.Position = m.base + UDim2.fromOffset(px, py)
				end
			end
		end
	end)
end

local wired = setmetatable({}, { __mode = "k" })

local function dimTargets(btn)
	local t = {}
	local function insideState(inst)
		local n = inst
		while n and n ~= btn do
			if n:GetAttribute("FigmaState") ~= nil then return true end
			n = n.Parent
		end
		return false
	end
	local function add(inst, prop)
		local pick = inst:GetAttribute("FigmaColorPick") -- a layer with its own hover colour is not dimmed: the pick IS its hover look
		if type(pick) == "number" and pick >= 0 and inst:GetAttribute("FigmaColor") ~= nil then return end
		local e = { inst = inst, prop = prop, base = inst[prop], own = 0 }
		inst:GetPropertyChangedSignal(prop):Connect(function()
			if e.own == 0 then e.base = inst[prop] end
		end)
		t[#t + 1] = e
	end
	if btn:IsA("ImageButton") and btn.Image ~= "" and btn.ImageTransparency < 1 then
		add(btn, "ImageColor3")
	end
	if btn.BackgroundTransparency < 1 then
		add(btn, "BackgroundColor3")
	end
	for _, d in ipairs(btn:GetDescendants()) do
		if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d:GetAttribute("FigmaNoDim") == nil and not insideState(d) then
			add(d, "ImageColor3")
		end
	end
	if #t == 0 then
		if btn:IsA("TextButton") and btn.TextTransparency < 1 then add(btn, "TextColor3") end
		for _, d in ipairs(btn:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.TextTransparency < 1
				and d:GetAttribute("FigmaNoDim") == nil and not insideState(d) then
				add(d, "TextColor3")
			end
		end
	end
	return t
end

local function centreAnchor(btn)
	if btn.AnchorPoint == Vector2.new(0.5, 0.5) then return end
	if btn.Parent then
		for _, ch in ipairs(btn.Parent:GetChildren()) do
			if ch:IsA("UIListLayout") or ch:IsA("UIGridLayout") or ch:IsA("UITableLayout") or ch:IsA("UIPageLayout") then
				return
			end
		end
	end
	local ap, pos, sz = btn.AnchorPoint, btn.Position, btn.Size
	btn.Position = UDim2.new(
		pos.X.Scale + (0.5 - ap.X) * sz.X.Scale,
		pos.X.Offset + (0.5 - ap.X) * sz.X.Offset,
		pos.Y.Scale + (0.5 - ap.Y) * sz.Y.Scale,
		pos.Y.Offset + (0.5 - ap.Y) * sz.Y.Offset
	)
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
end

local function buttonSound(btn, names, fallbackId)
	local id
	for _, a in ipairs(names) do
		id = btn:GetAttribute(a)
		if id ~= nil then break end
	end
	if id == nil then id = fallbackId end
	if type(id) == "number" then id = string.format("%.0f", id) end
	id = tostring(id)
	if id == "" or id == "0" then return nil end
	if not id:match("^rbxassetid://") then id = "rbxassetid://" .. id end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Parent = btn
	return s
end
local function voice(template)
	if not template then return end
	local s = template:Clone()
	s.Parent = template.Parent
	s.Ended:Once(function() s:Destroy() end)
	s:Play()
	Debris:AddItem(s, 15)
end

local function wire(btn)
	if wired[btn] then return end
	wired[btn] = true

	local sndHover = buttonSound(btn, { "HoverSound", "FigmaHoverSound", "SmoothHoverSound" }, "139800881181209") -- "" or 0 = silent
	local sndClick = buttonSound(btn, { "ClickSound", "FigmaClickSound", "SmoothClickSound" }, "102702078778790")
	if sndHover then btn.MouseEnter:Connect(function() voice(sndHover) end) end
	if sndClick then btn.MouseButton1Down:Connect(function() voice(sndClick) end) end

	if btn:GetAttribute("FigmaMagnet") and UserInputService.MouseEnabled then
		magnets[#magnets + 1] = {
			btn = btn,
			pull = btn:GetAttribute("MagnetPull") or btn:GetAttribute("FigmaMagnetPull") or MAGNET_PULL,
			radius = btn:GetAttribute("MagnetRadius") or btn:GetAttribute("FigmaMagnetRadius") or MAGNET_RADIUS,
			ox = 0, oy = 0, vx = 0, vy = 0,
		}
		startMagnetLoop()
	end

	if btn:GetAttribute("FigmaSmooth") then
		btn.AutoButtonColor = false
		centreAnchor(btn)
		local scale = fwChannel(btn, "k_btn") -- a channel, so an idle pulse survives the hover
		local base = scale.Value
		local hoverK = btn:GetAttribute("SmoothHover") or btn:GetAttribute("FigmaSmoothHover") or 1.08
		local pressK = btn:GetAttribute("SmoothPress") or btn:GetAttribute("FigmaSmoothPress") or 0.9
		local hovering, held, tween = false, false, nil
		local function glide(target, t)
			if tween then tween:Cancel() end
			tween = TweenService:Create(scale, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = target })
			tween:Play()
		end
		btn.MouseEnter:Connect(function()
			hovering = true
			if not held then glide(base * hoverK, 0.15) end
		end)
		btn.MouseLeave:Connect(function()
			hovering = false
			if not held then glide(base, 0.15) end
		end)
		btn.MouseButton1Down:Connect(function()
			held = true
			glide(base * pressK, 0.08)
		end)
		local function release()
			if not held then return end
			held = false
			glide(hovering and base * hoverK or base, 0.1)
		end
		btn.MouseButton1Up:Connect(release)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				release()
			end
		end)
	end

	local states = {}
	for _, c in ipairs(btn:GetDescendants()) do
		local s = c:GetAttribute("FigmaState")
			if (s == "hover" or s == "clicked" or s == "disabled" or s == "default") and not states[s] then
			local owned, n = true, c.Parent
			while n and n ~= btn do
				if n:IsA("GuiButton") then owned = false break end
				n = n.Parent
			end
			if owned then states[s] = c end
		end
	end
	if next(states) then
		local function show(name)
			for s, c in pairs(states) do
				if s == "default" then
					c.Visible = (name == nil)
				else
					c.Visible = (s == name)
				end
			end
		end
		local function disabled()
			local ok, value = pcall(function() return btn.Interactable == false end)
			return (ok and value) or btn.Active == false
		end
		local function rest() show(disabled() and states.disabled and "disabled" or nil) end
		btn.MouseEnter:Connect(function() if not disabled() and states.hover then show("hover") end end)
		btn.MouseLeave:Connect(rest)
		btn.MouseButton1Down:Connect(function() if not disabled() and states.clicked then show("clicked") end end)
		btn.MouseButton1Up:Connect(function() if disabled() then rest() else show(states.hover and "hover" or nil) end end)
		btn:GetPropertyChangedSignal("Active"):Connect(rest)
		pcall(function() btn:GetPropertyChangedSignal("Interactable"):Connect(rest) end)
		rest()
		if states.hover or states.clicked then return end
	end

	if btn:GetAttribute("FigmaSmooth") then return end

	local targets = dimTargets(btn)
	if #targets == 0 then
		btn.AutoButtonColor = true
		return
	end
	btn.AutoButtonColor = false
	centreAnchor(btn)
	local hoverDim = btn:GetAttribute("HoverDim") or btn:GetAttribute("FigmaHoverDim") or HOVER
	local pressDim = btn:GetAttribute("PressDim") or btn:GetAttribute("FigmaPressDim") or PRESS
	local pressIn = btn:GetAttribute("PressScale") or btn:GetAttribute("FigmaSmoothPress") or 0.985
	local scale = fwChannel(btn, "k_press")
	local function to(k, s)
		for _, tg in ipairs(targets) do
			local c = tg.base
			tg.own = tg.own + 1
			local tw = TweenService:Create(tg.inst, TweenInfo.new(TIME), { [tg.prop] = Color3.new(c.R * k, c.G * k, c.B * k) })
			tw.Completed:Once(function()
				if tg.own > 0 then tg.own = tg.own - 1 end
			end)
			tw:Play()
		end
		TweenService:Create(scale, TweenInfo.new(TIME), { Value = s }):Play()
	end
	btn.MouseEnter:Connect(function() to(hoverDim, 1) end)
	btn.MouseLeave:Connect(function() to(1, 1) end)
	btn.MouseButton1Down:Connect(function() to(pressDim, pressIn) end)
	btn.MouseButton1Up:Connect(function() to(hoverDim, 1) end)
end

local function onScrollMoved(btn, fn)
	local sf = btn:FindFirstAncestorWhichIsA("ScrollingFrame")
	if not sf then return end
	sf:GetPropertyChangedSignal("CanvasPosition"):Connect(fn)
end
local function laidOutBy(btn)
	local p = btn.Parent
	if not p then return false end
	return p:FindFirstChildWhichIsA("UIGridLayout") ~= nil
		or p:FindFirstChildWhichIsA("UIListLayout") ~= nil
		or p:FindFirstChildWhichIsA("UITableLayout") ~= nil
		or p:FindFirstChildWhichIsA("UIPageLayout") ~= nil
end
local function slotFor(btn)
	if not laidOutBy(btn) then return end
	local slot = Instance.new("Frame")
	slot.Name = btn.Name .. "_LiftSlot"
	slot:SetAttribute("FW_LiftSlot", true)
	slot.BackgroundTransparency = 1
	slot.BorderSizePixel = 0
	slot.Size = btn.Size
	slot.Position = btn.Position
	slot.AnchorPoint = btn.AnchorPoint
	slot.LayoutOrder = btn.LayoutOrder
	slot.ZIndex = btn.ZIndex
	slot.Visible = btn.Visible
	slot.Parent = btn.Parent
	btn.AnchorPoint = Vector2.new(0, 0)
	btn.Position = UDim2.fromScale(0, 0)
	btn.Size = UDim2.fromScale(1, 1)
	btn.Parent = slot
	centreAnchor(btn)
end
local function cardAround(el)
	local n = el.Parent
	while n and n ~= gui do
		if n:IsA("GuiButton") then return n end
		n = n.Parent
	end
	return nil
end

local function wireSquish(btn)
	if not btn:GetAttribute("FigmaSquish") then return end
	if btn:GetAttribute("FW_Squish") then return end
	btn:SetAttribute("FW_Squish", true)
	slotFor(btn)
	centreAnchor(btn)
	local base = nil
	local tw = nil
	local function squash(on)
		if base == nil then base = btn.Size end
		local amp = (btn:GetAttribute("SquishAmp") or btn:GetAttribute("FigmaSquishAmp") or 10) / 100
		local t = btn:GetAttribute("SquishTime") or btn:GetAttribute("FigmaSquishTime") or 0.18
		if tw then tw:Cancel() end
		local target = on
			and UDim2.new(base.X.Scale * (1 + amp), base.X.Offset * (1 + amp), base.Y.Scale * (1 - amp), base.Y.Offset * (1 - amp))
			or base
		tw = TweenService:Create(btn, TweenInfo.new(on and t / 3 or t, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = target })
		tw:Play()
	end
	btn.MouseButton1Down:Connect(function() squash(true) end)
	btn.MouseButton1Up:Connect(function() squash(false) end)
	btn.MouseLeave:Connect(function() if base and btn.Size ~= base then squash(false) end end)
end

local function wireRipple(btn)
	if not btn:GetAttribute("FigmaRipple") then return end
	if btn:GetAttribute("FW_Ripple") then return end
	btn:SetAttribute("FW_Ripple", true)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local host = Instance.new("Frame")
		host.BackgroundTransparency = 1
		host.Size = UDim2.fromScale(1, 1)
		host.ClipsDescendants = true
		host:SetAttribute("FW_Owned", true)
		local corner = btn:FindFirstChildWhichIsA("UICorner")
		if corner then corner:Clone().Parent = host end
		local top = btn.ZIndex -- above the button's own content, or the wash hides under it
		for _, d in ipairs(btn:GetChildren()) do
			if d:IsA("GuiObject") and d.ZIndex > top then top = d.ZIndex end
		end
		host.ZIndex = top + 1
		host.Parent = btn
		local c = btn:GetAttribute("RippleColor") or btn:GetAttribute("FigmaRippleColor") or 16777215
		local op = btn:GetAttribute("RippleOp") or btn:GetAttribute("FigmaRippleOp") or 0.4
		local t = btn:GetAttribute("RippleTime") or btn:GetAttribute("FigmaRippleTime") or 0.45
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.BorderSizePixel = 0
		dot.BackgroundColor3 = Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256)
		dot.BackgroundTransparency = 1 - op
		dot.Position = UDim2.fromOffset(input.Position.X - btn.AbsolutePosition.X, input.Position.Y - btn.AbsolutePosition.Y)
		dot.Size = UDim2.fromOffset(0, 0)
		local round = Instance.new("UICorner")
		round.CornerRadius = UDim.new(1, 0)
		round.Parent = dot
		dot.Parent = host
		local sz = btn.AbsoluteSize -- reach the farthest corner from the touch, no further
		local px = input.Position.X - btn.AbsolutePosition.X
		local py = input.Position.Y - btn.AbsolutePosition.Y
		local far = math.sqrt(math.max(px, sz.X - px) ^ 2 + math.max(py, sz.Y - py) ^ 2)
		local m = far * 2 -- diameter
		dot.ZIndex = host.ZIndex
		TweenService:Create(dot, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.fromOffset(m, m) }):Play()
		TweenService:Create(dot, TweenInfo.new(t * 0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.In), -- fades as it travels
			{ BackgroundTransparency = 1 }):Play()
		task.delay(t + 0.1, function() host:Destroy() end)
	end)
end

local function wireLean(el)
	if not el:GetAttribute("FigmaLean") then return end
	if el:GetAttribute("FW_Lean") then return end
	el:SetAttribute("FW_Lean", true)
	local card = cardAround(el)
	if not card then return end
	local knob = Instance.new("NumberValue") -- rotation goes through the compositor
	knob.Name = "FW_LeanKnob"
	knob:SetAttribute("FW_Owned", true)
	knob.Parent = el
	knob.Changed:Connect(function() fwRotSet(el, "r_hover", knob.Value) end)
	local function lean(on)
		local a = el:GetAttribute("LeanAngle")
		if type(a) ~= "number" then a = el:GetAttribute("FigmaLeanAngle") end
		if type(a) ~= "number" then a = LEAN_ANGLE end
		local t = el:GetAttribute("LeanTime")
		if type(t) ~= "number" then t = el:GetAttribute("FigmaLeanTime") end
		if type(t) ~= "number" then t = LEAN_TIME end
		TweenService:Create(knob, TweenInfo.new(t, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Value = on and a or 0 }):Play()
	end
	local hovered = false
	card.MouseEnter:Connect(function() hovered = true; lean(true) end)
	card.MouseLeave:Connect(function() hovered = false; lean(false) end)
	onScrollMoved(el, function()
		if hovered then hovered = false; lean(false) end
	end)
end

local COLOR_PROP = { -- what paints each class (same rule as the Color runtime)
	Frame = "BackgroundColor3", ScrollingFrame = "BackgroundColor3", CanvasGroup = "BackgroundColor3",
	ImageLabel = "ImageColor3", ImageButton = "ImageColor3",
	TextLabel = "TextColor3", TextButton = "TextColor3", TextBox = "TextColor3",
}
local function hexColor(n)
	if type(n) ~= "number" or n < 0 then return nil end
	return Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
end
local function hoverCoat(el, c1, c2, angle) -- a copy of the layer that carries the gradient and fades over the original
	local coat = el:FindFirstChild("FW_HoverCoat")
	if coat then return coat end
	local fadeProp = "BackgroundTransparency"
	if (el:IsA("TextLabel") or el:IsA("TextButton") or el:IsA("TextBox")) and el.Text ~= "" then
		coat = Instance.new("TextLabel")
		coat.Text = el.Text
		coat.RichText = el.RichText == true
		coat.FontFace = el.FontFace
		coat.TextScaled = el.TextScaled == true
		coat.TextSize = el.TextSize
		coat.TextWrapped = el.TextWrapped == true
		coat.LineHeight = el.LineHeight
		coat.TextXAlignment = el.TextXAlignment
		coat.TextYAlignment = el.TextYAlignment
		coat.TextColor3 = Color3.new(1, 1, 1)
		coat.TextStrokeTransparency = 1
		coat.BackgroundTransparency = 1
		fadeProp = "TextTransparency"
	elseif el:IsA("ImageLabel") or el:IsA("ImageButton") then
		coat = Instance.new("ImageLabel")
		coat.Image = el.Image
		coat.ImageColor3 = Color3.new(1, 1, 1)
		coat.ScaleType = el.ScaleType
		coat.SliceCenter = el.SliceCenter
		coat.SliceScale = el.SliceScale
		coat.TileSize = el.TileSize
		coat.ImageRectOffset = el.ImageRectOffset
		coat.ImageRectSize = el.ImageRectSize
		coat.BackgroundTransparency = 1
		fadeProp = "ImageTransparency"
	else
		coat = Instance.new("Frame")
		coat.BackgroundColor3 = Color3.new(1, 1, 1)
		local corner = el:FindFirstChildOfClass("UICorner")
		if corner then corner:Clone().Parent = coat end
	end
	coat.Name = "FW_HoverCoat"
	coat[fadeProp] = 1
	coat.Size = UDim2.fromScale(1, 1)
	coat.ZIndex = el.ZIndex + 1
	coat:SetAttribute("FW_Owned", true)
	coat:SetAttribute("FW_FadeProp", fadeProp)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = angle
	g:SetAttribute("FW_Owned", true)
	g.Parent = coat
	coat.Parent = el
	if fadeProp == "TextTransparency" then -- the text scaler resizes the label later: the copy follows it
		for _, prop in ipairs({ "Text", "TextSize", "TextScaled" }) do
			el:GetPropertyChangedSignal(prop):Connect(function() coat[prop] = el[prop] end)
		end
	end
	return coat
end
local function wireHoverColor(el) -- _color inside a button: the picked colour is the HOVER colour, rest is as drawn
	if not el:GetAttribute("FigmaColor") then return end
	if el:GetAttribute("FW_HoverColor") then return end
	local card = el:IsA("GuiButton") and el or cardAround(el)
	if not card then return end
	local prop = COLOR_PROP[el.ClassName]
	if prop == "TextColor3" then
		local ok, txt = pcall(function() return el.Text end)
		if ok and txt == "" then prop = "BackgroundColor3" end -- a button shell holds no text: its fill IS its colour
	end
	if not prop then return end
	local function hoverColor()
		local c = el:GetAttribute("HoverColor")
		if typeof(c) == "Color3" then return c end
		return hexColor(el:GetAttribute("FigmaColorPick"))
	end
	local function secondColor()
		local c = el:GetAttribute("HoverColor2")
		if typeof(c) == "Color3" then return c end
		return hexColor(el:GetAttribute("FigmaColorPick2"))
	end
	if not hoverColor() then return end
	el:SetAttribute("FW_HoverColor", true)
	local rest = el[prop] -- the design's colour, read BEFORE any hover dim has touched the layer
	el:GetAttributeChangedSignal("Color"):Connect(function() -- code repainted the slot: that is the rest colour now
		local c = el:GetAttribute("Color")
		if typeof(c) == "Color3" then rest = c end
	end)
	local function secs(on)
		local t = el:GetAttribute(on and "ColorIn" or "ColorOut")
		if type(t) ~= "number" then t = el:GetAttribute(on and "FigmaColorIn" or "FigmaColorOut") end
		if type(t) ~= "number" then t = on and LEAN_TIME or 0.25 end -- leaving is slower than arriving, like a real glow cooling
		return math.max(0, t)
	end
	local function paint(on)
		local info = TweenInfo.new(secs(on), Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local c1, c2 = hoverColor(), secondColor()
		if c2 then -- a gradient: a copy of the layer carrying it fades over the original
			local angle = el:GetAttribute("HoverAngle")
			if type(angle) ~= "number" then angle = el:GetAttribute("FigmaColorAngle") or 0 end
			local coat = hoverCoat(el, c1, c2, angle)
			local g = coat:FindFirstChildOfClass("UIGradient")
			if g then g.Color = ColorSequence.new(c1, c2); g.Rotation = angle end
			TweenService:Create(coat, info, { [coat:GetAttribute("FW_FadeProp")] = on and 0 or 1 }):Play()
			return
		end
		local goal = on and c1 or rest
		TweenService:Create(el, info, { [prop] = goal }):Play()
	end
	local hovered = false
	card.MouseEnter:Connect(function() hovered = true; paint(true) end)
	card.MouseLeave:Connect(function() hovered = false; paint(false) end)
	onScrollMoved(el, function()
		if hovered then hovered = false; paint(false) end
	end)
end

local function wireTurn(btn)
	if not btn:GetAttribute("FigmaTurn") then return end
	if btn:GetAttribute("FW_Turn") then return end -- DescendantAdded re-fires on every reparent
	btn:SetAttribute("FW_Turn", true)
	slotFor(btn)
	local knob = Instance.new("NumberValue") -- rotation goes through the compositor
	knob.Name = "FW_TurnKnob"
	knob:SetAttribute("FW_Owned", true)
	knob.Parent = btn
	knob.Changed:Connect(function() fwRotSet(btn, "r_hover", knob.Value) end)
	local function turn(on)
		local a = btn:GetAttribute("TurnAngle")
		if type(a) ~= "number" then a = btn:GetAttribute("FigmaTurnAngle") end
		if type(a) ~= "number" then a = TURN_ANGLE end
		local t = btn:GetAttribute("TurnTime")
		if type(t) ~= "number" then t = btn:GetAttribute("FigmaTurnTime") end
		if type(t) ~= "number" then t = TURN_TIME end
		TweenService:Create(knob, TweenInfo.new(t, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Value = on and a or 0 }):Play()
	end
	local hovered = false
	btn.MouseEnter:Connect(function() hovered = true; turn(true) end)
	btn.MouseLeave:Connect(function() hovered = false; turn(false) end)
	onScrollMoved(btn, function()
		if hovered then hovered = false; turn(false) end
	end)
end

local function wireLift(btn)
	if not btn:GetAttribute("FigmaUp") then return end
	if btn:GetAttribute("FW_Lift") then return end
	btn:SetAttribute("FW_Lift", true)
	slotFor(btn)
	local base = nil
	local function px()
		local r = gui:FindFirstChildWhichIsA("GuiObject")
		if not r then
			for _, v in ipairs(gui:GetChildren()) do
				if v:IsA("BillboardGui") then -- clickable _billboard: kept inside this ScreenGui
					r = v:FindFirstChildWhichIsA("GuiObject")
					break
				end
				if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
					r = v.Value:FindFirstChildWhichIsA("GuiObject")
					break
				end
			end
		end
		local dh = gui:GetAttribute("BB_DesignH")
		if r and type(dh) == "number" and dh > 0 and r.AbsoluteSize.Y > 1 then return r.AbsoluteSize.Y / dh end
		return 1
	end
	local function lift(on)
		local d = btn:GetAttribute("UpDist")
		if type(d) ~= "number" then d = btn:GetAttribute("FigmaUpDist") end
		if type(d) ~= "number" then d = UP_DIST end
		local t = btn:GetAttribute("UpTime")
		if type(t) ~= "number" then t = btn:GetAttribute("FigmaUpTime") end
		if type(t) ~= "number" then t = UP_TIME end
		local info = TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		if not base then base = btn.Position end
		local goal = on and (base + UDim2.fromOffset(0, -d * px())) or base
