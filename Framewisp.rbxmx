	local recolour = Instance.new("LocalScript")
	recolour.Name = "FramewispColor"
	recolour.Source = [==[
-- Framewisp: _color — the layer's colour belongs to the game.
-- el:SetAttribute("Color", Color3.fromRGB(255, 0, 0)) repaints it: the fill of a
-- frame, the tint of a picture, the ink of a label. A picture is tinted by
-- MULTIPLYING, so white art takes any colour and coloured art only darkens.
-- Safe to delete: the layer keeps the colour the design gave it.
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end

local PROP = {
	Frame = "BackgroundColor3", ScrollingFrame = "BackgroundColor3", CanvasGroup = "BackgroundColor3",
	ImageLabel = "ImageColor3", ImageButton = "ImageColor3",
	TextLabel = "TextColor3", TextButton = "TextColor3", TextBox = "TextColor3",
}

local function propFor(el)
	local prop = PROP[el.ClassName]
	if prop == "TextColor3" then
		local ok, txt = pcall(function() return el.Text end)
		if ok and txt == "" then return "BackgroundColor3" end -- a button shell holds no text: its fill IS its colour
	end
	return prop
end

local function paint(el, prop)
	local c = el:GetAttribute("Color")
	if typeof(c) == "ColorSequence" then -- the whole gradient, stops and all
		local g = el:FindFirstChildOfClass("UIGradient")
		if g then g.Color = c end
		return
	end
	if typeof(c) ~= "Color3" then return end
	pcall(function() el[prop] = c end) -- on a gradient layer this TINTS it: the gradient multiplies into the base colour
end

for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaColor") ~= nil and d:IsA("GuiObject") then
		local prop = propFor(d)
		if prop then
			if d:GetAttribute("Color") == nil then -- an older import never got the seed
				local g = d:FindFirstChildOfClass("UIGradient")
				local ok, cur = pcall(function() return g and g.Color or d[prop] end)
				if ok and (typeof(cur) == "Color3" or typeof(cur) == "ColorSequence") then d:SetAttribute("Color", cur) end
			end
			paint(d, prop)
			d:GetAttributeChangedSignal("Color"):Connect(function() paint(d, prop) end)
		end
	end
end
]==]
	stampRuntime(recolour)
