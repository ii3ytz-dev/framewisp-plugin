                local started = time()
                while object.Parent and time() - started < duration do
                    local decay = 1 - (time() - started) / duration
                    object.Position = base + UDim2.fromOffset((math.random() * 2 - 1) * amplitude * decay, (math.random() * 2 - 1) * amplitude * decay)
