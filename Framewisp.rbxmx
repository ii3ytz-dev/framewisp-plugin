	focus.Source = [==[
-- Framewisp: _focus — opening this panel focuses the world behind it.
-- The camera pushes in, Lighting picks up a blur, and the world can dim; closing
-- the panel puts all three back. Attributes: FocusFov (degrees ADDED to the
-- game's own field of view, negative pushes in), FocusBlur, FocusDim (0-1),
-- FocusTime (seconds). Safe to delete: the world stops reacting, nothing else.
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function attr(el, key, def)
	local v = el:GetAttribute(key)
	if type(v) ~= "number" then v = el:GetAttribute("Figma" .. key) end
	return type(v) == "number" and v or def
end

local open = {} -- one shared set of world effects, however many panels are open
local openCount = 0
local blur, dim
local baseFov, fovOwned = nil, false
local function cam() return workspace.CurrentCamera end

local function ensure()
	if not blur or not blur.Parent then
		blur = Lighting:FindFirstChild("FW_FocusBlur") or Instance.new("BlurEffect")
		blur.Name = "FW_FocusBlur"
		blur.Size = 0
		blur.Enabled = true
		blur.Parent = Lighting
	end
	if not dim or not dim.Parent then
		dim = Lighting:FindFirstChild("FW_FocusDim") or Instance.new("ColorCorrectionEffect")
		dim.Name = "FW_FocusDim"
		dim.Brightness = 0
		dim.Enabled = true
		dim.Parent = Lighting
	end
end

local function settle() -- strongest open panel wins; none open = the world back
	local fov, bl, dm, t = 0, 0, 0, 0.3
	for panel in pairs(open) do
		if panel.Parent then
			local f = attr(panel, "FocusFov", -8)
			if math.abs(f) > math.abs(fov) then fov = f end
			bl = math.max(bl, attr(panel, "FocusBlur", 18))
			dm = math.max(dm, attr(panel, "FocusDim", 0))
			t = math.max(0.05, attr(panel, "FocusTime", 0.35))
		end
	end
	ensure()
	local info = TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(blur, info, { Size = bl }):Play()
	TweenService:Create(dim, info, { Brightness = -dm * 0.5 }):Play()
	local c = cam()
	if not c then return end
	if openCount > 0 then
		if not fovOwned then baseFov, fovOwned = c.FieldOfView, true end
		TweenService:Create(c, info, { FieldOfView = math.clamp(baseFov + fov, 1, 120) }):Play()
	elseif fovOwned then
		local back = baseFov
		fovOwned, baseFov = false, nil
		TweenService:Create(c, info, { FieldOfView = back }):Play()
	end
end

local function setOpen(panel, on)
	if on == (open[panel] == true) then return end
	if on then open[panel] = true; openCount = openCount + 1
	else open[panel] = nil; openCount = math.max(0, openCount - 1) end
	settle()
end

local function wire(el)
	if not el:IsA("GuiObject") then return end
	if el:GetAttribute("FigmaFocus") == nil or el:GetAttribute("FW_Focus") then return end
	el:SetAttribute("FW_Focus", true)
	local function shown()
		if not gui.Enabled then return false end
		local n = el
		while n and n ~= gui do
			if n:IsA("GuiObject") and not n.Visible then return false end
			n = n.Parent
		end
		return el.Parent ~= nil
	end
	local hooks = {} -- one Visible hook per ancestor: _close hides the PANEL, not the tagged layer
	local rehook
	local function refresh() setOpen(el, shown()) end
	rehook = function()
		for _, c in ipairs(hooks) do c:Disconnect() end
		hooks = {}
		local n = el
		while n and n ~= gui do
			if n:IsA("GuiObject") then
				hooks[#hooks + 1] = n:GetPropertyChangedSignal("Visible"):Connect(refresh)
			end
			n = n.Parent
		end
		hooks[#hooks + 1] = gui:GetPropertyChangedSignal("Enabled"):Connect(refresh)
		refresh()
	end
	el.AncestryChanged:Connect(function()
		if not el:IsDescendantOf(game) then
			for _, c in ipairs(hooks) do c:Disconnect() end
			hooks = {}
			setOpen(el, false)
		else
			rehook()
		end
	end)
	rehook()
end
for _, d in ipairs(fwAll()) do wire(d) end
for _, r in ipairs(fwRoots()) do r.DescendantAdded:Connect(wire) end

script.Destroying:Connect(function() -- never leave the world blurred
	if blur then blur:Destroy() end
	if dim then dim:Destroy() end
	local c = cam()
	if c and fovOwned and baseFov then c.FieldOfView = baseFov end
end)
