selText.TextColor3 = COL.dim
selText.TextXAlignment = Enum.TextXAlignment.Left
selText.TextTruncate = Enum.TextTruncate.AtEnd
selText.Size = UDim2.new(1, -24, 1, 0)
selText.Parent = selChip

-- ---- POSITION & SIZE (visual editor) ----------------------------------------
local ps = card("Position & size")

-- editor state: the element's box as fractions of its parent (top-left based)
local curX, curY, curW, curH = 0, 0, 0.5, 0.5
-- size is written responsive (Scale, holds at any screen size) by default; the
-- user can switch to fixed pixels. Position is ALWAYS Scale.
local sizeMode = "scale" -- "scale" | "offset"
-- true when the selected element has a UIAspectRatioConstraint — resize must
-- keep the ratio so the box matches what Roblox actually renders
local aspectLocked = false
local fX, fY, fW, fH -- numeric fields (declared early for applyToElement)
local syncKnob -- set by the slider block

local stageWrap = Instance.new("Frame")
stageWrap.BackgroundTransparency = 1
stageWrap.Size = UDim2.new(1, 0, 0, 150)
stageWrap.LayoutOrder = 1
stageWrap.Parent = ps
local stage = Instance.new("Frame")
stage.AnchorPoint = Vector2.new(0.5, 0.5)
stage.Position = UDim2.fromScale(0.5, 0.5)
stage.Size = UDim2.new(1, 0, 1, 0)
stage.BackgroundColor3 = COL.field
stage.BorderSizePixel = 0
stage.Parent = stageWrap
corner(stage, 8)

stage.ClipsDescendants = true -- the box can never fly outside the stage
local stageRatio = Instance.new("UIAspectRatioConstraint")
stageRatio.AspectRatio = 1.6
stageRatio.AspectType = Enum.AspectType.FitWithinMaxSize
stageRatio.Parent = stage
UI.emptyStage = UI.text(stage, "Select an element in Explorer\nto move and resize it here.", 12, COL.dim, UDim2.new(0, 16, 0.5, -24), UDim2.new(1, -32, 0, 48))
UI.emptyStage.TextXAlignment = Enum.TextXAlignment.Center
UI.emptyStage.TextWrapped = true

-- dashed guide lines — rebuilt whenever the stage is laid out (pro-editor look)
local guideRebuilds = {}
local function dashedLine(horizontal, colr, thick, zi)
	thick = thick or 1
	zi = zi or 0
	local c = Instance.new("Frame")
	c.BackgroundTransparency = 1
	c.BorderSizePixel = 0
	c.ZIndex = zi
	c.Parent = stage
	local function rebuild()
		-- AbsoluteSize already includes the UIScale; divide it back out so the
		-- dashes are generated in the container's own (unscaled) space and stay
		-- even at any dock width
		local raw = horizontal and c.AbsoluteSize.X or c.AbsoluteSize.Y
		local len = raw / math.max(uiScale.Scale, 0.01)
		if len < 2 then return end
		c:ClearAllChildren()
		local step = 8
		local n = math.floor(len / step)
		for i = 0, n - 1 do
			local seg = Instance.new("Frame")
			seg.BorderSizePixel = 0
			seg.BackgroundColor3 = colr
			seg.ZIndex = zi
			if horizontal then
				seg.Size = UDim2.fromOffset(5, thick)
				seg.Position = UDim2.fromOffset(i * step, 0)
			else
				seg.Size = UDim2.fromOffset(thick, 5)
				seg.Position = UDim2.fromOffset(0, i * step)
			end
			seg.Parent = c
		end
	end
	table.insert(guideRebuilds, rebuild)
	return c
end
local function rebuildGuides()
	for _, fn in ipairs(guideRebuilds) do
		fn()
	end
end
-- Smart centre guides (V + H): HIDDEN until the box is dragged near the parent
-- centre, then they light up and snap it exactly — like Figma. Bright, 2px,
-- drawn above the box (ZIndex 2).
local GUIDE_MID = Color3.fromRGB(160, 130, 255)
local gV = dashedLine(false, GUIDE_MID, 2, 2)
gV.AnchorPoint = Vector2.new(0.5, 0.5); gV.Position = UDim2.fromScale(0.5, 0.5); gV.Size = UDim2.new(0, 2, 1, -6)
gV.Visible = false
local gH = dashedLine(true, GUIDE_MID, 2, 2)
gH.AnchorPoint = Vector2.new(0.5, 0.5); gH.Position = UDim2.fromScale(0.5, 0.5); gH.Size = UDim2.new(1, -6, 0, 2)
gH.Visible = false
stage:GetPropertyChangedSignal("AbsoluteSize"):Connect(rebuildGuides)
task.defer(rebuildGuides)

local box = Instance.new("Frame")
box.Active = true
box.BackgroundColor3 = COL.accent
box.BackgroundTransparency = 0.72
box.Size = UDim2.fromScale(curW, curH)
box.Position = UDim2.fromScale(curX, curY)
box.Parent = stage
corner(box, 4)
stroke(box, COL.accent, 1.5)

local function stagePx()
	return stage.AbsoluteSize
end
local function drawBox()
	-- keep the box fully inside the stage (no flying off) — this also stops the
	-- element from being dragged outside its parent
	curW = math.clamp(curW, 0.02, 1)
	curH = math.clamp(curH, 0.02, 1)
	curX = math.clamp(curX, 0, 1 - curW)
	curY = math.clamp(curY, 0, 1 - curH)
	box.Position = UDim2.fromScale(curX, curY)
	box.Size = UDim2.fromScale(curW, curH)
end
-- Parent's usable rect in absolute screen px: (origin top-left, size).
-- For a ScreenGui/LayerCollector with IgnoreGuiInset=false the 36px topbar inset
-- is baked into every child's AbsolutePosition and into Scale positioning, so we
-- must account for it here or scale positions double-count it and drift downward.
local GuiService = game:GetService("GuiService")
local function parentRect(g)
	local p = g.Parent
	if p and p:IsA("GuiObject") then
		return p.AbsolutePosition, p.AbsoluteSize
	end
	local origin = Vector2.new(0, 0)
	local shrink = Vector2.new(0, 0)
	if p and p:IsA("ScreenGui") and not p.IgnoreGuiInset then -- only a ScreenGui has an inset
		local tl, br = GuiService:GetGuiInset()
		origin = tl
		shrink = tl + br
	end
	local base
	if p and p:IsA("LayerCollector") then
		base = p.AbsoluteSize
	else
		local cam = workspace.CurrentCamera
		base = (cam and cam.ViewportSize) or Vector2.new(1280, 720)
	end
	local size = base - shrink
	size = Vector2.new(math.max(1, size.X), math.max(1, size.Y))
	return origin, size
end
local function applyToElement()
	local g = firstSelectedGui()
	if not g then return end
	local _, pp = parentRect(g)
	local a = g.AnchorPoint
	-- position is SCALE (responsive): the anchor sits at this parent fraction.
	-- top-left is (curX,curY); anchor point adds a fraction of the size.
	local posX = curX + a.X * curW
	local posY = curY + a.Y * curH
	if sizeMode == "offset" then
		g.Size = UDim2.fromOffset(math.max(1, math.round(curW * pp.X)), math.max(1, math.round(curH * pp.Y)))
	else
		g.Size = UDim2.fromScale(curW, curH)
	end
	g.Position = UDim2.fromScale(posX, posY)
	if fX then
		fX.Text = string.format("%.3f", posX)
		fY.Text = string.format("%.3f", posY)
		if sizeMode == "offset" then
			fW.Text = tostring(math.round(curW * pp.X))
			fH.Text = tostring(math.round(curH * pp.Y))
		else
			fW.Text = string.format("%.3f", curW)
			fH.Text = string.format("%.3f", curH)
		end
	end
end
local function readFromElement()
	local g = firstSelectedGui()
	if not g or not g.Parent then return end
	local origin, pp = parentRect(g)
	if pp.X <= 0 or pp.Y <= 0 then return end
	curX = (g.AbsolutePosition.X - origin.X) / pp.X
	curY = (g.AbsolutePosition.Y - origin.Y) / pp.Y
	curW = g.AbsoluteSize.X / pp.X
	curH = g.AbsoluteSize.Y / pp.Y
	aspectLocked = g:FindFirstChildWhichIsA("UIAspectRatioConstraint") ~= nil
	stageRatio.AspectRatio = math.clamp(pp.X / pp.Y, 0.4, 3)
	drawBox()
	if fX then
		local a = g.AnchorPoint
		fX.Text = string.format("%.3f", curX + a.X * curW)
		fY.Text = string.format("%.3f", curY + a.Y * curH)
		if sizeMode == "offset" then
			fW.Text = tostring(math.round(g.AbsoluteSize.X))
			fH.Text = tostring(math.round(g.AbsoluteSize.Y))
		else
			fW.Text = string.format("%.3f", curW)
			fH.Text = string.format("%.3f", curH)
		end
	end
	if syncKnob then syncKnob() end
end

-- one undo record spans a whole drag; direct property writes in between
local dragRec
local function beginDrag()
	if firstSelectedGui() then
		dragRec = ChangeHistoryService:TryBeginRecording("Move/resize")
		return true
	end
	setStatus("Select a UI element first.", COL.err)
	return false
end
local function endDrag()
	if dragRec then
		ChangeHistoryService:FinishRecording(dragRec, Enum.FinishRecordingOperation.Commit)
		dragRec = nil
	end
end

-- Drag machinery: a full-widget invisible overlay reliably captures mouse
-- movement + release during a drag (GuiObject input fires in plugin widgets;
-- UserInputService does not for docked widgets). One drag at a time.
local dragOverlay = Instance.new("TextButton")
dragOverlay.Text = ""
dragOverlay.AutoButtonColor = false
dragOverlay.BackgroundTransparency = 1
dragOverlay.Size = UDim2.fromScale(1, 1)
dragOverlay.ZIndex = 50
dragOverlay.Active = true
dragOverlay.Visible = false
dragOverlay.Parent = tbg
local dragMove -- function(mousePos) while dragging, else nil
local function endSession()
	if not dragMove then return end
	dragMove = nil
	dragOverlay.Visible = false
	gV.Visible = false
	gH.Visible = false
	endDrag()
	if syncKnob then syncKnob() end
end
dragOverlay.InputChanged:Connect(function(input)
	if dragMove and input.UserInputType == Enum.UserInputType.MouseMovement then
		dragMove(input.Position)
	end
end)
dragOverlay.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		endSession()
	end
end)
-- Backstop: the mouse-button release can be delivered to the object the press
-- STARTED on (the box/handle), not the overlay, so also end on a global mouse-up.
local UserInputService = game:GetService("UserInputService")
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		endSession()
	end
end)

-- onMove(dx, dy) gets the per-frame delta in stage fractions
local function bindDrag(obj, onMove)
	obj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not dragMove then
			if not beginDrag() then return end
			local last = input.Position
			dragMove = function(pos)
				local sp = stagePx()
				if sp.X > 0 and sp.Y > 0 then
					onMove((pos.X - last.X) / sp.X, (pos.Y - last.Y) / sp.Y)
					drawBox()
					applyToElement()
				end
				last = pos
			end
			dragOverlay.Visible = true
		end
	end)
	-- release on the object the press began on, in case it captured the input
	obj.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			endSession()
		end
	end)
end

bindDrag(box, function(dx, dy)
	curX = math.clamp(curX + dx, -0.5, 1.5)
	curY = math.clamp(curY + dy, -0.5, 1.5)
	-- auto-centre: when the box centre gets close to the stage centre, snap it
	-- exactly there and light up the guide (hidden otherwise)
	local SNAP = 0.022
	if math.abs((curX + curW / 2) - 0.5) <= SNAP then
		curX = 0.5 - curW / 2
		gV.Visible = true
	else
		gV.Visible = false
	end
	if math.abs((curY + curH / 2) - 0.5) <= SNAP then
		curY = 0.5 - curH / 2
		gH.Visible = true
	else
		gH.Visible = false
	end
end)

local HANDLES = {
	{ ex = -1, ey = -1, px = 0, py = 0 },
	{ ex = 0, ey = -1, px = 0.5, py = 0 },
	{ ex = 1, ey = -1, px = 1, py = 0 },
	{ ex = -1, ey = 0, px = 0, py = 0.5 },
	{ ex = 1, ey = 0, px = 1, py = 0.5 },
	{ ex = -1, ey = 1, px = 0, py = 1 },
	{ ex = 0, ey = 1, px = 0.5, py = 1 },
	{ ex = 1, ey = 1, px = 1, py = 1 },
}
for _, hd in ipairs(HANDLES) do
	local dot = Instance.new("Frame")
	dot.Active = true
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(hd.px, hd.py)
	dot.Size = UDim2.fromOffset(9, 9)
	dot.BackgroundColor3 = COL.text
	dot.ZIndex = 3
	dot.Parent = box
	corner(dot, 3)
	stroke(dot, COL.accent, 1.5)
	bindDrag(dot, function(dx, dy)
		if aspectLocked then
			-- keep the ratio so the box tracks the real (constrained) frame:
			-- resize uniformly, anchored at the opposite corner/edge
			local ratio = curW / math.max(curH, 1e-4)
			local dW = (hd.ex ~= 0) and (dx * hd.ex) or (dy * hd.ey * ratio)
			local newW = math.max(0.02, curW + dW)
			local newH = math.max(0.02, newW / ratio)
			local anchorX = curX + (1 - hd.px) * curW
			local anchorY = curY + (1 - hd.py) * curH
			curW, curH = newW, newH
			curX = anchorX - (1 - hd.px) * newW
			curY = anchorY - (1 - hd.py) * newH
			return
		end
		if hd.ex == 1 then
			curW = curW + dx
		elseif hd.ex == -1 then
			curX = curX + dx
			curW = curW - dx
		end
		if hd.ey == 1 then
			curH = curH + dy
		elseif hd.ey == -1 then
			curY = curY + dy
			curH = curH - dy
		end
	end)
end

-- scale slider (uniform, keeps aspect + centre)
local sliderTrack = Instance.new("Frame")
sliderTrack.BackgroundColor3 = COL.bg
sliderTrack.Size = UDim2.new(1, 0, 0, 6)
sliderTrack.LayoutOrder = 2
sliderTrack.Parent = ps
corner(sliderTrack, 3)
local sliderFill = Instance.new("Frame")
sliderFill.BackgroundColor3 = COL.accent
sliderFill.Size = UDim2.fromScale(0.5, 1)
sliderFill.BorderSizePixel = 0
sliderFill.Parent = sliderTrack
corner(sliderFill, 3)
local knob = Instance.new("Frame")
knob.Active = true
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.Position = UDim2.fromScale(0.5, 0.5)
knob.Size = UDim2.fromOffset(14, 14)
knob.BackgroundColor3 = COL.text
knob.ZIndex = 2
knob.Parent = sliderTrack
corner(knob, 7)
stroke(knob, COL.accent, 1.5)
do
	local aspect, cx, cy
	local function setKnob(frac)
		frac = math.clamp(frac, 0, 1)
		knob.Position = UDim2.fromScale(frac, 0.5)
		sliderFill.Size = UDim2.fromScale(frac, 1)
	end
	local function applySlider(frac)
		local newW = math.clamp(0.02 + frac * 0.98, 0.02, 1.5)
		local newH = (aspect and aspect > 0) and (newW / aspect) or newW
		newW = math.clamp(newW, 0.02, 1)
		newH = math.clamp(newH, 0.02, 1)
		curW, curH = newW, newH
		curX, curY = cx - newW / 2, cy - newH / 2
		drawBox()
		applyToElement()
	end
	syncKnob = function()
		setKnob(math.clamp((curW - 0.02) / 0.98, 0, 1))
	end
	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not dragMove then
			if not beginDrag() then return end
			aspect = curW / math.max(curH, 0.001)
			cx, cy = curX + curW / 2, curY + curH / 2
			dragMove = function(pos)
				local w = sliderTrack.AbsoluteSize.X
				if w > 0 then
					local frac = math.clamp((pos.X - sliderTrack.AbsolutePosition.X) / w, 0, 1)
					setKnob(frac)
					applySlider(frac)
				end
			end
			dragOverlay.Visible = true
		end
	end)
	knob.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			endSession()
		end
	end)
	syncKnob()
end

-- numeric fields (exact input)
local psGrid = Instance.new("Frame")
psGrid.BackgroundTransparency = 1
psGrid.Size = UDim2.new(1, 0, 0, 0)
psGrid.AutomaticSize = Enum.AutomaticSize.Y
psGrid.LayoutOrder = 3
psGrid.Parent = ps
local psLayout = Instance.new("UIGridLayout")
psLayout.CellSize = UDim2.new(0.5, -4, 0, 32)
psLayout.CellPadding = UDim2.fromOffset(8, 8)
psLayout.SortOrder = Enum.SortOrder.LayoutOrder
psLayout.Parent = psGrid

local function fieldCell(letter, order)
	local cell = Instance.new("Frame")
	cell.BackgroundTransparency = 1
	cell.LayoutOrder = order
	cell.Parent = psGrid
	local h = Instance.new("UIListLayout")
	h.FillDirection = Enum.FillDirection.Horizontal
	h.VerticalAlignment = Enum.VerticalAlignment.Center
	h.Padding = UDim.new(0, 5)
	h.Parent = cell
	local lab = Instance.new("TextLabel")
	lab.BackgroundTransparency = 1
	lab.Font = Enum.Font.GothamBold
	lab.Text = letter
	lab.TextSize = 12
	lab.TextColor3 = COL.dim
	lab.Size = UDim2.fromOffset(15, 26)
	lab.Parent = cell
	local b = Instance.new("TextBox")
	b.Text = ""
	b.PlaceholderText = "-"
	b.ClearTextOnFocus = false
	b.Font = Enum.Font.Code
	b.TextSize = 13
	b.TextColor3 = COL.text
	b.PlaceholderColor3 = COL.dim
	b.BackgroundColor3 = COL.field
	b.Size = UDim2.new(1, -20, 0, 26)
	b.Parent = cell
	corner(b, 6)
	local st = stroke(b, COL.stroke, 1)
	b.Focused:Connect(function() st.Color = COL.accent end)
	b.FocusLost:Connect(function() st.Color = COL.stroke end)
	return b
end
fX = fieldCell("X", 1)
fY = fieldCell("Y", 2)
fW = fieldCell("W", 3)
fH = fieldCell("H", 4)
local function commitFields()
	local g = firstSelectedGui()
	if not g then return end
	local px, py = tonumber(fX.Text), tonumber(fY.Text) -- scale (0..1)
	local sw, sh = tonumber(fW.Text), tonumber(fH.Text) -- scale OR pixels per sizeMode
	-- fall back to the element's CURRENT scale position (what the field shows),
	-- not its raw Position.Scale, so blanking a field never drops an offset
	local origin, pp = parentRect(g)
	local a = g.AnchorPoint
	local curPX = (g.AbsolutePosition.X - origin.X) / pp.X + a.X * (g.AbsoluteSize.X / pp.X)
	local curPY = (g.AbsolutePosition.Y - origin.Y) / pp.Y + a.Y * (g.AbsoluteSize.Y / pp.Y)
	record("Edit position/size", function()
		g.Position = UDim2.fromScale(px or curPX, py or curPY)
		if sizeMode == "offset" then
			g.Size = UDim2.fromOffset(
				sw or math.round(g.AbsoluteSize.X),
				sh or math.round(g.AbsoluteSize.Y))
		else
			g.Size = UDim2.fromScale(
				sw or (g.AbsoluteSize.X / pp.X),
				sh or (g.AbsoluteSize.Y / pp.Y))
		end
	end)
	readFromElement()
end
fX.FocusLost:Connect(commitFields)
fY.FocusLost:Connect(commitFields)
fW.FocusLost:Connect(commitFields)
fH.FocusLost:Connect(commitFields)

-- quick actions
local function quickBtn(label, order)
	local b = Instance.new("TextButton")
	b.Text = label
	b.Font = Enum.Font.Gotham
	b.TextSize = 12
	b.AutoButtonColor = false
	b.TextColor3 = COL.text
	b.BackgroundColor3 = COL.field
	b.Size = UDim2.new(1, 0, 0, 30)
	b.LayoutOrder = order
	b.Parent = ps
	corner(b, 7)
	b.BorderSizePixel = 0
	b.MouseEnter:Connect(function()
		if b:GetAttribute("active") ~= true then b.BackgroundColor3 = COL.stroke end
	end)
	b.MouseLeave:Connect(function()
		if b:GetAttribute("active") ~= true then b.BackgroundColor3 = COL.field end
	end)
	return b
end
quickBtn("Fit to parent", 4).MouseButton1Click:Connect(function()
	local g = firstSelectedGui()
	if not g then setStatus("Select a UI element first.", COL.err) return end
	record("Fit to parent", function()
		g.AnchorPoint = Vector2.new(0, 0)
		g.Position = UDim2.fromScale(0, 0)
		g.Size = UDim2.fromScale(1, 1)
	end)
	readFromElement()
	setStatus("Filled its parent.", COL.ok)
end)
-- SIZE MODE toggle (persistent). Scale = holds at any screen/viewport size;
-- Offset = locked pixels. Default is Scale so edits stay responsive.
local sBtnScale = quickBtn("Size: responsive — fits any screen", 5)
local sBtnOffset = quickBtn("Size: fixed pixels", 6)
local function refreshSizeMode()
	sBtnScale:SetAttribute("active", sizeMode == "scale")
	sBtnOffset:SetAttribute("active", sizeMode == "offset")
	sBtnScale.BackgroundColor3 = (sizeMode == "scale") and COL.accent or COL.field
	sBtnOffset.BackgroundColor3 = (sizeMode == "offset") and COL.accent or COL.field
end
sBtnScale.MouseButton1Click:Connect(function()
	if not firstSelectedGui() then setStatus("Select a UI element first.", COL.err) return end
	sizeMode = "scale"
	refreshSizeMode()
	record("Size to Scale", applyToElement)
	readFromElement()
	setStatus("Size is responsive (Scale) — holds at any screen size.", COL.ok)
end)
sBtnOffset.MouseButton1Click:Connect(function()
	if not firstSelectedGui() then setStatus("Select a UI element first.", COL.err) return end
	sizeMode = "offset"
	refreshSizeMode()
	record("Size to Offset", applyToElement)
	readFromElement()
	setStatus("Size is fixed (pixels) — won't scale with the screen.", COL.ok)
end)
refreshSizeMode()

-- ---- ANCHOR ------------------------------------------------------------------
local anchorCard = card("Anchor")
local anchorHint = Instance.new("TextLabel")
anchorHint.BackgroundTransparency = 1
anchorHint.Font = Enum.Font.Gotham
anchorHint.Text = "Snap the element to this spot of its parent — corner, edge or centre. Sets the matching anchor too."
anchorHint.TextSize = 11
anchorHint.TextWrapped = true
anchorHint.TextColor3 = COL.dim
anchorHint.TextXAlignment = Enum.TextXAlignment.Left
anchorHint.Size = UDim2.new(1, 0, 0, 14)
anchorHint.AutomaticSize = Enum.AutomaticSize.Y
anchorHint.LayoutOrder = 1
anchorHint.Parent = anchorCard

local anchorRow = Instance.new("Frame")
anchorRow.BackgroundTransparency = 1
anchorRow.Size = UDim2.new(1, 0, 0, 98)
anchorRow.LayoutOrder = 2
anchorRow.Parent = anchorCard

local anchorBox = Instance.new("Frame")
anchorBox.AnchorPoint = Vector2.new(0.5, 0.5)
anchorBox.Position = UDim2.fromScale(0.5, 0.5)
anchorBox.Size = UDim2.fromOffset(98, 98)
anchorBox.BackgroundColor3 = COL.field
anchorBox.Parent = anchorRow
corner(anchorBox, 10)
stroke(anchorBox, COL.stroke, 1)
local anchorPad = Instance.new("UIPadding")
anchorPad.PaddingLeft = UDim.new(0, 7); anchorPad.PaddingTop = UDim.new(0, 7)
anchorPad.Parent = anchorBox
local ag = Instance.new("UIGridLayout")
ag.CellSize = UDim2.fromOffset(26, 26)
ag.CellPadding = UDim2.fromOffset(3, 3)
ag.SortOrder = Enum.SortOrder.LayoutOrder
ag.Parent = anchorBox

local anchorBtns = {}
local function highlightAnchor()
	local g = firstSelectedGui()
	for _, b in ipairs(anchorBtns) do
		local on = g ~= nil
			and math.abs(b:GetAttribute("ax") - g.AnchorPoint.X) < 0.01
			and math.abs(b:GetAttribute("ay") - g.AnchorPoint.Y) < 0.01
		b:SetAttribute("on", on)
		b.BackgroundColor3 = on and COL.accent or COL.field
		local d = b:FindFirstChild("dot")
		if d then d.BackgroundColor3 = on and COL.text or COL.dim end
	end
end

for i = 0, 8 do
	local cc = i % 3
	local rr = math.floor(i / 3)
	local ax, ay = cc * 0.5, rr * 0.5
	local b = Instance.new("TextButton")
	b.Text = ""
	b.AutoButtonColor = false
	b.BackgroundColor3 = COL.field
	b.LayoutOrder = i + 1
	b.Parent = anchorBox
	b:SetAttribute("ax", ax)
	b:SetAttribute("ay", ay)
	corner(b, 6)
	b.BorderSizePixel = 0
	local dot = Instance.new("Frame")
	dot.Name = "dot"
	dot.AnchorPoint = Vector2.new(ax, ay)
	dot.Position = UDim2.new(ax, (0.5 - ax) * 8, ay, (0.5 - ay) * 8)
	dot.Size = UDim2.fromOffset(7, 7)
	dot.BackgroundColor3 = COL.dim
	dot.Parent = b
	corner(dot, 4)
	anchorBtns[i + 1] = b
	b.MouseEnter:Connect(function()
		if b:GetAttribute("on") ~= true then b.BackgroundColor3 = COL.stroke end
	end)
	b.MouseLeave:Connect(function()
		if b:GetAttribute("on") ~= true then b.BackgroundColor3 = COL.field end
	end)
	b.MouseButton1Click:Connect(function()
		local g = firstSelectedGui()
		if not g then setStatus("Select a UI element first.", COL.err) return end
		record("Snap to parent", function()
			-- move the element to this spot of the parent AND set the anchor there:
			-- anchor (ax,ay) placed at parent scale (ax,ay) sits it flush to that
			-- corner/edge/centre. Pure scale, so no GuiInset double-count.
			g.AnchorPoint = Vector2.new(ax, ay)
			g.Position = UDim2.fromScale(ax, ay)
		end)
		readFromElement()
		highlightAnchor()
		local where = ({ [0] = "left", [0.5] = "centre", [1] = "right" })[ax]
			.. " / " .. ({ [0] = "top", [0.5] = "middle", [1] = "bottom" })[ay]
		setStatus("Snapped to " .. where .. " of parent.", COL.ok)
	end)
end

-- ---- CHANGE ELEMENT TYPE ----------------------------------------------------
-- ---- SCALE <-> OFFSET ---------------------------------------------------------
-- Built inside a function, not just a do-block: a main-chunk local lives to the
-- end of the file and Luau allows 200 registers per function, so a plain scope
-- would still count against that ceiling. Nothing here is needed outside.
;(function()
-- Scale = a share of the parent, so the element holds its place on any screen.
-- Offset = fixed pixels. Each property below is measured against a DIFFERENT
-- reference; converting against the wrong one is the classic way UI drifts.
local function refFor(inst, prop)
	local p = inst.Parent
	local box = (p and p:IsA("GuiObject")) and p.AbsoluteSize or nil
	if not box then
		local cam = workspace.CurrentCamera
		box = cam and cam.ViewportSize or Vector2.new(1, 1)
	end
	if prop == "CanvasSize" then
		-- CanvasSize.Scale is measured against the frame's PARENT, like Size —
		-- not against the scroll frame itself.
		return parentSize(inst)
	end
	-- Children of a ScrollingFrame resolve Scale against the CANVAS, not the
	-- window: converting against the window silently resizes everything.
	if p and p:IsA("ScrollingFrame") then
		box = p.AbsoluteCanvasSize
	end
	return box
end

-- A stroke's "Scale" is the Framewisp scaler's: it draws FigmaStrokeW * k, where
-- k = the design's height on screen now / its height in Figma. So the attribute
-- must hold the DESIGN width. Writing today's pixels there applied k twice — on
-- any screen bigger than the design every outline swelled, and each Scale click
-- swelled it again (report, 29.09.2026). nil = no scaler runs over this stroke.
local function strokeK(st)
	local screen = st:FindFirstAncestorWhichIsA("LayerCollector")
	if not screen then return nil end
	local root = findManagedRoot(screen)
	if not root or not st:IsDescendantOf(root) then return nil end
	local designH = screen:GetAttribute("BB_DesignH") or root:GetAttribute("BB_DesignH")
	if type(designH) ~= "number" or designH <= 0 then return nil end
	local sm = root:FindFirstChild("FW_Scale") or root:FindFirstChild("FramewispSmooth") or root:FindFirstChild("FWActScale")
	local smScale = (sm and sm:IsA("UIScale") and sm.Scale > 0) and sm.Scale or 1
	local k = root.AbsoluteSize.Y / designH / smScale
	return k > 0 and k or nil
end
local function strokeShort(st) -- what Roblox measures a ScaledSize stroke against
	local host = st.Parent
	if not (host and host:IsA("GuiObject")) then return 0 end
	return math.min(host.AbsoluteSize.X, host.AbsoluteSize.Y)
end
local function strokeScaledSize(st)
	local ok, mode = pcall(function() return st.StrokeSizingMode end)
	return ok and mode == Enum.StrokeSizingMode.ScaledSize
end

local function toScaleU(u, ref)
	if ref <= 0 then return u end
	return UDim.new(u.Scale + u.Offset / ref, 0)
end
local function toOffsetU(u, ref)
	return UDim.new(0, math.floor(u.Scale * ref + u.Offset + 0.5))
end
local function convU2(v, refX, refY, toScale)
	if toScale then
		return UDim2.new(toScaleU(v.X, refX), toScaleU(v.Y, refY))
	end
	return UDim2.new(toOffsetU(v.X, refX), toOffsetU(v.Y, refY))
end

-- what the chips can turn on; order is the order they are drawn
-- Rewrite one instance's properties. Returns how many it actually touched.
local function convertInstance(inst, toScale, wants)
	local n = 0
	if inst:IsA("GuiObject") then
		if wants("Position") or wants("Size") then
			local ref = refFor(inst, "Size")
			if wants("Position") then
				inst.Position = convU2(inst.Position, ref.X, ref.Y, toScale)
				n = n + 1
			end
			if wants("Size") then
				inst.Size = convU2(inst.Size, ref.X, ref.Y, toScale)
				n = n + 1
			end
		end
		if wants("CanvasSize") and inst:IsA("ScrollingFrame") then
			local ref = refFor(inst, "CanvasSize")
			inst.CanvasSize = convU2(inst.CanvasSize, ref.X, ref.Y, toScale)
			n = n + 1
		end
	elseif inst:IsA("UIPadding") then
		if wants("Padding") then
			local box = (inst.Parent and inst.Parent:IsA("GuiObject")) and inst.Parent.AbsoluteSize or Vector2.new(1, 1)
			local f = toScale and toScaleU or toOffsetU
			inst.PaddingLeft = f(inst.PaddingLeft, box.X)
			inst.PaddingRight = f(inst.PaddingRight, box.X)
			inst.PaddingTop = f(inst.PaddingTop, box.Y)
			inst.PaddingBottom = f(inst.PaddingBottom, box.Y)
			n = n + 1
		end
	elseif inst:IsA("UIGridLayout") then
		local host = inst.Parent
		local box = (host and host:IsA("ScrollingFrame")) and host.AbsoluteCanvasSize
			or ((host and host:IsA("GuiObject")) and host.AbsoluteSize or Vector2.new(1, 1))
		if wants("CellSize") then
			inst.CellSize = convU2(inst.CellSize, box.X, box.Y, toScale)
			n = n + 1
		end
		if wants("CellPadding") then
			inst.CellPadding = convU2(inst.CellPadding, box.X, box.Y, toScale)
			n = n + 1
		end
	elseif inst:IsA("UIListLayout") then
		if wants("CellPadding") then
			local host = inst.Parent
			local box = (host and host:IsA("GuiObject")) and host.AbsoluteSize or Vector2.new(1, 1)
			local ref = (inst.FillDirection == Enum.FillDirection.Horizontal) and box.X or box.Y
			inst.Padding = toScale and toScaleU(inst.Padding, ref) or toOffsetU(inst.Padding, ref)
			n = n + 1
		end
	elseif inst:IsA("UIStroke") then
		if wants("UIStroke") then
			-- Scale: the outline keeps the width it shows NOW and grows with the UI from
			-- here. Offset: locked pixels, again at the width it shows now.
			if toScale then
				if not strokeScaledSize(inst) then -- already a fraction of its parent: nothing to do
					local k = strokeK(inst)
					if k then
						if inst:GetAttribute("FigmaTextStrokeW") == nil then
							inst:SetAttribute("FigmaStrokeW", inst.Thickness / k)
						end -- a text outline keeps its Figma width: its pixels also carry the label's spill
						inst:SetAttribute("FW_StrokeOwn", nil)
						inst:SetAttribute("FW_StrokeMine", inst.Thickness)
						n = n + 1
					else
						-- no Framewisp scaler runs here (a hand-made UI): Roblox scales it itself
						local short = strokeShort(inst)
						local px = inst.Thickness
						if short > 0 and pcall(function() inst.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize end) then
							inst.Thickness = px / short
							-- the mark every scaler and effect reads: "this Thickness is a fraction"
							inst:SetAttribute("FW_StrokeScaled", true)
							n = n + 1
						end
					end
				end
			else
				if strokeScaledSize(inst) then
					local px = inst.Thickness * strokeShort(inst)
					if px > 0 and pcall(function() inst.StrokeSizingMode = Enum.StrokeSizingMode.FixedSize end) then
						inst.Thickness = px
						inst:SetAttribute("FW_StrokeScaled", nil)
						n = n + 1
					end
				end
				if (inst:GetAttribute("FigmaStrokeW") ~= nil or inst:GetAttribute("FigmaTextStrokeW") ~= nil)
					and not inst:GetAttribute("FW_StrokeOwn") then
					inst:SetAttribute("FW_StrokeOwn", true) -- both scalers leave an owned stroke alone; Scale takes it back
					n = n + 1
				end
			end
		end
	elseif inst:IsA("UICorner") then
		if wants("CornerRadius") then
			local host = inst.Parent
			local box = (host and host:IsA("GuiObject")) and host.AbsoluteSize or Vector2.new(1, 1)
			-- Roblox resolves a corner against the SHORTER side and clamps at half
			local side = math.max(1, math.min(box.X, box.Y))
			inst.CornerRadius = toScale and toScaleU(inst.CornerRadius, side) or toOffsetU(inst.CornerRadius, side)
			n = n + 1
		end
	end
	return n
end

local soCard = card("Scale & offset")

-- Scale | Offset — the direction the chosen property is converted to.
local soMode = "scale"
local soSeg = Instance.new("Frame")
soSeg.BackgroundTransparency = 1
soSeg.Size = UDim2.new(1, 0, 0, 30)
soSeg.LayoutOrder = 1
soSeg.Parent = soCard
local soSegLay = Instance.new("UIListLayout")
soSegLay.FillDirection = Enum.FillDirection.Horizontal
soSegLay.Padding = UDim.new(0, 8)
soSegLay.Parent = soSeg

local soBtnScale, soBtnOffset
local function paintMode()
	soBtnScale.BackgroundColor3 = (soMode == "scale") and COL.accent or COL.field
	soBtnOffset.BackgroundColor3 = (soMode == "offset") and COL.accent or COL.field
	soBtnScale.TextColor3 = (soMode == "scale") and COL.text or COL.dim
	soBtnOffset.TextColor3 = (soMode == "offset") and COL.text or COL.dim
end
local function segBtn(label, order)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Font = Enum.Font.GothamBold
	b.Text = label
	b.TextSize = 12
	b.TextColor3 = COL.text
	b.BackgroundColor3 = COL.field
	b.Size = UDim2.new(0.5, -4, 1, 0)
	b.LayoutOrder = order
	b.Parent = soSeg
	corner(b, 7)
	b.BorderSizePixel = 0
	return b
end
soBtnScale = segBtn("Scale", 1)
soBtnOffset = segBtn("Offset", 2)

-- the property this applies to
local SO_PROPS = {
	{ key = "All", label = "Everything" },
	{ key = "Position", label = "Position" },
	{ key = "Size", label = "Size" },
	{ key = "CellSize", label = "CellSize" },
	{ key = "Padding", label = "Padding" },
	{ key = "CellPadding", label = "CellPadding" },
	{ key = "CornerRadius", label = "CornerRadius" },
	{ key = "UIStroke", label = "UIStroke" },
	{ key = "CanvasSize", label = "CanvasSize" },
}
local soPick = "All"
local soDeep = true

local soDrop = Instance.new("TextButton")
soDrop.AutoButtonColor = false
soDrop.Font = Enum.Font.GothamBold
soDrop.Text = "Everything"
soDrop.TextSize = 12
soDrop.TextColor3 = COL.text
soDrop.BackgroundColor3 = COL.field
soDrop.Size = UDim2.new(1, 0, 0, 30)
soDrop.LayoutOrder = 2
soDrop.Parent = soCard
corner(soDrop, 7)
soDrop.BorderSizePixel = 0
local soArrow = Instance.new("TextLabel")
soArrow.BackgroundTransparency = 1
soArrow.Font = Enum.Font.GothamBold
soArrow.Text = "v"
soArrow.TextSize = 11
soArrow.TextColor3 = COL.dim
soArrow.AnchorPoint = Vector2.new(1, 0.5)
soArrow.Position = UDim2.new(1, -10, 0.5, 0)
soArrow.Size = UDim2.fromOffset(12, 12)
soArrow.Parent = soDrop

local soList = Instance.new("Frame")
soList.BackgroundTransparency = 1
soList.Size = UDim2.new(1, 0, 0, 0)
soList.AutomaticSize = Enum.AutomaticSize.Y
soList.Visible = false
soList.LayoutOrder = 3
soList.Parent = soCard
local soListLay = Instance.new("UIListLayout")
soListLay.SortOrder = Enum.SortOrder.LayoutOrder
soListLay.Padding = UDim.new(0, 4)
soListLay.Parent = soList

for i, d in ipairs(SO_PROPS) do
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Font = Enum.Font.Gotham
	b.Text = d.label
	b.TextSize = 11.5
	b.TextColor3 = COL.text
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.BackgroundColor3 = COL.field
	b.Size = UDim2.new(1, 0, 0, 26)
	b.LayoutOrder = i
	b.Parent = soList
	corner(b, 6)
	local bp = Instance.new("UIPadding")
	bp.PaddingLeft = UDim.new(0, 10)
	bp.Parent = b
	b.MouseEnter:Connect(function() b.BackgroundColor3 = COL.stroke end)
	b.MouseLeave:Connect(function() b.BackgroundColor3 = COL.field end)
	b.MouseButton1Click:Connect(function()
		soPick = d.key
		soDrop.Text = d.label
		soList.Visible = false
	end)
end
soDrop.MouseButton1Click:Connect(function()
	soList.Visible = not soList.Visible
	soArrow.Text = soList.Visible and "^" or "v"
end)

local soDeepBtn = Instance.new("TextButton")
soDeepBtn.AutoButtonColor = false
soDeepBtn.Font = Enum.Font.Gotham
soDeepBtn.Text = "Everything inside too"
soDeepBtn.TextSize = 11
soDeepBtn.TextColor3 = COL.text
soDeepBtn.BackgroundColor3 = COL.accent
soDeepBtn.Size = UDim2.new(1, 0, 0, 26)
soDeepBtn.LayoutOrder = 4
soDeepBtn.Parent = soCard
corner(soDeepBtn, 7)
soDeepBtn.BorderSizePixel = 0
soDeepBtn.MouseButton1Click:Connect(function()
	soDeep = not soDeep
	soDeepBtn.BackgroundColor3 = soDeep and COL.accent or COL.field
	soDeepBtn.TextColor3 = soDeep and COL.text or COL.dim
	soDeepBtn.Text = soDeep and "Everything inside too" or "Only the selected element"
end)

local function wants(key)
	return soPick == "All" or soPick == key
end

local soReact
local function runConvert(toScale, btn)
	local roots = {}
	for _, s2 in ipairs(Selection:Get()) do
		-- a UIStroke, UICorner, UIPadding or layout picked in the Explorer is what the
		-- person means to convert: it is not a GuiObject, and dropping it left
		-- "Nothing selected" on screen with the stroke highlighted (29.09.2026)
		if s2:IsA("GuiObject") or s2:IsA("UIComponent") then table.insert(roots, s2) end
	end
	if #roots == 0 then
		setStatus("Select a UI element first.", COL.dim)
		if btn then soReact(btn, "Nothing selected — pick a UI element (or its UIStroke, UICorner, UIPadding) in the Explorer first.", COL.dim) end
		return
	end
	local touched, elements = 0, 0
	record(toScale and "Convert to Scale" or "Convert to Offset", function()
		local seen = {}
		local function visit(inst)
			if seen[inst] then return end
			seen[inst] = true
			local n = convertInstance(inst, toScale, wants)
			if n > 0 then
				touched = touched + n
				elements = elements + 1
			end
			if soDeep then
				for _, c in ipairs(inst:GetChildren()) do visit(c) end
			else
				-- a corner, a padding or a layout is a CHILD, not a property:
				-- "only this element" still has to reach its own modifiers
				for _, c in ipairs(inst:GetChildren()) do
					if c:IsA("UIComponent") then
						local n2 = convertInstance(c, toScale, wants)
						if n2 > 0 then touched = touched + n2 end
					end
				end
			end
		end
		for _, r in ipairs(roots) do visit(r) end
	end)
	readFromElement()
	local msg, col
	if touched == 0 then
		-- Name the property that was asked for: the usual cause is a filter matching
		-- nothing in this selection, not a button that failed to fire.
		msg = (soPick == "All")
			and ("Nothing to convert — everything here is already " .. (toScale and "Scale" or "Offset") .. ".")
			or ("Nothing to convert — no " .. soPick .. " here, or it is already " .. (toScale and "Scale" or "Offset") .. ".")
		col = COL.dim
	else
		msg = ("%s → %s: %d %s on %d element%s."):format(
			(soPick == "All") and "Everything" or soPick,
			toScale and "Scale" or "Offset", touched,
			touched == 1 and "property" or "properties",
			elements, elements == 1 and "" or "s")
		col = COL.ok
	end
	setStatus(msg, col)
	if btn then soReact(btn, msg, col) end
end

-- The panel's status line lives at the very bottom, often scrolled out of sight, so
-- a click here looked like nothing happened at all. Answer next to the buttons.
local soResult = Instance.new("TextLabel")
soResult.BackgroundTransparency = 1
soResult.Font = Enum.Font.GothamMedium
soResult.Text = ""
soResult.TextSize = 11
soResult.TextColor3 = COL.dim
soResult.TextWrapped = true
soResult.TextXAlignment = Enum.TextXAlignment.Left
soResult.Size = UDim2.new(1, 0, 0, 0)
soResult.AutomaticSize = Enum.AutomaticSize.Y
soResult.Visible = false
soResult.LayoutOrder = 5
soResult.Parent = soCard

-- ...and the button itself answers for a moment: colour, then its own label back.
-- The token guards a second click landing while the first is still counting down.
local soBeat = 0
function soReact(btn, msg, col) -- fills the forward local declared above runConvert
	soResult.Text = msg
	soResult.TextColor3 = col
	soResult.Visible = true
	-- Only a real conversion touches the button. "Nothing selected" and "nothing
	-- matched" are not failures — they are the panel telling you where you are, and
	-- flashing a red button at that reads as if something broke.
	if col ~= COL.ok then return end
	soBeat = soBeat + 1
	local beat = soBeat
	local label = (btn == soBtnScale) and "Scale" or "Offset"
	btn.Text = "✓  " .. label
	btn.BackgroundColor3 = COL.ok
	btn.TextColor3 = COL.field
	task.delay(0.9, function()
		if beat ~= soBeat then return end
		btn.Text = label
		paintMode()
	end)
end

soBtnScale.MouseButton1Click:Connect(function()
	soMode = "scale"; paintMode(); runConvert(true, soBtnScale)
end)
soBtnOffset.MouseButton1Click:Connect(function()
	soMode = "offset"; paintMode(); runConvert(false, soBtnOffset)
end)
paintMode()

local soHint = Instance.new("TextLabel")
soHint.BackgroundTransparency = 1
soHint.Font = Enum.Font.Gotham
soHint.Text = "Scale keeps a share of the parent, so it holds on any screen. Offset is fixed pixels. Pick a property, then a direction."
soHint.TextSize = 11
soHint.TextColor3 = COL.dim
soHint.TextWrapped = true
soHint.TextXAlignment = Enum.TextXAlignment.Left
soHint.Size = UDim2.new(1, 0, 0, 0)
soHint.AutomaticSize = Enum.AutomaticSize.Y
soHint.LayoutOrder = 6 -- the answer to the last click sits above the standing hint
soHint.Parent = soCard

-- ---- QUICK ACTIONS -----------------------------------------------------------
local qaCard = card("Quick actions")
local function qaBtn(label, order, fn)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Font = Enum.Font.Gotham
	b.Text = label
	b.TextSize = 12
	b.TextColor3 = COL.text
	b.BackgroundColor3 = COL.field
	b.Size = UDim2.new(1, 0, 0, 30)
	b.LayoutOrder = order
	b.Parent = qaCard
	corner(b, 7)
	b.BorderSizePixel = 0
	b.MouseEnter:Connect(function() b.BackgroundColor3 = COL.stroke end)
	b.MouseLeave:Connect(function() b.BackgroundColor3 = COL.field end)
	b.MouseButton1Click:Connect(function()
		local g = firstSelectedGui()
		if not g then setStatus("Select a UI element first.", COL.err) return end
		record(label, function() fn(g) end)
		readFromElement()
	end)
	return b
end

qaBtn("Remove background", 1, function(g)
	g.BackgroundTransparency = 1
	setStatus("Background hidden — the element still holds its children.", COL.ok)
end)
qaBtn("Lock aspect ratio", 2, function(g)
	local c = g:FindFirstChildWhichIsA("UIAspectRatioConstraint")
	if not c then
		c = Instance.new("UIAspectRatioConstraint")
		c.Parent = g
	end
	local sz = g.AbsoluteSize
	c.AspectRatio = (sz.Y > 0) and (sz.X / sz.Y) or 1
	c.DominantAxis = Enum.DominantAxis.Width
	setStatus(("Locked at %.3f — it keeps this shape on every screen."):format(c.AspectRatio), COL.ok)
end)
qaBtn("Unlock aspect ratio", 3, function(g)
	local c = g:FindFirstChildWhichIsA("UIAspectRatioConstraint")
	if c then
		c:Destroy()
		setStatus("Aspect lock removed.", COL.ok)
	else
		setStatus("This element had no aspect lock.", COL.dim)
	end
end)
qaBtn("Text: fit the box (TextScaled)", 4, function(g)
	if not (g:IsA("TextLabel") or g:IsA("TextButton") or g:IsA("TextBox")) then
		setStatus("That works on text elements only.", COL.err)
		return
	end
	g.TextScaled = not g.TextScaled
	setStatus(g.TextScaled and "TextScaled on — the text fills its box." or "TextScaled off — TextSize is back in charge.", COL.ok)
end)
end)()

-- ---- IMAGE (ScaleType) -------------------------------------------------------
-- Figma fills in Fill mode arrive as ScaleType=Crop: when shrunk, Roblox cuts a
-- window out of the art instead of scaling it ("my image gets cropped"). This
-- fixes it in one click; undo with Ctrl+Z.
local imgCard = card("IMAGE")
imgCard.Visible = false
local imgHint = Instance.new("TextLabel")
imgHint.BackgroundTransparency = 1
imgHint.Font = Enum.Font.Gotham
imgHint.Text = "How the art fills its box. Fit scales it with the box, Crop windows into it, Stretch distorts."
imgHint.TextSize = 10.5
imgHint.TextWrapped = true
imgHint.TextColor3 = COL.dim
imgHint.TextXAlignment = Enum.TextXAlignment.Left
imgHint.Size = UDim2.new(1, 0, 0, 14)
imgHint.AutomaticSize = Enum.AutomaticSize.Y
imgHint.LayoutOrder = 1
imgHint.Parent = imgCard

local imgRow = Instance.new("Frame")
imgRow.BackgroundTransparency = 1
imgRow.Size = UDim2.new(1, 0, 0, 30)
imgRow.LayoutOrder = 2
imgRow.Parent = imgCard
local imgRowL = Instance.new("UIListLayout")
imgRowL.FillDirection = Enum.FillDirection.Horizontal
imgRowL.Padding = UDim.new(0, 8)
imgRowL.SortOrder = Enum.SortOrder.LayoutOrder
imgRowL.Parent = imgRow

local IMG_MODES = {
	{ label = "Fit", mode = Enum.ScaleType.Fit },
	{ label = "Crop", mode = Enum.ScaleType.Crop },
	{ label = "Stretch", mode = Enum.ScaleType.Stretch },
}
local imgBtns = {}
local function isImageGui(g)
	return g ~= nil and (g:IsA("ImageLabel") or g:IsA("ImageButton"))
end
local function refreshImgMode()
	local g = firstSelectedGui()
	local ok = isImageGui(g)
	imgCard.Visible = ok
	if not ok then return end
	for _, b in ipairs(imgBtns) do
		local on = g.ScaleType == b.mode
		b.btn:SetAttribute("on", on)
		b.btn.BackgroundColor3 = on and COL.accent or COL.field
	end
end
for i, m in ipairs(IMG_MODES) do
	local b = Instance.new("TextButton")
	b.Text = m.label
	b.Font = Enum.Font.Gotham
	b.TextSize = 12
	b.AutoButtonColor = false
	b.TextColor3 = COL.text
	b.BackgroundColor3 = COL.field
	b.Size = UDim2.new(1 / 3, -6, 1, 0)
	b.LayoutOrder = i
	b.Parent = imgRow
	corner(b, 7)
	b.BorderSizePixel = 0
	b.MouseEnter:Connect(function()
		if b:GetAttribute("on") ~= true then b.BackgroundColor3 = COL.stroke end
	end)
	b.MouseLeave:Connect(function()
		if b:GetAttribute("on") ~= true then b.BackgroundColor3 = COL.field end
	end)
	table.insert(imgBtns, { btn = b, mode = m.mode })
	b.MouseButton1Click:Connect(function()
		local g = firstSelectedGui()
		if not isImageGui(g) then return end
		record("Image scale mode", function() g.ScaleType = m.mode end)
		refreshImgMode()
		setStatus("Image scaling: " .. m.label .. ".", COL.ok)
	end)
end

local ccCard = card("Element type")
local ccGrid = Instance.new("Frame")
ccGrid.BackgroundTransparency = 1
ccGrid.Size = UDim2.new(1, 0, 0, 0)
ccGrid.AutomaticSize = Enum.AutomaticSize.Y
ccGrid.LayoutOrder = 1
ccGrid.Parent = ccCard
local ccLayout = Instance.new("UIGridLayout")
ccLayout.CellSize = UDim2.new(0.5, -4, 0, 34)
ccLayout.CellPadding = UDim2.fromOffset(8, 8)
ccLayout.SortOrder = Enum.SortOrder.LayoutOrder
ccLayout.Parent = ccGrid

for i, cls in ipairs(CONVERT_CLASSES) do
	local b = Instance.new("TextButton")
	b.Text = ""
	b.AutoButtonColor = false
	b.BackgroundColor3 = COL.field
	b.LayoutOrder = i
	b.Parent = ccGrid
	corner(b, 8)
	b.BorderSizePixel = 0
	local bl = Instance.new("UIListLayout")
	bl.FillDirection = Enum.FillDirection.Horizontal
	bl.VerticalAlignment = Enum.VerticalAlignment.Center
	bl.Padding = UDim.new(0, 6)
	bl.Parent = b
	local bp = Instance.new("UIPadding")
	bp.PaddingLeft = UDim.new(0, 8)
	bp.Parent = b
	local ic = Instance.new("ImageLabel")
	ic.BackgroundTransparency = 1
	ic.Size = UDim2.fromOffset(16, 16)
	classIcon(ic, cls)
	ic.Parent = b
	local nm = Instance.new("TextLabel")
	nm.BackgroundTransparency = 1
	nm.Font = Enum.Font.Gotham
	nm.Text = cls
	nm.TextSize = 10.5
	nm.TextColor3 = COL.text
	nm.TextXAlignment = Enum.TextXAlignment.Left
	nm.TextTruncate = Enum.TextTruncate.AtEnd
	nm.Size = UDim2.new(1, -26, 1, 0)
	nm.Parent = b
	b.MouseEnter:Connect(function() b.BackgroundColor3 = COL.stroke end)
	b.MouseLeave:Connect(function() b.BackgroundColor3 = COL.field end)
	b.MouseButton1Click:Connect(function()
		local g = firstSelectedGui()
		if not g then setStatus("Select a UI element first.", COL.err) return end
		if g.ClassName == cls then setStatus("Already a " .. cls .. ".", COL.dim) return end
		local from = g.ClassName
		local ok, err = record("Convert to " .. cls, function()
			local newInst = convertClass(g, cls)
			Selection:Set({ newInst })
		end)
		if ok then
			setStatus(from .. " to " .. cls, COL.ok)
		else
			setStatus("Convert failed: " .. tostring(err), COL.err)
		end
	end)
end

-- ---- status -----------------------------------------------------------------
tstatus = Instance.new("TextLabel")
tstatus.Text = "Drag the box to move it, pull the dots to resize. Everything is undo-able (Ctrl+Z)."
tstatus.Font = Enum.Font.Gotham
tstatus.TextSize = 11
tstatus.TextWrapped = true
tstatus.TextColor3 = COL.dim
tstatus.BackgroundTransparency = 1
tstatus.Size = UDim2.new(1, 0, 0, 28)
tstatus.AutomaticSize = Enum.AutomaticSize.Y
tstatus.TextYAlignment = Enum.TextYAlignment.Top
tstatus.TextXAlignment = Enum.TextXAlignment.Left
tstatus.LayoutOrder = ord()
tstatus.Parent = tcontent

local function refreshSel()
	local g = firstSelectedGui()
	if g then
		selText.Text = g.ClassName .. "  (" .. g.Name .. ")"
		selText.TextColor3 = COL.text
		classIcon(selIcon, g.ClassName)
		box.Visible = true
		UI.emptyStage.Visible = false
		readFromElement()
	else
		selText.Text = "Select a UI element to edit"
		selText.TextColor3 = COL.dim
		selIcon.Visible = false
		box.Visible = false
		UI.emptyStage.Visible = true
	end
	highlightAnchor()
	refreshImgMode()
	rebuildGuides()
end
Selection.SelectionChanged:Connect(refreshSel)
refreshSel()

toolsBtn.Click:Connect(function()
	toolsWidget.Enabled = not toolsWidget.Enabled
	if toolsWidget.Enabled then
		refreshSel()
	end
end)
