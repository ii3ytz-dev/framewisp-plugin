end
local function restoreSequences(state)
	if state.first ~= nil then
		state.grad.Color = state.color
		state.grad.Transparency = state.alpha
		state.first = nil
	end
end
local function restore(st, state)
	states[st] = nil
	local grad = state.grad
	if not grad or grad.Parent ~= st then return end
	if state.made then
		grad:Destroy()
	else
