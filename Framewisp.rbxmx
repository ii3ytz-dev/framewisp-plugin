end
local function paint(state, dt)
	local el, grad = state.el, state.grad
	local still = reduced(el)
	local mode = number(el, "StrokeMode", 0, 0, 1) >= 0.5 and 1 or 0
	if state.mode ~= mode then
		state.mode, state.turn, state.travel = mode, 0, 0
	end
	local angle = number(el, "StrokeAngle", state.rotation, -360, 360)
	if not still then
		if mode == 0 then
			state.turn = (state.turn + dt * number(el, "StrokeRotate", 45, -360, 360)) % 360
		else
